// Zig binding tests. `zig build test` links libservirtium_vcr
// (core/.build.ae output: core/native/libservirtium_vcr.so) at build time via
// bldr.zig's addLibraryPath + linkSystemLibrary("servirtium_vcr") + rpath, so
// this deps libservirtium_vcr node and points the build at it through
// SERVIRTIUM_VCR_LIB. The test shells out to curl against a playback server
// (one VCR server per process; tests run serially).
import bldr
import zig
import bldr (env)
aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        zig.test_existing() { env("SERVIRTIUM_VCR_LIB", lib) }
    }
}
