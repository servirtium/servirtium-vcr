// Third-party-consumer PACKAGE stage for the Zig binding.
// A Zig consumer links the engine .so via its own bldr.zig, pointed at the
// package's bundled native/ dir. Stages the freshly-built engine .so into
// zig/native/. Deps core/.build.ae; publishes the zig package dir on
// "package_dir".
import bldr
import copy
import copy (from, to)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")

        // copy.file auto-creates the dest parent; `to` resolves against this
        // leaf's source_dir (zig/), so no ${root}/zig hardcode for the stage.
        copy.file() {
            from(lib)
            to("native/libservirtium_vcr.so")
        }

        publish_artifact("package_dir", "${_get("root")}/zig")
        println("zig package: staged engine .so into zig/native/ (Zig package ready)")
        return 0
    }
}
