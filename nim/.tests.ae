// Nim binding tests. Nim's C backend links the shared engine (core/.build.ae
// output: core/native/libservirtium_vcr.so) via native.nim's
// `{.passL: "-L<core/native> -lservirtium_vcr -Wl,-rpath,<core/native>".}`,
// so this deps the engine node and passes SERVIRTIUM_VCR_LIB at compile time
// (native.nim honors it to resolve the -L dir). It runs the full suite — the
// playback smoke test plus the playback/record/mutation suites (parity with
// the Go binding) — each as a `nim c -r` unittest. --threads:on is required:
// the record/mutation suites run a throwaway std/asynchttpserver upstream on a
// dedicated thread. Playback drives requests with curl, record with
// std/httpclient (one VCR server per port).
import build
import nim
import build (env)
import nim (test_file, nim_flag)
aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    lib = build.dep_artifact(b, "core/.build.ae", "shared_lib")
    nim.test(b) {
        env("SERVIRTIUM_VCR_LIB", lib)
        nim_flag("--hints:off")
        nim_flag("--threads:on")
        nim_flag("--path:src")
        nim_flag("--path:tests")
        test_file("tests/playback.nim")
        test_file("tests/playback_test.nim")
        test_file("tests/record_test.nim")
        test_file("tests/mutation_test.nim")
    }
}
