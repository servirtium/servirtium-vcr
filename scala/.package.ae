// Third-party-consumer PACKAGE stage for the Scala binding.
// mvn-installs the Scala helper layer (vcr-scala) to ~/.m2; deps
// java/.package.ae so the Java jar (with the bundled libservirtium_vcr.so) is in ~/.m2
// first and rides along transitively for a Scala consumer.
import bldr
import maven

aeb(cap) {
    bldr.build() {
        dep("java/.package.ae")

        // maven.install runs `mvn -q -DskipTests install` in this leaf's
        // module_dir (scala/) — no ${root}/scala hardcode.
        maven.install()

        publish_artifact("maven_gav", "dev.servirtium:vcr-scala:2.0.0-alpha.15")
        println("scala package: installed vcr-scala jar to ~/.m2")
        return 0
    }
}
