// Scala binding — aeb-native. Compiles src/main/scala against the Java
// binding classes (bldr.dep java/.build.ae); the scala SDK resolves the
// scala3 compiler + library via maven coords.
import bldr
import scala
import scala (scala_version)
aeb(cap) {
    bldr.build() {
        dep("java/.build.ae")
        scala.scalac() { scala_version("3.3.4") }
    }
}
