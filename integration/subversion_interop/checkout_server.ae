// VCR-backed Subversion checkout replay server.
//
// Loads the (pre-scrubbed) Servirtium-Java SVN checkout tape and serves
// it to a real `svn checkout` client. The .svn_checkout.ae leaf builds
// this, starts it, drives `svn checkout` against it, and asserts the
// replay working tree has the expected files. Reads TAPE_PATH (default
// is the vendored scrubbed tape) and prints READY once listening.

import std.http
import core.vcr

extern exit(code: int)
extern http_server_start_raw(server: ptr) -> int
extern os_getenv(name: string) -> string

const PORT = 18142
const TAPE_REL = "integration/subversion_interop/tapes/svn_checkout_scrubbed.tape"

message StartSrv { raw: ptr }
message Noop {}

actor SrvActor {
    state s = 0
    receive { StartSrv(raw) -> { s = raw; http_server_start_raw(raw) } }
}

actor SchedHelper {
    state x = 0
    receive { Noop() -> { x = 1 } }
}

main() {
    tape_path = os_getenv("TAPE_PATH")
    if tape_path == 0 {
        tape_path = TAPE_REL
    }

    raw = vcr.load(tape_path, PORT)
    if raw == 0 {
        println("FAIL: vcr.load returned null")
        exit(1)
    }

    // NOTE: no server_set_keepalive — same reasoning as checkout_via_vcr.ae:
    // the tape's recorded Keep-Alive headers replay verbatim; the server's
    // own keepalive header emission would fight them. Defaults were in
    // effect all along (the old call's bare-int idle was a silent no-op).

    access_log = os_getenv("ACCESS_LOG")
    if access_log != 0 {
        log_err = http.server_set_access_log(raw, "json", access_log)
        if log_err != "" {
            println("FAIL: server_set_access_log: ${log_err}")
            exit(1)
        }
    }

    println("READY")

    spawn(SchedHelper())
    a = spawn(SrvActor())
    a ! StartSrv { raw: raw }

    // Block until the shell runner terminates this process.
    sleep(120000)
    vcr.eject(raw)
    exit(0)
}
