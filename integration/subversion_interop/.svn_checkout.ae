// Real `svn` client driven through the Aether VCR — offline replay half of
// the engine's svn_checkout_fs_equivalence test (the gated live-network
// comparison against svn.apache.org is intentionally NOT ported).
//
// Inline UP -> use -> DOWN, modelled on integration/todobackend/.python_record.ae:
// the "service" is the VCR replay server process (checkout_server.ae, built
// against the local engine via --extra), torn down unconditionally.
//
//   UP    build checkout_server.ae, start it on :18142 reading the vendored
//         pre-scrubbed tape (tapes/svn_checkout_scrubbed.tape), poll for READY
//   USE   `svn checkout --non-interactive <playback-url> target/.../conf`
//   ASSERT rc==0 and exactly 4 working-tree files (providers.xml, identity.jks,
//         trust.jks, log4j.properties) materialised — the recorded checkout
//   DOWN  kill the server (pkill -x checkout_server), clean target/ checkout
//
// The tape is committed pre-scrubbed: the engine's .sh did the request-block
// scrub (perl) + spliced a synthetic 404 for interaction 4 (awk) at runtime;
// here that transform is baked into tapes/svn_checkout_scrubbed.tape once.
//
// Run:  aeb integration/subversion_interop/.svn_checkout.ae
import build
import std.os
import std.string

const PORT = 18142
const PLAYBACK = "http://127.0.0.1:18142/repos/asf/synapse/tags/3.0.0/modules/distribution/src/main/conf"

main() {
    // svn must be present; skip cleanly otherwise.
    have_svn = os.system("command -v svn >/dev/null 2>&1")
    if have_svn != 0 {
        println("subversion_interop(svn_checkout): SKIP — svn not found")
        return 0
    }

    b = build.start()
    root = build._get(b, "root")
    out = "${root}/target/subversion_interop"
    cc = "${root}/core/aether_vcr.c"
    tape = "${root}/integration/subversion_interop/tapes/svn_checkout_scrubbed.tape"
    srv_bin = "${out}/checkout_server"
    srv_log = "${out}/checkout_server.log"
    co_dir = "${out}/svn_checkout/conf"
    co_log = "${out}/svn_checkout.log"
    _mk = os.system("mkdir -p \"${out}\" && rm -rf \"${out}/svn_checkout\"")

    // --- build the VCR replay server against the local engine ---
    bld = os.system("cd \"${root}\" && ae build integration/subversion_interop/checkout_server.ae --extra \"${cc}\" -o \"${srv_bin}\" 2>\"${srv_log}\"")
    if bld != 0 {
        println("subversion_interop(svn_checkout): server build failed (see ${srv_log})")
        return 1
    }

    // --- UP: start the server in the background, poll for READY ---
    _start = os.system("TAPE_PATH=\"${tape}\" \"${srv_bin}\" >\"${srv_log}\" 2>&1 &")
    ready = 0
    i = 0
    while i < 60 {
        seen = os.system("grep -q '^READY' \"${srv_log}\" 2>/dev/null")
        if seen == 0 { ready = 1  i = 60 } else { _s = os.system("sleep 0.25")  i = i + 1 }
    }

    // --- USE: drive a real svn checkout against the VCR; assert file count ---
    result = 1
    if ready == 1 {
        println("subversion_interop(svn_checkout): VCR up on :${PORT}")
        co = os.system("svn checkout --non-interactive \"${PLAYBACK}\" \"${co_dir}\" >\"${co_log}\" 2>&1")
        if co != 0 {
            println("subversion_interop(svn_checkout): svn checkout failed (see ${co_log})")
        } else {
            cnt_s, _ = os.exec("find \"${co_dir}\" -path '*/.svn/*' -prune -o -type f -print | wc -l")
            cnt = string.trim(cnt_s)
            if cnt == "4" {
                println("subversion_interop(svn_checkout): PASS — svn checkout replayed cleanly, ${cnt} working-tree files")
                result = 0
            } else {
                println("subversion_interop(svn_checkout): FAIL — expected 4 working-tree files, got ${cnt}")
            }
        }
    } else {
        println("subversion_interop(svn_checkout): VCR server never reported READY (see ${srv_log})")
    }

    // --- DOWN: unconditional teardown + cleanup ---
    _kill = os.system("pkill -x checkout_server >/dev/null 2>&1")
    _rm = os.system("rm -rf \"${out}/svn_checkout\"")
    println("subversion_interop(svn_checkout): tore down VCR server")

    if result != 0 { return 1 }
    return 0
}
