// On-demand network leaf — the record-equivalent / live checks for the
// climate walkthrough. These hit the real GitHub-Pages mirror over HTTPS,
// so they are NOT part of the offline .tests.ae; run them by name when you
// want to re-record the tape or sanity-check against the live upstream.
//
// Both probes honor AETHER_SKIP_NETWORK (set it and they skip / replay-only),
// and both are built against the LOCAL engine (core/vcr.ae, pure Aether —
// aether.program with lib("../..") resolves `import core.vcr`) so they
// build cleanly even on offline runners.
//
//   1. test_climate_record_then_replay.ae — Servirtium roadmap step 3.
//      Tape present (the default — it's committed) → replays it offline.
//      Delete tapes/climate_5_endpoints.tape and re-run to exercise the
//      recorder: proxies the 5 paths to the live mirror, captures, flushes
//      the tape, then asserts. Set AETHER_VCR_RECORD=1 with a tape present
//      to drive the re-record byte-diff check.
//   2. test_climate_real.ae — Servirtium roadmap step 1. The 5 assertions
//      straight against DEFAULT_BASE (the live mirror), no VCR. Skips under
//      AETHER_SKIP_NETWORK.
//
// Porting this leaf out of .tests.ae mirrors integration/subversion_interop's
// split (offline .tests.ae vs on-demand .svn_checkout.ae).
//
// Run:  aeb integration/climate_interop/.record.ae
import bldr
import aether
import aether (source, output, lib)
import std.os

aeb(cap) {
    bldr.build() {
        aether.program() {
            source("test_climate_record_then_replay.ae")
            output("test_climate_record_then_replay")
            lib("../..")
        }
        aether.program() {
            source("test_climate_real.ae")
            output("test_climate_real")
            lib("../..")
        }
        root = _get("root")
        td = _get("target_dir")

        fails = 0

        // --- probe 1: record-then-replay (replays committed tape by default; ---
        // --- records from the live mirror when the tape is absent) ---
        log1 = "${td}/test_climate_record_then_replay.log"
        rc1 = os.system("cd \"${root}\" && \"${td}/bin/test_climate_record_then_replay\" >\"${log1}\" 2>&1")
        if rc1 != 0 {
            println("climate_interop(record): test_climate_record_then_replay FAILED (see ${log1})")
            fails = fails + 1
        } else {
            grep1 = os.system("grep -qE \"All 5 record-then-replay tests passed|SKIP test_climate_record_then_replay\" \"${log1}\"")
            if grep1 != 0 { println("climate_interop(record): record_then_replay missing pass/skip summary"); fails = fails + 1 }
            else { println("climate_interop(record): test_climate_record_then_replay PASS (see ${log1})") }
        }

        // --- probe 2: real-network assertions (no VCR); skips under AETHER_SKIP_NETWORK ---
        log2 = "${td}/test_climate_real.log"
        rc2 = os.system("cd \"${root}\" && \"${td}/bin/test_climate_real\" >\"${log2}\" 2>&1")
        if rc2 != 0 {
            println("climate_interop(record): test_climate_real FAILED (see ${log2})")
            fails = fails + 1
        } else {
            grep2 = os.system("grep -qE \"All 5 climate API tests passed|SKIP test_climate_api_real\" \"${log2}\"")
            if grep2 != 0 { println("climate_interop(record): test_climate_real missing pass/skip summary"); fails = fails + 1 }
            else { println("climate_interop(record): test_climate_real PASS (see ${log2})") }
        }

        if fails != 0 { println("climate_interop(record): ${fails} test(s) failed"); return 1 }
        println("climate_interop(record): live/record probes passed")
        return 0
    }
}
