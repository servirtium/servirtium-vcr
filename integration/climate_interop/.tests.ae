// WorldBank-climate VCR test (offline, pure-Aether) — the canonical Servirtium
// "weather" walkthrough, ported from the Aether engine's
// contrib/climate_http_tests/ into the monorepo so it rides on core/ (the
// engine now lives here). One probe, compiled against the LOCAL engine
// (core/vcr.ae, pure Aether — aether.program with lib("../..") resolves
// `import core.vcr` from the repo root) and run inline here — no .sh runner:
//
//   test_climate_via_vcr.ae — replays the committed 5-interaction tape
//     (tapes/climate_5_endpoints.tape) through the VCR on port 18099 and
//     drives the climate API client (module.ae) against it. 5 assertions:
//     gbr/fra/egy mean rainfall + the two body-content failure modes
//     (unsupported date range, bad country code). Fully offline.
//     Summary: "=== All 5 climate-via-VCR tests passed ==="
//
// The network-dependent tests (record-then-replay against the live
// GitHub-Pages mirror, and the real-network assertions) live in the
// sibling on-demand leaf .record.ae — NOT run here.
//
// Run:  aeb integration/climate_interop/.tests.ae
import bldr
import aether
import aether (source, output, lib)
import std.os

aeb(cap) {
    bldr.build() {
        aether.program() {
            source("test_climate_via_vcr.ae")
            output("test_climate_via_vcr")
            lib("../..")
        }
        root = _get("root")
        td = _get("target_dir")

        log1 = "${td}/test_climate_via_vcr.log"
        rc1 = os.system("cd \"${root}\" && \"${td}/bin/test_climate_via_vcr\" >\"${log1}\" 2>&1")
        if rc1 != 0 {
            println("climate_interop: test_climate_via_vcr FAILED (see ${log1})")
            return 1
        }
        grep1 = os.system("grep -q \"All 5 climate-via-VCR tests passed\" \"${log1}\"")
        if grep1 != 0 { println("climate_interop: test_climate_via_vcr missing pass summary"); return 1 }
        println("climate_interop: test_climate_via_vcr PASS (5 assertions, offline replay on :18099)")
        println("climate_interop: offline probe passed")
        return 0
    }
}
