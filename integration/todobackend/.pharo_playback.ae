// TodoBackend browser integration — Pharo binding, PLAYBACK leaf.
//
// Name this leaf to run it:  aeb integration/todobackend/.pharo_playback.ae
//
// Replays the committed CRUD tape through a Pharo-hosted VCR and runs the real
// TodoBackend Mocha spec against it in real headless Chrome, driven by Parasol
// (Pharo's Selenium WebDriver client). No SUT, no network — proves the full
// record/replay loop for the Pharo binding.
//
// Parasol speaks WebDriver over /wd/hub to a Selenium *Server* (it does not hit
// chromedriver's /session directly), so run.sh starts a `selenium-server
// standalone` backed by the cached chromedriver and tears it down. Models the
// pharo/.tests.ae invocation (PHARO_DIR, SERVIRTIUM_VCR_LIB via run.sh); also
// needs a Selenium 4.x server jar (SELENIUM_SERVER_JAR, default
// $HOME/.cache/selenium/selenium-server.jar).
import bldr
import std.os
import std.string
aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        root = _get("root")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        pharo = os.getenv("PHARO_DIR")
        if string.length(pharo) == 0 { pharo = "$HOME/.local/pharo" }
        rc = os.system("cd \"${root}/integration/todobackend/pharo\" && SERVIRTIUM_VCR_LIB=\"${lib}\" PHARO_DIR=\"${pharo}\" ./run.sh playback")
        if rc != 0 { println("todobackend/pharo playback: failed"); return 1 }
        println("todobackend/pharo playback: passed")
        return 0
    }
}
