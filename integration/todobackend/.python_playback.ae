// TodoBackend browser integration — Python binding, PLAYBACK leaf.
//
// Name this leaf to run it:  aeb integration/todobackend/.python_playback.ae
//
// Replays the committed CRUD tape through a Python-hosted VCR and runs the real
// TodoBackend Mocha spec against it in headless Chrome (Python selenium). No
// SUT, no network — proves the full record/replay loop for the Python binding.
import build
import std.os
aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    root = build._get(b, "root")
    lib = "${root}/core/native/libservirtium_vcr.so"
    rc = os.system("cd \"${root}/integration/todobackend/python\" && SERVIRTIUM_VCR_LIB=\"${lib}\" PYTHONPATH=\"${root}/python:.\" python3 playback_test.py")
    if rc != 0 { println("todobackend/python playback: failed"); return 1 }
    println("todobackend/python playback: passed")
    return 0
}
