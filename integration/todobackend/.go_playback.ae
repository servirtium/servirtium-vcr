// TodoBackend browser integration — Go binding, PLAYBACK leaf.
//
// Name this leaf to run it:  aeb integration/todobackend/.go_playback.ae
//
// Replays the committed CRUD tape through a Go-hosted VCR (cgo over the shared
// engine) and runs the real TodoBackend Mocha spec against it in headless
// Chrome (Go's own github.com/tebeka/selenium WebDriver client, launching the
// cached chromedriver service). No SUT, no network — proves the full
// record/replay loop for the Go binding. The record-phase test skips unless
// TODOBACKEND_UPSTREAM is set, so -run selects only the playback test.
//
// The integration test has its own go.mod (it adds the selenium client) with a
// replace pointing at the in-repo binding (go/); cgo links the shared engine
// via the binding package's own rpath (relative to go/), so the .so resolves.
import build
import std.os
main() {
    b = build.start()
    build.dep(b, "core/.build.ae")
    root = build._get(b, "root")
    lib = "${root}/core/native/libservirtium_vcr.so"
    rc = os.system("cd \"${root}/integration/todobackend/go\" && SERVIRTIUM_VCR_LIB=\"${lib}\" go test -run TestMochaSuitePassesOffTheTape -v")
    if rc != 0 { println("todobackend/go playback: failed"); return 1 }
    println("todobackend/go playback: passed")
    return 0
}
