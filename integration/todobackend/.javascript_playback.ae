// TodoBackend browser integration — JavaScript binding, PLAYBACK leaf.
//
// Name this leaf to run it:  aeb integration/todobackend/.javascript_playback.ae
//
// Replays the committed CRUD tape through a JS-hosted VCR and runs the real
// TodoBackend Mocha spec against it in headless Chrome (JS's own
// selenium-webdriver). No SUT, no network — proves the full record/replay loop
// for the JavaScript binding.
import build
import std.os
aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    root = build._get(b, "root")
    lib = "${root}/core/native/libservirtium_vcr.so"
    rc = os.system("cd \"${root}/javascript\" && npm install --silent --no-audit --no-fund && npm run --silent build && cd \"${root}/integration/todobackend/javascript\" && SERVIRTIUM_VCR_LIB=\"${lib}\" NODE_PATH=\"${root}/javascript/node_modules\" node playback.js")
    if rc != 0 { println("todobackend/javascript playback: failed"); return 1 }
    println("todobackend/javascript playback: passed")
    return 0
}
