// TodoBackend browser integration — Rust binding, PLAYBACK leaf.
//
// Name this leaf to run it:  aeb integration/todobackend/.rust_playback.ae
//
// Replays the committed CRUD tape through a Rust-hosted VCR and runs the real
// TodoBackend Mocha spec against it in headless Chrome. The Rust binding drives
// Chrome with its own WebDriver client (thirtyfour, async/tokio) connecting to
// a chromedriver the test starts on an ephemeral port. No SUT, no network —
// proves the full record/replay loop for the Rust binding.
import build
import std.os
import std.string

// The thirtyfour client doesn't auto-fetch a driver; locate the cached one.
_chromedriver() {
    out, _ = os.exec("find \"$HOME/.cache/selenium\" -name chromedriver -type f 2>/dev/null | head -1")
    return string.trim(out)
}

aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    root = build._get(b, "root")
    lib = build.dep_artifact(b, "core/.build.ae", "shared_lib")
    cd = _chromedriver()
    if cd == "" { println("todobackend/rust playback: no cached chromedriver found under ~/.cache/selenium"); return 1 }
    rc = os.system("cd \"${root}/integration/todobackend/rust\" && SERVIRTIUM_VCR_LIB=\"${lib}\" CHROMEDRIVER=\"${cd}\" cargo test --test playback -- --nocapture")
    if rc != 0 { println("todobackend/rust playback: failed"); return 1 }
    println("todobackend/rust playback: passed")
    return 0
}
