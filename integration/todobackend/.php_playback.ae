// TodoBackend browser integration — PHP binding, PLAYBACK leaf.
//
// Name this leaf to run it:  aeb integration/todobackend/.php_playback.ae
//
// Replays the committed CRUD tape through a PHP-hosted VCR and runs the real
// TodoBackend Mocha spec against it in headless Chrome. The PHP binding drives
// Chrome with its own WebDriver client (php-webdriver/webdriver) connecting to
// a chromedriver the program starts on an ephemeral port. No SUT, no network —
// proves the full record/replay loop for the PHP binding.
import build
import std.os
import std.string

// The php-webdriver client doesn't auto-fetch a driver; locate the cached one.
_chromedriver() {
    out, _ = os.exec("find \"$HOME/.cache/selenium\" -name chromedriver -type f 2>/dev/null | head -1")
    return string.trim(out)
}

aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    root = build._get(b, "root")
    lib = "${root}/core/native/libservirtium_vcr.so"
    cd = _chromedriver()
    if cd == "" { println("todobackend/php playback: no cached chromedriver found under ~/.cache/selenium"); return 1 }
    // php-webdriver lives in the binding's composer vendor dir; install if absent.
    dep = os.system("cd \"${root}/php\" && { [ -d vendor ] || composer install --no-interaction --quiet; }")
    if dep != 0 { println("todobackend/php playback: composer install failed"); return 1 }
    rc = os.system("cd \"${root}/integration/todobackend/php\" && SERVIRTIUM_VCR_LIB=\"${lib}\" CHROMEDRIVER=\"${cd}\" php playback_test.php")
    if rc != 0 { println("todobackend/php playback: failed"); return 1 }
    println("todobackend/php playback: passed")
    return 0
}
