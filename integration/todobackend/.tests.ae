// TodoBackend browser integration — PLAYBACK (offline, the CI artifact).
//
// Replays the committed CRUD tape through the VCR and runs the real
// TodoBackend Mocha spec against it in headless Chrome — no SUT, no network.
// Proves the full record/replay loop end to end for a real-world browser test
// suite. Engine-shared, hosted via the Python binding. Regenerate the tape
// with ./record.sh (brings the Kotlin SUT up in a container).
//
// Needs: Chrome/Chromium + Python selenium (Selenium Manager fetches the
// matching chromedriver). PYTHONPATH carries both the python binding and "."
// so playback_test.py can import its sibling browser.py.
import build
import std.os
main() {
    b = build.start()
    build.dep(b, "core/.build.ae")
    root = build._get(b, "root")
    lib = "${root}/core/native/libservirtium_vcr.so"
    rc = os.system("cd \"${root}/integration/todobackend\" && SERVIRTIUM_VCR_LIB=\"${lib}\" PYTHONPATH=\"${root}/python:.\" python3 playback_test.py")
    if rc != 0 { println("integration(todobackend): failed"); return 1 }
    println("integration(todobackend): passed")
    return 0
}
