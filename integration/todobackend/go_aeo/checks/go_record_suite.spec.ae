// SPIKE — the RECORD step for the aeo go todobackend composition.
//
// Declared by suite("checks/go_record_suite.spec.ae") in ../todobackend_go.ae.
// `aeo suite ../todobackend_go.ae` stands the SUT container up, waits for its
// health() to pass, then runs THIS spec, then tears the container down (even if
// this fails). So this spec is exactly the leaf's RECORD phase — no UP, no DOWN,
// no poll loop; aeo owns the lifecycle around it.
//
// It invokes the CANONICAL aeb record leaf (../../go/.record.ae) — NOT a
// hand-built `cd … && ENV=… go test` shell string. That leaf declares the whole
// go-test invocation via go.go_test() { env_var(...) run_filter(...) }, gets the
// engine .so through dep_artifact, and runs from the go.mod dir. So the only
// thing this spec does is ask the build runner to run it: `aeb <leaf>`.
//
// The record test itself drives the Mocha CRUD suite in headless Chrome through a
// record-mode VCR against the health-gated SUT (host :54321, from the
// composition's publish_map(54321,8000)) and flushes the tape.

import std.spec
import std.os

main() {
    fw = spec.init()
    spec.describe(fw, "todobackend/go — record against the health-gated SUT") {
        spec.it("aeb record leaf records the CRUD suite through a record-mode VCR") callback {
            // One build-runner invocation — the leaf owns lib-wiring, env, and the
            // -run selector declaratively. (aeb is on PATH in this ecosystem.)
            rc = os.system("aeb integration/todobackend/go/.record.ae")
            spec.expect_int(rc).to_equal(0)
        }
    }
    return spec.run_summary(fw)
}
