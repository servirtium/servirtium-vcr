// SPIKE — the Go todobackend RECORD standup, expressed as an aeo composition.
//
// Side-by-side experiment (see ../.go_record.ae for the shell version it
// mirrors). Measures whether aeo expresses the container BUILD -> UP -> record ->
// VERIFIED-teardown lifecycle more cleanly than the hand-rolled `podman build` /
// `podman run` / curl-poll / `rm -f` in the leaf.
//
// As of aeo v0.2.2 this mirrors the leaf's REAL invocation with NO workarounds:
//   * BUILD the SUT image from the real Containerfile + source-tree context
//     (containerfile()/build_context()), so there is no manual `podman build`
//     pre-step — aeo builds it before boot.
//   * UP on host :54321 -> container :8000 (publish_map — asymmetric, exactly
//     the leaf's `-p 54321:8000`), with the SUT's real entrypoint + args
//     (exec_entrypoint() -> `--entrypoint`, command() as real args, not sh -c).
//   * health-gated bring-up (aeo polls health() until 0-exit — no poll loop).
//   * RECORD: the suite() spec drives the Go record test while the SUT is up.
//   * DOWN: `aeo suite` tears the container down AFTER the spec — GUARANTEED,
//     even if it fails. The leaf's `rm -f` only runs if control reaches it.
//
// Run:  aeo suite integration/todobackend/go_aeo/todobackend_go.ae   (build + deploy + record + teardown)
//       aeo up    ...  --no-supervisor                               (just build + stand it up)
//       aeo down  ...  --no-supervisor                               (tear down)

import compose (system, container)
import compose (containerfile, build_context, exec_entrypoint, command, publish_map, health)
import compose (health_retry, every, up_within, down_within)
import compose (suite)

exports ( aeo_orchestration )

aeo_orchestration() {
    system("todobackend_go_record") {
        health_retry() {
            every(500ms)
            up_within(60s)       // the http4k SUT is a JVM (Undertow) — give first boot headroom
            down_within(10s)
        }

        sut = container("sut") {
            // Out-of-line build: the real multi-stage gradle Containerfile against
            // the vendored SUT source tree. aeo builds it before boot — no manual
            // `podman build`, no image() tag to pre-stage. Paths are relative to
            // THIS composition file's dir (go_aeo/), so ../ = integration/todobackend/.
            containerfile("../Containerfile.sut")
            build_context("../sut")

            // Real invocation, matching the leaf: --entrypoint + args, host
            // 54321 -> container 8000. baseUrl = VCR origin :51080 so the todo
            // URLs the SUT mints point back at the VCR and get recorded.
            exec_entrypoint("/app/bin/http4k-todo-backend")
            command("8000 http://127.0.0.1:51080")
            publish_map(54321, 8000)

            // health: aeo runs this via `<engine> exec sut /bin/sh -c "…"` INSIDE
            // the container, so it uses a tool the JRE-alpine image ships (busybox
            // wget; no curl). Probe the CONTAINER port (8000). 0 exit = ready.
            health("wget -qO- http://127.0.0.1:8000/ >/dev/null 2>&1")
        }

        // The record step: a std.spec suite that runs the Go record test against
        // the live SUT (host :54321). aeo runs it after health passes, then tears
        // the tree down.
        suite("checks/go_record_suite.spec.ae")
    }
}
