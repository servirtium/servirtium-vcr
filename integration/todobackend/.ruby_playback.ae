// TodoBackend browser integration — Ruby binding, PLAYBACK leaf.
//
// Name this leaf to run it:  aeb integration/todobackend/.ruby_playback.ae
//
// Replays the committed CRUD tape through a Ruby-hosted VCR and runs the real
// TodoBackend Mocha spec against it in headless Chrome (Ruby selenium). No
// SUT, no network — proves the full record/replay loop for the Ruby binding.
import bldr
import std.os
aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        root = _get("root")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        rc = os.system("cd \"${root}/integration/todobackend/ruby\" && SERVIRTIUM_VCR_LIB=\"${lib}\" RUBYLIB=\"${root}/ruby/lib\" ruby playback_test.rb")
        if rc != 0 { println("todobackend/ruby playback: failed"); return 1 }
        println("todobackend/ruby playback: passed")
        return 0
    }
}
