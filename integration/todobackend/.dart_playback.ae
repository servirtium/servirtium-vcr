// TodoBackend browser integration — Dart binding, PLAYBACK leaf.
//
// Name this leaf to run it:  aeb integration/todobackend/.dart_playback.ae
//
// Replays the committed CRUD tape through a Dart-hosted VCR and runs the real
// TodoBackend Mocha spec against it in headless Chrome (Dart `webdriver`). No
// SUT, no network — proves the full record/replay loop for the Dart binding.
import build
import std.os
main() {
    b = build.start()
    build.dep(b, "core/.build.ae")
    root = build._get(b, "root")
    lib = "${root}/core/native/libservirtium_vcr.so"
    base = "cd \"${root}/integration/todobackend/dart\" && SERVIRTIUM_VCR_LIB=\"${lib}\""
    rc = os.system("${base} dart pub get >/dev/null 2>&1 && ${base} dart test -j 1 playback_test.dart")
    if rc != 0 { println("todobackend/dart playback: failed"); return 1 }
    println("todobackend/dart playback: passed")
    return 0
}
