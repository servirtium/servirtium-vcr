// TodoBackend browser integration — .NET binding, PLAYBACK leaf.
//
// Name this leaf to run it:  aeb integration/todobackend/.dotnet_playback.ae
//
// Replays the committed CRUD tape through a .NET-hosted VCR (P/Invoke over the
// shared engine) and runs the real TodoBackend Mocha spec against it in headless
// Chrome (.NET's own Selenium.WebDriver; Selenium Manager auto-fetches a matching
// chromedriver). No SUT, no network — proves the full record/replay loop for the
// .NET binding. The record-phase test is gated on TODOBACKEND_UPSTREAM, so the
// filter below excludes it (it would otherwise just skip).
import bldr
import std.os
aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        root = _get("root")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        rc = os.system("cd \"${root}/dotnet\" && SERVIRTIUM_VCR_LIB=\"${lib}\" TODOBACKEND_FIXTURES=\"${root}/integration/todobackend\" dotnet test Servirtium.Vcr.Integration.TodoBackend --nologo --filter \"FullyQualifiedName!~TodoBackendRecord\"")
        if rc != 0 { println("todobackend/dotnet playback: failed"); return 1 }
        println("todobackend/dotnet playback: passed")
        return 0
    }
}
