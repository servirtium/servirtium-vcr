// TodoBackend browser integration — Java binding, PLAYBACK leaf.
//
// Name this leaf to run it:  aeb integration/todobackend/.java_playback.ae
//
// Replays the committed CRUD tape through a Java-hosted VCR (FFM/Panama over the
// shared engine) and runs the real TodoBackend Mocha spec against it in headless
// Chrome (Java's own org.openqa.selenium). No SUT, no network — proves the full
// record/replay loop for the Java binding.
import build
import std.os
import std.string
main() {
    b = build.start()
    build.dep(b, "core/.build.ae")
    root = build._get(b, "root")
    lib = "${root}/core/native/libservirtium_vcr.so"
    jdk = os.getenv("JAVA25_HOME")
    if string.length(jdk) == 0 { jdk = "/usr/lib/jvm/java-25-openjdk-amd64" }
    rc = os.system("cd \"${root}/java\" && SERVIRTIUM_VCR_LIB=\"${lib}\" JAVA_HOME=\"${jdk}\" mvn -q test -Dtest=TodoBackendPlaybackIT")
    if rc != 0 { println("todobackend/java playback: failed"); return 1 }
    println("todobackend/java playback: passed")
    return 0
}
