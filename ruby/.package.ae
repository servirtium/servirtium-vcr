// Third-party-consumer PACKAGE stage for the Ruby binding.
//
// Builds the `servirtium` gem as a downstream user would receive it from
// RubyGems: the freshly-built engine .so bundled INSIDE the gem (the gemspec's
// `spec.files = Dir['lib/**/*']` sweeps in lib/servirtium/native/*.so), via the
// idiomatic `gem build`.
//
// Deps core/.build.ae for the engine .so; publishes the built .gem on the
// "gem" artifact edge, which ruby/.example.ae consumes.
import bldr
import std.os
import copy
import copy (from, to)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")
        rbdir = "${root}/ruby"

        // 1. Bundle the engine .so into lib/ (what `Dir['lib/**/*']` ships).
        //    copy.file auto-creates the dest parent; `to` resolves against the
        //    leaf's source_dir (ruby/).
        copy.file() {
            from(lib)
            to("lib/servirtium/native/libservirtium_vcr.so")
        }

        // 2. Build the gem to a stable filename (gem install accepts any name).
        rc2 = os.system("cd \"${rbdir}\" && mkdir -p pkg && gem build servirtium.gemspec --output pkg/servirtium.gem")
        if rc2 != 0 {
            println("ruby package: `gem build` failed")
            return 1
        }
        publish_artifact("gem", "${rbdir}/pkg/servirtium.gem")
        println("ruby package: built gem with engine .so bundled → ruby/pkg/servirtium.gem")
        return 0
    }
}
