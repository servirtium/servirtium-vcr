// Ruby binding tests. Fiddle loads the shared engine via SERVIRTIUM_VCR_LIB.
import build
import ruby
import build (env)
aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    lib = build.dep_artifact(b, "core/.build.ae", "shared_lib")
    ruby.rspec(b) { env("SERVIRTIUM_VCR_LIB", lib) }
}
