// Third-party-consumer EXAMPLE test for the Ruby binding.
//
// Installs the packaged gem (from ruby/.package.ae) into a CLEAN GEM_HOME and
// replays the canonical single_get tape from the INSTALLED gem — no source
// tree on the load path (no -Ilib), no SERVIRTIUM_VCR_LIB. The honest "gem
// install and it just works" test the in-tree ruby/.tests.ae cannot give.
//
// Both .so-location modes, each in its own fresh process: `explicit`
// (first-class native_lib: argument) and `discovery` (zero-config; the gem
// finds its own bundled .so).
import bldr
import std.os

aeb(cap) {
    bldr.build() {
        dep("ruby/.package.ae")
        gem = dep_artifact("ruby/.package.ae", "gem")
        root = _get("root")
        exdir = "${root}/ruby/example"
        gemhome = "${root}/target/ruby-consumer-gems"
    
        // Fresh isolated gem dir; install ONLY our gem (no runtime gem deps).
        // NOTE: --install-dir, NOT just GEM_HOME — Arch patches rubygems
        // (operating_system.rb) to force installs into the user dir regardless of
        // GEM_HOME; --install-dir is what actually isolates the install.
        rc = os.system("rm -rf \"${gemhome}\" && gem install --no-document --local --install-dir \"${gemhome}\" \"${gem}\"")
        if rc != 0 {
            println("ruby example: gem install into clean dir failed")
            return 1
        }
    
        // Run from example/ with the isolated GEM_HOME/GEM_PATH so `require
        // 'servirtium'` resolves to the INSTALLED gem, not ruby/lib/. Default gems
        // (net/http) still load from the ruby install. SERVIRTIUM_VCR_LIB unset.
        rc2 = os.system("cd \"${exdir}\" && env -u SERVIRTIUM_VCR_LIB GEM_HOME=\"${gemhome}\" GEM_PATH=\"${gemhome}\" ruby consumer_example.rb explicit")
        if rc2 != 0 {
            println("ruby example: explicit-mode consumer run failed")
            return 1
        }
        rc3 = os.system("cd \"${exdir}\" && env -u SERVIRTIUM_VCR_LIB GEM_HOME=\"${gemhome}\" GEM_PATH=\"${gemhome}\" ruby consumer_example.rb discovery")
        if rc3 != 0 {
            println("ruby example: discovery-mode consumer run failed")
            return 1
        }
    
        println("ruby example: PASS — installed gem replayed the canonical tape (explicit + discovery)")
        return 0
    }
}
