// Crystal binding tests. Crystal binds the engine's flat C ABI
// (aether_vcr_embed_*) DIRECTLY via a `lib`/`fun` block (@[Link]) — no glue, no
// second copy of the marshalling rules. The idiomatic Crystal surface (the Vcr
// object with block forms, typed enums, caller-owned-string handling, a typed
// error) is in src/servirtium.cr.
//
// The engine .so is staged into native/ (copy.file) and CRYSTAL_LIBRARY_PATH
// points Crystal's linker there so `-lservirtium_vcr` resolves; the @[Link]
// ldflags also carry a self-locating -L/-rpath off __DIR__, so a compiled
// binary runs without LD_LIBRARY_PATH. crystal.test runs `crystal spec`.
//
// Skipped by the gate when Crystal is absent (loud-skip).
import bldr
import crystal
import copy
aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        native_lib = dep_artifact("core/.build.ae", "shared_lib")
        copy.file() {
            from(native_lib)
            to("native/libservirtium_vcr.so")
        }
        crystal.test() {
            env("CRYSTAL_LIBRARY_PATH", "native")
            env("LD_LIBRARY_PATH", "native")
        }
    }
}
