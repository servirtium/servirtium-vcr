// Every binding's shared fixture dependency runs the same XML contract suite.
import bldr
import aether
import aether (source, lib, caps)
aeb(cap) {
    bldr.build() {
        aether.program_test() {
            source("test_vcr_xml_matrix.ae"); lib(".."); caps("fs,net,os,extern")
        }
        aether.program_test() {
            source("test_vcr_pretty_xml.ae"); lib(".."); caps("fs,net,os,extern")
        }
    }
}
