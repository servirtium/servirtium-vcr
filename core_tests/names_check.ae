// No spaces in names, ever (Paul, 2026-11-11): fails when any tracked file
// or directory name in the repository holds a space. Directories are checked
// through the paths of the files they hold (git tracks no empty directory).
// A name with a space breaks unquoted shell lines, URLs and links in
// markdown, and the converters here write slugged names for that reason.
//
// Outside a git checkout (a lab lane's `git archive` copy) it checks every
// file on disk under the root instead, but target/ and node_modules/.
//
// Run by core_tests/.names.ae (a dep of core_tests/.tests.ae), from the root
// given in SVCR_TEST_ROOT, or the current directory. Lists every offender.

import std.os
import std.fs
import std.string

extern exit(code: int)

main() {
    root = os.getenv("SVCR_TEST_ROOT")
    if root == "" { root = "." }
    what = "tracked path(s)"
    out, err = os.exec("git -C '${root}' -c core.quotePath=false ls-files 2>/dev/null")
    if err != "" || string.length(out) == 0 {
        // Not a git checkout: a lab lane gets the committed tree by
        // `git archive`, with no .git. Check every file under the root
        // instead, leaving out what builds make (target/, node_modules/).
        what = "file path(s) (no git checkout: the tree on disk)"
        out = ""
        found = fs.find_ext(root, "")
        n0 = string.length(found)
        c0 = 0
        while c0 < n0 {
            nl0 = string.index_of_from(found, "\n", c0)
            e0 = n0
            if nl0 >= 0 { e0 = nl0 }
            p = string.substring(found, c0, e0)
            if string.starts_with(p, "${root}/") == 1 { p = string.substring(p, string.length(root) + 1, string.length(p)) }
            if string.starts_with(p, "target/") == 0 && string.contains(p, "node_modules/") == 0 && string.length(p) > 0 {
                out = "${out}${p}\n"
            }
            if nl0 < 0 { break }
            c0 = nl0 + 1
        }
        if string.length(out) == 0 { println("names: no files under ${root}"); exit(1) }
    }
    bad = 0
    total = 0
    n = string.length(out)
    cur = 0
    while cur < n {
        nl = string.index_of_from(out, "\n", cur)
        e = n
        if nl >= 0 { e = nl }
        line = string.substring(out, cur, e)
        if string.length(line) > 0 {
            total = total + 1
            if string.contains(line, " ") == 1 || string.contains(line, "\t") == 1 {
                println("names: a space in a name: '${line}'")
                bad = bad + 1
            }
        }
        if nl < 0 { break }
        cur = nl + 1
    }
    if bad > 0 {
        println("names: ${bad} of ${total} ${what} have a space in a file or directory name; rename them (lowercase, '-' for spaces)")
        exit(1)
    }
    println("names: ${total} ${what}, no spaces")
    exit(0)
}
