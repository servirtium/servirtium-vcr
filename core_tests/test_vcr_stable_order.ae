// Opt-in stable order at record time: JSON object keys, chosen JSON arrays,
// response header lines and one header's comma-separated items written in
// one order, so a service that answers in a different order every run
// (a Go map, a Java set, a list ordered by a random id) re-records byte for
// byte without leaving anything out.
//
// Part A drives the emitter directly (record_full_response + flush):
//    1. Off by default: the tape is byte-exact.
//    2. sort_json_keys: keys sorted at every depth; array order kept;
//       duplicate keys keep their order.
//    3. sort_json_array: by a member, by a JSON pointer, by canonical JSON;
//       "*" and bare-name paths; integers by value; an element without the
//       member leaves its array as sent; unselected arrays untouched;
//       sort_json_array_at scopes a rule to matching request paths.
//    4. sort_response_headers (stable for a repeated header) and
//       sort_header_value (Allow).
//    5. normalize's tokens are numbered in the sorted order: two recordings
//       of the same content in different orders write the same bytes.
//    6. Sorted JSON is only written pretty-printed: a JSON sort rule with
//       pretty_json off refuses to emit (flush, check, fail-if-changed),
//       whatever order the calls came in; sort and pretty_json together
//       emit; pretty_json alone keeps the service's key order; the header
//       rules need no pretty_json (Test 4).
//    7. Bad rules refused; non-JSON and malformed bodies byte-exact; a body
//       served as text/plain is JSON only on a request path a
//       sort_json_array_at rule names; request bodies never reordered.
// The JSON sort tests run with pretty_json on; pj() is the expected layout.
// Part B records through a real upstream that flips its order on every
// request: two recordings are byte-identical, the footer lists the ordering
// rules, and playback serves the sorted response with a matching
// Content-Length.

import core.vcr
import std.http
import std.http.client
import std.fs
import std.string
import std.io
import std.json

extern exit(code: int)
extern http_server_stop(server: ptr)

const UPSTREAM_PORT = 18293
const RECORD_PORT   = 18294
const PLAYBACK_PORT = 18295

const REQ_HDRS = "Content-Type: application/json"

var flip: int = 0

tmp_path(name: string) -> string {
    tmp = io.getenv("TEMP")
    if tmp == 0 { tmp = io.getenv("TMPDIR") }
    if tmp == 0 { tmp = "/tmp" }
    return "${tmp}/${name}"
}

fail(msg: string) {
    println("  FAIL: ${msg}")
    exit(1)
}

need(h: string, n: string, label: string) {
    if string.contains(h, n) != 1 { fail("${label}: expected\n${n}\nin:\n${h}") }
}

lacks(h: string, n: string, label: string) {
    if string.contains(h, n) == 1 { fail("${label}: did not expect\n${n}\nin:\n${h}") }
}

// Record one interaction with the bare (current-key) API and read the tape.
rec(vh: ptr, path: string, ctype: string, body: string, resp_h: string, req_b: string) -> string {
    vcr.clear_recording_h(vh)
    e = vcr.record_full_response_h(vh, "POST", "/x", 200, ctype, body, REQ_HDRS, req_b, resp_h)
    if e != "" { fail("record_full_response: ${e}") }
    f = vcr.flush_h(vh, path)
    if f != "" { fail("flush: ${f}") }
    t, de = fs.read(path)
    if de != "" { fail("read back: ${de}") }
    return t
}

reset_all(vh: ptr) {
    vcr.clear_format_options_h(vh)
    vcr.clear_collapses_h(vh)
    vcr.clear_volatile_h(vh)
}

// reset_all, then pretty_json on: the JSON sort rules need it.
reset_pretty(vh: ptr) {
    reset_all(vh)
    vcr.set_pretty_json_h(vh, 2)
}

// A body as the tape fences it.
fenced(b: string) -> string {
    return "```\n${b}\n```"
}

// `compact` as pretty_json(2) writes it (json.pretty keeps key order).
pj(compact: string) -> string {
    f, err = json.pretty(compact, 2)
    if err != "" { fail("pj: ${err} in ${compact}") }
    return f
}

// The upstream: the same content in one order, then the other, by request.
handle_list(req: ptr, res: ptr, ud: ptr) {
    flip = flip + 1
    http.response_set_status(res, 200)
    if flip % 2 == 1 {
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_header(res, "Allow", "PUT, DELETE, GET")
        http.response_set_header(res, "X-Zeta", "z")
        http.response_set_header(res, "X-Alpha", "a")
        http.response_set_body(res, "{\"value\":[{\"name\":\"b\",\"id\":\"7d444840-9dc0-11d1-b245-5ffdce74fad2\"},{\"name\":\"a\",\"id\":\"0e4b3a1c-1111-4222-8333-944455556666\"}],\"count\":2}")
    } else {
        http.response_set_header(res, "X-Alpha", "a")
        http.response_set_header(res, "Allow", "GET, PUT, DELETE")
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_header(res, "X-Zeta", "z")
        http.response_set_body(res, "{\"count\":2,\"value\":[{\"id\":\"0e4b3a1c-1111-4222-8333-944455556666\",\"name\":\"a\"},{\"id\":\"7d444840-9dc0-11d1-b245-5ffdce74fad2\",\"name\":\"b\"}]}")
    }
}

wait_ready(url: string) {
    i = 0
    while i < 200 {
        sleep(25)
        req = client.request("GET", url)
        if req != null {
            client.set_timeout(req, 1s)
            resp, err = client.send_request(req)
            client.request_free(req)
            if err == "" {
                client.response_free(resp)
                return
            }
        }
        i = i + 1
    }
    fail("server not ready at ${url}")
}

// GET /list through `port`: (status, body, Content-Length header).
get_list(port: int) -> (int, string, string) {
    req = client.request("GET", "http://127.0.0.1:${port}/list")
    client.set_timeout(req, 5s)
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return -1, err, "" }
    st = client.response_status(resp)
    b = string.copy(client.response_body(resp))
    cl = string.copy(client.response_header(resp, "Content-Length"))
    client.response_free(resp)
    return st, b, cl
}

stable_rules(h: ptr) {
    vcr.sort_json_keys_h(h, 1)
    vcr.sort_response_headers_h(h, 1)
    e = vcr.sort_header_value_h(h, "Allow")
    if e == "" { e = vcr.sort_json_array_h(h, "/value", "name") }
    if e == "" { e = vcr.volatile_rule_h(h, "body", "template", "\"id\": \"{{id}}\"") }
    if e != "" { fail("rule: ${e}") }
    if e == "" { e = vcr.remove_header_h(h, vcr.FIELD_RESPONSE_HEADERS, "Date") }
    // Matches the sorted body only (the upstream's first order has "value"
    // first): the footer must say it applied, as the rules saw the body.
    if e == "" { e = vcr.redact_whole_tape_h(h, "\"count\":2,\"value\"", "\"count\":2,\"value\"") }
    if e != "" { fail("rule: ${e}") }
    vcr.set_rules_footer_h(h, 1)
    // Last: the need for pretty_json is checked when the tape is written,
    // so the order of the calls does not matter.
    vcr.set_pretty_json_h(h, 2)
}

record_once(path: string, rport: int) -> string {
    recorder, recorder_oerr = vcr.open_record(path, "http://127.0.0.1:${UPSTREAM_PORT}", rport)
    if recorder == null { fail("load_record") }
    stable_rules(recorder)
    serr = http.server_start_background(vcr.server_of(recorder))
    if serr != "" { fail("recorder start ${serr}") }
    sleep(250)
    st, b, _ = get_list(rport)
    if st != 200 { fail("record GET /list: ${st} ${b}") }
    ferr = vcr.stop_and_flush_h(recorder, path)
    vcr.destroy_h(recorder)
    if ferr != "" { fail("stop_and_flush ${ferr}") }
    t, terr = fs.read(path)
    if terr != "" { fail("read tape ${terr}") }
    return t
}

main() {
    vh = vcr.open_offline()
    println("=== VCR stable order ===\n")
    OUT = tmp_path("vcr_stable_order.tape")
    UNSORTED = "{\"z\":1,\"a\":{\"y\":[{\"q\":1,\"b\":2},3],\"c\":null},\"m\":\"x\",\"m\":\"y\"}"
    RESP_H = "Content-Type: application/json\nX-Zeta: 1\nSet-Cookie: s=2\nallow: PUT, DELETE, GET\nSet-Cookie: s=1\nX-Alpha: 2"

    println("Test 1: off by default, byte-exact")
    reset_all(vh)
    t1 = rec(vh, OUT, "application/json", UNSORTED, RESP_H, UNSORTED)
    need(t1, "```\n${UNSORTED}\n```", "response body as sent")
    need(t1, RESP_H, "response headers as sent")
    println("  PASS")

    println("Test 2: sort_json_keys, recursive, arrays and duplicates kept in order")
    reset_pretty(vh)
    vcr.sort_json_keys_h(vh, 1)
    t2 = rec(vh, OUT, "application/json", UNSORTED, RESP_H, UNSORTED)
    need(t2, fenced(pj("{\"a\":{\"c\":null,\"y\":[{\"b\":2,\"q\":1},3]},\"m\":\"x\",\"m\":\"y\",\"z\":1}")), "keys sorted at every depth")
    need(t2, pj(UNSORTED), "the request body is formatted but never reordered")
    need(t2, "Content-Type: application/json\nX-Zeta: 1", "headers untouched by the JSON option")
    pretty_in = "{\n  \"b\": 1,\n  \"a\": {\n    \"d\": true,\n    \"c\": \"x\"\n  }\n}"
    t2b = rec(vh, OUT, "application/json", pretty_in, "", "")
    need(t2b, "{\n  \"a\": {\n    \"c\": \"x\",\n    \"d\": true\n  },\n  \"b\": 1\n}", "a pretty body sorted")
    println("  PASS")

    println("Test 3: sort_json_array by member, pointer, canonical form; paths; integers; missing member")
    reset_pretty(vh)
    e = vcr.sort_json_array_h(vh, "", "name")
    if e != "" { fail(e) }
    t3 = rec(vh, OUT, "application/json", "[{\"name\":\"b\",\"n\":1},{\"name\":\"a\",\"n\":2}]", "", "")
    need(t3, pj("[{\"name\":\"a\",\"n\":2},{\"name\":\"b\",\"n\":1}]"), "root array by member")
    reset_pretty(vh)
    e = vcr.sort_json_array_h(vh, "/dbs", "/db_name/L")
    if e != "" { fail(e) }
    t3b = rec(vh, OUT, "application/json", "{\"dbs\":[{\"id\":110,\"db_name\":{\"L\":\"shop\"}},{\"id\":1,\"db_name\":{\"L\":\"mysql\"}}],\"other\":[3,1,2]}", "", "")
    need(t3b, pj("{\"dbs\":[{\"id\":1,\"db_name\":{\"L\":\"mysql\"}},{\"id\":110,\"db_name\":{\"L\":\"shop\"}}],\"other\":[3,1,2]}"), "by pointer; an unselected array untouched; keys left unsorted")
    reset_pretty(vh)
    e = vcr.sort_json_array_h(vh, "/items/*/tags", "")
    if e != "" { fail(e) }
    t3c = rec(vh, OUT, "application/json", "{\"items\":[{\"tags\":[\"z\",{\"b\":1,\"a\":2},\"a\"]},{\"tags\":[3,1]}],\"tags\":[\"y\",\"x\"]}", "", "")
    need(t3c, pj("{\"items\":[{\"tags\":[\"a\",\"z\",{\"b\":1,\"a\":2}]},{\"tags\":[1,3]}],\"tags\":[\"y\",\"x\"]}"), "wildcard path, canonical form")
    reset_pretty(vh)
    e = vcr.sort_json_array_h(vh, "tags", "")
    if e != "" { fail(e) }
    t3d = rec(vh, OUT, "application/json", "{\"items\":[{\"tags\":[\"z\",\"a\"]}],\"tags\":[\"y\",\"x\"],\"other\":[\"b\",\"a\"]}", "", "")
    need(t3d, pj("{\"items\":[{\"tags\":[\"a\",\"z\"]}],\"tags\":[\"x\",\"y\"],\"other\":[\"b\",\"a\"]}"), "a bare name selects that member's arrays at any depth")
    reset_pretty(vh)
    e = vcr.sort_json_array_h(vh, "", "id")
    if e != "" { fail(e) }
    t3e = rec(vh, OUT, "application/json", "[{\"id\":4611686018427387905},{\"id\":10},{\"id\":-3},{\"id\":2}]", "", "")
    need(t3e, pj("[{\"id\":-3},{\"id\":2},{\"id\":10},{\"id\":4611686018427387905}]"), "integers by value, any size")
    t3f = rec(vh, OUT, "application/json", "[{\"id\":2},{\"x\":1},{\"id\":1}]", "", "")
    need(t3f, pj("[{\"id\":2},{\"x\":1},{\"id\":1}]"), "an element without the member leaves its array as sent")
    t3g = rec(vh, OUT, "application/json", "[{\"id\":1,\"k\":\"second\"},{\"id\":0},{\"id\":1,\"k\":\"first\"}]", "", "")
    need(t3g, pj("[{\"id\":0},{\"id\":1,\"k\":\"second\"},{\"id\":1,\"k\":\"first\"}]"), "the sort is stable")
    // Several keys: the first decides, the next breaks ties.
    reset_pretty(vh)
    e = vcr.sort_json_array_h(vh, "", "/ks,name")
    if e != "" { fail(e) }
    t3k = rec(vh, OUT, "application/json", "[{\"ks\":\"b\",\"name\":\"x\"},{\"ks\":\"a\",\"name\":\"y\"},{\"ks\":\"a\",\"name\":\"x\"}]", "", "")
    need(t3k, pj("[{\"ks\":\"a\",\"name\":\"x\"},{\"ks\":\"a\",\"name\":\"y\"},{\"ks\":\"b\",\"name\":\"x\"}]"), "two keys")
    t3l = rec(vh, OUT, "application/json", "[{\"ks\":\"b\",\"name\":\"x\"},{\"ks\":\"a\"}]", "", "")
    need(t3l, pj("[{\"ks\":\"b\",\"name\":\"x\"},{\"ks\":\"a\"}]"), "an element without the second key leaves its array as sent")
    if vcr.sort_json_array_h(vh, "", "a,") == "" { fail("an empty key in 'by' accepted") }
    if vcr.sort_json_array_h(vh, "", ",a") == "" { fail("an empty first key in 'by' accepted") }
    if vcr.sort_json_array_h(vh, "", "a,x/y") == "" { fail("a relative second key with '/' accepted") }
    // Scoped to request paths: only the interaction whose path matches.
    reset_pretty(vh)
    e = vcr.sort_json_array_at_h(vh, "^/y", "", "id")
    if e != "" { fail(e) }
    t3i = rec(vh, OUT, "application/json", "[{\"id\":2},{\"id\":1}]", "", "")
    need(t3i, pj("[{\"id\":2},{\"id\":1}]"), "a rule for another request path leaves the array as sent")
    e = vcr.sort_json_array_at_h(vh, "^/x$", "", "id")
    if e != "" { fail(e) }
    t3j = rec(vh, OUT, "application/json", "[{\"id\":2},{\"id\":1}]", "", "")
    need(t3j, pj("[{\"id\":1},{\"id\":2}]"), "a rule for this request path sorts")
    if vcr.sort_json_array_at_h(vh, "(", "", "id") == "" { fail("a bad request-path regex accepted") }
    // Sort keys too: the canonical-form sort sees sorted keys.
    reset_pretty(vh)
    vcr.sort_json_keys_h(vh, 1)
    e = vcr.sort_json_array_h(vh, "", "")
    if e != "" { fail(e) }
    t3h = rec(vh, OUT, "application/json", "[ {\"b\": 2, \"a\": 2}, {\"a\": 1} ]", "", "")
    need(t3h, pj("[{\"a\":1},{\"a\":2,\"b\":2}]"), "keys and array together")
    println("  PASS")

    println("Test 4: sort_response_headers (stable for a repeated header) and sort_header_value, no pretty_json needed")
    reset_all(vh)
    vcr.sort_response_headers_h(vh, 1)
    e = vcr.sort_header_value_h(vh, "Allow")
    if e != "" { fail(e) }
    t4 = rec(vh, OUT, "application/json", "{\"b\":1,\"a\":2}", RESP_H, "")
    need(t4, "```\nallow: DELETE, GET, PUT\nContent-Type: application/json\nSet-Cookie: s=2\nSet-Cookie: s=1\nX-Alpha: 2\nX-Zeta: 1\n```", "lines by name, repeated header in order, Allow's items sorted (name matched case-insensitively)")
    need(t4, "```\n{\"b\":1,\"a\":2}\n```", "the body as sent: header rules are not JSON rules")
    reset_all(vh)
    e = vcr.sort_header_value_h(vh, "Allow")
    t4b = rec(vh, OUT, "application/json", "{}", RESP_H, "")
    need(t4b, "Content-Type: application/json\nX-Zeta: 1\nSet-Cookie: s=2\nallow: DELETE, GET, PUT\nSet-Cookie: s=1\nX-Alpha: 2", "value sort alone keeps line order")
    println("  PASS")

    println("Test 5: normalize tokens are numbered in the sorted order")
    UUID_RE = "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
    A = "{\"id\":\"7d444840-9dc0-11d1-b245-5ffdce74fad2\",\"at\":3}"
    B = "{\"id\":\"0e4b3a1c-1111-4222-8333-944455556666\",\"at\":1}"
    reset_pretty(vh)
    e = vcr.volatile_rule_h(vh, "body", "regex", "(?<uuid>${UUID_RE})")
    if e == "" { e = vcr.sort_json_array_h(vh, "", "at") }
    if e != "" { fail(e) }
    t5a = rec(vh, OUT, "application/json", "[${A},${B}]", "", "")
    t5b = rec(vh, OUT, "application/json", "[${B},${A}]", "", "")
    if string.equals(t5a, t5b) != 1 { fail("two orders, two tapes:\n${t5a}\n---\n${t5b}") }
    need(t5a, pj("[{\"id\":\"{{uuid-1}}\",\"at\":1},{\"id\":\"{{uuid-2}}\",\"at\":3}]"), "token 1 is the first in sorted order")
    println("  PASS")

    println("Test 6: sorted JSON is only written pretty-printed")
    // A JSON sort rule with pretty_json off: nothing is written, and the
    // error says why (flush, check and fail-if-changed alike).
    reset_all(vh)
    vcr.sort_json_keys_h(vh, 1)
    vcr.clear_recording_h(vh)
    re1 = vcr.record_full_response_h(vh, "POST", "/x", 200, "application/json", "{\"b\":1,\"a\":2}", REQ_HDRS, "", "")
    if re1 != "" { fail("record_full_response: ${re1}") }
    fs.delete(OUT)
    f6 = vcr.flush_h(vh, OUT)
    need(f6, "sort_json_keys needs pretty_json: sorted JSON is only written pretty-printed", "flush refused")
    _, rd6 = fs.read(OUT)
    if rd6 == "" { fail("a refused flush wrote a tape") }
    f6b = vcr.flush_and_fail_if_changed_h(vh, OUT)
    need(f6b, "sort_json_keys needs pretty_json", "fail-if-changed refused")
    _, rd6b = fs.read(OUT)
    if rd6b == "" { fail("a refused fail-if-changed wrote a tape") }
    fs.write(OUT, "x")
    f6c = vcr.flush_or_check_h(vh, OUT)
    need(f6c, "sort_json_keys needs pretty_json", "check refused")
    reset_all(vh)
    e = vcr.sort_json_array_at_h(vh, "^/x$", "", "id")
    if e != "" { fail(e) }
    vcr.clear_recording_h(vh)
    re2 = vcr.record_full_response_h(vh, "POST", "/x", 200, "application/json", "[{\"id\":2},{\"id\":1}]", REQ_HDRS, "", "")
    if re2 != "" { fail("record_full_response: ${re2}") }
    f6d = vcr.flush_h(vh, OUT)
    need(f6d, "sort_json_array needs pretty_json: sorted JSON is only written pretty-printed", "an array rule refused too")
    // Even when no body in the tape is JSON: the rule is checked, not its hits.
    vcr.clear_recording_h(vh)
    re3 = vcr.record_full_response_h(vh, "POST", "/x", 200, "text/plain", "hello", REQ_HDRS, "", "")
    if re3 != "" { fail("record_full_response: ${re3}") }
    f6e = vcr.flush_h(vh, OUT)
    need(f6e, "sort_json_array needs pretty_json", "refused whatever the bodies")
    // Rule, then pretty_json, or the other way round: both emit (checked when
    // the tape is written, not when a rule is set).
    reset_all(vh)
    e = vcr.sort_json_array_h(vh, "", "id")
    if e != "" { fail(e) }
    vcr.set_pretty_json_h(vh, 2)
    t6a = rec(vh, OUT, "application/json", "[{\"id\":2},{\"id\":1}]", "", "")
    need(t6a, fenced(pj("[{\"id\":1},{\"id\":2}]")), "rule first, then pretty_json")
    reset_all(vh)
    vcr.set_pretty_json_h(vh, 2)
    vcr.sort_json_keys_h(vh, 1)
    t6 = rec(vh, OUT, "application/json", "{\"b\":[2,1],\"a\":1.0}", "", "")
    need(t6, "```\n{\n  \"a\": 1.0,\n  \"b\": [\n    2,\n    1\n  ]\n}\n```", "pretty_json first, then the rule: sorted, then indented")
    // Turning pretty_json off again refuses again.
    vcr.set_pretty_json_h(vh, 0)
    vcr.clear_recording_h(vh)
    vcr.record_full_response_h(vh, "POST", "/x", 200, "application/json", "{}", REQ_HDRS, "", "")
    need(vcr.flush_h(vh, OUT), "sort_json_keys needs pretty_json", "pretty_json turned off again")
    // pretty_json alone keeps the service's key order.
    reset_all(vh)
    vcr.set_pretty_json_h(vh, 2)
    t6p = rec(vh, OUT, "application/json", "{\"b\":[2,1],\"a\":1}", "", "")
    need(t6p, "```\n{\n  \"b\": [\n    2,\n    1\n  ],\n  \"a\": 1\n}\n```", "pretty_json alone: key order as sent")
    println("  PASS")

    println("Test 7: bad rules refused; non-JSON and malformed bodies byte-exact; text/plain JSON only where a rule names it")
    reset_pretty(vh)
    if vcr.sort_json_array_h(vh, "a/b", "") == "" { fail("a relative path with '/' accepted") }
    if vcr.sort_json_array_h(vh, "/a", "x/y") == "" { fail("a relative 'by' with '/' accepted") }
    if vcr.sort_header_value_h(vh, "") == "" { fail("an empty header name accepted") }
    if vcr.sort_header_value_h(vh, "A: b") == "" { fail("a header line accepted as a name") }
    vcr.sort_json_keys_h(vh, 1)
    t7 = rec(vh, OUT, "text/plain", "{\"b\":1,\"a\":2}", "", "")
    need(t7, "```\n{\"b\":1,\"a\":2}\n```", "text/plain untouched: no rule names its path")
    t7b = rec(vh, OUT, "application/json", "{\"b\":1,\"a\":}", "", "")
    need(t7b, "```\n{\"b\":1,\"a\":}\n```", "malformed JSON untouched")
    t7c = rec(vh, OUT, "application/vnd.api+json; charset=utf-8", "{\"b\":1,\"a\":2}", "", "")
    need(t7c, pj("{\"a\":2,\"b\":1}"), "+json sorted")
    // A service serving JSON as text/plain (YugabyteDB): JSON on the request
    // paths a sort_json_array_at rule names, and only there.
    e = vcr.sort_json_array_at_h(vh, "^/y$", "/l", "")
    if e != "" { fail(e) }
    t7e = rec(vh, OUT, "text/plain", "{\"l\":[2,1],\"b\":1}", "", "")
    need(t7e, "```\n{\"l\":[2,1],\"b\":1}\n```", "text/plain on a path no rule names: untouched")
    e = vcr.sort_json_array_at_h(vh, "^/x$", "/l", "")
    if e != "" { fail(e) }
    t7f = rec(vh, OUT, "text/plain", "{\"l\":[2,1],\"b\":1}", "", "")
    need(t7f, fenced(pj("{\"b\":1,\"l\":[1,2]}")), "text/plain JSON on a named path: sorted and pretty-printed")
    t7g = rec(vh, OUT, "text/plain", "{not json", "", "")
    need(t7g, "```\n{not json\n```", "text/plain that does not parse on a named path: untouched")
    t7h = rec(vh, OUT, "text/html", "<p>{\"b\":1,\"a\":2}</p>", "", "")
    need(t7h, "<p>{\"b\":1,\"a\":2}</p>", "HTML on a named path: untouched")
    println("  PASS")
    reset_all(vh)

    println("Test 8: a real upstream flipping its order: two recordings, one tape; footer; playback")
    upstream = http.server_create(UPSTREAM_PORT)
    if upstream == 0 { fail("upstream server_create") }
    http.server_get(upstream, "/list", handle_list, 0)
    userr = http.server_start_background(upstream)
    if userr != "" { fail("upstream start ${userr}") }
    wait_ready("http://127.0.0.1:${UPSTREAM_PORT}/list")
    // wait_ready made one request; make the next recording start on order 1.
    if flip % 2 == 1 { flip = flip + 1 }
    P1 = tmp_path("vcr_stable_order_1.tape")
    P2 = tmp_path("vcr_stable_order_2.tape")
    r1 = record_once(P1, RECORD_PORT)
    r2 = record_once(P2, RECORD_PORT)
    if string.equals(r1, r2) != 1 { fail("two recordings differ:\n${r1}\n---\n${r2}") }
    SORTED = pj("{\"count\":2,\"value\":[{\"id\":\"{{id-1}}\",\"name\":\"a\"},{\"id\":\"{{id-2}}\",\"name\":\"b\"}]}")
    need(r1, "```\n${SORTED}\n```", "sorted and pretty-printed body, tokens in sorted order")
    need(r1, "Allow: DELETE, GET, PUT\n", "Allow's items sorted")
    need(r1, "| collapsed | whole recording | `\"count\":2,\"value\"` | `\"count\":2,\"value\"` | 0 |", "footer: a collapse sees the sorted body")
    need(r1, "| ordered | response headers | every header | sorted by name; a repeated header's lines keep their order | 0 |", "footer: header order")
    need(r1, "| ordered | response headers | `Allow` | its comma-separated items sorted | 0 |", "footer: Allow")
    need(r1, "| ordered | response body | JSON object keys | sorted, at every depth | 0 |", "footer: keys")
    need(r1, "| ordered | response body | JSON arrays at `/value` | sorted by `name` | 0 |", "footer: array")
    hstart = string.index_of(r1, "### Response headers recorded for playback:")
    hblock = string.substring(r1, hstart, string.length(r1))
    ai = string.index_of(hblock, "Allow:")
    ci = string.index_of(hblock, "Content-Type:")
    xa = string.index_of(hblock, "X-Alpha:")
    xz = string.index_of(hblock, "X-Zeta:")
    if !(ai < ci && ci < xa && xa < xz) { fail("response headers not by name:\n${hblock}") }

    playback, playback_oerr = vcr.open_playback(P1, PLAYBACK_PORT)
    if playback == null { fail("load playback: ${playback_oerr}") }
    vcr.volatile_bind_h(playback, "id-1", "id-of-a")
    vcr.volatile_bind_h(playback, "id-2", "id-of-b")
    perr = ""
    if vcr.start_background_h(playback, 10000) != 0 { perr = vcr.last_error_h(playback) }
    if perr != "" { fail("playback start ${perr}") }
    sleep(250)
    st, b, cl = get_list(PLAYBACK_PORT)
    if st != 200 { fail("playback: ${st} ${vcr.last_error_h(playback)}") }
    PLAYED = string.replace_all(string.replace_all(SORTED, "{{id-1}}", "id-of-a"), "{{id-2}}", "id-of-b")
    if string.equals(b, PLAYED) != 1 { fail("playback serves the sorted order, pretty-printed; got:\n${b}") }
    if string.length(cl) > 0 && string.equals(cl, "${string.length(b)}") != 1 { fail("Content-Length ${cl} != ${string.length(b)} bytes served") }
    vcr.destroy_h(playback)
    http_server_stop(upstream)
    fs.delete(P1)
    fs.delete(P2)
    fs.delete(OUT)
    println("  PASS")

    println("\n=== All stable order tests passed ===")
    exit(0)
}
