// Whole-tape normalization probe — the acceptance gate for the two tape-wide
// rewrite verbs (vcr.normalize_whole_tape + vcr.redact_whole_tape, and their
// embed ABIs). It reproduces the exact non-determinism that dirties a real
// record leaf — the TodoBackend CRUD tape — and proves the engine now makes a
// re-record byte-identical.
//
// Two kinds of volatility, deliberately modelled differently:
//   * server-minted entity UUIDs  — CORRELATED: each id appears in the POST
//     response body/url AND in later request paths. normalize_whole_tape gives
//     each distinct id a stable {{id-N}} token, so the count+order (stable
//     across runs) makes the tape deterministic and the id round-trips.
//   * Date response headers       — UNCORRELATED + variable-cardinality: run A
//     straddles a second boundary (two distinct Date values), run B lands in
//     one second (one value). A correlated token would NOT be byte-stable
//     here (A would mint {{date-1}},{{date-2}}; B only {{date-1}}), so Date
//     uses redact_whole_tape — collapse every match to one constant.
//
// Built against the LOCAL pure-Aether engine, driven through the no-server
// record()/flush() helpers.   aeb core_tests/.normalize.ae

import core.vcr
import std.string

extern exit(code: int)

const PATTERN_UUID = "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
const PATTERN_DATE = "[A-Z][a-z][a-z], [0-9]{2} [A-Z][a-z][a-z] [0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2} GMT"

fail(msg: string) {
    println("FAIL: ${msg}")
    exit(1)
}

// Record POST /todos (mints uuid) then GET /<uuid>, with the two response
// Dates supplied by the caller — so a run can straddle a second boundary or
// not. `norm_dates` chooses whether the Date rule is registered. Returns the
// flushed-tape bytes via emit_tape (no file needed).
tape_for(uuid: string, date0: string, date1: string, norm_dates: int) -> string {
    vcr.clear_recording()
    vcr.clear_normalizations()
    _e = vcr.normalize_whole_tape(PATTERN_UUID, "id")
    if norm_dates == 1 { _d = vcr.redact_whole_tape(PATTERN_DATE, "Date: <DATE>") }

    body = "{\"id\":\"${uuid}\",\"url\":\"http://h/${uuid}\",\"title\":\"a todo\"}"

    e = vcr.record_full_response("POST", "/", 201, "application/json",
            body, "Host: h", "{\"title\":\"a todo\"}",
            "content-type: application/json\nDate: ${date0}")
    if e != "" { fail("record POST: ${e}") }

    e = vcr.record_full_response("GET", "/${uuid}", 200, "application/json",
            body, "Host: h", "",
            "content-type: application/json\nDate: ${date1}")
    if e != "" { fail("record GET: ${e}") }

    return vcr.emit_tape()
}

main() {
    println("=== VCR whole-tape normalize ===")

    // Run A: uuid #1, and TWO distinct Dates (straddles :30 -> :31).
    // Run B: uuid #2, and ONE Date (both interactions in the same second).
    UUID_A = "b56f0574-a6a7-4020-b215-033d47219985"
    UUID_B = "973cc72d-6f08-4c5c-8609-376224584730"

    // --- First, the diagnosis: uuid-correlation ON, date-collapse OFF. The
    //     ids line up but the differing Dates still split the two tapes. This
    //     is exactly the residue go_record left behind. ---
    a_nodate = tape_for(UUID_A, "Tue, 26 May 2026 07:49:30 GMT", "Tue, 26 May 2026 07:49:31 GMT", 0)
    b_nodate = tape_for(UUID_B, "Mon, 08 Jun 2026 20:53:07 GMT", "Mon, 08 Jun 2026 20:53:07 GMT", 0)
    if a_nodate == b_nodate { fail("expected Date headers to still differ without redact_whole_tape") }
    if string.index_of(a_nodate, UUID_A) >= 0 { fail("uuid not normalized even in diagnosis run") }
    println("  PASS: normalize_whole_tape correlates the ids; only Date still differs (the go_record residue)")

    // --- Now both verbs: uuid-correlation + date-collapse. Byte-identical. ---
    a = tape_for(UUID_A, "Tue, 26 May 2026 07:49:30 GMT", "Tue, 26 May 2026 07:49:31 GMT", 1)
    b = tape_for(UUID_B, "Mon, 08 Jun 2026 20:53:07 GMT", "Mon, 08 Jun 2026 20:53:07 GMT", 1)
    if a != b {
        println("--- tape A ---"); println(a)
        println("--- tape B ---"); println(b)
        fail("re-record not byte-identical with normalize + redact whole-tape")
    }
    println("  PASS: two records (different uuids, different #distinct dates) flush byte-identical")

    // Tokens present, raw values gone.
    if string.index_of(a, "{{id-1}}") < 0 { fail("expected {{id-1}} token absent") }
    if string.index_of(a, "Date: <DATE>") < 0 { fail("expected collapsed Date absent") }
    if string.index_of(a, UUID_A) >= 0 { fail("raw uuid leaked") }
    if string.index_of(a, "07:49:3") >= 0 { fail("raw date leaked") }
    println("  PASS: ids -> {{id-N}}, dates -> Date: <DATE>, no raw volatile values on tape")

    // Cross-field correlation: the POST-minted id is the same token in the GET path.
    if string.index_of(a, "## Interaction 1: GET /{{id-1}}") < 0 {
        fail("GET request path did not correlate to {{id-1}}")
    }
    println("  PASS: response-body id correlates to the later request-path token")

    println("=== whole-tape normalize passed ===")
    exit(0)
}
