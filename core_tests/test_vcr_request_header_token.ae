// {{request.header.NAME}} in a recorded response is filled, on playback,
// with the live request's NAME header.
//
// Found by the Azure SDK harness (sdk_harnesses/azure-sdk-for-net): Azure
// Storage echoes the request's x-ms-client-request-id in the response, and
// the SDK refuses a response whose id is not the one it sent ("Response
// x-ms-client-request-id ... does not match the original expected request
// id"). The id is a fresh Guid per request, so a replayed response carrying
// the recorded one fails every call. Recorded as the token (redact_header on
// the response headers), each replayed response carries the id its request
// sent. The upstream here echoes X-Correlation-Id the same way.

import core.vcr
import std.http.client
import std.http
import std.fs
import std.io
import std.string

extern exit(code: int)
extern http_server_stop(server: ptr)

const UPSTREAM_PORT = 18330
const RECORD_PORT   = 18331
const PLAYBACK_PORT = 18332
const FIELD_RESPONSE_HEADERS = 5

fail(msg: string) {
    println("FAIL: ${msg}")
    exit(1)
}

handle_get(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 200)
    http.response_set_header(res, "X-Correlation-Id", http.get_header(req, "X-Correlation-Id"))
    http.response_set_body(res, "ok")
}

// GET with `id`; return the status and the response's X-Correlation-Id.
get(port: int, id: string) -> (int, string) {
    req = client.request("GET", "http://127.0.0.1:${port}/thing")
    client.set_timeout(req, 5s)
    client.set_header(req, "X-Correlation-Id", id)
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return -1, err }
    st = client.response_status(resp)
    echoed = string.copy(client.response_header(resp, "X-Correlation-Id"))
    client.response_free(resp)
    return st, echoed
}

main() {
    println("=== VCR fills {{request.header.NAME}} from the live request ===")
    tmp = io.getenv("TMPDIR")
    if tmp == 0 { tmp = "/tmp" }
    TAPE_PATH = "${tmp}/vcr_request_header_token.tape"
    fs.delete(TAPE_PATH)

    upstream = http.server_create(UPSTREAM_PORT)
    if upstream == 0 { fail("upstream server_create") }
    http.server_get(upstream, "/*", handle_get, null)
    if http.server_start_background(upstream) != "" { fail("upstream start") }
    sleep(250)

    recorder, _roerr = vcr.open_record(TAPE_PATH, "http://127.0.0.1:${UPSTREAM_PORT}", RECORD_PORT)
    if recorder == null { fail("open_record") }
    rerr = vcr.redact_header_h(recorder, FIELD_RESPONSE_HEADERS, "X-Correlation-Id", "{{request.header.x-correlation-id}}")
    if rerr != "" { fail("redact_header ${rerr}") }
    vcr.remove_header_h(recorder, 3, "X-Correlation-Id")
    if http.server_start_background(vcr.server_of(recorder)) != "" { fail("recorder start") }
    sleep(250)
    st1, e1 = get(RECORD_PORT, "recorded-id-1")
    if st1 != 200 || string.equals(e1, "recorded-id-1") != 1 { fail("record ${st1} echoed '${e1}'") }
    ferr = vcr.stop_and_flush_h(recorder, TAPE_PATH)
    if ferr != "" { fail("stop_and_flush ${ferr}") }
    vcr.destroy_h(recorder)

    tape, terr = fs.read(TAPE_PATH)
    if terr != "" { fail("read tape ${terr}") }
    if string.contains(tape, "X-Correlation-Id: {{request.header.x-correlation-id}}") != 1 { fail("the token is not on the tape:\n${tape}") }
    println("  PASS the tape holds the token, not the recorded id")

    playback, _poerr = vcr.open_playback(TAPE_PATH, PLAYBACK_PORT)
    if playback == null { fail("open_playback") }
    vcr.remove_header_h(playback, 3, "X-Correlation-Id")
    if http.server_start_background(vcr.server_of(playback)) != "" { fail("playback start") }
    sleep(250)
    st2, e2 = get(PLAYBACK_PORT, "live-id-2")
    if st2 != 200 { fail("playback ${st2}; ${vcr.last_error_h(playback)}") }
    if string.equals(e2, "live-id-2") != 1 { fail("replayed X-Correlation-Id is '${e2}', not the live request's") }
    println("  PASS the replayed response carries the live request's id")

    vcr.destroy_h(playback)
    http_server_stop(upstream)
    fs.delete(TAPE_PATH)
    println("PASS")
    exit(0)
}
