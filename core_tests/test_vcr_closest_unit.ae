// Unit tests for core/closest.ae: the token-aware first difference, the
// similarity score, element paths (XML, escaped XML, JSON) and line windows.
// Pure functions; no server.
import core.closest
import std.string
import std.time

extern exit(code: int)

const M = 0   // Mustache markers

eq_s(got: string, want: string, what: string) {
    if got != want {
        println("FAIL: ${what}\n--- got\n${got}\n--- want\n${want}")
        exit(1)
    }
}
eq_i(got: int, want: int, what: string) {
    if got != want {
        println("FAIL: ${what}: got ${got}, want ${want}")
        exit(1)
    }
}
diff_at(a: string, b: string, bound: string, wa: int, wb: int, what: string) {
    da, db = closest.first_real_difference(a, b, M, bound)
    eq_i(da, wa, "${what} (offset in a)")
    eq_i(db, wb, "${what} (offset in b)")
}

main() {
    println("=== closest candidate: unit ===")

    // ---- first real difference ----
    diff_at("abc", "abc", "", -1, -1, "equal")
    diff_at("abc", "abd", "", 2, 2, "last byte")
    diff_at("abc", "ab", "", 2, 2, "a longer")
    diff_at("", "x", "", 0, 0, "a empty")
    // A token lines up with a -? slot of its name: never a difference.
    diff_at("<id>{{messageId-1}}</id><v>1</v>", "<id>{{messageId-?}}</id><v>2</v>", "", 27, 27, "slot skipped, real field found")
    diff_at("<id>{{messageId-1}}</id>", "<id>{{messageId-?}}</id>", "", -1, -1, "only a token: equal")
    // Unequal token texts, a slot of another name, a bound token: real.
    diff_at("/c/{{caseId-1}}/d", "/c/{{caseId-?}}/d", "|{{caseId-1}}|", 3, 3, "a bound token meets a slot")
    diff_at("/c/{{caseId-1}}/d", "/c/{{orderId-?}}/d", "", 3, 3, "another name")
    diff_at("/c/{{caseId-1}}/d", "/c/{{caseId-2}}/d", "", 3, 3, "another token of the name")
    // One-sided tokens render the same on both sides.
    diff_at("<s>{{submitted}}</s><t>a</t>", "<s>{{submitted}}</s><t>b</t>", "", 23, 23, "unnumbered token")
    // Offsets differ on each side once a slot was skipped.
    diff_at("{{a-1}}xy", "{{a-?}}xz", "", 8, 8, "same widths")
    diff_at("{{a-12}}xy", "{{a-?}}xz", "", 9, 8, "different widths")

    // ---- similarity ----
    eq_i(closest.similarity("", "", M, ""), 1000, "both empty")
    eq_i(closest.similarity("same", "same", M, ""), 1000, "equal")
    eq_i(closest.similarity("abcdefghij", "abcdXfghij", M, ""), 900, "one byte of ten")
    eq_i(closest.similarity("abcdefghij", "zzzzzzzzzz", M, ""), 0, "nothing shared")
    eq_i(closest.similarity("aaaa", "aaaaaaaa", M, ""), 500, "prefix and suffix never overlap")
    eq_i(closest.similarity("<x>{{id-1}}</x><b>1</b>", "<x>{{id-?}}</x><b>2</b>", M, ""), 956, "tokens count as common")
    // Closer bodies score higher.
    near = closest.similarity("<c><t>Leak</t><s>Rule 1</s></c>", "<c><t>Leak</t><s></s></c>", M, "")
    far = closest.similarity("<l><code>R1</code></l>", "<c><t>Leak</t><s></s></c>", M, "")
    if near <= far { println("FAIL: a near body (${near}) outscores a far one (${far})"); exit(1) }
    // The ranking compares the exact fractions, finer than thousandths.
    c1, l1 = closest.similarity_parts("abcdefghij", "abcdXfghij", M, "")
    eq_i(c1, 9, "common")
    eq_i(l1, 10, "longer")
    eq_i(closest.more_alike(3999998, 4000000, 3999997, 4000000), 1, "finer than thousandths")
    eq_i(closest.more_alike(3999997, 4000000, 3999998, 4000000), 0, "and the other way")
    eq_i(closest.more_alike(1, 2, 2, 4), 0, "equal fractions")
    eq_s(closest.per_mille_text(987), "0.987", "per mille")
    eq_s(closest.per_mille_text(1000), "1.000", "one")
    eq_s(closest.per_mille_text(5), "0.005", "small")
    eq_s(closest.per_mille_text(40), "0.040", "tens")

    // Linear on large bodies: two 4 MB bodies that differ in the middle.
    big = "0123456789abcdef"
    while string.length(big) < 4194304 { big = string.concat(big, big) }
    half = string.length(big) / 2
    other = string.concat(string.concat(string.substring(big, 0, half), "!"), string.substring(big, half + 1, string.length(big)))
    t0 = time.now_ms()
    s = closest.similarity(big, other, M, "")
    da, _db = closest.first_real_difference(big, other, M, "")
    ms = time.now_ms() - t0
    eq_i(da, half, "large: first difference")
    eq_i(s, 999, "large: score")
    if ms > 5000 { println("FAIL: large bodies took ${ms} ms"); exit(1) }
    println("  ok: two 4 MB bodies scored in ${ms} ms")

    // ---- XML element paths ----
    x = "<s:Envelope xmlns:s=\"urn:s\"><s:Body><Create xmlns=\"urn:c\"><caseData>&lt;CaseData&gt;&lt;Title&gt;Leak&lt;/Title&gt;&lt;SubjectValue&gt;Rule 1;&lt;/SubjectValue&gt;&lt;/CaseData&gt;</caseData></Create></s:Body></s:Envelope>"
    off = string.index_of(x, "Rule 1")
    path, start, name, escaped = closest.xml_element_at(x, off)
    eq_s(path, "/Envelope/Body/Create/caseData/CaseData/SubjectValue", "escaped markup is walked")
    eq_i(escaped, 1, "escaped")
    eq_s(name, "SubjectValue", "name")
    end = closest.xml_element_end(x, start, off, name, escaped)
    eq_s(closest.xml_unescape(string.substring(x, start, end)), "<SubjectValue>Rule 1;</SubjectValue>", "the element, readable")
    // The difference sits at an end tag: still inside the element.
    y = "<a><b>x</b><c>1</c></a>"
    p2, s2, n2, e2 = closest.xml_element_at(y, string.index_of(y, "1</c>") + 1)
    eq_s(p2, "/a/c", "at an end tag")
    eq_s(string.substring(y, s2, closest.xml_element_end(y, s2, 0, n2, e2)), "<c>1</c>", "raw element")
    // Closed siblings, self-closing elements, comments and attributes with '>'.
    z = "<?xml version=\"1.0\"?><r><!-- <x> --><e a=\"1>2\"/><f><g>q</g></f><h>w</h></r>"
    p3, _s3, _n3, _e3 = closest.xml_element_at(z, string.index_of(z, "w</h>"))
    eq_s(p3, "/r/h", "siblings closed")
    // The difference is in a start tag: that element.
    w = "<a><b>1</b><c>2</c></a>"
    p6, s6, n6, e6 = closest.xml_element_at(w, string.index_of(w, "c>2"))
    eq_s(p6, "/a/c", "in a start tag")
    eq_s(string.substring(w, s6, closest.xml_element_end(w, s6, s6, n6, e6)), "<c>2</c>", "that element")
    p4, s4, _n4, _e4 = closest.xml_element_at("text", 2)
    eq_s(p4, "", "no element")
    eq_i(s4, -1, "no element start")
    // Pretty-printed lines (PrettyXml / MatchXmlBody canonical form).
    pretty = "<r>\n  <a>1</a>\n  <b>two</b>\n</r>"
    p5, _s5, _n5, _e5 = closest.xml_element_at(pretty, string.index_of(pretty, "two"))
    eq_s(p5, "/r/b", "pretty")
    eq_s(closest.line_window(pretty, string.index_of(pretty, "two"), 200), "  <b>two</b>", "pretty line")

    // ---- JSON pointers ----
    j = "{\"caseData\":{\"title\":\"Leak\",\"tags\":[\"a\",\"b\",{\"k\":\"v\"}],\"subject\":\"Rule 1\"},\"x/y\":1}"
    eq_s(closest.json_pointer_at(j, string.index_of(j, "Rule 1")), "/caseData/subject", "object member")
    eq_s(closest.json_pointer_at(j, string.index_of(j, "\"b\"")), "/caseData/tags/1", "array index")
    eq_s(closest.json_pointer_at(j, string.index_of(j, "\"v\"")), "/caseData/tags/2/k", "nested")
    eq_s(closest.json_pointer_at(j, string.index_of(j, ":1}") + 1), "/x~1y", "escaped key")
    eq_s(closest.json_pointer_at(j, 0), "", "top")

    // ---- line windows ----
    eq_s(closest.line_window("one\ntwo\nthree", 5, 80), "two", "a line")
    long_line = "aaaaaaaaaaaaaaaaaaaaXbbbbbbbbbbbbbbbbbbbb"
    eq_s(closest.line_window(long_line, 20, 10), "...aaaaaXbbbb...", "cut around the offset")
    eq_s(closest.line_window("abc", 3, 80), "abc", "at the end")

    println("=== closest candidate: unit passed ===")
    exit(0)
}
