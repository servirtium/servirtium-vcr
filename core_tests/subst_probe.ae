// Response-side substitution (field report #1, the paging blocker): on playback
// the VCR rewrites {{request.host}}/{{request.scheme}}/{{baseUrl}} (from the live
// request) and caller-registered placeholders in the RESPONSE body and headers,
// so a taped nextLink/id/absolute URL resolves against the test's own host.
// This probe loads a tape whose response carries those tokens, registers one
// caller substitution ({{vault}} -> a literal), serves it, and asserts the
// fetched body + Link header came back filled in.
import core.vcr
import std.http
import std.http.client
import std.string

extern exit(code: int)

const PORT = 18293
const TAPE = "core_tests/tapes/substitute.tape"

fail(msg: string) { println("FAIL: ${msg}"); exit(1) }

main() {
    println("=== response-side substitution: {{baseUrl}}/{{request.host}}/{{vault}} on playback ===\n")

    srv = vcr.load(TAPE, PORT)
    if srv == null { fail("load: ${vcr.load_error()}") }

    // Caller substitution for a non-request-derived placeholder. {{vault}} is in
    // the BODY only on this tape, but FIELD_RESPONSE (body AND headers, one rule)
    // is the right field-report shape; it still matches the body here.
    serr = vcr.substitute_h(srv, vcr.FIELD_RESPONSE, "{{vault}}", "https://vault.example", 1)
    if serr != "" { fail("substitute body: ${serr}") }
    // A non-response field must be rejected.
    e_bad = vcr.substitute_h(srv, vcr.FIELD_PATH, "{{x}}", "y", 1)
    if e_bad == "" { fail("substitute should reject a non-response field") }
    // An OPTIONAL rule whose pattern never appears must not trip
    // assert_all_redactions_used.
    e_opt = vcr.substitute_h(srv, vcr.FIELD_RESPONSE, "{{absent}}", "x", 0)
    if e_opt != "" { fail("optional substitute config: ${e_opt}") }

    rc = vcr.start_background_h(srv, 10000)
    if rc != 0 { fail("start: ${vcr.last_error_h(srv)}") }
    port = http.server_port(srv)
    expect_base = "http://127.0.0.1:${port}"

    req = client.request("GET", "${expect_base}/page1")
    client.set_timeout(req, 5s)
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" { fail("GET failed: ${err}") }
    status = client.response_status(resp)
    body = string.copy(client.response_body(resp))
    headers = string.copy(client.response_headers(resp))
    client.response_free(resp)

    if status != 200 { fail("status ${status}") }

    // {{baseUrl}} in the body -> http://127.0.0.1:<port>
    if string.index_of(body, "${expect_base}/page2") < 0 {
        fail("body {{baseUrl}} not filled; got: ${body}")
    }
    // {{vault}} caller substitution
    if string.index_of(body, "https://vault.example/secret") < 0 {
        fail("body {{vault}} not filled; got: ${body}")
    }
    // {{request.host}} -> the live Host header (127.0.0.1:<port>)
    if string.index_of(body, "127.0.0.1:${port}") < 0 {
        fail("body {{request.host}} not filled; got: ${body}")
    }
    // No raw placeholder left behind.
    if string.index_of(body, "{{") >= 0 {
        fail("body still has a raw placeholder; got: ${body}")
    }
    // {{baseUrl}} in the Link RESPONSE HEADER
    if string.index_of(headers, "${expect_base}/page2") < 0 {
        fail("Link header {{baseUrl}} not filled; got: ${headers}")
    }

    // Field-report additions: the required {{vault}} rule fired and the optional
    // {{absent}} rule didn't -> assert_all_redactions_used passes (optional
    // unused rules are never reported); and nothing {{...}} was served, so
    // assert_no_unfilled_placeholders passes.
    rused = vcr.assert_all_redactions_used_h(srv)
    if rused != "" { fail("assert_all_redactions_used should pass (optional rule unused): '${rused}'") }
    unfilled = vcr.assert_no_unfilled_placeholders_h(srv)
    if unfilled != "" { fail("assert_no_unfilled_placeholders should pass: '${unfilled}'") }
    // A REQUIRED rule that never fires MUST be reported (by pattern, not value).
    _rq = vcr.substitute_h(srv, vcr.FIELD_RESPONSE, "{{nope}}", "zzz", 1)
    rep = vcr.assert_all_redactions_used_h(srv)
    if string.index_of(rep, "{{nope}}") < 0 {
        fail("a REQUIRED unused rule must be reported by pattern; got '${rep}'")
    }
    if string.index_of(rep, "zzz") >= 0 {
        fail("assert_all_redactions_used must NOT leak the replacement value; got '${rep}'")
    }

    vcr.eject(srv)
    println("\nPASS: response substitution filled ({{baseUrl}}, {{request.host}}, {{vault}});")
    println("      FIELD_RESPONSE + required/optional + assert_no_unfilled_placeholders verified")
    exit(0)
}
