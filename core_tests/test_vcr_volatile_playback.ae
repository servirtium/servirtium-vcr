// Volatile values on playback (docs/volatile-values.md): a tape token
// matches whatever the live request carries there and binds it; response
// tokens are filled from the bindings, from what the test bound, or from a
// hand-written tape's value; correlation is guarded (a request against a
// request, a request against the test); the tape's own block applies with
// no code rules, and a profile or code rules give the same; canonical forms
// are compared (an indented tape, a compact request); marker styles are
// checked at start; match_multiple rebinds; escapes come back as text.
import core.vcr
import std.http
import std.http.client
import std.string
import std.fs
import std.io

extern exit(code: int)

const PORT = 18351
const WSA = "http://www.w3.org/2005/08/addressing"
const DIR = "core_tests/volatile"

has(text: string, part: string, what: string) {
    if string.contains(text, part) != 1 {
        println("FAIL: ${what}: no [${part}] in\n${text}")
        exit(1)
    }
}
eq(got: string, want: string, what: string) {
    if got != want {
        println("FAIL: ${what}\n--- got\n${got}\n--- want\n${want}")
        exit(1)
    }
}
ok(err: string, what: string) {
    if err != "" { println("FAIL: ${what}: ${err}"); exit(1) }
}
tmp_tape(name: string, text: string) -> string {
    t = io.getenv("TMPDIR")
    if t == 0 { t = "/tmp" }
    p = "${t}/vcr_volatile_${name}.tape"
    ok(fs.write(p, text), "write ${name}")
    return p
}

hit(method: string, path: string, body: string, ctype: string) -> (int, string) {
    req = client.request(method, "http://127.0.0.1:${PORT}${path}")
    if string.length(body) > 0 { client.set_body(req, string.bytes(body), ctype) }
    client.set_timeout(req, 5s)
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return -1, err }
    st = client.response_status(resp)
    b = string.copy(client.response_body(resp))
    client.response_free(resp)
    return st, b
}

open_tape(tape: string) -> ptr {
    h, err = vcr.open_playback(tape, PORT)
    if h == null { println("FAIL: open ${tape}: ${err}"); exit(1) }
    return h
}
go(h: ptr) {
    if vcr.start_background_h(h, 10000) != 0 { println("FAIL: start: ${vcr.last_error_h(h)}"); exit(1) }
}
refuses(h: ptr, part: string, what: string) {
    if vcr.start_background_h(h, 10000) == 0 { println("FAIL: ${what}: start should fail"); exit(1) }
    has(vcr.last_error_h(h), part, what)
    vcr.destroy_h(h)
}
done(h: ptr) {
    vcr.eject(h)
    vcr.destroy_h(h)
}

soap(id: string, endpoint: string, stamp: string) -> string {
    return "<s:Envelope xmlns:s=\"http://www.w3.org/2003/05/soap-envelope\" xmlns:a=\"${WSA}\"><s:Header><a:Action s:mustUnderstand=\"1\">http://services.example.test/case/ICaseService/CreateCase</a:Action><a:MessageID>urn:uuid:${id}</a:MessageID><a:ReplyTo><a:Address>${WSA}/anonymous</a:Address></a:ReplyTo><a:To s:mustUnderstand=\"1\">${endpoint}/Services/CaseService.svc</a:To></s:Header><s:Body><CreateCase xmlns=\"http://services.example.test/case\"><caseData>&lt;CaseData&gt;&lt;Title&gt;Water leak&lt;/Title&gt;&lt;SubmissionDate&gt;${stamp}&lt;/SubmissionDate&gt;&lt;/CaseData&gt;</caseData></CreateCase></s:Body></s:Envelope>"
}

wcf_round_trip(h: ptr, id: string, endpoint: string, what: string) {
    vcr.reset_cursor_h(h)
    st, body = hit("POST", "/Services/CaseService.svc", soap(id, endpoint, "2026-11-13T09:41:07"), "application/soap+xml")
    if st != 200 { println("FAIL: ${what}: ${st} ${body}\n${vcr.last_error_h(h)}"); exit(1) }
    has(body, "<a:RelatesTo>urn:uuid:${id}</a:RelatesTo>", "${what}: RelatesTo is the request's own MessageID")
}

code_rules(h: ptr) {
    ok(vcr.volatile_rule_h(h, "request body", "template", "<a:MessageID>urn:uuid:{{messageId}}</a:MessageID>"), "rule")
    ok(vcr.volatile_rule_h(h, "request body", "template", "<a:To s:mustUnderstand=\"1\">{{endpoint}}/Services/"), "rule")
    ok(vcr.volatile_rule_h(h, "request body", "template", "&lt;SubmissionDate&gt;{{submitted}}&lt;/SubmissionDate&gt;"), "rule")
    ok(vcr.volatile_rule_h(h, "response body", "template", "<a:RelatesTo>urn:uuid:{{messageId}}</a:RelatesTo>"), "rule")
}

interaction(i: int, method: string, path: string, req_body: string, status: int, resp_type: string, resp_body: string) -> string {
    fence = "```"
    return "## Interaction ${i}: ${method} ${path}\n\n### Request headers recorded for playback:\n\n${fence}\n${fence}\n### Request body recorded for playback ():\n\n${fence}\n${req_body}\n${fence}\n### Response headers recorded for playback:\n\n${fence}\nContent-Type: ${resp_type}\n${fence}\n### Response body recorded for playback (${status}: ${resp_type}):\n\n${fence}\n${resp_body}\n${fence}\n\n"
}

main() {
    println("=== volatile values: playback ===")
    A = "5f1d0c6e-2a8b-4c3e-9d41-7b6a0f2e8c13"
    B = "0b6c35a3-7f2e-4f5f-8b2a-1d6e4c9a2f70"

    // ---- tests 1, 6, 8: the tape declares its rules; an indented tape, compact requests ----
    h = open_tape("${DIR}/wcf.md")
    vcr.set_pretty_xml_h(h, 2)
    go(h)
    wcf_round_trip(h, A, "https://workpro--not-real.invalid:53187", "WCF run 1")
    wcf_round_trip(h, B, "http://foo.example.test", "WCF run 2: another id, another endpoint")
    has(vcr.volatile_report_h(h), "binding: {{messageId-1}} = ${B} (interaction 0)", "the binding is reported")
    vcr.reset_cursor_h(h)
    vcr.clear_last_error_h(h)
    st0, _b0 = hit("POST", "/Services/CaseService.svc", string.replace_all(soap(A, "http://x.example.test", "2026-11-13T09:41:07"), "CreateCase", "OpenCase"), "application/soap+xml")
    if st0 != 599 { println("FAIL: a renamed element must not match (${st0})"); exit(1) }
    done(h)

    // ---- test 6: the same tape without its block, plus a profile; or rules in code ----
    h = open_tape("${DIR}/wcf_plain.md")
    vcr.set_pretty_xml_h(h, 2)
    ok(vcr.volatile_profile_h(h, "${DIR}/profile.md"), "the profile")
    go(h)
    wcf_round_trip(h, A, "https://workpro--not-real.invalid:53187", "profile run")
    done(h)
    h = open_tape("${DIR}/wcf_plain.md")
    vcr.set_pretty_xml_h(h, 2)
    code_rules(h)
    go(h)
    wcf_round_trip(h, A, "https://workpro--not-real.invalid:53187", "code rules")
    done(h)
    h = open_tape("${DIR}/wcf_plain.md")
    vcr.set_pretty_xml_h(h, 2)
    go(h)
    stn, _bn = hit("POST", "/Services/CaseService.svc", soap(A, "https://workpro--not-real.invalid:53187", "2026-11-13T09:41:07"), "application/soap+xml")
    if stn != 599 { println("FAIL: without rules the tokens are text (${stn})"); exit(1) }
    done(h)
    // Rules set after start re-prepare (bindings whose open also starts).
    h = open_tape("${DIR}/wcf_plain.md")
    go(h)
    vcr.set_pretty_xml_h(h, 2)
    code_rules(h)
    wcf_round_trip(h, A, "https://workpro--not-real.invalid:53187", "rules after start")
    done(h)

    // ---- marker styles ----
    h = open_tape("${DIR}/wcf_dollar.md")
    vcr.set_pretty_xml_h(h, 2)
    ok(vcr.set_volatile_markers_h(h, 1), "DollarCurly")
    go(h)
    wcf_round_trip(h, A, "https://workpro--not-real.invalid:53187", "DollarCurly tape")
    done(h)
    refuses(open_tape("${DIR}/wcf_dollar.md"), "the tape's rules use DollarCurly", "a tape whose rules are in another style")
    h = open_tape("${DIR}/wcf_dollar.md")
    vcr.set_volatile_markers_h(h, 1)
    pe = vcr.volatile_profile_h(h, "${DIR}/profile.md")
    has(pe, "uses Mustache ({{name}}) markers; this VCR uses DollarCurly", "a profile in another style")
    vcr.destroy_h(h)
    D = string.from_char(36)
    mixed = tmp_tape("mixed", string.concat("## Volatile values\n\n- request path: `/a/{{x}}/b`\n\n", string.concat(interaction(0, "GET", "/a/{{x-1}}/b", "", 200, "text/plain", "one"), interaction(1, "GET", "/a/${D}{x-1}/b", "", 200, "text/plain", "two"))))
    refuses(open_tape(mixed), "the tape mixes token styles", "mixed styles")
    dollar_only = tmp_tape("dollar_only", string.concat("## Volatile values\n\n- request path: `/a/{{x}}/b`\n\n", interaction(0, "GET", "/a/${D}{x-1}/b", "", 200, "text/plain", "one")))
    refuses(open_tape(dollar_only), "the tape's tokens are DollarCurly", "tokens in another style")

    // ---- test 2: a response hands out an id, the next request uses it ----
    h = open_tape("${DIR}/cases.md")
    go(h)
    _s1, b1 = hit("POST", "/cases", "", "")
    eq(b1, "{\"caseId\":\"42\"}", "an unbound token replays the hand-written value")
    s2, b2 = hit("GET", "/cases/42/documents", "", "")
    if s2 != 200 { println("FAIL: the handed-out id matches (${s2} ${b2})"); exit(1) }
    vcr.reset_cursor_h(h)
    vcr.clear_last_error_h(h)
    hit("POST", "/cases", "", "")
    s3, b3 = hit("GET", "/cases/99/documents", "", "")
    if s3 != 599 { println("FAIL: another id must not match (${s3})"); exit(1) }
    has(b3, "{{caseId-1}} = 42 (bound by interaction 0); the request sent 99", "the mismatch names the binding")
    dj = vcr.diagnostics_json_h(h, 1)
    has(dj, "\"volatile\":", "diagnostics carry the volatile section")
    has(dj, "normalized path", "both normalized forms")
    has(dj, "caseId-?", "an unbound slot")
    has(dj, "{{caseId-1}} = 42 (interaction 0)", "the bindings")
    done(h)

    // ---- bind: the test supplies what no request binds first ----
    refuses(open_tape("${DIR}/cases_recorded.md"), "bind them in the test, bind(name, value)): caseId", "an unbound response token")
    names = ["caseId", "caseId-1"]
    ni = 0
    while ni < 2 {
        h = open_tape("${DIR}/cases_recorded.md")
        ok(vcr.volatile_bind_h(h, names[ni], "42"), "bind ${names[ni]}")
        go(h)
        _r1, rb1 = hit("POST", "/cases", "", "")
        eq(rb1, "{\"caseId\":\"42\"}", "bind(${names[ni]}) fills the response")
        r2, rb2 = hit("GET", "/cases/42/documents", "", "")
        if r2 != 200 { println("FAIL: the bound id comes back (${r2} ${rb2})"); exit(1) }
        eq(rb2, "the documents of case 42", "and fills the next response")
        done(h)
        ni = ni + 1
    }
    // A request against what the test bound.
    h = open_tape("${DIR}/wcf.md")
    vcr.set_pretty_xml_h(h, 2)
    ok(vcr.volatile_bind_h(h, "messageId", A), "bind messageId")
    go(h)
    wcf_round_trip(h, A, "https://workpro--not-real.invalid:53187", "the request sends what the test bound")
    vcr.reset_cursor_h(h)
    vcr.clear_last_error_h(h)
    sx, bx = hit("POST", "/Services/CaseService.svc", soap(B, "https://workpro--not-real.invalid:53187", "2026-11-13T09:41:07"), "application/soap+xml")
    if sx != 599 { println("FAIL: a request against the test's bind (${sx})"); exit(1) }
    has(bx, "{{messageId-1}} was bound by the test to ${A}; the request sent ${B}", "the diagnostic names both")
    done(h)
    // A bound value must fit an inline pattern.
    h = open_tape("${DIR}/wcf_plain.md")
    ok(vcr.volatile_rule_h(h, "request body", "template", "<a:MessageID>urn:uuid:{{messageId:[0-9a-f-]{36}}}</a:MessageID>"), "rule")
    ok(vcr.volatile_bind_h(h, "messageId-1", "not-a-uuid"), "bind")
    refuses(h, "bind(messageId-1, not-a-uuid): the value does not match the placeholder's pattern `[0-9a-f-]{36}`", "a bound value checked at start")
    hk = open_tape("${DIR}/cases.md")
    has(vcr.volatile_bind_h(hk, "case-id", "1"), "is neither a placeholder name nor a token", "bind key checked")
    vcr.destroy_h(hk)

    // ---- a client that sends the token text itself ----
    lit = tmp_tape("literal", string.concat("## Volatile values\n\n- request path: `/checkout/{{cartId}}/card`\n\n", interaction(0, "GET", "/checkout/{{cartId-1}}/card", "", 200, "text/plain", "card")))
    h = open_tape(lit)
    go(h)
    sl, _bl = hit("GET", "/checkout/{{cartId-1}}/card", "", "")
    if sl != 200 { println("FAIL: a literal token matches (${sl})"); exit(1) }
    vcr.reset_cursor_h(h)
    sl2, _bl2 = hit("GET", "/checkout/c-77/card", "", "")
    if sl2 != 200 { println("FAIL: so does a value (${sl2})"); exit(1) }
    done(h)

    // ---- an inline pattern guards the format ----
    UUIDP = "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
    guard = tmp_tape("guard", string.concat("## Volatile values\n\n- request body: `\"requestId\": \"{{requestId:${UUIDP}}}\"`\n\n", interaction(0, "POST", "/r", "{\"requestId\":\"{{requestId-1}}\"}", 200, "text/plain", "ok")))
    h = open_tape(guard)
    vcr.set_pretty_json_h(h, 2)
    go(h)
    sa, _ba = hit("POST", "/r", "{\"requestId\":\"${B}\"}", "application/json")
    if sa != 200 { println("FAIL: a UUID matches (${sa}): ${vcr.last_error_h(h)}"); exit(1) }
    vcr.reset_cursor_h(h)
    vcr.clear_last_error_h(h)
    sb, _bb = hit("POST", "/r", "{\"requestId\":\"42\"}", "application/json")
    if sb != 599 { println("FAIL: 42 is not a UUID (${sb})"); exit(1) }
    has(vcr.last_error_ex_h(h, 0), "normalized request body", "normalized forms")
    done(h)

    // ---- test 7: a code rule contradicting the tape's fails start ----
    h = open_tape("${DIR}/cases.md")
    ce = vcr.volatile_rule_h(h, "response body", "template", "\"caseId\":\"{{id}}\"")
    has(ce, "conflicts with `response body: `\"caseId\":\"{{caseId}}\"`` (tape)", "conflict when given")
    refuses(h, "conflicts with", "and at start")

    // ---- a bad block fails start, naming the line ----
    bad = tmp_tape("bad", string.concat("## Volatile values\n\n- request body: `no placeholder`\n\n", interaction(0, "GET", "/", "", 200, "text/plain", "x")))
    refuses(open_tape(bad), "line 3", "a bad block")

    // ---- match_multiple: an interaction replayed again rebinds ----
    h = open_tape("${DIR}/wcf.md")
    vcr.set_pretty_xml_h(h, 2)
    vcr.set_match_multiple_h(h, 1)
    go(h)
    wcf_round_trip(h, "11111111-2a8b-4c3e-9d41-7b6a0f2e8c13", "http://a.example.test", "poll 1")
    wcf_round_trip(h, "22222222-2a8b-4c3e-9d41-7b6a0f2e8c13", "http://b.example.test", "poll 2")
    done(h)

    // ---- escapes: a literal marker stays text, a token is filled ----
    esc = tmp_tape("escape", string.concat("## Volatile values\n\n- request path: `/e/{{id}}`\n\n", interaction(0, "GET", "/e/{{id-1}}", "", 200, "text/plain", "literal {{{{}}id-1}}, value {{id-1}}")))
    h = open_tape(esc)
    go(h)
    _es, eb2 = hit("GET", "/e/abc", "", "")
    eq(eb2, "literal {{id-1}}, value abc", "escape and token")
    done(h)

    println("=== volatile values: playback passed ===")
    exit(0)
}
