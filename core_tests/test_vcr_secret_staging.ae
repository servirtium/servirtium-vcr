import core.vcr
import std.fs
import std.string
extern exit(code: int)
check(ok: int, label: string) { if ok == 0 { println("FAIL: ${label}"); exit(1) } }
main() {
    tape = "/tmp/vcr-secret-staging.md"
    h = vcr.load_record(tape, "http://127.0.0.1:1", 0)
    check(h != null, "record handle")
    error = vcr.record_full_response("POST", "/billing/login?password=original&safe=keep", 200,
        "application/json", "{ \"password\":123, \"keep\":1 }\n", "Content-Type: application/json\nAuthorization: original\n",
        "{ \"password\":123, \"nested\":{\"password\":\"original\"}, \"keep\":true }\n", "X-Password: original\n")
    check(error == "", error)
    check(vcr.secret_begin_h(h, 0) == "", "begin")
    check(vcr.secret_begin_h(h, 0) != "", "reject nested staging")
    check(fs.write(tape, "sentinel") == "", "sentinel")
    check(vcr.flush(tape) != "", "pending decisions cannot write")
    count = 0
    while vcr.secret_next_h(h) > 0 {
        key = vcr.secret_get_h(h, 1)
        check(vcr.secret_get_h(h, 3) == "POST", "method metadata")
        check(vcr.secret_get_h(h, 4) == "/billing/login?password=original&safe=keep", "raw request path metadata")
        if key == "password" || key == "Authorization" || key == "X-Password" {
            check(vcr.secret_apply_h(h, "BILLING_PASSWORD") == "", "apply named token")
            count = count + 1
        }
    }
    check(count == 6, "all five locations and nested leaves")
    check(vcr.secret_finish_h(h) == "", "finish")
    blob = vcr.emit_tape()
    check(string.contains(blob, "original") == 0, "no original secrets emitted")
    check(string.contains(blob, "{{secret:BILLING_PASSWORD|4}}") == 1, "primitive encoding retained")
    check(vcr.vcr_get_req_body(0) == "{ \"password\":123, \"nested\":{\"password\":\"original\"}, \"keep\":true }\n", "capture unchanged")
    check(vcr.flush(tape) == "", "write redacted tape")
    p = vcr.load(tape, 0)
    check(p != null, "load redacted tape")
    check(vcr.secret_begin_h(p, 1) == "", "begin resolver")
    while vcr.secret_next_h(p) > 0 {
        check(vcr.secret_get_h(p, 2) == "BILLING_PASSWORD", "same token across encodings")
        value = "original"
        path = vcr.secret_get_h(p, 7); format = vcr.secret_get_h(p, 6)
        if format == "json" && path == "/password" { value = "123" }
        check(vcr.secret_apply_h(p, value) == "", "resolve")
    }
    check(vcr.secret_finish_h(p) == "", "finish resolver")
    check(vcr.vcr_get_req_body(0) == "{ \"password\":123, \"nested\":{\"password\":\"original\"}, \"keep\":true }\n", "request source spans and terminal newline preserved")
    check(vcr.flush(tape) != "", "resolved playback cannot write plaintext")
    check(vcr.secret_begin_h(p, 1) != "", "resolving twice cannot bypass emission protection")
    check(vcr.flush(tape) != "", "resolved secrets remain protected")
    retained, err = fs.read(tape)
    check(err == "" && retained == blob, "disk tape remains redacted")
    missing = vcr.load(tape, 0)
    check(vcr.secret_check_ready_h(missing) != "", "named markers require a resolver")
    failed = vcr.load_record(tape, "http://127.0.0.1:1", 0)
    error = vcr.record_full("POST", "/ok", 200, "text/plain", "ok", "Content-Type: application/yaml", "password: &anchor original\n")
    check(vcr.secret_begin_h(failed, 0) != "", "unsupported YAML fails explicitly")
    check(vcr.stop_and_flush_h(failed, tape) != "", "extraction failure cannot flush")
    retained, err = fs.read(tape)
    check(err == "" && retained == blob, "failed extraction preserves tape")
    check(vcr.emit_code_block("line\n") == "```\nline\n\n```\n", "fenced terminal newline")
    vcr.indent_code_blocks()
    check(vcr.emit_code_block("line\n") == "    line\n    \n", "indented terminal newline")
    println("secret staging: passed")
}
