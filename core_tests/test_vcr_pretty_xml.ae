// Opt-in pretty_xml recording option: record-time indentation of XML bodies.
//
// Drives the record-side emitter directly (vcr.record_full + vcr.flush, no
// upstream needed), reads the tape back, then replays the written tape over
// real HTTP. Cases:
//
//   1. pretty_xml(2) on: XML response body is indented in the tape; an XML
//      request body is indented too when match_xml_body is on.
//   2. Replay: the SUT's original compact request still matches (xml-semantic
//      matching), the prettified response is served as recorded, and the
//      Content-Length the client sees equals the bytes actually served.
//   3. Request body is left byte-exact when match_xml_body is OFF (default
//      byte-exact matching would otherwise reject the live request).
//   4. Option off (default): tape byte-exact as before.
//   5. Malformed XML with the option on: body recorded byte-exact, no failure.
//   6. Non-XML content type: untouched.
//   7. application/soap+xml with "; charset=utf-8": prettified.
//   8. Redaction acts on the RAW body first: a secret that spans two
//      elements (and would be split by the added line break) is still redacted.
//   9. clear_format_options turns the option off again.
//  10. Indent width 4 and the 16 clamp.

import core.vcr
import std.http
import std.http.client
import std.fs
import std.string
import std.io

extern exit(code: int)
extern http_server_start_raw(server: ptr) -> int

const PORT = 18171

const COMPACT_RESP = "<Envelope><Body><Result id=\"1\"><Name>Ann</Name></Result></Body></Envelope>"
const COMPACT_REQ  = "<Envelope><Body><Submit><Who>Bob</Who></Submit></Body></Envelope>"
const BAD_XML      = "<Envelope><Body><oops></Envelope>"
const REQ_HDRS     = "Content-Type: application/xml"

flush_out_path() -> {
    tmp = io.getenv("TEMP")
    if tmp == 0 { tmp = io.getenv("TMPDIR") }
    if tmp == 0 { tmp = "/tmp" }
    return "${tmp}/vcr_pretty_xml_test.tape"
}

message StartVCR { raw: ptr }
message Noop {}

actor VCRActor {
    state s = 0
    receive { StartVCR(raw) -> { s = raw; http_server_start_raw(raw) } }
}

actor SchedHelper {
    state x = 0
    receive { Noop() -> { x = 1 } }
}

fail(msg: string) {
    println("  FAIL: ${msg}")
    exit(1)
}

assert_contains(h: string, n: string, label: string) {
    if string.contains(h, n) != 1 { fail("${label} — expected '${n}' in:\n${h}") }
}

assert_not_contains(h: string, n: string, label: string) {
    if string.contains(h, n) == 1 { fail("${label} — did not expect '${n}' in:\n${h}") }
}

record_and_read(path: string, st: int, ctype: string, resp: string, req: string) -> string {
    vcr.clear_recording()
    e = vcr.record_full("POST", "/x", st, ctype, resp, REQ_HDRS, req)
    if e != "" { fail("record_full: ${e}") }
    f = vcr.flush(path)
    if f != "" { fail("flush: ${f}") }
    t, de = fs.read(path)
    if de != "" { fail("read back: ${de}") }
    return t
}

main() {
    println("=== VCR pretty_xml recording option ===\n")
    OUT = flush_out_path()

    // ---- 1. on + match_xml_body: both bodies indented ----
    println("Test 1: pretty_xml(2) indents the XML response, leaves the request byte-exact")
    vcr.vcr_set_pretty_xml(2)
    t1 = record_and_read(OUT, 200, "application/xml", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t1, "\n  <Body>\n", "response body not indented")
    assert_contains(t1, "\n    <Result id=\"1\">", "response nesting not indented")
    assert_contains(t1, "      <Name>Ann</Name>", "response leaf not indented")
    assert_contains(t1, COMPACT_REQ, "request body must stay byte-exact")
    assert_contains(t1, "</Envelope>\n```", "no stray trailing blank line")
    assert_not_contains(t1, COMPACT_RESP, "compact response survived")
        println("  PASS")

    // ---- 2. replay the prettified tape ----
    println("Test 2: replay serves the prettified response; the SUT's compact request still matches byte-exactly")
    raw = vcr.load(OUT, PORT)
    if raw == null { fail("vcr.load") }
    spawn(SchedHelper())
    a = spawn(VCRActor())
    a ! StartVCR { raw: raw }
    sleep(500)

    creq = client.request("POST", "http://127.0.0.1:${PORT}/x")
    client.set_header(creq, "Content-Type", "application/xml")
    berr = client.set_body(creq, string.bytes(COMPACT_REQ), "application/xml")
    if berr != "" { fail("set_body: ${berr}") }
    cresp, cerr = client.send_request(creq)
    client.request_free(creq)
    if cerr != "" { fail("transport: ${cerr}") }
    s2 = client.response_status(cresp)
    b2 = string.copy(client.response_body(cresp))
    cl2 = string.copy(client.response_header(cresp, "Content-Length"))
    client.response_free(cresp)
    if s2 != 200 { fail("status ${s2}, last_error='${vcr.last_error_h(raw)}'") }
    assert_contains(b2, "\n      <Name>Ann</Name>", "replayed body not the prettified form")
    blen = string.length(b2)
    if string.length(cl2) > 0 && string.equals(cl2, "${blen}") != 1 {
        fail("Content-Length ${cl2} != served body length ${blen}")
    }
    vcr.eject(raw)
    // load()/eject() switch the ambient config key; re-apply the bare options.
    vcr.vcr_set_pretty_xml(2)
    println("  PASS: 200, Content-Length '${cl2}' vs ${blen} bytes served")

    // ---- 3. request XML body never prettified, even with XML matching on ----
    println("Test 3: request body untouched even with a request Content-Type of XML")
    t3 = record_and_read(OUT, 200, "application/xml", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t3, COMPACT_REQ, "request body must stay byte-exact")
    assert_not_contains(t3, COMPACT_RESP, "response should still be prettified")
    println("  PASS")

    // ---- 4. option off ----
    println("Test 4: option off is byte-exact")
    vcr.vcr_set_pretty_xml(0)
    t4 = record_and_read(OUT, 200, "application/xml", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t4, COMPACT_RESP, "response not byte-exact")
    assert_contains(t4, COMPACT_REQ, "request not byte-exact")
    println("  PASS")

    // ---- 5. malformed XML ----
    println("Test 5: malformed XML recorded byte-exact, recording does not fail")
    vcr.vcr_set_pretty_xml(2)
    t5 = record_and_read(OUT, 200, "text/xml", BAD_XML, BAD_XML)
    assert_contains(t5, BAD_XML, "malformed body must be byte-exact")
    println("  PASS")

    // ---- 6. non-XML content type ----
    println("Test 6: non-XML content type untouched")
    t6 = record_and_read(OUT, 200, "application/json", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t6, COMPACT_RESP, "json-typed body must be untouched")
    t6b = record_and_read(OUT, 200, "text/plain", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t6b, COMPACT_RESP, "text/plain body must be untouched")
    println("  PASS")

    // ---- 7. +xml type with parameters ----
    println("Test 7: +xml types and parameters are prettified")
    t7 = record_and_read(OUT, 200, "application/soap+xml; charset=utf-8", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t7, "      <Name>Ann</Name>", "soap+xml not prettified")
    t7b = record_and_read(OUT, 200, "application/atom+xml", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t7b, "      <Name>Ann</Name>", "atom+xml not prettified")
    t7c = record_and_read(OUT, 200, "TEXT/XML; charset=ISO-8859-1", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t7c, "      <Name>Ann</Name>", "TEXT/XML not prettified")
    println("  PASS")

    // ---- 8. redaction on the raw body ----
    println("Test 8: redaction spanning elements still applies (raw body redacted first)")
    SECRET = "<K>top</K><V>secret</V>"
    vcr.clear_redactions()
    rr = vcr.redact(vcr.FIELD_RESPONSE_BODY, SECRET, "<K>x</K>")
    if rr != "" { fail("redact: ${rr}") }
    t8 = record_and_read(OUT, 200, "application/xml", "<R><A><K>top</K><V>secret</V></A></R>", COMPACT_REQ)
    assert_not_contains(t8, "secret", "secret leaked")
    assert_contains(t8, "    <K>x</K>", "redacted value should be indented")
    vcr.clear_redactions()
    println("  PASS")

    // ---- 9. clear_format_options ----
    println("Test 9: clear_format_options turns pretty_xml off")
    vcr.clear_format_options()
    if vcr.vcr_get_pretty_xml() != 0 { fail("getter still on") }
    t9 = record_and_read(OUT, 200, "application/xml", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t9, COMPACT_RESP, "still prettified after clear")
    println("  PASS")

    // ---- 10. width and clamp ----
    println("Test 10: indent width 4; >16 clamps to 16; <0 is off")
    vcr.vcr_set_pretty_xml(4)
    t10 = record_and_read(OUT, 200, "application/xml", COMPACT_RESP, "")
    assert_contains(t10, "\n    <Body>", "width 4 not applied")
    vcr.vcr_set_pretty_xml(99)
    if vcr.vcr_get_pretty_xml() != 16 { fail("99 should clamp to 16") }
    vcr.vcr_set_pretty_xml(-3)
    if vcr.vcr_get_pretty_xml() != 0 { fail("-3 should be off") }
    vcr.clear_format_options()
    println("  PASS")

    println("\n=== All pretty_xml tests passed ===")
    exit(0)
}
