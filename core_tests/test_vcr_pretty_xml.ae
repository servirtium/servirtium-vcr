// Shared record/playback XML contract, including real upstream round trips.
import core.vcr
import std.http
import std.http.client
import std.fs
import std.string
import std.io

extern exit(code: int)

const PORT = 18171

const COMPACT_RESP = "<Envelope><Body><Result id=\"1\"><Name>Ann</Name></Result></Body></Envelope>"
const COMPACT_REQ  = "<Envelope><Body><Submit><Who>Bob</Who></Submit></Body></Envelope>"
const BAD_XML      = "<Envelope><Body><oops></Envelope>"
const REQ_HDRS     = "Content-Type: application/xml"

flush_out_path() -> {
    tmp = io.getenv("TEMP")
    if tmp == 0 { tmp = io.getenv("TMPDIR") }
    if tmp == 0 { tmp = "/tmp" }
    return "${tmp}/vcr_pretty_xml_test.tape"
}

fail(msg: string) {
    println("  FAIL: ${msg}")
    exit(1)
}

assert_contains(h: string, n: string, label: string) {
    if string.contains(h, n) != 1 { fail("${label} — expected '${n}' in:\n${h}") }
}

assert_not_contains(h: string, n: string, label: string) {
    if string.contains(h, n) == 1 { fail("${label} — did not expect '${n}' in:\n${h}") }
}

record_and_read(vh: ptr, path: string, st: int, ctype: string, resp: string, req: string) -> string {
    vcr.clear_recording_h(vh)
    e = vcr.record_full_h(vh, "POST", "/x", st, ctype, resp, REQ_HDRS, req)
    if e != "" { fail("record_full: ${e}") }
    f = vcr.flush_h(vh, path)
    if f != "" { fail("flush: ${f}") }
    t, de = fs.read(path)
    if de != "" { fail("read back: ${de}") }
    return t
}

extern http_server_stop(server: ptr)
const ROUND_REQ = "<CaseData><C> Line one\nLine two \n</C><Captcha>token</Captcha></CaseData>"
const ROUND_RESP = "<Result><C> Line one\nLine two \n</C><Ok>yes</Ok></Result>"
var received_request = ""
xml_upstream(req: ptr, res: ptr, _ud: ptr) {
    received_request = string.copy(http.request_body(req))
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "application/xml")
    http.response_set_body(res, ROUND_RESP)
}
xml_rules(h: ptr) {
    vcr.set_pretty_xml_h(h, 2)
    vcr.strict_ignore_common_headers_h(h)
    vcr.remove_transport_headers_h(h)
}
round_post(port: int, want: string) {
    req = client.request("POST", "http://127.0.0.1:${port}/case")
    err = client.set_body(req, string.bytes(ROUND_REQ), "application/xml")
    if err != "" { fail(err) }
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" { fail(err) }
    if client.response_status(resp) != 200 { fail("roundtrip status ${client.response_status(resp)}") }
    if string.equals(client.response_body(resp), want) == 0 { fail("roundtrip changed response data") }
    len = string.length(want)
    if client.response_header(resp, "Content-Length") != "${len}" { fail("roundtrip length") }
    client.response_free(resp)
}
real_roundtrip() {
    println("Test 11: real upstream, unchanged client bytes, hand indentation, whole-file CRLF")
    upstream = http.server_create(18180)
    http.server_post(upstream, "/*", xml_upstream, null)
    if http.server_start_background(upstream) != "" { fail("upstream start") }
    path = "${flush_out_path()}.roundtrip"
    recorder, err = vcr.open_record(path, "http://127.0.0.1:18180", 18181)
    if err != "" { fail(err) }
    xml_rules(recorder)
    if vcr.start_background_h(recorder, 10000) != 0 { fail("recorder start") }
    round_post(18181, ROUND_RESP)
    if string.equals(received_request, ROUND_REQ) == 0 { fail("upstream request rewritten") }
    err = vcr.stop_and_flush_h(recorder, path)
    if err != "" { fail(err) }
    vcr.destroy_h(recorder)
    http_server_stop(upstream)
    tape, err = fs.read(path)
    if err != "" { fail(err) }
    assert_contains(tape, "  <C> Line one\nLine two \n</C>", "leaf data lost")
    assert_contains(tape, "  <Captcha>token</Captcha>", "request not pretty")
    assert_contains(tape, "  <Ok>yes</Ok>", "response not pretty")
    for variant in 0..3 {
        edited = tape
        want = vcr.xml_canonicalize(ROUND_RESP)
        if variant == 1 {
            edited = vcr.str_replace_all(tape, "\n  <", "\n       <")
            want = vcr.str_replace_all(want, "\n  <", "\n       <")
        }
        if variant == 2 { edited = vcr.str_replace_all(tape, "\n", "\r\n") }
        err = fs.write(path, edited)
        if err != "" { fail(err) }
        playback, err = vcr.open_playback(path, 18182)
        if err != "" { fail(err) }
        xml_rules(playback)
        if vcr.start_background_h(playback, 10000) != 0 { fail("roundtrip playback start") }
        round_post(18182, want)
        if vcr.last_kind_h(playback) != 0 { fail("roundtrip mismatch") }
        vcr.destroy_h(playback)
    }
    println("  PASS real recording + three playback variants")
}

main() {
    println("=== VCR pretty_xml recording option ===\n")
    OUT = flush_out_path()

    // ---- 1. on + match_xml_body: both bodies indented ----
    println("Test 1: pretty_xml(2) indents XML request and response bodies")
    vh = vcr.open_offline()
    vcr.set_pretty_xml_h(vh, 2)
    t1 = record_and_read(vh, OUT, 200, "application/xml", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t1, "\n  <Body>\n", "response body not indented")
    assert_contains(t1, "\n    <Result id=\"1\">", "response nesting not indented")
    assert_contains(t1, "      <Name>Ann</Name>", "response leaf not indented")
    assert_contains(t1, "      <Who>Bob</Who>", "request body not indented")
    assert_contains(t1, "</Envelope>\n```", "no stray trailing blank line")
    assert_not_contains(t1, COMPACT_RESP, "compact response survived")
        println("  PASS")

    // ---- 2. replay the prettified tape ----
    println("Test 2: replay serves the prettified response; the SUT's compact request matches with the single setting")
    raw, raw_oerr = vcr.open_playback(OUT, PORT)
    if raw == null { fail("vcr.load") }
    vcr.set_pretty_xml_h(raw, 2)
    if vcr.start_background_h(raw, 10000) != 0 { println("FAIL: start: ${vcr.last_error_h(raw)}"); exit(1) }

    creq = client.request("POST", "http://127.0.0.1:${PORT}/x")
    client.set_header(creq, "Content-Type", "application/xml")
    berr = client.set_body(creq, string.bytes(COMPACT_REQ), "application/xml")
    if berr != "" { fail("set_body: ${berr}") }
    cresp, cerr = client.send_request(creq)
    client.request_free(creq)
    if cerr != "" { fail("transport: ${cerr}") }
    s2 = client.response_status(cresp)
    b2 = string.copy(client.response_body(cresp))
    cl2 = string.copy(client.response_header(cresp, "Content-Length"))
    client.response_free(cresp)
    if s2 != 200 { fail("status ${s2}, last_error='${vcr.last_error_h(raw)}'") }
    assert_contains(b2, "\n      <Name>Ann</Name>", "replayed body not the prettified form")
    blen = string.length(b2)
    if string.length(cl2) > 0 && string.equals(cl2, "${blen}") != 1 {
        fail("Content-Length ${cl2} != served body length ${blen}")
    }
    vcr.destroy_h(raw)
    println("  PASS: 200, Content-Length '${cl2}' vs ${blen} bytes served")

    // ---- 3. request XML uses the same formatter as the response ----
    println("Test 3: request body indented with a request Content-Type of XML")
    t3 = record_and_read(vh, OUT, 200, "application/xml", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t3, "      <Who>Bob</Who>", "request body not indented")
    assert_not_contains(t3, COMPACT_RESP, "response should still be prettified")
    println("  PASS")

    // ---- 4. option off ----
    println("Test 4: option off is byte-exact")
    vcr.set_pretty_xml_h(vh, 0)
    t4 = record_and_read(vh, OUT, 200, "application/xml", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t4, COMPACT_RESP, "response not byte-exact")
    assert_contains(t4, COMPACT_REQ, "request not byte-exact")
    println("  PASS")

    // ---- 5. malformed XML ----
    println("Test 5: malformed XML recorded byte-exact, recording does not fail")
    vcr.set_pretty_xml_h(vh, 2)
    t5 = record_and_read(vh, OUT, 200, "text/xml", BAD_XML, BAD_XML)
    assert_contains(t5, BAD_XML, "malformed body must be byte-exact")
    println("  PASS")

    // ---- 6. non-XML content type ----
    println("Test 6: non-XML content type untouched")
    t6 = record_and_read(vh, OUT, 200, "application/json", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t6, COMPACT_RESP, "json-typed body must be untouched")
    t6b = record_and_read(vh, OUT, 200, "text/plain", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t6b, COMPACT_RESP, "text/plain body must be untouched")
    println("  PASS")

    // ---- 7. +xml type with parameters ----
    println("Test 7: +xml types and parameters are prettified")
    t7 = record_and_read(vh, OUT, 200, "application/soap+xml; charset=utf-8", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t7, "      <Name>Ann</Name>", "soap+xml not prettified")
    t7b = record_and_read(vh, OUT, 200, "application/atom+xml", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t7b, "      <Name>Ann</Name>", "atom+xml not prettified")
    t7c = record_and_read(vh, OUT, 200, "TEXT/XML; charset=ISO-8859-1", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t7c, "      <Name>Ann</Name>", "TEXT/XML not prettified")
    println("  PASS")

    // ---- 8. redaction on the raw body ----
    println("Test 8: redaction spanning elements still applies (raw body redacted first)")
    SECRET = "<K>top</K><V>secret</V>"
    vcr.clear_redactions_h(vh)
    rr = vcr.redact_h(vh, vcr.FIELD_RESPONSE_BODY, SECRET, "<K>x</K>")
    if rr != "" { fail("redact: ${rr}") }
    t8 = record_and_read(vh, OUT, 200, "application/xml", "<R><A><K>top</K><V>secret</V></A></R>", COMPACT_REQ)
    assert_not_contains(t8, "secret", "secret leaked")
    assert_contains(t8, "    <K>x</K>", "redacted value should be indented")
    vcr.clear_redactions_h(vh)
    println("  PASS")

    // ---- 9. clear_format_options ----
    println("Test 9: clear_format_options turns pretty_xml off")
    vcr.clear_format_options_h(vh)
    if vcr.get_pretty_xml_h(vh) != 0 { fail("getter still on") }
    t9 = record_and_read(vh, OUT, 200, "application/xml", COMPACT_RESP, COMPACT_REQ)
    assert_contains(t9, COMPACT_RESP, "still prettified after clear")
    println("  PASS")

    // ---- 10. width and clamp ----
    println("Test 10: indent width 4; >16 clamps to 16; <0 is off")
    vcr.set_pretty_xml_h(vh, 4)
    t10 = record_and_read(vh, OUT, 200, "application/xml", COMPACT_RESP, "")
    assert_contains(t10, "\n    <Body>", "width 4 not applied")
    vcr.set_pretty_xml_h(vh, 99)
    if vcr.get_pretty_xml_h(vh) != 16 { fail("99 should clamp to 16") }
    vcr.set_pretty_xml_h(vh, -3)
    if vcr.get_pretty_xml_h(vh) != 0 { fail("-3 should be off") }
    vcr.clear_format_options_h(vh)
    println("  PASS")

    real_roundtrip()
    vcr.destroy_h(vh)
    println("\n=== All pretty_xml tests passed ===")
    exit(0)
}
