// Four services/passwords on one upstream port, with JSON/form/XML/YAML bodies.
import core_tests.fixture_support
import std.fs
import std.http
import std.json
import std.os
import std.string
const SERVICES[] = ["accounts", "billing", "shipping", "support"]
const MIMES[] = ["application/json", "application/x-www-form-urlencoded", "application/xml", "application/yaml"]
var directory = ""
var captured = 0
password(i: int) -> string { return "pw-${SERVICES[i]}&secret" }
encoded_password(i: int) -> string { return "pw-${SERVICES[i]}%26secret" }
payload(i: int) -> string {
    p = password(i)
    if i == 0 { return "{ \"password\": \"${p}\", \"nested\": [{\"password\": \"${p}\"}], \"safe\": \"keep\" }" }
    if i == 1 { return "password=${encoded_password(i)}&password=${encoded_password(i)}&safe=keep" }
    if i == 2 { return "<root password=\"pw-shipping&amp;secret\"><password>pw-shipping&amp;secret</password><safe>keep</safe></root>" }
    return "credentials:\n  password: '${p}' # keep this comment\nitems:\n  - password: ${p}\nsafe: keep\n"
}
handle(req: ptr, res: ptr, _data: ptr) {
    i = captured
    fixture_support.check(i < SERVICES.len, "unexpected upstream request")
    fixture_support.check(http.request_body(req) == payload(i), "forwarded ${SERVICES[i]} body")
    fixture_support.check(fixture_support.full_path(req) == "/${SERVICES[i]}/login?password=${encoded_password(i)}&safe=keep", "forwarded ${SERVICES[i]} query")
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", MIMES[i])
    http.response_set_body(res, payload(i))
    captured += 1
    if captured == SERVICES.len { fixture_support.check(fs.write("${directory}/done", "received") == "", "publish received requests") }
}
serve(dir: string) {
    directory = dir
    server = fixture_support.listen_upstream(handle)
    fixture_support.check(fs.write_atomic("${dir}/url", string.bytes("http://127.0.0.1:${http.server_port(server)}")) == "", "publish upstream URL")
    deadline = os.now_monotonic_ms() + 45000
    while fs.exists("${dir}/done") == 0 && os.now_monotonic_ms() < deadline { fixture_support.poll_pause() }
    http.server_stop(server)
    fixture_support.check(captured == SERVICES.len, "upstream timed out")
    fixture_support.check(fs.write("${dir}/done", "done") == "", "publish completion")
}
drive(base: string) {
    for i in 0..SERVICES.len {
        status, body = fixture_support.post_request(base, "/${SERVICES[i]}/login?password=${encoded_password(i)}&safe=keep", payload(i), MIMES[i], null)
        fixture_support.check(status == 200 && body == payload(i), "${SERVICES[i]} response")
    }
}
check_tape(file: string) {
    tape = fs.read(file)!
    for i in 0..SERVICES.len {
        name = "${string.to_upper(SERVICES[i])}_PASSWORD"
        fixture_support.check(string.contains(tape, name) == 1, "missing ${name}")
        fixture_support.check(string.contains(tape, password(i)) == 0 && string.contains(tape, encoded_password(i)) == 0, "password leaked into tape")
    }
    fixture_support.check(string.contains(tape, "keep this comment") == 1 && string.contains(tape, "\"safe\": \"keep\"") == 1, "unrelated layout changed")
    fixture_support.check(string.contains(tape, "%7B%7Bsecret%3A") == 1, "missing encoded markers")
}
main() {
    action = os.args_get(1); location = os.args_get(2)
    if action == "serve" { serve(location) }
    else if action == "start" { println(fixture_support.launch(location)) }
    else if action == "drive" { drive(location) }
    else if action == "check" { check_tape(location) }
    else { fixture_support.check(false, "expected start, drive or check") }
}
