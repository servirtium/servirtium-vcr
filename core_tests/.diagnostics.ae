// C ABI black-box contract: load and call the built library through std.dl.
import bldr
import aether
import aether (source, lib, caps)
import bldr (env)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        root = _get("root")
        library = dep_artifact("core/.build.ae", "shared_lib")
        aether.program_test() {
            source("diagnostics_tests.ae"); lib(".."); caps("fs,net,os,extern")
            env("SVCR_TEST_ROOT", root)
            env("SERVIRTIUM_VCR_LIB", library)
        }
    }
}
