// Aether-level libservirtium_vcr tests: the test_vcr_*.ae suite (vendored from the Aether
// stdlib) compiled against libservirtium_vcr (core/vcr.ae, pure Aether),
// not the .so the bindings use. run-tests.sh builds + runs each as a binary.
import bldr
import std.os
aeb(cap) {
    bldr.build() {
        root = _get("root")
        rc = os.system("cd \"${root}/core_tests\" && ./run-tests.sh")
        if rc != 0 { println("core_tests: libservirtium_vcr tests failed"); return 1 }
        println("core_tests: libservirtium_vcr tests passed")
        return 0
    }
}
