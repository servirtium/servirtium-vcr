// Volatile values, the pure parts (core/volatile.ae): rules (templates and
// regex), placeholders and inline patterns in each marker style, scopes, the
// block grammar, conflicts, tokens and the escape, what a placeholder
// captures (the trailing-literal trap, end of line), and the regex limits.
// docs/volatile-values.md.
import core.volatile
import std.string
import std.list
import std.time

extern exit(code: int)

const M = 0
const D = 1
const W = 2

check(ok: int, what: string) {
    if ok != 1 { println("FAIL: ${what}"); exit(1) }
}
eq(got: string, want: string, what: string) {
    if got != want {
        println("FAIL: ${what}\n  got:  [${got}]\n  want: [${want}]")
        exit(1)
    }
}
add(scope: string, kind: string, pattern: string, style: int) -> (ptr, string) {
    l = list_new()
    err = volatile.add_rule(l, scope, kind, pattern, style, "")
    return l, err
}
refused(scope: string, kind: string, pattern: string, style: int, part: string) {
    _l, err = add(scope, kind, pattern, style)
    if string.contains(err, part) != 1 { println("FAIL: `${pattern}` should be refused with [${part}], got [${err}]"); exit(1) }
}
// What the rule's placeholders capture in `text` (scope bit `bit`): "name=value|…".
caught(scope: string, kind: string, pattern: string, style: int, bit: int, text: string) -> string {
    l, err = add(scope, kind, pattern, style)
    if err != "" { println("FAIL: rule `${pattern}`: ${err}"); exit(1) }
    res = volatile.find_spans(l, bit, text)
    out = ""
    i = 0
    while i < volatile.span_count(res) {
        if i > 0 { out = string_concat(out, "|") }
        out = string_concat(out, "${volatile.span_name(res, i)}=${string.substring(text, volatile.span_start(res, i), volatile.span_end(res, i))}")
        i = i + 1
    }
    return out
}
dollar() -> string { return string.from_char(36) }

main() {
    RB = volatile.SCOPE_REQUEST_BODY
    RH = volatile.SCOPE_RESPONSE_HEADERS

    // ---- templates capture ----
    eq(caught("request body", "template", "<a:MessageID>urn:uuid:{{messageId}}</a:MessageID>", M, RB,
        "<x><a:MessageID>urn:uuid:5f1d0c6e-2a8b-4c3e-9d41-7b6a0f2e8c13</a:MessageID></x>"),
        "messageId=5f1d0c6e-2a8b-4c3e-9d41-7b6a0f2e8c13", "a template captures between its literals")
    eq(caught("request path", "template", "/cases/{{caseId}}/documents", M, volatile.SCOPE_PATH, "/cases/42/documents?x=1"), "caseId=42", "path")
    eq(caught("request body", "template", "a {{x}} b", M, RB, "a 1 b, a 2 b\na 3 b"), "x=1|x=2|x=3", "every match, one line each")
    eq(caught("request body", "template", "a {{x}} b", M, RB, "a 1\n2 b"), "", "a placeholder never spans lines")
    eq(caught("request body", "template", "[{{x}}](.*+?)", M, RB, "[v](.*+?)"), "x=v", "literal metacharacters are quoted")
    eq(caught("body", "template", "id={{id}};", M, volatile.SCOPE_RESPONSE_BODY, "id=7;"), "id=7", "body covers the response body")
    eq(caught("response body", "template", "id={{id}};", M, RB, "id=7;"), "", "and response body does not cover the request's")
    // The trap: the literal after a placeholder occurs inside the value.
    to = "<a:To s:mustUnderstand=\"1\">https://workpro--not-real.invalid:53187/Services/CaseService.svc</a:To>"
    eq(caught("request body", "template", "<a:To s:mustUnderstand=\"1\">{{endpoint}}/", M, RB, to), "endpoint=https:", "the trap: / follows the scheme")
    eq(caught("request body", "template", "<a:To s:mustUnderstand=\"1\">{{endpoint}}/Services/", M, RB, to), "endpoint=https://workpro--not-real.invalid:53187", "the fix: more context")
    eq(caught("request body", "regex", "<a:To[^>]*>(?<endpoint>https?://[^/]+)/", M, RB, to), "endpoint=https://workpro--not-real.invalid:53187", "or a regex rule")
    // End of template: to the end of the line, trailing blanks excluded.
    hdrs = "Content-Type: text/plain\nDate: Fri, 13 Nov 2026 09:41:07 GMT  \t\nX-Other: 1\n"
    eq(caught("response headers", "template", "Date: {{serverDate}}", M, RH, hdrs), "serverDate=Fri, 13 Nov 2026 09:41:07 GMT", "a final placeholder takes the header value")
    eq(caught("response body", "template", "last: {{v}}", M, volatile.SCOPE_RESPONSE_BODY, "first\nlast: the end"), "v=the end", "body hole at end of file, no newline")
    eq(caught("response body", "template", "v={{v}}", M, volatile.SCOPE_RESPONSE_BODY, "v=a b c\r\nw"), "v=a b c", "spaces inside, stops at CRLF")

    // ---- inline patterns ----
    dob = "<a:DOB>{{dob:\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])}}</a:DOB>"
    eq(caught("request body", "template", dob, M, RB, "<a:DOB>1999-12-31</a:DOB><a:DOB>1999-13-01</a:DOB>"), "dob=1999-12-31", "inline pattern: braces, brackets and groups")
    eq(caught("request body", "template", "<n>${dollar()}{n:\\d{4}}</n>", D, RB, "<n>2026</n>"), "n=2026", "\\d{4} under DollarCurly")
    eq(caught("request body", "template", "<n>[[n:[12]\\d]]</n>", W, RB, "<n>17</n><n>37</n>"), "n=17", "[12] under Wikilink")
    eq(caught("request body", "template", "<n>{{n:\\{[a-z]+\\}}}</n>", M, RB, "<n>{ab}</n>"), "n={ab}", "escaped braces do not count")
    refused("request body", "template", "<n>{{n:^\\d+}}</n>", M, "holds an anchor")
    refused("request body", "template", "<n>{{n:\\d+$}}</n>", M, "holds an anchor")
    eq(caught("request body", "template", "<n>{{n:[^<$]+}}</n>", M, RB, "<n>ok</n>"), "n=ok", "^ and $ inside a class are not anchors")
    refused("request body", "template", "<n>{{n:(?<inner>\\d+)}}</n>", M, "named group inside a placeholder")
    refused("request body", "template", "<n>{{n:\\d{4}</n>", M, "no closing")
    refused("request body", "template", "<n>{{n:(}}</n>", M, "invalid pattern")

    // ---- template errors ----
    refused("request body", "template", "no placeholder", M, "needs at least one placeholder")
    refused("request body", "template", "{{a}}{{b}}", M, "literal text between them")
    refused("request body", "template", "{{a}} and {{a}}", M, "appears twice")
    refused("request body", "template", "x {{9a}} y", M, "needs a name")
    refused("request body", "template", "x {{a b}} y", M, "a name is letters")
    refused("request body", "template", "x {{}} y", M, "needs a name")
    refused("requests body", "template", "x {{a}}", M, "expected request path")
    refused("request body", "glob", "x {{a}}", M, "expected template or regex")

    // ---- regex rules ----
    eq(caught("request body", "regex", "(\\w+)=(?<v>\\d+)&(?P<w>\\d+)", M, RB, "a=1&2 b=3&4"), "v=1|w=2|v=3|w=4", "named groups (both syntaxes); unnamed produce nothing")
    refused("request body", "regex", "(\\d+)", M, "needs a named group")
    refused("request body", "regex", "(?<a-b>x)", M, "invalid regex")
    refused("request body", "regex", "(?|(?<a>x)|(?<a>y))", M, "branch reset")
    refused("request body", "regex", "(", M, "invalid regex")

    // ---- lines, keys, conflicts ----
    l1, e1 = add("request body", "template", "<a:MessageID>urn:uuid:{{messageId}}</a:MessageID>", M)
    eq(e1, "", "add")
    eq(volatile.rule_line(l1, 0), "request body: `<a:MessageID>urn:uuid:{{messageId}}</a:MessageID>`", "canonical line")
    eq(volatile.add_rule(l1, "request body", "template", "<a:MessageID>urn:uuid:{{messageId}}</a:MessageID>", M, " (tape)"), "", "the same rule twice is one")
    check(volatile.rule_count(l1) == 1, "deduplicated")
    ce = volatile.add_rule(l1, "request body", "template", "<a:MessageID>urn:uuid:{{msgId}}</a:MessageID>", M, " (code)")
    eq(ce, "volatile rule `request body: `<a:MessageID>urn:uuid:{{msgId}}</a:MessageID>`` (code) conflicts with `request body: `<a:MessageID>urn:uuid:{{messageId}}</a:MessageID>``: the same text, other placeholder names", "conflict names both")
    eq(volatile.add_rule(l1, "response body", "template", "<a:RelatesTo>urn:uuid:{{messageId}}</a:RelatesTo>", M, ""), "", "another rule, the same name")
    lb, _eb = add("body", "regex", "a`b(?<x>c)", M)
    eq(volatile.rule_line(lb, 0), "body regex: ``a`b(?<x>c)``", "a backtick in a pattern")

    // ---- blocks ----
    blk = "## Volatile values\n\n- response headers: `Date: {{serverDate}}`\n- request body regex: `<a:To[^>]*>(?<endpoint>https?://[^/]+)/`\n\n"
    lp = list_new()
    eq(volatile.parse_block(blk, lp, M, " (tape)"), "", "parse a block")
    eq(volatile.render_block(lp), "## Volatile values\n\n- request body regex: `<a:To[^>]*>(?<endpoint>https?://[^/]+)/`\n- response headers: `Date: {{serverDate}}`\n\n", "rendered sorted")
    lr = list_new()
    eq(volatile.parse_block(volatile.render_block(lp), lr, M, ""), "", "round trip")
    bad = list_new()
    be = volatile.parse_block("## Volatile values\n\nresponse headers: `Date: {{d}}`\n", bad, M, "")
    check(string.contains(be, "line 3") == 1 && string.contains(be, "starts with") == 1, "a line without \"- \": ${be}")
    be2 = volatile.parse_block("## Volatile values\n\n- response headers: `Date: {{d}}` x\n", bad, M, "")
    check(string.contains(be2, "text after the pattern") == 1, "trailing text: ${be2}")
    be3 = volatile.parse_block("## Volatile values (v2)\n", bad, M, "")
    check(string.contains(be3, "unknown grammar version") == 1, "v2: ${be3}")
    eq(volatile.parse_block("## Volatile values (v1)\n\n- headers: `X-Id: {{id}}`\n", bad, M, ""), "", "(v1)")
    eq(volatile.block_in("LICENSE\n\n## Volatile values\n\n- a\n\n## Interaction 0: GET /\n"), "## Volatile values\n\n- a\n\n", "block_in")
    check(volatile.profile_style("Markers: DollarCurly\nx") == D, "profile style")
    check(volatile.profile_style("## Volatile values\n") < 0, "no style line")
    lo = list_new()
    volatile.parse_block("## Volatile values\n\n- request body: `<a>{{sent}}</a>`\n- response body: `<b>{{sent}}</b>`\n- response headers: `Date: {{serverDate}}`\n", lo, M, "")
    eq(volatile.response_only_names(lo), "serverDate", "names no request rule has")

    // ---- tokens and the escape, per style ----
    eq(volatile.token_text("messageId", 3, M), "{{messageId-3}}", "mustache token")
    eq(volatile.token_text("messageId", 3, D), "${dollar()}{messageId-3}", "dollar-curly token")
    eq(volatile.token_text("messageId", 3, W), "[[messageId-3]]", "wikilink token")
    t = "x{{case_id-12}}y"
    check(volatile.token_end(t, 1, M) == 15, "token end")
    eq(volatile.token_name(t, 1, M), "case_id", "token name")
    check(volatile.token_number(t, 1, M) == 12, "token number")
    check(volatile.token_end("{{a-0}}", 0, M) < 0, "no token 0")
    check(volatile.token_end("{{a-01}}", 0, M) < 0, "no leading zero")
    check(volatile.token_end("{{request.host}}", 0, M) < 0, "placeholders of substitution are not tokens")
    check(volatile.token_end("{{a-b-1}}", 0, M) < 0, "a name has no hyphen")
    check(volatile.token_end("${dollar()}{a-1}", 0, M) < 0, "a dollar-curly token is not a mustache one")
    eq(volatile.escape("say {{messageId-1}} now", M), "say {{{{}}messageId-1}} now", "escape a token-shaped literal")
    eq(volatile.escape("{{request.host}} {{x}}", M), "{{request.host}} {{x}}", "placeholders untouched")
    eq(volatile.escape("say [[a-1]]", W), "say [[[[]]a-1]]", "wikilink escape")
    eq(volatile.escape("say ${dollar()}{a-1}", D), "say ${dollar()}{${dollar()}{}a-1}", "dollar-curly escape")
    styles = [M, D, W]
    raw = ["say {{a-1}} [[a-1]] ${dollar()}{a-1} now", "{{{{}}", "[[[[]]", "${dollar()}{${dollar()}{}", "{{{a-1}}", "plain", "{{"]
    si = 0
    while si < 3 {
        i = 0
        while i < raw.len {
            eq(volatile.unescape(volatile.escape(raw[i], styles[si]), styles[si]), raw[i], "escape round trip (style ${si}): ${raw[i]}")
            i = i + 1
        }
        si = si + 1
    }
    check(volatile.tokens_in_style("a {{x-1}} [[x-2]] [[y-1]]", W, "|x|") == 1, "tokens of known names, one style")

    // ---- the regex limit bounds a pathological pattern ----
    big = string.copy("a")
    while string.length(big) < 65536 { big = string_concat(big, big) }
    big = string_concat(big, "!")
    lx, ex = add("response body", "regex", "(?<x>(a+)+)$", M)
    eq(ex, "", "pathological rule accepted")
    t0 = time.now_ms()
    res = volatile.find_spans(lx, volatile.SCOPE_RESPONSE_BODY, big)
    took = time.now_ms() - t0
    check(took < 5000, "bounded: ${took} ms")
    check(string.contains(volatile.span_warnings(res), "match limit") == 1, "reported: ${volatile.span_warnings(res)}")
    lt, _et = add("response body", "template", "<n>{{n:(a+)+}}!</n>", M)
    t1 = time.now_ms()
    _r2 = volatile.find_spans(lt, volatile.SCOPE_RESPONSE_BODY, string_concat("<n>", big))
    check(time.now_ms() - t1 < 5000, "inline patterns are bounded too")
    println("  ok: (a+)+$ on 64 KiB stopped by the match limit in ${took} ms")

    println("volatile grammar: all checks passed")
    exit(0)
}
