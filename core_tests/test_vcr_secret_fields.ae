import core.secret_fields
import std.string
extern exit(code: int)
check(ok: int, label: string) { if ok == 0 { println("FAIL: ${label}"); exit(1) } }
main() {
    fields, err = secret_fields.scan("{\"credentials\":{\"password\":\"shh\"},\"items\":[{\"password\":123}]}", "json")
    check(err == "", err); check(secret_fields.count(fields) == 2, "JSON nested leaves")
    check(secret_fields.path_at(fields, 0) == "/credentials/password", "JSON path")
    check(secret_fields.path_at(fields, 1) == "/items/0/password", "array path")
    fields, err = secret_fields.scan("<root password='a&amp;b'><password> shh </password><x><![CDATA[value]]></x></root>", "xml")
    check(err == "", err); check(secret_fields.count(fields) == 3, "XML fields")
    check(secret_fields.value_at(fields, 0) == "a&b", "XML entities")
    check(secret_fields.key_at(fields, 1) == "password", "XML key")
    check(secret_fields.style_at(fields, 2) == 13, "CDATA")
    fields, err = secret_fields.scan("credentials:\n  password: 'shh' # keep\nitems:\n  - password: hello\n    safe: yes\n  - password: world\n", "yaml")
    check(err == "", err); check(secret_fields.count(fields) == 4, "YAML leaves")
    check(secret_fields.path_at(fields, 0) == "/credentials/password", "YAML path")
    check(secret_fields.path_at(fields, 1) == "/items/0/password", "YAML list mapping")
    check(secret_fields.path_at(fields, 3) == "/items/1/password", "YAML list next item")
    fields, err = secret_fields.scan("{password: 'shh', inner: {password: value}, array: [one, two]}", "yaml")
    check(err == "", err); check(secret_fields.count(fields) == 4, "flow YAML")
    fields, err = secret_fields.scan("password: |-\n  first\n  second\nsafe: yes\n", "yaml")
    check(err == "", err); check(secret_fields.count(fields) == 2, "YAML block scalar")
    check(secret_fields.style_at(fields, 0) == 11, "YAML block style")
    fields, err = secret_fields.scan("password: &shared shh\nother: *shared\n", "yaml")
    check(err != "", "YAML aliases fail explicitly")
    fields, err = secret_fields.scan("/login?pass%77ord=a%26b&password=second&safe=keep", "query")
    check(err == "", err); check(secret_fields.count(fields) == 3, "query repeated keys")
    check(secret_fields.key_at(fields, 0) == "password", "query key decoding")
    check(secret_fields.value_at(fields, 0) == "a&b", "query value decoding")
    fields, err = secret_fields.scan("--X\r\nContent-Disposition: form-data; name=\"password\"\r\n\r\nsecret\r\n--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"upload.txt\"\r\n\r\nbinary\r\n--X--\r\n", "multipart:X")
    check(err == "", err); check(secret_fields.count(fields) == 1, "multipart text fields only")
    check(secret_fields.key_at(fields, 0) == "password", "multipart key")
    value, err = secret_fields.render("a&\"<b", 6, 0, "")
    check(err == "" && value == "a&amp;&quot;&lt;b", "XML attribute escaping")
    value, err = secret_fields.render("line\nquote\"", 3, 0, "")
    check(err == "" && value == "\"line\\nquote\\\"\"", "JSON escaping")
    value, err = secret_fields.render("\"string\"", 4, 0, "")
    check(err != "", "JSON primitive must remain primitive")
    value, err = secret_fields.render("unsafe\nheader", 2, 0, "")
    check(err != "", "header injection rejected")
    value, err = secret_fields.render("a: b", 10, 0, "")
    check(err != "", "unsafe YAML plain replacement rejected")
    fields, err = secret_fields.scan("opaque {{secret:OPAQUE|12}} value", "opaque")
    check(err == "" && secret_fields.count(fields) == 1, "explicit opaque marker")
    println("secret field extraction: passed")
}
