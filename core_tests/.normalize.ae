// Whole-tape normalization test: record the same two interactions twice with
// different server-minted uuids/dates and assert the flushed tapes are
// byte-identical, with the correlated id collapsed to one {{id-1}} token
// across response body and later request path. This is the acceptance gate
// for vcr.normalize_whole_tape — the thing that lets record leaves leave the
// tree clean (drift detection then fires only on REAL upstream changes).
//
// aether.program builds the probe (lib("..") resolves `import core.vcr`);
// the run stays imperative (cwd = root for the probe's relative paths).
//
// Its own leaf (not the test_vcr_* run-tests.sh loop) so it can be run alone:
//   aeb core_tests/.normalize.ae
import bldr
import aether
import aether (source, output, lib)
import std.os
aeb(cap) {
    bldr.build() {
        aether.program() {
            source("normalize_probe.ae")
            output("normalize_probe")
            lib("..")
        }
        root = _get("root")
        td = _get("target_dir")
        result = os.system("cd \"${root}\" && \"${td}/bin/normalize_probe\"")
        if result != 0 { println("core_tests/normalize: failed"); return 1 }
        println("core_tests/normalize: passed")
        return 0
    }
}
