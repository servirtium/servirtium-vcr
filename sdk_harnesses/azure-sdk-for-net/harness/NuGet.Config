<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore from nuget.org. The SDK repository's own NuGet.Config names only
  the Azure SDK team's Azure DevOps feed, which answers anonymous callers
  only for packages it has already cached from nuget.org (401 otherwise).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
