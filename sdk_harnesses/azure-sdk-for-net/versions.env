# Pins for the azure-sdk-for-net harness. Sourced by fetch.sh, env.sh and
# the aeb leaves; recorded in every tape's licence notice.

# Azure/azure-sdk-for-net (MIT). main as of 2026-11-11.
AZSDK_REPO=https://github.com/Azure/azure-sdk-for-net.git
AZSDK_COMMIT=5084eb7e2bdcafe0aa70308b114e336096553c74

# Azurite (MIT), Microsoft's Azure Storage emulator, started by
# testcontainers-dotnet's Azurite module in record mode.
AZURITE_IMAGE=mcr.microsoft.com/azure-storage/azurite:3.37.0

# testcontainers-dotnet (MIT): its Azurite module starts the container.
TESTCONTAINERS_AZURITE_VERSION=4.16.0
