// Third-party-consumer PACKAGE stage for the Pharo binding.
// A Pharo consumer loads the Servirtium package into their image via a
// Metacello baseline and pins the engine explicitly with
// `ServirtiumLibrary libPath: anAbsolutePath` (the binding's first-class
// native-lib override). This stages the freshly-built engine .so into
// pharo/native/ so there is a bundled path to point at. Deps core/.build.ae;
// publishes the pharo package dir.
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    lib = build.dep_artifact(b, "core/.build.ae", "shared_lib")
    root = build._get(b, "root")
    phdir = "${root}/pharo"

    rc = os.system("mkdir -p \"${phdir}/native\" && cp \"${lib}\" \"${phdir}/native/libservirtium_vcr.so\"")
    if rc != 0 {
        println("pharo package: failed to stage engine .so into pharo/native/")
        return 1
    }
    build.publish_artifact(b, "package_dir", "${phdir}")
    println("pharo package: staged engine .so into pharo/native/ (Pharo package ready)")
    return 0
}
