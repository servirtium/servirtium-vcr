// JavaScript/TS binding tests (koffi). Loads the shared engine via
// SERVIRTIUM_VCR_LIB; jest --runInBand for the one-server-per-process rule.
import build
import std.os
main() {
    b = build.start()
    build.dep(b, "engine/.build.ae")
    root = build._get(b, "root")
    lib = "${root}/engine/native/libservirtium_vcr.so"
    rc = os.system("cd \"${root}/javascript\" && npm install --silent --no-audit --no-fund && SERVIRTIUM_VCR_LIB=\"${lib}\" npx jest --runInBand")
    if rc != 0 { println("javascript: tests failed"); return 1 }
    println("javascript: tests passed")
    return 0
}
