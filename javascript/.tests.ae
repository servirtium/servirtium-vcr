// JavaScript/TS binding tests (koffi). Loads the shared engine via
// SERVIRTIUM_VCR_LIB; jest --runInBand for the one-server-per-process rule.
import bldr
import javascript
import bldr (env)
import javascript (npm_install, jest)
aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        javascript.test() {
            env("SERVIRTIUM_VCR_LIB", lib)
            npm_install("--silent --no-audit --no-fund")
            jest("--runInBand")
        }
    }
}
