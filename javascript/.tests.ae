// JavaScript/TS binding tests (koffi). Loads the shared engine via
// SERVIRTIUM_VCR_LIB; jest --runInBand for the one-server-per-process rule.
import build
import javascript
import build (env, step)
aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    lib = build.dep_artifact(b, "core/.build.ae", "shared_lib")
    javascript.test(b) {
        env("SERVIRTIUM_VCR_LIB", lib)
        step("npm install --silent --no-audit --no-fund")
        step("npx jest --runInBand")
    }
}
