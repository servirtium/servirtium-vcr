<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shippable F# library: idiomatic F# over the ONE C# P/Invoke binding
       (dotnet/Servirtium.Vcr) — no second FFI, no second .so. The engine .so
       travels in the Servirtium.Vcr package, which this one depends on, so
       `dotnet pack` here produces a small managed-only nupkg. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Servirtium.Vcr.FSharp</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Servirtium.Vcr.FSharp</PackageId>
    <Version>2.0.0</Version>
    <Authors>Paul Hammant</Authors>
    <Description>Idiomatic F# record/replay (Servirtium markdown tapes) over the Aether VCR core — loan-pattern combinators and curry-friendly members over the Servirtium.Vcr .NET binding.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Servirtium.fs" />
  </ItemGroup>

  <!-- The generated csproj is produced by dotnet/Servirtium.Vcr/.build.ae (the
       .ae leaf is the source of truth; the .csproj is git-ignored), so this
       reference resolves only after that dep has run — which the .ae leaves
       declare. On pack it becomes a NuGet dependency on Servirtium.Vcr. -->
  <ItemGroup>
    <ProjectReference Include="../../dotnet/Servirtium.Vcr/.Servirtium.Vcr.generated.csproj" />
  </ItemGroup>

</Project>
