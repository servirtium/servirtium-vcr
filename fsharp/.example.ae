// Third-party-consumer EXAMPLE test for the F# binding.
//
// Builds a standalone consumer project that PackageReferences
// Servirtium.Vcr.FSharp and restores it from a local NuGet feed holding the
// two nupkgs fsharp/.package.ae produced — no ProjectReference to this repo —
// then runs it with SERVIRTIUM_VCR_LIB UNSET.
//
// Two things this proves that fsharp/.tests.ae cannot. First, the F# nupkg's
// dependency on Servirtium.Vcr actually resolves: F# ships managed-only
// because the CLR family rides ONE native assembly, so if that dependency were
// wrong the consumer would restore an F# layer with no engine underneath it.
// Second, the engine .so reaches the consumer purely as the Servirtium.Vcr
// package's per-RID native payload, extracted by the C# NativeLoader.
//
// The package cache entries are cleared first: a stale
// ~/.nuget/packages/servirtium.vcr* from an earlier run would let a BROKEN
// feed appear to work.
import bldr
import std.os
aeb(cap) {
    bldr.build() {
        dep("fsharp/.package.ae")
        feed = dep_artifact("fsharp/.package.ae", "nupkg_dir")
        root = _get("root")
        exdir = "${root}/fsharp/example"
        consumer = "${root}/target/fsharp-consumer"

        rc = os.system("rm -rf \"${consumer}\" \"$HOME/.nuget/packages/servirtium.vcr\" \"$HOME/.nuget/packages/servirtium.vcr.fsharp\" && mkdir -p \"${consumer}/tapes\" && cp \"${exdir}/Program.fs\" \"${consumer}/\" && cp \"${exdir}/ServirtiumConsumerExample.fsproj\" \"${consumer}/\" && cp \"${exdir}/tapes/single_get.md\" \"${consumer}/tapes/\" && cd \"${consumer}\" && dotnet new nugetconfig >/dev/null && dotnet nuget add source \"${feed}\" --name servirtium-local >/dev/null")
        if rc != 0 {
            println("fsharp example: staging the consumer + local feed failed")
            return 1
        }

        rc2 = os.system("cd \"${consumer}\" && env -u SERVIRTIUM_VCR_LIB dotnet run -v quiet --nologo")
        if rc2 != 0 {
            println("fsharp example: consumer `dotnet run` against the installed packages failed")
            return 1
        }
        println("fsharp example: PASS — consumer replayed the canonical tape (discovery; local NuGet feed, engine .so from the Servirtium.Vcr package)")
        return 0
    }
}
