<Project Sdk="Microsoft.NET.Sdk">

  <!-- A standalone consumer: it references the PACKAGES, never this repo's
       projects. fsharp/.example.ae points it at a local feed holding the two
       nupkgs that fsharp/.package.ae produced. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Servirtium.Vcr.FSharp" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="tapes/single_get.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
