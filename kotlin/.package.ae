// Third-party-consumer PACKAGE stage for the Kotlin binding.
//
// `mvn install`s the Kotlin DSL layer (com.paulhammant.servirtium:
// servirtium-vcr-kotlin) to ~/.m2. It depends on the Java jar
// (servirtium-vcr, which bundles the engine .so as a resource), so we dep
// java/.package.ae to get that into ~/.m2 first. A Kotlin consumer then
// resolves servirtium-vcr-kotlin and the .so rides along transitively.
import bldr
import maven

aeb(cap) {
    bldr.build() {
        dep("java/.package.ae")

        // maven.install runs `mvn -q -DskipTests install` in this leaf's
        // module_dir (kotlin/) — no ${root}/kotlin hardcode.
        maven.install()

        publish_artifact("maven_gav", "com.paulhammant.servirtium:servirtium-vcr-kotlin:2.0.0-SNAPSHOT")
        println("kotlin package: installed servirtium-vcr-kotlin jar to ~/.m2")
        return 0
    }
}
