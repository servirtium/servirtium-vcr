// Kotlin binding — aeb-native. Compiles src/main/kotlin against the Java
// binding's classes (bldr.dep java/.build.ae); kotlinc supplies kotlin-stdlib.
import bldr
import kotlin
import kotlin (source_layout)
aeb(cap) {
    bldr.build() {
        dep("java/.build.ae")
        kotlin.kotlinc() { source_layout("maven idiomatic") }
    }
}
