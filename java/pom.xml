<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.paulhammant.servirtium</groupId>
    <artifactId>servirtium-vcr</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Servirtium VCR (Java)</name>
    <description>Record/replay for HTTP service tests in the Servirtium markdown tape format.
        A thin Java FFM (java.lang.foreign / Project Panama) wrapper over the Aether VCR core.
    </description>

    <url>http://github.com/paul-hammant/servirtium</url>
    <licenses>
        <license>
            <name>Two clause BSD license</name>
            <url>https://github.com/paul-hammant/servirtium/blob/master/LICENSE.txt</url>
        </license>
    </licenses>
    <scm>
        <connection>scm:git:git@github.com:paul-hammant/servirtium.git</connection>
        <developerConnection>scm:git:git@github.com:paul-hammant/servirtium.git</developerConnection>
        <url>git@github.com:paul-hammant/servirtium.git</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- FFM (java.lang.foreign) is final since JDK 22; compile to 22 bytecode
             so the JVM-family bindings (Kotlin/Scala/Groovy/Clojure) can consume
             this jar. Still runs/tests on JDK 25. -->
        <maven.compiler.release>22</maven.compiler.release>
        <junit.version>6.0.3</junit.version>
        <selenium.version>4.39.0</selenium.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Drives real headless Chrome for the TodoBackend browser integration
             test (Selenium 4.x's Selenium Manager auto-fetches the matching
             chromedriver). Test scope: only the integration test needs it. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <!-- JDK 25's java.lang.foreign is stable but still prints a
                         native-access warning unless the module is granted access.
                         Granting it keeps test output clean. Consumers running
                         servirtium-vcr in their own tests need the same flag. -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <!-- v1 VCR state is process-global: ONE active server per
                         process. JUnit 5 runs sequentially by default; do NOT
                         enable parallel execution. forkCount=1 keeps it in one JVM. -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
