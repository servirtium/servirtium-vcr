// Java binding tests (FFM/Panama) — aeb-native (no Maven). Compiles
// src/test/java with javac against the main classes (bldr.dep java/.build.ae)
// + the vendored test-dep closure (bldr.dep libs/java/selenium, generated by
// tools/mvn-to-aeb), then runs JUnit 5 with --enable-native-access and the
// engine .so via SERVIRTIUM_VCR_LIB.
import bldr
import java
import java (source_layout, jvm_args, release)
import bldr (env)
aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        dep("java/.build.ae")
        dep("libs/java/selenium/.selenium.jar.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        java.javac_test() { source_layout("maven idiomatic") release("22") }
        java.junit5() {
            jvm_args("--enable-native-access=ALL-UNNAMED")
            env("SERVIRTIUM_VCR_LIB", lib)
        }
    }
}
