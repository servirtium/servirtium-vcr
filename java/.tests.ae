// Java binding tests (FFM/Panama) — aeb-native (no Maven). Compiles
// src/test/java with javac against the main classes (build.dep java/.build.ae)
// + the vendored test-dep closure (build.dep libs/java/selenium, generated by
// tools/mvn-to-aeb), then runs JUnit 5 with --enable-native-access and the
// engine .so via SERVIRTIUM_VCR_LIB.
import build
import java
import java (source_layout, jvm_args, release)
import build (env)
aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    build.dep(b, "java/.build.ae")
    build.dep(b, "libs/java/selenium/.selenium.jar.ae")
    lib = build.dep_artifact(b, "core/.build.ae", "shared_lib")
    java.javac_test(b) { source_layout("maven idiomatic") release("22") }
    java.junit5(b) {
        jvm_args("--enable-native-access=ALL-UNNAMED")
        env("SERVIRTIUM_VCR_LIB", lib)
    }
}
