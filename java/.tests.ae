// Java binding tests (FFM/Panama). Loads the shared engine via
// SERVIRTIUM_VCR_LIB; needs JDK 25 + --enable-native-access (pom argLine).
import build
import std.os
import std.string
aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    root = build._get(b, "root")
    lib = "${root}/core/native/libservirtium_vcr.so"
    jdk = os.getenv("JAVA25_HOME")
    if string.length(jdk) == 0 { jdk = "/usr/lib/jvm/java-25-openjdk-amd64" }
    rc = os.system("cd \"${root}/java\" && SERVIRTIUM_VCR_LIB=\"${lib}\" JAVA_HOME=\"${jdk}\" mvn -q test")
    if rc != 0 { println("java: tests failed"); return 1 }
    println("java: tests passed")
    return 0
}
