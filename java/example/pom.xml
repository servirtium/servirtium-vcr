<?xml version="1.0" encoding="UTF-8"?>
<!--
  Third-party consumer example for the Java binding.

  A standalone Maven project that depends on the INSTALLED servirtium-vcr jar
  (com.paulhammant.servirtium:servirtium-vcr, resolved from the local ~/.m2 repo
  that `mvn install` populated) and replays the canonical tape from that jar —
  the engine .so is discovered from the jar's own /native/<rid>/ resource, with
  no SERVIRTIUM_VCR_LIB. The honest "add the dependency and it just works" test.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>servirtium-consumer-example</artifactId>
    <version>0.0.1</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>22</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.paulhammant.servirtium</groupId>
            <artifactId>servirtium-vcr</artifactId>
            <version>2.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Consumers of servirtium-vcr (FFM/Panama) need this flag too. -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
