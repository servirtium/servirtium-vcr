// Gleam binding tests. Gleam compiles to the BEAM and reuses the CANONICAL
// `servirtium_nif` NIF built once by the Erlang binding (erlang/.build.ae ->
// erlang/_build/servirtium_nif) — no gleam-side C, no gleam-side NIF module.
// servirtium.gleam binds to it via @external(erlang, "servirtium_nif", ...);
// this node deps that build and runs `gleam test` with the shared app on the
// code path via ERL_LIBS (the `servirtium_nif` module + its priv .so resolve
// the standard OTP way — code:priv_dir). Engine .so comes transitively via the
// erlang build's dep on core.
import bldr
import gleam
import bldr (env, step)
aeb(cap) {
    bldr.build() {
        dep("erlang/.build.ae")
        libs = dep_artifact("erlang/.build.ae", "erl_libs")
        gleam.test_existing() {
            env("ERL_LIBS", libs)
            step("PATH=\"$HOME/.local/bin:$PATH\" gleam test")
        }
    }
}
