// Third-party-consumer PACKAGE stage for the Gleam binding.
//
// Gleam consumes `servirtium_gleam` as a Hex-style package: gleam.toml + src/,
// compiled by the consumer's own `gleam`. So the Gleam half of the package is
// SOURCE (no compile step here) — what packaging must actually produce is the
// other half: the shared servirtium_nif OTP app, staged so a consumer needs
// nothing from this repo.
//
// That app is not rebuilt here; it is copied from erlang/.package.ae's
// RELOCATABLE build (engine .so in priv/, NIF linked `-Wl,-rpath,$ORIGIN`)
// into gleam/_build_pkg, so the Gleam package is self-contained — one engine,
// one NIF, one rpath story for the whole BEAM family. `gleam` honors ERL_LIBS,
// so a consumer points that at the staged dir and needs no
// SERVIRTIUM_VCR_LIB.
//
// No tests run here; packaging is a build step (gleam/.tests.ae is the test
// node). Deps erlang/.package.ae; publishes "package_dir" and "erl_libs".
import bldr
import std.os
aeb(cap) {
    bldr.build() {
        dep("erlang/.package.ae")
        nif_libs = dep_artifact("erlang/.package.ae", "erl_libs")
        root = _get("root")
        gldir = "${root}/gleam"
        pkg = "${gldir}/_build_pkg"

        rc = os.system("rm -rf \"${pkg}\" && mkdir -p \"${pkg}\" && cp -r \"${nif_libs}/servirtium_nif\" \"${pkg}/servirtium_nif\"")
        if rc != 0 {
            println("gleam package: staging the shared servirtium_nif app failed")
            return 1
        }

        publish_artifact("package_dir", "${gldir}")
        publish_artifact("erl_libs", "${pkg}")
        println("gleam package: gleam package source + relocatable servirtium_nif app → gleam/_build_pkg")
        return 0
    }
}
