// Ported from testcontainers-go modules/ravendb/ravendb_test.go, by way of
// testcontainers-ae's tests/test_ravendb.ae (moved here 2026-11-07).
//
// A real RavenDB: the management URL serves /build/version, the databases
// API answers without credentials (unsecured mode), and the TCP endpoint
// helper points at the mapped server port.
//
// PORTING: the HTTP conversation is in the tape beside this file; the
// container start and the module's TCP endpoint shape are checked only when
// live, since playback starts no container. The server runs unsecured, so no
// credentials are sent.

import std.spec
import std.string
import std.http.client
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import servirtium
import modules.ravendb

const IMAGE = "ravendb/ravendb:6.0-ubuntu-latest"

// The User-Agent this test's HTTP client sends, as an app's client library
// would: Go's net/http adds `Go-http-client/1.1` by itself, Aether's
// std.http.client adds none. Set here, in the test's own client, so the
// recordings show a representative request; Servirtium records what the
// client sends and adds nothing of its own.
const USER_AGENT = "testcontainers-ae-tests (Aether std.http.client)"

// One HTTP request: (status, body, error). hdrs are "Name: value" lines.
fn http_do(method: string, url: string, hdrs: string[], body: string) -> (int, string, string) {
    req = client.request(method, url)
    client.set_header(req, "User-Agent", USER_AGENT)
    client.set_timeout(req, 30s)
    for h in hdrs {
        colon = string.index_of(h, ":")
        client.set_header(req, string.substring(h, 0, colon), string.trim(string.substring(h, colon + 1, string.length(h))))
    }
    if string.length(body) > 0 { client.set_body(req, string.bytes(body), "application/json") }
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    st = client.response_status(r)
    b = client.response_body(r)
    client.response_free(r)
    return st, b, ""
}

main() {
    fw = spec.init()
    if servirtium.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }
    // The licence terms of the recorded service, written at the top of each
    // tape (UPSTREAM-TERMS.md).
    servirtium.license_notice("Recorded against ravendb/ravendb:6.0-ubuntu-latest with its EULA\naccepted (RAVEN_License_Eula_Accepted=true) and no licence key, so the\nserver is under AGPL-3.0 per EULA section 1. The EULA (section 3)\nforbids reverse engineering, decompiling or disassembling the software.\nUse of this tape is subject to those terms; see UPSTREAM-TERMS.md in\nservirtium-vcr's pre-recorded/from-testcontainers.")
    // What differs run to run, never sent back: the Server-Startup-Time
    // response header.
    servirtium.collapse(servirtium.RFC3339, "2000-01-01T00:00:00Z")

    spec.describe(fw, "modules/ravendb") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("serves the management API (TestRavenDB)") callback {
            url = ""
            if servirtium.live() == 1 {
                c, err = ravendb.run(IMAGE)
                testing.cleanup_container(c)
                spec.assert_ok(err, "ravendb starts")
                if err != "" { return }
                u, uerr = ravendb.management_url(c)
                spec.assert_ok(uerr, "management url")
                spec.assert_true(string.starts_with(u, "http://localhost:") == 1, "an http URL: ${u}")
                tcp, terr = ravendb.tcp_endpoint(c)
                spec.assert_ok(terr, "tcp endpoint")
                spec.assert_true(string.starts_with(tcp, "localhost:") == 1, "host:port: ${tcp}")
                url = u
            }
            base, rec = servirtium.recording("ravendb", "serves_the_management_api", url)
            st, body, herr = http_do("GET", "${base}/build/version", [], "")
            spec.assert_ok(herr, "GET /build/version")
            spec.assert_eq(st, 200, "version is 200")
            spec.assert_contains(body, "ProductVersion", "the version document: ${body}")
            ds, _db, derr = http_do("GET", "${base}/databases", [], "")
            spec.assert_ok(derr, "GET /databases")
            spec.assert_eq(ds, 200, "unsecured access is allowed")
            servirtium.end_recording(rec)
        }
    }
    return spec.run_summary(fw)
}
