// Ported from testcontainers-go modules/vearch/vearch_test.go, by way of
// testcontainers-ae's tests/test_vearch.ae (moved here 2026-11-07).
//
// A real Vearch (TestVearch): GET on the REST endpoint answers 200.
//
// PORTING: the HTTP conversation is in the tape beside this file; the
// container start and the endpoint's shape are checked only when live,
// since playback starts no container.

import std.spec
import std.string
import std.http.client
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import servirtium
import modules.vearch

const IMAGE = "vearch/vearch:3.5.1"

// The User-Agent this test's HTTP client sends, as an app's client library
// would: Go's net/http adds `Go-http-client/1.1` by itself, Aether's
// std.http.client adds none. Set here, in the test's own client, so the
// recordings show a representative request; Servirtium records what the
// client sends and adds nothing of its own.
const USER_AGENT = "testcontainers-ae-tests (Aether std.http.client)"

// (status, body, error) of a GET.
fn http_get(url: string) -> (int, string, string) {
    req = client.request("GET", url)
    client.set_header(req, "User-Agent", USER_AGENT)
    client.set_timeout(req, 30s)
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    status = client.response_status(r)
    out = client.response_body(r)
    client.response_free(r)
    return status, out, ""
}

main() {
    fw = spec.init()
    if servirtium.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }
    // What differs run to run: Vearch (Go) writes the keys of the root
    // banner's "data" object in a different order every time, and the test
    // checks only the status, so the object is collapsed whole.
    servirtium.collapse("\"data\":\\{.*\\}\\}", "\"data\":{\"name\":\"vearch\"}}")

    spec.describe(fw, "modules/vearch") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("serves the REST endpoint (TestVearch)") callback {
            url = ""
            if servirtium.live() == 1 {
                c, err = vearch.run(IMAGE)
                testing.cleanup_container(c)
                spec.assert_ok(err, "vearch starts")
                if err != "" { return }
                u, uerr = vearch.rest_endpoint(c)
                spec.assert_ok(uerr, "rest endpoint")
                spec.assert_true(string.starts_with(u, "http://localhost:") == 1, "an http:// URL: ${u}")
                url = u
            }
            base, rec = servirtium.recording("vearch", "serves_the_rest_endpoint", url)
            st, _, herr = http_get(base)
            spec.assert_ok(herr, "GET the REST endpoint")
            spec.assert_eq(st, 200, "REST endpoint answers 200")
            servirtium.end_recording(rec)
        }
    }
    return spec.run_summary(fw)
}
