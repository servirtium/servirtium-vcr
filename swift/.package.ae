// Third-party-consumer PACKAGE stage for the Swift binding.
//
// Swift consumes `Servirtium` as a SwiftPM package (source-consumed from a path
// or git URL): Package.swift + Sources/. Package.swift links the engine with
// `-L native -lservirtium_vcr` and bakes an rpath, so the engine .so must ship
// INSIDE the package, in native/. This stages the freshly-built engine .so
// there.
//
// No tests run here; packaging is a build step (swift/.tests.ae is the test
// node — and it needs a working Swift toolchain, which packaging does not).
// Deps core/.build.ae; publishes the package dir on "package_dir".
import bldr
import copy
import copy (from, to)
aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")

        copy.file() {
            from(lib)
            to("native/libservirtium_vcr.so")
        }

        publish_artifact("package_dir", "${_get("root")}/swift")
        println("swift package: staged engine .so into swift/native/ (SwiftPM package ready)")
        return 0
    }
}
