// libservirtium_vcr, built ONCE for the whole monorepo from
// libservirtium_vcr source that lives IN this repo (core/).
//
// Output: libservirtium_vcr.so — every binding's .tests.ae deps this node
// and then links (cgo/NIF/cabal) or loads (ctypes/ffi/koffi/Fiddle/FFM/uFFI,
// via SERVIRTIUM_VCR_LIB) that single artifact. Consumers read it back via
// dep_artifact("core/.build.ae", "shared_lib") — no hardcoded path.
//
// Source: core/embed.ae (the aether_vcr_embed_* C-ABI) imports the local
// `vcr` module (core/vcr.ae) — the WHOLE libservirtium_vcr RUNTIME (Servirtium markdown
// parser / emitter + tape storage + dispatchers + matching + record) is
// PURE AETHER (was the 2133-line core/aether_vcr.c). The only C left is
// core/_embed_strdup.c (~12 lines): the embed ABI's vcr_embed_dup/free
// caller-owned-string bridge — the one malloc/free FFI primitive Aether's
// stdlib can't express — linked in via extra_source.
//
// aeb-native since the Shape A rework: aether.shared_lib runs
// `ae build --emit=lib` (cwd = core/, so `import vcr` resolves) and ALSO
// publishes the transitive-link artifacts (shared_library_deps_including_
// transitive, ldlibdeps) that let JVM/Go/Rust consumer nodes auto-wire.
//
// COMPAT: the .so is also copied to core/native/ — go/servirtium.go's cgo
// LDFLAGS (`-L${SRCDIR}/../core/native -rpath ...`), lua/haskell link lines,
// and third-party-consumer docs bake that path in. The dep_artifact path
// (target/build/core/lib/) and core/native/ are the same bytes.
import bldr
import aether
import aether (source, output, extra_source, caps, size, stem, target)
import std.os
import std.string

aeb(cap) {
    bldr.build() {
        // TWO paths, selected by SVCR_TARGET:
        //
        //  - SVCR_TARGET set (release/build.sh, once per triple): CROSS-build the
        //    lib for that triple with --size (release strip parity), AND stage the
        //    `ae add` binary-package asset for it (target/build/core/ae-add/:
        //    aether.toml + servirtium_vcr-<tag>-<triple>.<ext> + .sha256). Tag from
        //    AEB_RELEASE_TAG (release/publish.sh sets it), else v0.0.0. output() is
        //    required on BOTH builders: a cross --emit=lib writes lib….so.dll/.dylib
        //    on disk, and emit_binary_package resolves the real name from its OWN
        //    output() (a separate builder map from shared_lib's), so set it here too.
        //    Needs aeb >= v0.319 + a clean Aether >= 0.681 runtime archive: earlier
        //    aeb/stale-libaether combos broke the orchestrator link with
        //    `undefined reference to os_arch_raw` (v0.319's floor-guard makes that a
        //    legible error instead).
        //
        //  - SVCR_TARGET unset (normal monorepo build, every binding's .tests.ae
        //    deps this): HOST build + the core/native/ compat copy the FFI link
        //    lines bake in. No ae-add (host consumers use dep_artifact / the .so).
        t = os.getenv("SVCR_TARGET")
        if string.length(t) > 0 {
            aether.shared_lib() {
                source("embed.ae")
                extra_source("_embed_strdup.c")
                caps("fs,net")
                size()
                output("libservirtium_vcr.so")
                target(t)
            }
            aether.emit_binary_package() {
                stem("servirtium_vcr")
                output("libservirtium_vcr.so")
                target(t)
            }
            return 0
        }
        aether.shared_lib() {
            source("embed.ae")
            extra_source("_embed_strdup.c")
            caps("fs,net")
            output("libservirtium_vcr.so")
        }
        root = _get("root")
        td = _get("target_dir")
        rc = os.system("mkdir -p \"${root}/core/native\" && cp \"${td}/lib/libservirtium_vcr.so\" \"${root}/core/native/\"")
        if rc != 0 { println("failed to stage core/native/libservirtium_vcr.so"); return 1 }
        println("built libservirtium_vcr.so (aether.shared_lib; staged to core/native/)")
        return 0
    }
}
