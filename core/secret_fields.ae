// Format-aware source spans for the staged secret API. No host callbacks here.
// All offsets are byte offsets into the original field; unrelated bytes survive.
import std.string
import std.list
import std.json
import std.xml
exports(scan, count, begin_at, end_at, key_at, path_at, style_at, value_at, indent_at, render, encode_url, decode_url)
extern malloc(n: int) -> ptr
extern string_concat(a: string, b: string) -> string @heap
struct SecretSpan { start: int; end: int; key: string; path: string; style: int; value: string; indent: string }
struct YamlFrame { indent: int; path: string; key: string; index: int }
count(l: ptr) -> int { return list_size(l) }
span(l: ptr, i: int) -> *SecretSpan { return list_get_raw(l, i) as *SecretSpan }
begin_at(l: ptr, i: int) -> int { return span(l, i).start }
end_at(l: ptr, i: int) -> int { return span(l, i).end }
key_at(l: ptr, i: int) -> string { return span(l, i).key }
path_at(l: ptr, i: int) -> string { return span(l, i).path }
style_at(l: ptr, i: int) -> int { return span(l, i).style }
value_at(l: ptr, i: int) -> string { return span(l, i).value }
indent_at(l: ptr, i: int) -> string { return span(l, i).indent }
add(l: ptr, start: int, end: int, key: string, path: string, style: int, value: string, indent: string) {
    item = malloc(sizeof(SecretSpan)) as *SecretSpan
    item.start = start; item.end = end; item.key = string.copy(key); item.path = string.copy(path)
    item.style = style; item.value = string.copy(value); item.indent = string.copy(indent)
    list_add_raw(l, item)
}
char(s: string, i: int) -> int { if i < 0 || i >= string.length(s) { return -1 }; return string.char_at(s, i) }
ws(c: int) -> int { if c == 32 || c == 9 || c == 10 || c == 13 { return 1 }; return 0 }
skip(s: string, i: int) -> int { p = i; while ws(char(s, p)) == 1 { p = p + 1 }; return p }
trim_end(s: string, start: int, end: int) -> int { p = end; while p > start && ws(char(s, p - 1)) == 1 { p = p - 1 }; return p }
line_end(s: string, i: int) -> int { p = string.index_of_from(s, "\n", i); if p < 0 { return string.length(s) }; return p }
hex(c: int) -> int { if c >= 48 && c <= 57 { return c - 48 }; if c >= 65 && c <= 70 { return c - 55 }; if c >= 97 && c <= 102 { return c - 87 }; return -1 }
decode_url(s: string) -> string {
    out = string.copy(""); i = 0
    while i < string.length(s) {
        c = char(s, i)
        if c == 43 { out = string_concat(out, " ") }
        else if c == 37 && i + 2 < string.length(s) && hex(char(s, i + 1)) >= 0 && hex(char(s, i + 2)) >= 0 {
            out = string_concat(out, string.from_char(hex(char(s, i + 1)) * 16 + hex(char(s, i + 2)))); i = i + 2
        } else { out = string_concat(out, string.substring(s, i, i + 1)) }
        i = i + 1
    }
    return out
}
encode_url(s: string) -> string {
    out = string.copy(""); digits = "0123456789ABCDEF"; i = 0
    while i < string.length(s) {
        c = char(s, i)
        if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 46 || c == 95 || c == 126 { out = string_concat(out, string.substring(s, i, i + 1)) }
        else { a = c / 16; b = c % 16; out = string_concat(out, "%"); out = string_concat(out, string.substring(digits, a, a + 1)); out = string_concat(out, string.substring(digits, b, b + 1)) }
        i = i + 1
    }
    return out
}
quoted_end(s: string, start: int, yaml_mode: int) -> int {
    quote = char(s, start); i = start + 1
    while i < string.length(s) {
        c = char(s, i)
        if quote == 34 && c == 92 { i = i + 2 }
        else if c == quote {
            if yaml_mode == 1 && quote == 39 && char(s, i + 1) == 39 { i = i + 2 }
            else { return i + 1 }
        } else { i = i + 1 }
    }
    return -1
}
unquote(s: string, start: int, end: int, yaml_mode: int) -> {
    if char(s, start) == 39 && yaml_mode == 1 {
        raw = string.substring(s, start + 1, end - 1)
        // YAML single quotes escape themselves by doubling.
        out = string.copy(""); i = 0
        while i < string.length(raw) { out = string_concat(out, string.substring(raw, i, i + 1)); if char(raw, i) == 39 && char(raw, i + 1) == 39 { i = i + 1 }; i = i + 1 }
        return out, ""
    }
    node, err = json.parse(string.substring(s, start, end))
    if node == null || err != "" { return "", "unsupported quoted scalar escape" }
    value = string.copy(json.json_get_string_raw(node)); json.json_free(node)
    return value, ""
}
path_key(path: string, key: string) -> string {
    out = string.copy(""); i = 0
    while i < string.length(key) {
        c = char(key, i)
        if c == 126 { out = string_concat(out, "~0") }
        else if c == 47 { out = string_concat(out, "~1") }
        else { out = string_concat(out, string.substring(key, i, i + 1)) }
        i = i + 1
    }
    return string_concat(string_concat(path, "/"), out)
}
// Recursive flow parser: strict JSON is validated before entry. YAML flow maps
// additionally allow single-quoted/unquoted keys and scalars. No alias expansion.
flow(s: string, start: int, key: string, path: string, out: ptr, yaml_mode: int, depth: int) -> {
    if depth > 128 { return start, "secret field nesting exceeds 128" }
    i = skip(s, start); c = char(s, i)
    if yaml_mode == 1 && (c == 38 || c == 42 || c == 33) { return i, "YAML anchors, aliases and tags require an explicit redaction rule" }
    if c == 123 {
        i = skip(s, i + 1)
        while char(s, i) != 125 {
            if char(s, i) < 0 { return i, "unclosed mapping" }
            key_start = i; key_end = i
            if char(s, i) == 34 || (yaml_mode == 1 && char(s, i) == 39) {
                key_end = quoted_end(s, i, yaml_mode)
                if key_end < 0 { return i, "unclosed mapping key" }
                name, err = unquote(s, i, key_end, yaml_mode)
                if err != "" { return i, err }
            } else {
                if yaml_mode == 0 { return i, "JSON key must be quoted" }
                while char(s, key_end) != 58 && char(s, key_end) >= 0 && char(s, key_end) != 10 { key_end = key_end + 1 }
                name = string.substring(s, key_start, trim_end(s, key_start, key_end))
                if name == "" || name == "<<" { return i, "unsupported YAML mapping key" }
            }
            colon = skip(s, key_end)
            if yaml_mode == 1 && char(s, key_start) != 34 && char(s, key_start) != 39 && ws(char(s, colon + 1)) == 0 && char(s, colon + 1) != 123 && char(s, colon + 1) != 91 {
                return colon, "YAML plain flow keys require whitespace after the colon"
            }
            if char(s, colon) != 58 { return colon, "mapping key has no colon" }
            i, err = flow(s, colon + 1, name, path_key(path, name), out, yaml_mode, depth + 1)
            if err != "" { return i, err }
            i = skip(s, i)
            if char(s, i) == 44 { i = skip(s, i + 1) }
            else if char(s, i) != 125 { return i, "mapping separator expected" }
        }
        return i + 1, ""
    }
    if c == 91 {
        i = skip(s, i + 1); index = 0
        while char(s, i) != 93 {
            if char(s, i) < 0 { return i, "unclosed sequence" }
            i, err = flow(s, i, key, path_key(path, string.from_int(index)), out, yaml_mode, depth + 1)
            if err != "" { return i, err }
            index = index + 1; i = skip(s, i)
            if char(s, i) == 44 { i = skip(s, i + 1) }
            else if char(s, i) != 93 { return i, "sequence separator expected" }
        }
        return i + 1, ""
    }
    if c == 34 || (yaml_mode == 1 && c == 39) {
        end = quoted_end(s, i, yaml_mode)
        if end < 0 { return i, "unclosed scalar" }
        value, err = unquote(s, i, end, yaml_mode)
        if err != "" { return i, err }
        style = 3
        if yaml_mode == 1 { style = 8; if c == 39 { style = 9 } }
        add(out, i, end, key, path, style, value, "")
        return end, ""
    }
    end = i
    while char(s, end) >= 0 && char(s, end) != 10 && char(s, end) != 13 {
        if (yaml_mode == 0 || depth > 0) && (char(s, end) == 44 || char(s, end) == 93 || char(s, end) == 125) { break }
        if yaml_mode == 0 && ws(char(s, end)) == 1 { break }
        if yaml_mode == 1 && char(s, end) == 35 && (end == i || ws(char(s, end - 1)) == 1) { break }
        end = end + 1
    }
    stop = trim_end(s, i, end)
    if stop == i { return i, "empty scalar" }
    style = 4; if yaml_mode == 1 { style = 10 }
    add(out, i, stop, key, path, style, string.substring(s, i, stop), "")
    return end, ""
}
scan_pairs(s: string, out: ptr, query: int) {
    i = 0; limit = string.length(s)
    if query == 1 { i = string.index_of(s, "?"); if i < 0 { return }; i = i + 1; hash = string.index_of_from(s, "#", i); if hash >= 0 { limit = hash } }
    while i < limit {
        end = string.index_of_from(s, "&", i); if end < 0 || end > limit { end = limit }
        eq = string.index_of_from(s, "=", i)
        if eq >= i && eq < end {
            name = decode_url(string.substring(s, i, eq))
            add(out, eq + 1, end, name, path_key("", name), 1, decode_url(string.substring(s, eq + 1, end)), "")
        }
        i = end + 1
    }
}
scan_headers(s: string, out: ptr) {
    i = 0
    while i < string.length(s) {
        end = line_end(s, i); stop = trim_end(s, i, end); colon = string.index_of_from(s, ":", i)
        if colon > i && colon < stop {
            start = skip(s, colon + 1)
            if start > stop { start = stop }
            name = string.substring(s, i, colon)
            add(out, start, stop, name, path_key("", name), 2, string.substring(s, start, stop), "")
        }
        i = end + 1
    }
}
xml_decode(s: string) -> {
    parser = xml.parser(string_concat(string_concat("<v>", s), "</v>")); value = string.copy("")
    while 1 == 1 {
        ev = xml.next(parser)
        if ev == xml.EVENT_ERROR { err = xml.error(parser); xml.free(parser); return "", err }
        if ev == xml.EVENT_EOF { break }
        if ev == xml.EVENT_TEXT { value = string_concat(value, xml.text(parser)) }
    }
    xml.free(parser); return value, ""
}
scan_xml(s: string, out: ptr) -> string {
    parser = xml.parser(s)
    while 1 == 1 { ev = xml.next(parser); if ev == xml.EVENT_ERROR { err = xml.error(parser); xml.free(parser); return err }; if ev == xml.EVENT_EOF { break } }
    xml.free(parser)
    paths = list_new(); names = list_new(); level = 0; i = 0
    while i < string.length(s) {
        if string.substring(s, i, i + 4) == "<!--" { end = string.index_of_from(s, "-->", i + 4); if end < 0 { return "unclosed XML comment" }; i = end + 3 }
        else if string.substring(s, i, i + 9) == "<![CDATA[" {
            end = string.index_of_from(s, "]]>", i + 9); if end < 0 { return "unclosed XML CDATA" }
            if level > 0 { name = list_get_string(names, level - 1); path = list_get_string(paths, level - 1); add(out, i + 9, end, name, path, 13, string.substring(s, i + 9, end), "") }
            i = end + 3
        } else if char(s, i) == 60 {
            if char(s, i + 1) == 63 || char(s, i + 1) == 33 {
                // No DTD/entity processing. Declarations are not key/value content.
                end = string.index_of_from(s, ">", i + 1); if end < 0 { return "unclosed XML declaration" }; i = end + 1
            } else if char(s, i + 1) == 47 {
                end = string.index_of_from(s, ">", i + 2); level = level - 1
                if level < 0 { return "invalid XML nesting" }
                i = end + 1
            } else {
                name_end = i + 1
                while char(s, name_end) >= 0 && ws(char(s, name_end)) == 0 && char(s, name_end) != 47 && char(s, name_end) != 62 { name_end = name_end + 1 }
                name = string.substring(s, i + 1, name_end); parent = ""
                if level > 0 { parent = list_get_string(paths, level - 1) }
                path = path_key(parent, name)
                if level < list_size(paths) { list_set_string(paths, level, path); list_set_string(names, level, name) }
                else { list_add_string(paths, path); list_add_string(names, name) }
                level = level + 1; i = skip(s, name_end)
                while char(s, i) != 62 && char(s, i) >= 0 {
                    if char(s, i) == 47 { level = level - 1; i = skip(s, i + 1); break }
                    key_end = i
                    while ws(char(s, key_end)) == 0 && char(s, key_end) != 61 && char(s, key_end) >= 0 { key_end = key_end + 1 }
                    attr_name = string.substring(s, i, key_end); eq = skip(s, key_end); start = skip(s, eq + 1)
                    quote = char(s, start); if char(s, eq) != 61 || (quote != 34 && quote != 39) { return "invalid XML attribute" }
                    end = string.index_of_from(s, string.from_char(quote), start + 1); if end < 0 { return "unclosed XML attribute" }
                    value, err = xml_decode(string.substring(s, start + 1, end)); if err != "" { return err }
                    style = 6; if quote == 39 { style = 7 }
                    add(out, start + 1, end, attr_name, string_concat(path, string_concat("/@", attr_name)), style, value, "")
                    i = skip(s, end + 1)
                }
                i = i + 1
            }
        } else {
            end = string.index_of_from(s, "<", i); if end < 0 { end = string.length(s) }
            start = skip(s, i); stop = trim_end(s, start, end)
            if stop > start && level > 0 {
                value, err = xml_decode(string.substring(s, start, stop)); if err != "" { return err }
                name = list_get_string(names, level - 1); path = list_get_string(paths, level - 1)
                add(out, start, stop, name, path, 5, value, "")
            }
            i = end
        }
    }
    return ""
}
// String-list helpers avoid borrowed pointers surviving subsequent parser calls.
list_add_string(l: ptr, s: string) { item = malloc(sizeof(SecretSpan)) as *SecretSpan; item.key = string.copy(s); list_add_raw(l, item) }
list_get_string(l: ptr, i: int) -> string { return (list_get_raw(l, i) as *SecretSpan).key }
list_set_string(l: ptr, i: int, s: string) { (list_get_raw(l, i) as *SecretSpan).key = string.copy(s) }
yaml_colon(s: string, start: int, end: int) -> int {
    i = start
    while i < end {
        c = char(s, i)
        if c == 34 || c == 39 { i = quoted_end(s, i, 1); if i < 0 { return -1 } }
        else { if c == 58 && (ws(char(s, i + 1)) == 1 || i + 1 == end || char(s, i + 1) == 123 || char(s, i + 1) == 91) { return i }; i = i + 1 }
    }
    return -1
}
scan_yaml(s: string, out: ptr) -> string {
    frames = list_new(); root = malloc(sizeof(YamlFrame)) as *YamlFrame
    root.indent = 0; root.path = ""; root.key = ""; root.index = 0; list_add_raw(frames, root)
    level = 0; i = 0; previous_indent = 0; previous_container = 1
    while i < string.length(s) {
        end = line_end(s, i); start = i
        while char(s, start) == 32 { start = start + 1 }
        if char(s, start) == 9 { return "tabs in YAML indentation are unsupported" }
        if start >= end || char(s, start) == 13 || char(s, start) == 35 { i = end + 1 }
        else {
            indent = start - i
            if indent > previous_indent && previous_container == 0 { return "multiline plain YAML scalars require an explicit rule" }
            while level > 0 && indent < (list_get_raw(frames, level) as *YamlFrame).indent { level = level - 1 }
            frame = list_get_raw(frames, level) as *YamlFrame; path = frame.path; key = frame.key
            if string.substring(s, start, start + 3) == "---" || string.substring(s, start, start + 3) == "..." { return "multiple/directive YAML documents require an explicit rule" }
            if char(s, start) == 37 || char(s, start) == 63 { return "YAML directives and complex keys require an explicit rule" }
            effective_indent = indent
            if char(s, start) == 45 && ws(char(s, start + 1)) == 1 {
                path = path_key(path, string.from_int(frame.index)); frame.index = frame.index + 1
                child = malloc(sizeof(YamlFrame)) as *YamlFrame; child.indent = indent + 1; child.path = path; child.key = key; child.index = 0
                level = level + 1; if level < list_size(frames) { list_set(frames, level, child) } else { list_add_raw(frames, child) }
                start = skip(s, start + 1); effective_indent = start - i
            }
            colon = yaml_colon(s, start, end)
            if colon >= 0 {
                key_end = trim_end(s, start, colon)
                key = string.substring(s, start, key_end)
                if char(s, start) == 34 || char(s, start) == 39 { key, err = unquote(s, start, key_end, 1); if err != "" { return err } }
                if key == "<<" || key == "" { return "unsupported YAML mapping key" }
                path = path_key(path, key); start = colon + 1
                while char(s, start) == 32 || char(s, start) == 9 { start = start + 1 }
            }
            if start >= end || char(s, start) == 13 || char(s, start) == 35 {
                child = malloc(sizeof(YamlFrame)) as *YamlFrame; child.indent = effective_indent + 1; child.path = path; child.key = key; child.index = 0
                level = level + 1; if level < list_size(frames) { list_set(frames, level, child) } else { list_add_raw(frames, child) }
                previous_container = 1; previous_indent = effective_indent; i = end + 1
            } else if char(s, start) == 124 || char(s, start) == 62 {
                // Keep the block indicator/chomping and its original indentation.
                next = end + 1; content_start = next
                while char(s, content_start) == 32 { content_start = content_start + 1 }
                content_indent = content_start - next
                if content_indent <= effective_indent { return "empty YAML block scalar" }
                scan_end = next; stop = next
                while scan_end < string.length(s) {
                    row_end = line_end(s, scan_end); row = scan_end
                    while char(s, row) == 32 { row = row + 1 }
                    if row < row_end && char(s, row) != 13 && row - scan_end < content_indent { break }
                    stop = row_end; scan_end = row_end + 1
                }
                value_end = trim_end(s, content_start, stop)
                add(out, content_start, value_end, key, path, 11, string.substring(s, content_start, value_end), string.substring(s, next, content_start))
                i = scan_end; previous_container = 0; previous_indent = effective_indent
            } else {
                stop, err = flow(s, start, key, path, out, 1, 0); if err != "" { return err }
                rest = stop
                while char(s, rest) == 32 || char(s, rest) == 9 || char(s, rest) == 13 { rest = rest + 1 }
                if char(s, rest) != 10 && char(s, rest) >= 0 && char(s, rest) != 35 { return "unsupported trailing YAML content" }
                i = line_end(s, stop) + 1; previous_container = 0; previous_indent = effective_indent
            }
        }
    }
    return ""
}
lower_ascii(s: string) -> string {
    out = string.copy(""); i = 0
    while i < string.length(s) { c = char(s, i); if c >= 65 && c <= 90 { out = string_concat(out, string.from_char(c + 32)) } else { out = string_concat(out, string.substring(s, i, i + 1)) }; i = i + 1 }
    return out
}
scan_multipart(s: string, boundary: string, out: ptr) -> string {
    if boundary == "" || string.contains(boundary, "\r") == 1 || string.contains(boundary, "\n") == 1 { return "invalid multipart boundary" }
    marker = string_concat("--", boundary); delimiter = string_concat("\r\n", marker)
    i = string.index_of(s, marker)
    if i < 0 { return "multipart boundary not found" }
    while i >= 0 {
        start = i + string.length(marker)
        if string.substring(s, start, start + 2) == "--" { return "" }
        if string.substring(s, start, start + 2) != "\r\n" { return "invalid multipart delimiter" }
        start = start + 2; split = string.index_of_from(s, "\r\n\r\n", start)
        if split < 0 { return "multipart part headers not terminated" }
        end = string.index_of_from(s, delimiter, split + 4)
        if end < 0 { return "multipart closing boundary not found" }
        headers = string.substring(s, start, split); lower = lower_ascii(headers)
        name_at = string.index_of(lower, "; name=")
        if name_at >= 0 && string.index_of(lower, "filename=") < 0 {
            if string.index_of(lower, "content-transfer-encoding:") >= 0 { return "encoded multipart text parts require an explicit rule" }
            name_start = name_at + 7; name_end = name_start
            if char(headers, name_start) == 34 { name_start = name_start + 1; name_end = string.index_of_from(headers, "\"", name_start); if name_end < 0 { return "unclosed multipart field name" } }
            else { while name_end < string.length(headers) && char(headers, name_end) != 59 && ws(char(headers, name_end)) == 0 { name_end = name_end + 1 } }
            name = string.substring(headers, name_start, name_end)
            add(out, split + 4, end, name, path_key("", name), 12, string.substring(s, split + 4, end), "")
        }
        i = end + 2
    }
    return ""
}
scan(s: string, format: string) -> {
    out = list_new()
    if format == "query" { scan_pairs(s, out, 1); return out, "" }
    if format == "form" { scan_pairs(s, out, 0); return out, "" }
    if format == "header" { scan_headers(s, out); return out, "" }
    if format == "json" {
        doc, err = json.parse(s); if doc == null || err != "" { return out, "secret redaction requires valid JSON" }; json.json_free(doc)
        end, err = flow(s, 0, "", "", out, 0, 0); return out, err
    }
    if format == "xml" { return out, scan_xml(s, out) }
    if string.substring(format, 0, 10) == "multipart:" { return out, scan_multipart(s, string.substring(format, 10, string.length(format)), out) }
    if format == "yaml" {
        start = skip(s, 0)
        if char(s, start) == 123 || char(s, start) == 91 { end, err = flow(s, start, "", "", out, 1, 0); if skip(s, end) != string.length(s) { return out, "trailing YAML flow content" }; return out, err }
        return out, scan_yaml(s, out)
    }
    // Opaque bodies participate only through explicitly designated raw markers.
    i = 0
    while i < string.length(s) {
        start = string.index_of_from(s, "{{secret:", i); if start < 0 { break }
        end = string.index_of_from(s, "}}", start + 9); if end < 0 { return out, "unclosed secret marker" }
        add(out, start, end + 2, "", "", 12, string.substring(s, start, end + 2), ""); i = end + 2
    }
    return out, ""
}
render(value: string, style: int, recording: int, indent: string) -> {
    if style == 1 { return encode_url(value), "" }
    if style == 2 {
        if string.contains(value, "\r") == 1 || string.contains(value, "\n") == 1 { return "", "header secrets must be a single line" }
        return value, ""
    }
    if style == 3 || style == 8 || (recording == 1 && (style == 4 || style == 10)) {
        node = json.str(value); encoded, err = json.encode(node); json.json_free(node); return encoded, err
    }
    if style == 4 {
        node, err = json.parse(value); if node == null || err != "" { return "", "resolved JSON primitive is invalid" }
        kind = json.json_type(node); json.json_free(node)
        if kind == 3 || kind == 4 || kind == 5 { return "", "resolved JSON primitive must be a number, boolean or null" }
        return value, ""
    }
    if style == 5 || style == 6 || style == 7 {
        out = string.copy(""); i = 0
        while i < string.length(value) {
            c = char(value, i)
            if c == 38 { out = string_concat(out, "&amp;") }
            else if c == 60 { out = string_concat(out, "&lt;") }
            else if c == 62 { out = string_concat(out, "&gt;") }
            else if c == 34 && style == 6 { out = string_concat(out, "&quot;") }
            else if c == 39 && style == 7 { out = string_concat(out, "&apos;") }
            else { out = string_concat(out, string.substring(value, i, i + 1)) }
            i = i + 1
        }
        return out, ""
    }
    if style == 9 {
        out = string.copy("'"); i = 0
        while i < string.length(value) { part = string.substring(value, i, i + 1); out = string_concat(out, part); if char(value, i) == 39 { out = string_concat(out, "'") }; if char(value, i) == 10 || char(value, i) == 13 { return "", "multiline single-quoted YAML replacements require an explicit rule" }; i = i + 1 }
        return string_concat(out, "'"), ""
    }
    if style == 10 {
        if value == "" || string.contains(value, "\n") == 1 || string.contains(value, ": ") == 1 || string.contains(value, " #") == 1 { return "", "resolved YAML plain scalar needs explicit quoting" }
        c = char(value, 0); if c == 38 || c == 42 || c == 33 || c == 123 || c == 91 || c == 35 || c == 39 || c == 34 || c == 124 || c == 62 { return "", "invalid resolved YAML plain scalar" }
        return value, ""
    }
    if style == 11 {
        out = string.copy(""); i = 0
        while i < string.length(value) { out = string_concat(out, string.substring(value, i, i + 1)); if char(value, i) == 10 { out = string_concat(out, indent) }; i = i + 1 }
        return out, ""
    }
    if style == 13 {
        // Split a closing CDATA delimiter rather than injecting XML markup.
        out = string.copy(""); i = 0
        while i < string.length(value) { if string.substring(value, i, i + 3) == "]]>" { out = string_concat(out, "]]]]><![CDATA[>"); i = i + 3 } else { out = string_concat(out, string.substring(value, i, i + 1)); i = i + 1 } }
        return out, ""
    }
    return value, ""
}
