// Volatile values: the rule grammar, placeholders and their compilation to
// PCRE2, the token syntax and its escape in each marker style, and finding a
// rule's values in one field's text. Pure functions over strings; the VCR's
// state (rules, values, numbering, bindings) lives in core/vcr.ae.
// docs/volatile-values.md is the specification.
import std.string
import std.list
import std.regex
exports(
    SCOPE_PATH, SCOPE_REQUEST_HEADERS, SCOPE_REQUEST_BODY, SCOPE_RESPONSE_HEADERS, SCOPE_RESPONSE_BODY,
    HEADING, MUSTACHE, DOLLAR_CURLY, WIKILINK, style_name, marker_open, marker_close,
    add_rule, parse_block, block_in, render_block, profile_style, rule_count, rule_line,
    rule_applies, rule_names, response_only_names, find_spans, span_count, span_start,
    span_end, span_rule, span_name, span_warnings, valid_name, token_end, token_name, token_number,
    token_text, escape, unescape, tokens_in_style, all_names, inline_patterns, value_fits,
    shape_end, real_token_end, parts, part_count, part_token, part_text, part_name, part_numbered,
    two_sided_names, one_sided_names
)
extern malloc(n: int) -> ptr
extern string_concat(a: string, b: string) -> string @heap

// Field bits a rule's scope covers.
const SCOPE_PATH = 1
const SCOPE_REQUEST_HEADERS = 2
const SCOPE_REQUEST_BODY = 4
const SCOPE_RESPONSE_HEADERS = 8
const SCOPE_RESPONSE_BODY = 16
const REQUEST_SIDE = 7

const HEADING = "## Volatile values"

// Marker styles: a placeholder is open name close, a token open name-N close.
const MUSTACHE = 0
const DOLLAR_CURLY = 1
const WIKILINK = 2

// A rule regex never runs unbounded (docs/volatile-values.md, "Limits").
const REGEX_LIMITS = "(*LIMIT_MATCH=1000000)(*LIMIT_DEPTH=10000)"
const REGEX_MAX_INPUT = 4194304
const MAX_MATCHES = 10000

struct VRule {
    scope: int           // SCOPE_* bits
    pattern: string      // as written (template or regex)
    compiled: string     // the PCRE2 the core runs (limits prepended)
    names: string        // placeholder names, "|"-separated, capture order
    inlines: string      // "name=pattern\n" per inline placeholder pattern
    groups: string       // their capture-group numbers, "|"-separated
    line: string         // canonical rule line, without the leading "- "
    key: string          // what a conflict compares: the line, names erased
    origin: string       // " (tape)", " (profile …)" or "" (code)
}

struct VSpan { start: int; end: int; rule: int; name: string }
struct SpanResult { spans: ptr; warnings: string }

char(s: string, i: int) -> int { if i < 0 || i >= string.length(s) { return -1 }; return string.char_at(s, i) }
is_digit(c: int) -> int { if c >= 48 && c <= 57 { return 1 }; return 0 }
is_alpha_(c: int) -> int { if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 { return 1 }; return 0 }
ws(c: int) -> int { if c == 32 || c == 9 || c == 10 || c == 13 { return 1 }; return 0 }
at(s: string, i: int, lit: string) -> int {
    if i < 0 || i + string.length(lit) > string.length(s) { return 0 }
    if string.substring(s, i, i + string.length(lit)) == lit { return 1 }
    return 0
}
has_name(names: string, name: string) -> int {
    if name == "" { return 0 }
    if string.index_of("|${names}|", "|${name}|") >= 0 { return 1 }
    return 0
}

// ---- markers ----

marker_open(style: int) -> string {
    if style == DOLLAR_CURLY { return string_concat(string.from_char(36), "{") }
    if style == WIKILINK { return "[[" }
    return "{{"
}
marker_close(style: int) -> string {
    if style == DOLLAR_CURLY { return "}" }
    if style == WIKILINK { return "]]" }
    return "}}"
}
style_name(style: int) -> string {
    if style == DOLLAR_CURLY { return "DollarCurly (${marker_open(style)}name})" }
    if style == WIKILINK { return "Wikilink ([[name]])" }
    return "Mustache ({{name}})"
}
// [A-Za-z_][A-Za-z0-9_]* (also a PCRE2 group name).
valid_name(n: string) -> int {
    if string.length(n) == 0 || is_alpha_(char(n, 0)) == 0 { return 0 }
    i = 1
    while i < string.length(n) {
        c = char(n, i)
        if is_alpha_(c) == 0 && is_digit(c) == 0 { return 0 }
        i = i + 1
    }
    return 1
}
name_end(s: string, i: int) -> int {
    if is_alpha_(char(s, i)) == 0 { return i }
    j = i + 1
    while is_alpha_(char(s, j)) == 1 || is_digit(char(s, j)) == 1 { j = j + 1 }
    return j
}

// ---- tokens: open name-N close (numbered), open name close (unnumbered) ----

// When a numbered token, open name-N close, starts at s[i]: the index after
// it; else -1. Any name: the shape alone, which is what escaping needs.
token_end(s: string, i: int, style: int) -> int {
    o = marker_open(style)
    if at(s, i, o) == 0 { return -1 }
    p = i + string.length(o)
    ne = name_end(s, p)
    if ne == p || char(s, ne) != 45 { return -1 }
    d = ne + 1
    if is_digit(char(s, d)) == 0 || char(s, d) == 48 { return -1 }
    while is_digit(char(s, d)) == 1 { d = d + 1 }
    if at(s, d, marker_close(style)) == 0 { return -1 }
    return d + string.length(marker_close(style))
}
// Token-shaped text at s[i]: a numbered token of any name, or an
// unnumbered one of a name in `one` ("|"-delimited). The index after it,
// or -1.
shape_end(s: string, i: int, style: int, one: string) -> int {
    te = token_end(s, i, style)
    if te > 0 { return te }
    o = marker_open(style)
    if at(s, i, o) == 0 { return -1 }
    p = i + string.length(o)
    ne = name_end(s, p)
    if ne == p || at(s, ne, marker_close(style)) == 0 { return -1 }
    if has_name(one, string.substring(s, p, ne)) == 0 { return -1 }
    return ne + string.length(marker_close(style))
}
// A real token at s[i] for this rule set: numbered of a name in `two`,
// unnumbered of a name in `one`. The index after it, or -1.
real_token_end(s: string, i: int, style: int, two: string, one: string) -> int {
    te = token_end(s, i, style)
    if te > 0 {
        if has_name(two, token_name(s, i, style)) == 1 { return te }
        return -1
    }
    return shape_end(s, i, style, one)
}
token_name(s: string, i: int, style: int) -> string {
    p = i + string.length(marker_open(style))
    return string.substring(s, p, name_end(s, p))
}
token_number(s: string, i: int, style: int) -> int {
    p = name_end(s, i + string.length(marker_open(style)))
    if char(s, p) != 45 { return 0 }
    p = p + 1
    d = p
    while is_digit(char(s, d)) == 1 { d = d + 1 }
    n, _e = string.to_int(string.substring(s, p, d))
    return n
}
// open name-N close, or open name close for n = 0 (an unnumbered token).
token_text(name: string, n: int, style: int) -> string {
    if n == 0 { return string_concat(string_concat(marker_open(style), name), marker_close(style)) }
    return string_concat(string_concat(marker_open(style), "${name}-${string.from_int(n)}"), marker_close(style))
}

backslashes(n: int) -> string {
    out = string.copy("")
    k = 0
    while k < n { out = string_concat(out, "\\"); k = k + 1 }
    return out
}
// The run of backslashes ending just before s[i], not reaching back past `from`.
run_before(s: string, i: int, from: int) -> int {
    k = 0
    while i - k - 1 >= from && char(s, i - k - 1) == 92 { k = k + 1 }
    return k
}

// Escape literal text for a tape: token-shaped text gets a backslash
// (\{{x-1}}), and a run of backslashes before it is doubled first. With
// `tail` = 1 the text is followed by a real token, so a run of backslashes
// it ends with is doubled too. Every other backslash is left alone.
escape(s: string, style: int, one: string, tail: int) -> string {
    o = marker_open(style)
    n = string.length(s)
    out = string.copy("")
    pos = 0
    i = string.index_of(s, o)
    while i >= 0 {
        te = shape_end(s, i, style, one)
        if te < 0 { i = string.index_of_from(s, o, i + 1); continue }
        k = run_before(s, i, pos)
        out = string_concat(out, string.substring(s, pos, i - k))
        out = string_concat(out, backslashes(2 * k + 1))
        out = string_concat(out, string.substring(s, i, te))
        pos = te
        i = string.index_of_from(s, o, te)
    }
    if tail == 1 {
        k2 = run_before(s, n, pos)
        out = string_concat(out, string.substring(s, pos, n - k2))
        return string_concat(out, backslashes(2 * k2))
    }
    return string_concat(out, string.substring(s, pos, n))
}

struct VPart { token: int; text: string; name: string; numbered: int }
part_add(l: ptr, token: int, text: string, name: string, numbered: int) {
    p = malloc(sizeof(VPart)) as *VPart
    p.token = token; p.text = string.copy(text); p.name = string.copy(name); p.numbered = numbered
    list_add_raw(l, p)
}
part_count(l: ptr) -> int { return list_size(l) }
part_token(l: ptr, i: int) -> int { return (list_get_raw(l, i) as *VPart).token }
part_text(l: ptr, i: int) -> string { return (list_get_raw(l, i) as *VPart).text }
part_name(l: ptr, i: int) -> string { return (list_get_raw(l, i) as *VPart).name }
part_numbered(l: ptr, i: int) -> int { return (list_get_raw(l, i) as *VPart).numbered }

// Read tape text: literal parts (escapes undone) and real tokens. Before
// token-shaped text, a run of k backslashes stands for k/2 backslashes, and
// an odd run makes the text literal.
parts(s: string, style: int, two: string, one: string) -> ptr {
    o = marker_open(style)
    l = list_new()
    buf = string.copy("")
    pos = 0
    i = string.index_of(s, o)
    while i >= 0 {
        te = shape_end(s, i, style, one)
        if te < 0 { i = string.index_of_from(s, o, i + 1); continue }
        k = run_before(s, i, pos)
        buf = string_concat(buf, string.substring(s, pos, i - k))
        buf = string_concat(buf, backslashes(k / 2))
        text = string.substring(s, i, te)
        real = 0
        if k % 2 == 0 && real_token_end(s, i, style, two, one) == te { real = 1 }
        if real == 1 {
            if buf != "" { part_add(l, 0, buf, "", 0) }
            buf = string.copy("")
            numbered = 0
            if token_end(s, i, style) == te { numbered = 1 }
            part_add(l, 1, text, token_name(s, i, style), numbered)
        } else {
            buf = string_concat(buf, text)
        }
        pos = te
        i = string.index_of_from(s, o, te)
    }
    buf = string_concat(buf, string.substring(s, pos, string.length(s)))
    if buf != "" { part_add(l, 0, buf, "", 0) }
    return l
}

// The text a tape holds, escapes undone and tokens left as written.
unescape(s: string, style: int, two: string, one: string) -> string {
    if string.index_of(s, marker_open(style)) < 0 { return s }
    l = parts(s, style, two, one)
    out = string.copy("")
    i = 0
    while i < list_size(l) { out = string_concat(out, part_text(l, i)); i = i + 1 }
    return out
}

// How many tokens of the rule set `s` holds in `style`.
tokens_in_style(s: string, style: int, two: string, one: string) -> int {
    o = marker_open(style)
    n = 0
    i = string.index_of(s, o)
    while i >= 0 {
        te = real_token_end(s, i, style, two, one)
        if te > 0 && run_before(s, i, 0) % 2 == 0 {
            n = n + 1
            i = string.index_of_from(s, o, te)
        } else { i = string.index_of_from(s, o, i + 1) }
    }
    return n
}

// Names used on both sides (a request-side and a response-side rule, or one
// rule whose scope spans both): their tokens are numbered. "|a|b|".
two_sided_names(l: ptr) -> string {
    req = string.copy("|")
    resp = string.copy("|")
    i = 0
    while i < list_size(l) {
        r = rule_at(l, i)
        parts_ = string.split(string.copy(r.names), "|")
        k = 0
        while k < string.array_size(parts_) {
            nm = string.array_get(parts_, k)
            if r.scope % 8 != 0 && has_name(req, nm) == 0 { req = string_concat(req, "${nm}|") }
            if r.scope / 8 != 0 && has_name(resp, nm) == 0 { resp = string_concat(resp, "${nm}|") }
            k = k + 1
        }
        string.array_free(parts_)
        i = i + 1
    }
    out = string.copy("|")
    rs = string.split(string.copy(req), "|")
    k = 0
    while k < string.array_size(rs) {
        nm = string.array_get(rs, k)
        if nm != "" && has_name(resp, nm) == 1 { out = string_concat(out, "${nm}|") }
        k = k + 1
    }
    string.array_free(rs)
    return out
}
// Names used on one side only: their tokens are unnumbered. "|a|b|".
one_sided_names(l: ptr) -> string {
    two = two_sided_names(l)
    out = string.copy("|")
    i = 0
    while i < list_size(l) {
        ns = string.split(string.copy(rule_at(l, i).names), "|")
        k = 0
        while k < string.array_size(ns) {
            nm = string.array_get(ns, k)
            if nm != "" && has_name(two, nm) == 0 && has_name(out, nm) == 0 { out = string_concat(out, "${nm}|") }
            k = k + 1
        }
        string.array_free(ns)
        i = i + 1
    }
    return out
}

// ---- code spans (CommonMark) ----

backtick_run(s: string, i: int) -> int {
    j = i
    while char(s, j) == 96 { j = j + 1 }
    return j - i
}
code_span(s: string, i: int) -> (string, int, string) {
    n = backtick_run(s, i)
    if n == 0 { return "", i, "expected the pattern in backticks" }
    j = i + n
    while j < string.length(s) {
        if char(s, j) == 96 {
            m = backtick_run(s, j)
            if m == n {
                c = string.substring(s, i + n, j)
                cl = string.length(c)
                if cl >= 2 && char(c, 0) == 32 && char(c, cl - 1) == 32 && string.length(string.trim(c)) > 0 {
                    c = string.substring(c, 1, cl - 1)
                }
                return c, j + n, ""
            }
            j = j + m
        } else { j = j + 1 }
    }
    return "", i, "unclosed backticks"
}
render_span(c: string) -> string {
    longest = 0
    i = 0
    while i < string.length(c) {
        r = backtick_run(c, i)
        if r > longest { longest = r }
        if r > 0 { i = i + r } else { i = i + 1 }
    }
    fence = string.copy("")
    k = 0
    while k <= longest { fence = string_concat(fence, "`"); k = k + 1 }
    cl = string.length(c)
    pad = 0
    if cl > 0 && (char(c, 0) == 96 || char(c, cl - 1) == 96) { pad = 1 }
    if cl >= 2 && char(c, 0) == 32 && char(c, cl - 1) == 32 && string.length(string.trim(c)) > 0 { pad = 1 }
    if pad == 1 { return "${fence} ${c} ${fence}" }
    return "${fence}${c}${fence}"
}

// ---- scopes ----

scope_bits(word: string) -> int {
    if word == "request path" { return SCOPE_PATH }
    if word == "request headers" { return SCOPE_REQUEST_HEADERS }
    if word == "response headers" { return SCOPE_RESPONSE_HEADERS }
    if word == "headers" { return SCOPE_REQUEST_HEADERS + SCOPE_RESPONSE_HEADERS }
    if word == "request body" { return SCOPE_REQUEST_BODY }
    if word == "response body" { return SCOPE_RESPONSE_BODY }
    if word == "body" { return SCOPE_REQUEST_BODY + SCOPE_RESPONSE_BODY }
    return 0
}
scope_word(bits: int) -> string {
    if bits == SCOPE_PATH { return "request path" }
    if bits == SCOPE_REQUEST_HEADERS { return "request headers" }
    if bits == SCOPE_RESPONSE_HEADERS { return "response headers" }
    if bits == SCOPE_REQUEST_HEADERS + SCOPE_RESPONSE_HEADERS { return "headers" }
    if bits == SCOPE_REQUEST_BODY { return "request body" }
    if bits == SCOPE_RESPONSE_BODY { return "response body" }
    return "body"
}

// ---- regex helpers ----

// Every capture group, numbered, with its name when it has one:
// "1=|2=name|…". Named: (?<n>…), (?P<n>…), (?'n'…). Not captures: (?:…),
// lookarounds, flags, (*VERB). Branch reset (?|…) is refused.
capture_groups(p: string) -> (string, string) {
    out = string.copy("")
    count = 0
    in_class = 0
    i = 0
    n = string.length(p)
    while i < n {
        c = char(p, i)
        if c == 92 { i = i + 2; continue }
        if in_class == 1 {
            if c == 93 { in_class = 0 }
            i = i + 1
            continue
        }
        if c == 91 {
            in_class = 1
            if char(p, i + 1) == 94 { i = i + 1 }
            if char(p, i + 1) == 93 { i = i + 1 }
            i = i + 1
            continue
        }
        if c == 40 {
            d = char(p, i + 1)
            if d == 42 { i = i + 1; continue }
            if d != 63 {
                count = count + 1
                out = string_concat(out, "${string.from_int(count)}=|")
                i = i + 1
                continue
            }
            e = char(p, i + 2)
            if e == 124 { return "", "branch reset (?|…) is not supported" }
            ns = -1
            if e == 60 && char(p, i + 3) != 61 && char(p, i + 3) != 33 { ns = i + 3 }
            if e == 80 && char(p, i + 3) == 60 { ns = i + 4 }
            if e == 39 { ns = i + 3 }
            if ns >= 0 {
                ne = name_end(p, ns)
                count = count + 1
                out = string_concat(out, "${string.from_int(count)}=${string.substring(p, ns, ne)}|")
            }
        }
        i = i + 1
    }
    return out, ""
}

check_regex(p: string) -> string {
    re, err = regex.compile(string_concat(REGEX_LIMITS, p))
    if err != "" { return err }
    regex.free(re)
    return ""
}

regex_quote(s: string) -> string {
    out = string.copy("")
    i = 0
    while i < string.length(s) {
        c = char(s, i)
        if string.index_of("\\.^$|?*+()[]{}/", string.from_char(c)) >= 0 { out = string_concat(out, "\\") }
        out = string_concat(out, string.substring(s, i, i + 1))
        i = i + 1
    }
    return out
}

// An inline placeholder pattern: no anchors, no named groups.
check_inline(name: string, p: string) -> string {
    if p == "" { return "placeholder ${name} has an empty pattern" }
    in_class = 0
    i = 0
    while i < string.length(p) {
        c = char(p, i)
        if c == 92 { i = i + 2; continue }
        if in_class == 1 {
            if c == 93 { in_class = 0 }
        } else {
            if c == 91 {
                in_class = 1
                if char(p, i + 1) == 94 { i = i + 1 }
                if char(p, i + 1) == 93 { i = i + 1 }
            }
            if c == 94 || c == 36 { return "placeholder ${name}: `${p}` holds an anchor (^ or ${string.from_char(36)}); the text around a placeholder anchors it" }
        }
        i = i + 1
    }
    groups, gerr = capture_groups(p)
    if gerr != "" { return "placeholder ${name}: ${gerr}" }
    parts = string.split(string.copy(groups), "|")
    k = 0
    while k < string.array_size(parts) {
        g = string.array_get(parts, k)
        eqp = string.index_of(g, "=")
        if eqp >= 0 && eqp < string.length(g) - 1 {
            string.array_free(parts)
            return "placeholder ${name}: a named group inside a placeholder (the placeholder is the name)"
        }
        k = k + 1
    }
    string.array_free(parts)
    err = check_regex(p)
    if err != "" { return "placeholder ${name}: invalid pattern `${p}`: ${err}" }
    return ""
}

// ---- templates ----

// Compile a template: literal text quoted, each placeholder a named group.
// (regex, name-erased key text, inline patterns "name=pattern\n", error)
compile_template(t: string, style: int) -> (string, string, string, string) {
    o = marker_open(style)
    cl = marker_close(style)
    rx = string.copy("")
    names = string.copy("|")
    inlines = string.copy("")
    key = string.copy("")
    lit = string.copy("")
    prev_placeholder = 0
    count = 0
    i = 0
    n = string.length(t)
    while i < n {
        if at(t, i, o) == 1 {
            // A run of k backslashes before a marker stands for k/2 of them;
            // an odd run makes the marker literal.
            k = run_before(lit, string.length(lit), 0)
            if k > 0 {
                lit = string_concat(string.substring(lit, 0, string.length(lit) - k), backslashes(k / 2))
                if k % 2 == 1 {
                    lit = string_concat(lit, o)
                    i = i + string.length(o)
                    continue
                }
            }
            p = i + string.length(o)
            ne = name_end(t, p)
            name = string.substring(t, p, ne)
            if name == "" { return "", "", "", "a placeholder needs a name: ${o}name${cl}" }
            if string.index_of(names, "|${name}|") >= 0 { return "", "", "", "placeholder ${name} appears twice in one template; write a rule for each" }
            if prev_placeholder == 1 && lit == "" { return "", "", "", "placeholders need literal text between them" }
            inline = ""
            if at(t, ne, cl) == 1 {
                i = ne + string.length(cl)
            } else if char(t, ne) == 58 {
                // The pattern runs to the close marker once its braces and
                // brackets are balanced (escaped ones do not count).
                depth = 0
                j = ne + 1
                found = -1
                while j < n {
                    c = char(t, j)
                    if c == 92 { j = j + 2; continue }
                    if depth == 0 && at(t, j, cl) == 1 { found = j; break }
                    if c == 123 || c == 91 { depth = depth + 1 }
                    if c == 125 || c == 93 { depth = depth - 1 }
                    if depth < 0 { return "", "", "", "placeholder ${name}: unbalanced braces or brackets in its pattern" }
                    j = j + 1
                }
                if found < 0 { return "", "", "", "placeholder ${name}: no closing ${cl} (are the pattern's braces and brackets balanced?)" }
                inline = string.substring(t, ne + 1, found)
                inlines = string_concat(inlines, "${name}=${inline}\n")
                ierr = check_inline(name, inline)
                if ierr != "" { return "", "", "", ierr }
                i = found + string.length(cl)
            } else {
                return "", "", "", "placeholder at `${string.substring(t, i, ne + 1)}`: a name is letters, digits and _, then ${cl} or :pattern${cl}"
            }
            rx = string_concat(rx, regex_quote(lit))
            key = string_concat(key, lit)
            lit = string.copy("")
            group = "[^\\r\\n]+?"
            if inline != "" { group = inline }
            // Last in the template: it runs to the end of the line, trailing
            // blanks excluded.
            tail = 1
            k = i
            while k < n { if ws(char(t, k)) == 0 { tail = 0 }; k = k + 1 }
            if inline == "" && tail == 1 { group = "[^\\r\\n]*?[^\\s](?=[ \\t]*(?:\\r|\\n|$))" }
            rx = string_concat(rx, "(?<${name}>${group})")
            key = string_concat(key, string_concat(string_concat(o, ":${inline}"), cl))
            names = string_concat(names, "${name}|")
            count = count + 1
            prev_placeholder = 1
            continue
        }
        lit = string_concat(lit, string.substring(t, i, i + 1))
        i = i + 1
    }
    rx = string_concat(rx, regex_quote(lit))
    key = string_concat(key, lit)
    if count == 0 { return "", "", "", "a template needs at least one placeholder, ${o}name${cl}" }
    return rx, key, inlines, ""
}

// ---- rules ----

new_rule() -> *VRule {
    r = malloc(sizeof(VRule)) as *VRule
    r.scope = 0
    r.pattern = ""; r.compiled = ""; r.names = ""; r.groups = ""
    r.line = ""; r.key = ""; r.origin = ""; r.inlines = ""
    return r
}
rule_at(l: ptr, i: int) -> *VRule { return list_get_raw(l, i) as *VRule }
rule_count(l: ptr) -> int { return list_size(l) }
rule_line(l: ptr, i: int) -> string { return rule_at(l, i).line }
rule_names(l: ptr, i: int) -> string { return rule_at(l, i).names }
rule_applies(l: ptr, i: int, field_bit: int) -> int {
    if (rule_at(l, i).scope / field_bit) % 2 == 1 { return 1 }
    return 0
}
// Every placeholder name of every rule, "|"-separated.
all_names(l: ptr) -> string {
    out = string.copy("")
    i = 0
    while i < list_size(l) {
        out = string_concat(out, "|${rule_at(l, i).names}")
        i = i + 1
    }
    return out
}
// Names no request-side rule has: a token of one is never bound by a
// request, so its replay value must be supplied ("|"-separated).
response_only_names(l: ptr) -> string {
    request_names = string.copy("")
    i = 0
    while i < list_size(l) {
        r = rule_at(l, i)
        if r.scope % 8 != 0 { request_names = string_concat(request_names, "|${r.names}") }
        i = i + 1
    }
    out = string.copy("")
    i = 0
    while i < list_size(l) {
        parts = string.split(string.copy(rule_at(l, i).names), "|")
        k = 0
        while k < string.array_size(parts) {
            nm = string.array_get(parts, k)
            if has_name(request_names, nm) == 0 && has_name(out, nm) == 0 {
                if out != "" { out = string_concat(out, "|") }
                out = string_concat(out, nm)
            }
            k = k + 1
        }
        string.array_free(parts)
        i = i + 1
    }
    return out
}

// Add one rule (scope words, kind "template" or "regex", pattern) to `out`.
// "" or the error. The same rule twice counts once; the same text with other
// placeholder names is a conflict.
add_rule(out: ptr, scope: string, kind: string, pattern: string, style: int, origin: string) -> string {
    bits = scope_bits(scope)
    if bits == 0 { return "volatile rule scope `${scope}`: expected request path, request headers, response headers, headers, request body, response body or body" }
    r = new_rule()
    r.scope = bits
    r.pattern = string.copy(pattern)
    r.origin = string.copy(origin)
    sw = scope_word(bits)
    if kind == "template" {
        rx, key, inl, err = compile_template(pattern, style)
        if err != "" { return "volatile rule `${sw}: ${render_span(pattern)}`: ${err}" }
        r.compiled = rx
        r.inlines = inl
        r.key = "${sw}: ${key}"
        r.line = "${sw}: ${render_span(pattern)}"
    } else if kind == "regex" {
        err = check_regex(pattern)
        if err != "" { return "volatile rule `${sw} regex: ${render_span(pattern)}`: invalid regex: ${err}" }
        r.compiled = pattern
        r.key = "${sw} regex: ${pattern}"
        r.line = "${sw} regex: ${render_span(pattern)}"
    } else {
        return "volatile rule kind `${kind}`: expected template or regex"
    }
    groups, gerr = capture_groups(r.compiled)
    if gerr != "" { return "volatile rule `${r.line}`: ${gerr}" }
    names = string.copy("")
    nums = string.copy("")
    parts = string.split(string.copy(groups), "|")
    k = 0
    while k < string.array_size(parts) {
        g = string.array_get(parts, k)
        eqp = string.index_of(g, "=")
        if eqp > 0 && eqp < string.length(g) - 1 {
            nm = string.substring(g, eqp + 1, string.length(g))
            if valid_name(nm) == 0 { return "volatile rule `${r.line}`: group name ${nm} is not a placeholder name ([A-Za-z_][A-Za-z0-9_]*)" }
            if names != "" { names = string_concat(names, "|"); nums = string_concat(nums, "|") }
            names = string_concat(names, nm)
            nums = string_concat(nums, string.substring(g, 0, eqp))
        }
        k = k + 1
    }
    string.array_free(parts)
    if names == "" { return "volatile rule `${r.line}`: a regex rule needs a named group, (?<name>…)" }
    r.names = names
    r.groups = nums
    r.compiled = string_concat(REGEX_LIMITS, r.compiled)
    j = 0
    while j < list_size(out) {
        o = rule_at(out, j)
        if o.line == r.line { return "" }
        if o.key == r.key {
            return "volatile rule `${r.line}`${origin} conflicts with `${o.line}`${o.origin}: the same text, other placeholder names"
        }
        j = j + 1
    }
    list_add_raw(out, r)
    return ""
}

// One rule line: scope: `template`, or scope regex: `regex`.
parse_line(line: string, out: ptr, style: int, origin: string) -> string {
    colon = string.index_of(line, ": ")
    if colon < 0 { return "`${line}`: expected scope: `pattern`" }
    head = string.substring(line, 0, colon)
    kind = "template"
    if string.ends_with(head, " regex") == 1 {
        kind = "regex"
        head = string.substring(head, 0, string.length(head) - 6)
    }
    p, after, err = code_span(line, colon + 2)
    if err != "" { return "`${line}`: ${err}" }
    if string.length(string.trim(string.substring(line, after, string.length(line)))) > 0 { return "`${line}`: text after the pattern" }
    return add_rule(out, head, kind, p, style, origin)
}

// A "## Volatile values" block (its heading, blank lines, "- rule" lines)
// into `out`. Errors name the line.
parse_block(text: string, out: ptr, style: int, origin: string) -> string {
    lines = string.split(string.copy(text), "\n")
    n = string.array_size(lines)
    i = 0
    while i < n {
        line = string.array_get(lines, i)
        if string.ends_with(line, "\r") == 1 { line = string.substring(line, 0, string.length(line) - 1) }
        num = i + 1
        i = i + 1
        if string.length(string.trim(line)) == 0 { continue }
        if string.starts_with(line, HEADING) == 1 {
            v = string.trim(string.substring(line, string.length(HEADING), string.length(line)))
            if v != "" && v != "(v1)" { return "line ${num}: `${line}`: unknown grammar version (this reader knows v1)" }
            continue
        }
        if string.starts_with(line, "- ") == 0 { return "line ${num}: `${line}`: a rule line starts with \"- \"" }
        err = parse_line(string.substring(line, 2, string.length(line)), out, style, origin)
        if err != "" { return "line ${num}: ${err}" }
    }
    string.array_free(lines)
    return ""
}

// The block in `text` (its heading to the next "## " or the end), or "".
block_in(text: string) -> string {
    first = -1
    if string.starts_with(text, HEADING) == 1 { first = 0 }
    else {
        p = string.index_of(text, string_concat("\n", HEADING))
        if p >= 0 { first = p + 1 }
    }
    if first < 0 { return "" }
    nl = string.index_of_from(text, "\n", first)
    if nl < 0 { return string.substring(text, first, string.length(text)) }
    next = string.index_of_from(text, "\n## ", nl)
    if next < 0 { return string.substring(text, first, string.length(text)) }
    return string.substring(text, first, next + 1)
}

// A profile's marker style, from its first line: "Markers: Mustache",
// "Markers: DollarCurly" or "Markers: Wikilink"; -1 when it has none.
profile_style(text: string) -> int {
    nl = string.index_of(text, "\n")
    first = text
    if nl >= 0 { first = string.substring(text, 0, nl) }
    first = string.trim(first)
    if first == "Markers: Mustache" { return MUSTACHE }
    if first == "Markers: DollarCurly" { return DOLLAR_CURLY }
    if first == "Markers: Wikilink" { return WIKILINK }
    return -1
}

render_block(rules: ptr) -> string {
    n = list_size(rules)
    if n == 0 { return "" }
    string[] lines = []
    i = 0
    while i < n { lines.push(rule_at(rules, i).line); i = i + 1 }
    i = 1
    while i < lines.len {
        cur = lines[i]
        j = i - 1
        while j >= 0 && string.compare(lines[j], cur) > 0 { lines[j + 1] = lines[j]; j = j - 1 }
        lines[j + 1] = cur
        i = i + 1
    }
    out = "${HEADING}\n\n"
    i = 0
    while i < lines.len { out = string_concat(out, "- ${lines[i]}\n"); i = i + 1 }
    return string_concat(out, "\n")
}

// ---- finding values ----

span_add(l: ptr, start: int, end: int, rule: int, name: string) {
    s = malloc(sizeof(VSpan)) as *VSpan
    s.start = start; s.end = end; s.rule = rule; s.name = string.copy(name)
    list_add_raw(l, s)
}
span_at(res: ptr, i: int) -> *VSpan { return list_get_raw((res as *SpanResult).spans, i) as *VSpan }
span_count(res: ptr) -> int { return list_size((res as *SpanResult).spans) }
span_start(res: ptr, i: int) -> int { return span_at(res, i).start }
span_end(res: ptr, i: int) -> int { return span_at(res, i).end }
span_rule(res: ptr, i: int) -> int { return span_at(res, i).rule }
span_name(res: ptr, i: int) -> string { return span_at(res, i).name }
span_warnings(res: ptr) -> string { return (res as *SpanResult).warnings }

// One rule's named-group values in `s`, match after match, each search
// starting where the last match ended. "" or a warning (a limit).
rule_spans(r: *VRule, ri: int, s: string, out: ptr) -> string {
    if string.length(s) > REGEX_MAX_INPUT { return "`${r.line}` not run: the field is larger than 4 MiB" }
    re, err = regex.compile(r.compiled)
    if err != "" { return "`${r.line}`: ${err}" }
    names = string.split(string.copy(r.names), "|")
    nums = string.split(string.copy(r.groups), "|")
    k = string.array_size(names)
    pos = 0
    count = 0
    warn = ""
    while pos <= string.length(s) && count < MAX_MATCHES {
        regex.clear_last_error()
        caps, cerr = regex.captures(re, string.substring(s, pos, string.length(s)))
        if caps == null {
            e = cerr
            if e == "" { e = regex.last_error() }
            if e != "" { warn = "`${r.line}` stopped: ${e} (the match limit; nothing more selected in this field)" }
            break
        }
        g = 0
        while g < k {
            gi, _e2 = string.to_int(string.array_get(nums, g))
            gs = regex.capture_start(caps, gi)
            ge = regex.capture_end(caps, gi)
            if gs >= 0 && ge > gs { span_add(out, pos + gs, pos + ge, ri, string.array_get(names, g)) }
            g = g + 1
        }
        ms = regex.capture_start(caps, 0)
        me = regex.capture_end(caps, 0)
        regex.captures_free(caps)
        if me <= ms { pos = pos + me + 1 } else { pos = pos + me }
        count = count + 1
    }
    string.array_free(names)
    string.array_free(nums)
    regex.free(re)
    return warn
}

// Every value the rules select in one field's text, in text order;
// overlaps dropped (the earlier start wins; at one start, the earlier rule).
find_spans(rules: ptr, field_bit: int, s: string) -> ptr {
    raw = list_new()
    warnings = string.copy("")
    i = 0
    while i < list_size(rules) {
        if rule_applies(rules, i, field_bit) == 1 {
            w = rule_spans(rule_at(rules, i), i, s, raw)
            if w != "" { warnings = string_concat(warnings, "${w}\n") }
        }
        i = i + 1
    }
    n = list_size(raw)
    i = 1
    while i < n {
        cur = list_get_raw(raw, i) as *VSpan
        j = i - 1
        while j >= 0 {
            prev = list_get_raw(raw, j) as *VSpan
            if prev.start > cur.start || (prev.start == cur.start && prev.rule > cur.rule) {
                list_set(raw, j + 1, prev)
                j = j - 1
            } else { break }
        }
        list_set(raw, j + 1, cur)
        i = i + 1
    }
    kept = list_new()
    last_end = -1
    i = 0
    while i < n {
        sp = list_get_raw(raw, i) as *VSpan
        if sp.start >= last_end {
            list_add_raw(kept, sp)
            last_end = sp.end
        }
        i = i + 1
    }
    res = malloc(sizeof(SpanResult)) as *SpanResult
    res.spans = kept
    res.warnings = warnings
    return res as ptr
}

// The inline patterns rules give placeholder `name` ("\n"-separated).
inline_patterns(l: ptr, name: string) -> string {
    out = string.copy("")
    i = 0
    while i < list_size(l) {
        lines = string.split(string.copy(rule_at(l, i).inlines), "\n")
        k = 0
        while k < string.array_size(lines) {
            x = string.array_get(lines, k)
            if string.starts_with(x, "${name}=") == 1 { out = string_concat(out, "${string.substring(x, string.length(name) + 1, string.length(x))}\n") }
            k = k + 1
        }
        string.array_free(lines)
        i = i + 1
    }
    return out
}
// 1 when `value` matches the whole of `pattern`.
value_fits(pattern: string, value: string) -> int {
    re, err = regex.compile(string_concat(REGEX_LIMITS, "^(?:${pattern})\\z"))
    if err != "" { return 0 }
    ok = regex.matches(re, value)
    regex.free(re)
    return ok
}
