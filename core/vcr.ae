// ---- whole-tape normalization storage ----

// Register a whole-tape rule. The pattern is validated by compiling it once
// here so a bad regex fails at config time (returns 0 + load_err) rather than
// silently no-op'ing at flush. Correlate mode passes name + replacement="";
// collapse mode passes name="" + the constant replacement.
vcr_add_normalization(pattern: string, name: string, replacement: string) -> int {
    re, err = regex.compile(pattern)
    if err != "" {
        set_load_err(string_concat("invalid normalize pattern: ", err))
        return 0
    }
    regex.free(re)
    r = malloc(sizeof(Normalization)) as *Normalization
    r.pattern = string.copy(pattern)
    r.name = string.copy(name)
    r.replacement = string.copy(replacement)
    r.description = string.copy("")
    list_add_raw(normalizations(), r)
    return 1
}

// Describe the whole-tape rule added last, for the recording-rules footer.
describe_last_normalization_k(key: string, description: string) {
    l = normalizations_k(key)
    n = list_size(l)
    if n == 0 { return }
    r = list_get_raw(l, n - 1) as *Normalization
    r.description = string.copy(description)
}
vcr_clear_normalizations() { list_reset(slot(cur_key(), "normalizations")) }
vcr_get_normalization_count() -> int { return list_size(normalizations()) }
vcr_get_normalization_pattern(i: int) -> string {
    if i < 0 || i >= list_size(normalizations()) { return "" }
    return (list_get_raw(normalizations(), i) as *Normalization).pattern
}
vcr_get_normalization_name(i: int) -> string {
    if i < 0 || i >= list_size(normalizations()) { return "" }
    return (list_get_raw(normalizations(), i) as *Normalization).name
}
vcr_get_normalization_replacement(i: int) -> string {
    if i < 0 || i >= list_size(normalizations()) { return "" }
    return (list_get_raw(normalizations(), i) as *Normalization).replacement
}

// Look up the token already assigned to `val` this emit, or "" if none yet.
norm_token_for_k(key: string, val: string) -> string {
    l = normtokens_k(key)
    nt = list_size(l)
    i = 0
    while i < nt {
        e = list_get_raw(l, i) as *NormToken
        if e.value == val { return e.token }
        i = i + 1
    }
    return ""
}
norm_token_for(val: string) -> string {
    return norm_token_for_k(cur_key(), val)
}

norm_token_add_k(key: string, value: string, token: string) {
    e = malloc(sizeof(NormToken)) as *NormToken
    e.value = string.copy(value)
    e.token = string.copy(token)
    list_add_raw(normtokens_k(key), e)
}
norm_token_add(value: string, token: string) {
    norm_token_add_k(cur_key(), value, token)
}

// Scan one field string for every match of `re`, assigning a fresh
// {{name-N}} token to each value not seen before this emit. `counter` is the
// running per-rule index; returns it advanced past any tokens minted here.
scan_field_for_norm_k(key: string, re: ptr, name: string, s: string, counter: int) -> int {
    if string.length(s) == 0 { return counter }
    fa, ferr = regex.find_all(re, s)
    if ferr != "" { return counter }
    m = regex.find_all_count(fa)
    c = counter
    i = 0
    while i < m {
        st = regex.find_all_start(fa, i)
        en = regex.find_all_end(fa, i)
        val = string.substring(s, st, en)
        if norm_token_for_k(key, val) == "" {
            c = c + 1
            tok = string_concat("{{", name)
            tok = string_concat(tok, "-")
            tok = string_concat(tok, string.from_int(c))
            tok = string_concat(tok, "}}")
            norm_token_add_k(key, val, tok)
        }
        i = i + 1
    }
    regex.find_all_free(fa)
    return c
}

// Build the per-emit value->token table by walking interactions in document
// order and, within each, fields in canonical order (path, request headers,
// request body, response headers, response body). First appearance wins the
// next token index, so the table — and therefore the flushed tape — is
// deterministic across re-records regardless of the live values seen.
build_normalization_map_k(key: string) {
    list_reset(slot(key, "normtokens"))
    norms = normalizations_k(key)
    nr = list_size(norms)
    if nr == 0 { return }
    n = list_size(tape_list_k(key))
    ri = 0
    while ri < nr {
        r = list_get_raw(norms, ri) as *Normalization
        pattern = string.copy(r.pattern)
        name = string.copy(r.name)
        repl = r.replacement
        // Collapse rules (replacement set) need no token table — they're a
        // straight regex replace_all in apply_normalizations. Only correlate
        // rules build first-appearance tokens here.
        if string.length(repl) > 0 {
            ri = ri + 1
        } else {
        re, err = regex.compile(pattern)
        if err == "" {
            counter = 0
            ii = 0
            while ii < n {
                e = tape_get_k(key, ii)
                counter = scan_field_for_norm_k(key, re, name, string.copy(e.path), counter)
                counter = scan_field_for_norm_k(key, re, name, string.copy(e.req_headers), counter)
                counter = scan_field_for_norm_k(key, re, name, string.copy(e.req_body), counter)
                // The ordered fields, so tokens are numbered in the order the
                // tape writes them (stable order, when registered).
                counter = scan_field_for_norm_k(key, re, name, string.copy(ordered_field_k(key, e, FIELD_RESPONSE_HEADERS)), counter)
                counter = scan_field_for_norm_k(key, re, name, string.copy(ordered_field_k(key, e, FIELD_RESPONSE_BODY)), counter)
                ii = ii + 1
            }
            regex.free(re)
        }
        ri = ri + 1
        }
    }
}
build_normalization_map() {
    build_normalization_map_k(cur_key())
}

// Apply the built value->token table to one field string. Substitution is a
// literal replace of each captured value (the regex already ran in the build
// pass). Tokens are applied in first-appearance order; this assumes captured
// values are not substrings of one another (true for ids/uuids/etags) — the
// common Servirtium normalization shapes.
apply_normalizations_k(key: string, s: string) -> string {
    out = s

    // Collapse rules first: regex replace_all every match to its constant.
    norms = normalizations_k(key)
    nr = list_size(norms)
    i = 0
    while i < nr {
        r = list_get_raw(norms, i) as *Normalization
        repl = r.replacement
        if string.length(repl) > 0 {
            re, err = regex.compile(string.copy(r.pattern))
            if err == "" {
                rep, rerr = regex.replace_all(re, out, repl)
                if rerr == "" { out = rep }
                regex.free(re)
            }
        }
        i = i + 1
    }

    // Correlate rules: literal replace of each captured value with its token.
    l = normtokens_k(key)
    nt = list_size(l)
    j = 0
    while j < nt {
        e = list_get_raw(l, j) as *NormToken
        out = str_replace_all(out, e.value, e.token)
        j = j + 1
    }
    return out
}
apply_normalizations(s: string) -> string {
    return apply_normalizations_k(cur_key(), s)
}

valid_header_removal_field(field: int) -> int {
    if field == FIELD_REQUEST_HEADERS { return 1 }
    if field == FIELD_RESPONSE_HEADERS { return 1 }
    return 0
}

vcr_add_header_removal(field: int, name: string) -> int {
    if valid_header_removal_field(field) == 0 {
        set_load_err("header removal only supports request/response header fields")
        return 0
    }
    if string.length(name) == 0 {
        set_load_err("header removal requires a header name")
        return 0
    }
    h = malloc(sizeof(HeaderRemoval)) as *HeaderRemoval
    h.field = field
    h.name = string.copy(name)
    h.origin = string.copy("")
    list_add_raw(header_removals(), h)
    return 1
}
vcr_clear_header_removals() { list_reset(slot(cur_key(), "header_removals")) }

vcr_get_header_removal_count() -> int { return list_size(header_removals()) }
vcr_get_header_removal_field(i: int) -> int {
    if i < 0 || i >= list_size(header_removals()) { return 0 }
    return (list_get_raw(header_removals(), i) as *HeaderRemoval).field
}
vcr_get_header_removal_name(i: int) -> string {
    if i < 0 || i >= list_size(header_removals()) { return "" }
    return (list_get_raw(header_removals(), i) as *HeaderRemoval).name
}

header_removed_for_field_k(key: string, field: int, name: string) -> int {
    l = header_removals_k(key)
    n = list_size(l)
    i = 0
    while i < n {
        h = list_get_raw(l, i) as *HeaderRemoval
        if h.field == field && icmp_rt(h.name, name) == 0 { return 1 }
        i = i + 1
    }
    return 0
}
header_removed_for_field(field: int, name: string) -> int {
    return header_removed_for_field_k(cur_key(), field, name)
}

// ---- ByHeader: match on specific named request headers (opt-in) ----

vcr_add_match_header(name: string) -> int {
    if string.length(name) == 0 {
        set_load_err("match-header requires a header name")
        return 0
    }
    h = malloc(sizeof(MatchHeaderName)) as *MatchHeaderName
    h.name = string.copy(name)
    list_add_raw(match_headers(), h)
    return 1
}
vcr_clear_match_headers() { list_reset(slot(cur_key(), "match_headers")) }

// The value of header `name` in a recorded "Name: value\n..." block, or "" if
// the block doesn't carry it. Case-insensitive on the name.
header_value_in_block(block: string, name: string) -> string {
    blen = string.length(block)
    cursor = 0
    while cursor < blen {
        nl = string.index_of_from(block, "\n", cursor)
        line_end = blen
        if nl >= 0 { line_end = nl }
        line = string.substring(block, cursor, line_end)
        ll = string.length(line)
        if ll > 0 && string.char_at(line, ll - 1) == 13 { line = string.substring(line, 0, ll - 1) }
        colon = string.index_of(line, ":")
        if colon > 0 {
            hn = string.substring(line, 0, colon)
            if icmp_rt(hn, name) == 0 {
                return trim_leading_ws(string.substring(line, colon + 1, string.length(line)))
            }
        }
        if nl < 0 { break }
        cursor = nl + 1
    }
    return ""
}

// For each ByHeader-registered name, require the live request's value to equal
// the recorded interaction's value (`block`). Returns "" when all match (or none
// registered), else a diagnostic naming the first mismatch. A header the tape
// didn't record reads as "" — so a request that carries it won't match, exactly
// like matching on any other recorded value.
match_headers_diff_k(srvkey: string, block: string, req: ptr) -> string {
    l = match_headers_k(srvkey)
    n = list_size(l)
    i = 0
    while i < n {
        name = (list_get_raw(l, i) as *MatchHeaderName).name
        recorded_v = header_value_in_block(block, name)
        live_v = request_header_value(req, name)
        if string.equals(recorded_v, live_v) == 0 {
            return "request header '${name}' differs — recorded '${recorded_v}', live '${live_v}'"
        }
        i = i + 1
    }
    return ""
}

// ---- static mounts ----

strip_trailing_slash(s: string) -> string {
    n = string.length(s)
    if n > 1 && string.char_at(s, n - 1) == 47 {
        return string.substring(s, 0, n - 1)
    }
    return s
}

vcr_add_static_content(mount_path: string, fs_dir: string) -> int {
    if string.length(mount_path) == 0 {
        set_load_err("vcr_add_static_content: null mount_path or fs_dir")
        return 0
    }
    if string.char_at(mount_path, 0) != 47 {
        set_load_err("vcr_add_static_content: mount_path must start with '/'")
        return 0
    }
    m = malloc(sizeof(StaticMount)) as *StaticMount
    m.mount_path = string.copy(strip_trailing_slash(mount_path))
    m.fs_dir = string.copy(strip_trailing_slash(fs_dir))
    list_add_raw(mounts(), m)
    return 1
}
vcr_clear_static_content() { list_reset(slot(cur_key(), "mounts")) }

// ---- untaped paths ----

vcr_add_untaped(path: string) -> int {
    if string.length(path) == 0 || string.char_at(path, 0) != 47 {
        set_load_err("vcr_add_untaped: path must start with '/'")
        return 0
    }
    // store path strings; std.list of heap strings. Wrap in a 1-field
    // struct so the element is a stable ptr.
    s = malloc(sizeof(StaticMount)) as *StaticMount
    s.mount_path = string.copy(path)
    s.fs_dir = string.copy("")
    list_add_raw(untaped_list(), s)
    return 1
}
vcr_clear_untaped() { list_reset(slot(cur_key(), "untaped")) }

path_is_untaped_k(key: string, path: string) -> int {
    if string.length(path) == 0 { return 0 }
    l = untaped_list_k(key)
    n = list_size(l)
    i = 0
    while i < n {
        s = list_get_raw(l, i) as *StaticMount
        if string.equals(path, s.mount_path) == 1 { return 1 }
        i = i + 1
    }
    return 0
}
path_is_untaped(path: string) -> int {
    return path_is_untaped_k(cur_key(), path)
}

// Find the static mount whose mount_path prefixes `path` (longest-prefix
// not needed — mounts are exact prefixes and don't overlap in practice).
// Returns the *StaticMount or null.
static_mount_for_k(key: string, path: string) -> *StaticMount {
    if string.length(path) == 0 { return null }
    l = mounts_k(key)
    n = list_size(l)
    i = 0
    while i < n {
        m = list_get_raw(l, i) as *StaticMount
        mp = m.mount_path
        mlen = string.length(mp)
        // path must equal mp or start with mp + "/" (so "/assets" matches
        // "/assets" and "/assets/x" but not "/assetsX").
        if string.starts_with(path, mp) == 1 {
            if string.length(path) == mlen { return m }
            if string.char_at(path, mlen) == 47 { return m }
        }
        i = i + 1
    }
    return null
}

// ---- string / ascii helpers ----

// Lowercase ASCII compare. -1 / 0 / 1. Public so vcr.ae can reuse.
icmp_rt(a: string, b: string) -> int {
    al = string.length(a)
    bl = string.length(b)
    minl = al
    if bl < minl { minl = bl }
    i = 0
    while i < minl {
        ca = string.char_at(a, i)
        cb = string.char_at(b, i)
        if ca >= 65 && ca <= 90 { ca = ca + 32 }
        if cb >= 65 && cb <= 90 { cb = cb + 32 }
        if ca != cb {
            if ca < cb { return -1 }
            return 1
        }
        i = i + 1
    }
    if al < bl { return -1 }
    if al > bl { return 1 }
    return 0
}

// Case-insensitive substring search.
ascii_ci_contains(haystack: string, needle: string) -> int {
    nl = string.length(needle)
    if nl == 0 { return 0 }
    hl = string.length(haystack)
    h = 0
    // Only start positions where the full needle can still fit.
    while h + nl <= hl {
        matched = 1
        i = 0
        while i < nl {
            a = string.char_at(haystack, h + i)
            b = string.char_at(needle, i)
            if a >= 65 && a <= 90 { a = a + 32 }
            if b >= 65 && b <= 90 { b = b + 32 }
            if a != b { matched = 0 ; i = nl ; break }
            i = i + 1
        }
        if matched == 1 { return 1 }
        h = h + 1
    }
    return 0
}

is_blank(s: string) -> int {
    n = string.length(s)
    i = 0
    while i < n {
        c = string.char_at(s, i)
        if c != 32 && c != 9 && c != 10 && c != 13 { return 0 }
        i = i + 1
    }
    return 1
}

// Pull the first header name out of "Name: ...\n..." up to ':' or '\n'.
first_header_name(recorded: string) -> string {
    n = string.length(recorded)
    i = 0
    while i < n {
        c = string.char_at(recorded, i)
        if c == 58 || c == 10 { break }
        i = i + 1
    }
    return string.substring(recorded, 0, i)
}

// Replace-all (mirror str_replace_all in vcr.ae / C replace_all_c).
replace_all(src: string, pattern: string, replacement: string) -> string {
    plen = string.length(pattern)
    if plen == 0 { return string.copy(src) }
    out = string.copy("")
    cursor = 0
    src_len = string.length(src)
    while cursor < src_len {
        idx = string.index_of_from(src, pattern, cursor)
        if idx < 0 {
            tail = string.substring(src, cursor, src_len)
            out = string_concat(out, tail)
            return out
        }
        chunk = string.substring(src, cursor, idx)
        out = string_concat(out, chunk)
        out = string_concat(out, replacement)
        cursor = idx + plen
    }
    return out
}

rt_apply_unredactions_for_k(srvkey: string, src: string, field: int) -> string {
    out = string.copy(src)
    l = unredactions_k(srvkey)
    n = list_size(l)
    i = 0
    while i < n {
        r = list_get_raw(l, i) as *Redaction
        if r.field == field {
            before = out
            out = replace_all(out, r.pattern, r.replacement)
            if out != before { r.used = 1 }
        }
        i = i + 1
    }
    return out
}
rt_apply_unredactions_for(src: string, field: int) -> string {
    return rt_apply_unredactions_for_k(cur_key(), src, field)
}

// Remove headers matching a removal-field from a "Name: Value\n..." block.
// The header block with its Content-Length line's value set to `n`; a block
// without one comes back unchanged.
set_content_length_in_block(headers: string, n: int) -> string {
    if string.length(headers) == 0 { return headers }
    out = string.copy("")
    cursor = 0
    h_len = string.length(headers)
    while cursor < h_len {
        nl_idx = string.index_of_from(headers, "\n", cursor)
        line_end = h_len
        if nl_idx >= 0 { line_end = nl_idx }
        line = string.substring(headers, cursor, line_end)
        colon_idx = string.index_of(line, ":")
        if colon_idx > 0 && icmp_rt(string.substring(line, 0, colon_idx), "Content-Length") == 0 {
            line = string_concat(string.substring(line, 0, colon_idx), ": ${n}")
        }
        out = string_concat(out, line)
        if nl_idx >= 0 { out = string_concat(out, "\n") }
        if nl_idx < 0 { break }
        cursor = nl_idx + 1
    }
    return out
}

// A recorded request-header block without the headers matching skips (see
// skip_in_matching), so a tape that records Host, Connection or
// Content-Length still matches a playback request sent to another address.
strip_transport_headers(headers: string) -> string {
    if string.length(headers) == 0 { return string.copy("") }
    out = string.copy("")
    cursor = 0
    h_len = string.length(headers)
    while cursor < h_len {
        nl_idx = string.index_of_from(headers, "\n", cursor)
        line_end = h_len
        if nl_idx >= 0 { line_end = nl_idx }
        line = string.substring(headers, cursor, line_end)
        keep = 1
        colon_idx = string.index_of(line, ":")
        if colon_idx > 0 && skip_in_matching(string.substring(line, 0, colon_idx)) == 1 { keep = 0 }
        if keep == 1 && string.length(line) > 0 {
            out = string_concat(out, line)
            if nl_idx >= 0 { out = string_concat(out, "\n") }
        }
        if nl_idx < 0 { break }
        cursor = nl_idx + 1
    }
    return out
}

remove_headers_from_block_k(srvkey: string, headers: string, field: int) -> string {
    if string.length(headers) == 0 { return string.copy("") }
    out = string.copy("")
    cursor = 0
    h_len = string.length(headers)
    while cursor < h_len {
        nl_idx = string.index_of_from(headers, "\n", cursor)
        line_end = h_len
        if nl_idx >= 0 { line_end = nl_idx }
        line = string.substring(headers, cursor, line_end)
        line_len = string.length(line)
        name_line = line
        if line_len > 0 && string.char_at(line, line_len - 1) == 13 {
            name_line = string.substring(line, 0, line_len - 1)
        }
        keep = 1
        colon_idx = string.index_of(name_line, ":")
        if colon_idx > 0 {
            name = string.substring(name_line, 0, colon_idx)
            if header_removed_for_field_k(srvkey, field, name) == 1 { keep = 0 }
        }
        if keep == 1 && line_len > 0 {
            out = string_concat(out, line)
            if nl_idx >= 0 { out = string_concat(out, "\n") }
        }
        if nl_idx < 0 { break }
        cursor = nl_idx + 1
    }
    return out
}
remove_headers_from_block(headers: string, field: int) -> string {
    if string.length(headers) == 0 { return string.copy("") }
    out = string.copy("")
    cursor = 0
    h_len = string.length(headers)
    while cursor < h_len {
        nl_idx = string.index_of_from(headers, "\n", cursor)
        line_end = h_len
        if nl_idx >= 0 { line_end = nl_idx }
        line = string.substring(headers, cursor, line_end)
        line_len = string.length(line)
        // trim trailing CR for the name lookup
        name_line = line
        if line_len > 0 && string.char_at(line, line_len - 1) == 13 {
            name_line = string.substring(line, 0, line_len - 1)
        }
        keep = 1
        colon_idx = string.index_of(name_line, ":")
        if colon_idx > 0 {
            name = string.substring(name_line, 0, colon_idx)
            if header_removed_for_field(field, name) == 1 { keep = 0 }
        }
        if keep == 1 && line_len > 0 {
            out = string_concat(out, line)
            if nl_idx >= 0 { out = string_concat(out, "\n") }
        }
        if nl_idx < 0 { break }
        cursor = nl_idx + 1
    }
    return out
}

is_hop_by_hop_header(name: string) -> int {
    if string.length(name) == 0 { return 1 }
    if icmp_rt(name, "Host") == 0 { return 1 }
    if icmp_rt(name, "Connection") == 0 { return 1 }
    if icmp_rt(name, "Content-Length") == 0 { return 1 }
    if icmp_rt(name, "Transfer-Encoding") == 0 { return 1 }
    if icmp_rt(name, "Keep-Alive") == 0 { return 1 }
    if icmp_rt(name, "Proxy-Authenticate") == 0 { return 1 }
    if icmp_rt(name, "Proxy-Authorization") == 0 { return 1 }
    if icmp_rt(name, "TE") == 0 { return 1 }
    if icmp_rt(name, "Trailer") == 0 { return 1 }
    if icmp_rt(name, "Upgrade") == 0 { return 1 }
    return 0
}

// A request header playback matching does not compare: the hop-by-hop
// ones, which differ between a record run and a playback run by nature
// (Host above all), and Accept-Encoding, a client library's own
// negotiation that the VCR answers itself (the tape holds bodies decoded,
// playback gzips on request). The tape still records them.
skip_in_matching(name: string) -> int {
    if is_hop_by_hop_header(name) == 1 { return 1 }
    if icmp_rt(name, "Accept-Encoding") == 0 { return 1 }
    return 0
}

// ---- request normalization ----

// Sort a list of "Name: Value" lines case-insensitively, join with \n,
// trailing \n. (insertion sort like vcr.ae's sort_lines, but operating
// on a pre-collected blob with trailing newlines.)
sort_join_lines(blob: string) -> string {
    if string.length(blob) == 0 { return string.copy("") }
    out = string.copy("")
    cursor = 0
    blob_len = string.length(blob)
    while cursor < blob_len {
        nl_idx = string.index_of_from(blob, "\n", cursor)
        line_end = blob_len
        if nl_idx >= 0 { line_end = nl_idx }
        line = string.substring(blob, cursor, line_end)
        if string.length(line) > 0 {
            ins_pos = 0
            o_len = string.length(out)
            while ins_pos < o_len {
                nl2 = string.index_of_from(out, "\n", ins_pos)
                exists_end = o_len
                if nl2 >= 0 { exists_end = nl2 }
                exists = string.substring(out, ins_pos, exists_end)
                if icmp_rt(exists, line) > 0 { break }
                if nl2 < 0 { ins_pos = o_len ; break }
                ins_pos = nl2 + 1
            }
            prefix = string.substring(out, 0, ins_pos)
            suffix = string.substring(out, ins_pos, o_len)
            out = string_concat(prefix, line)
            out = string_concat(out, "\n")
            out = string_concat(out, suffix)
        }
        if nl_idx < 0 { break }
        cursor = nl_idx + 1
    }
    return out
}

// Build the canonical "Name: Value\n..." blob from the live request for
// MATCHING: every header but those skip_in_matching names (Host,
// Connection, Content-Length, the other hop-by-hop ones, Accept-Encoding)
// and any header-removal'd names. Sorted ascending by name (ci). The tape keeps the transport
// headers (tape_live_headers_k); matching skips them on both sides
// (strip_transport_headers).
normalize_live_headers_k(srvkey: string, req: ptr) -> string {
    return live_headers_blob_k(srvkey, req, 1)
}

// The live request's headers as the tape records them: all of them, as the
// client sent them, but for the names a test removed (remove_header).
tape_live_headers_k(srvkey: string, req: ptr) -> string {
    return live_headers_blob_k(srvkey, req, 0)
}

live_headers_blob_k(srvkey: string, req: ptr, drop_transport: int) -> string {
    count = http.request_header_count(req)
    if count <= 0 { return string.copy("") }
    collected = string.copy("")
    i = 0
    while i < count {
        key = http.request_header_name(req, i)
        val = http.request_header_value(req, i)
        if string.length(key) == 0 {
            i = i + 1
            continue
        }
        skip = 0
        if drop_transport == 1 && skip_in_matching(key) == 1 { skip = 1 }
        // The in-memory recording keeps a removed header (emit leaves it out,
        // and the rules footer can say which interactions had it); matching
        // leaves it out here.
        if skip == 0 && drop_transport == 1 && header_removed_for_field_k(srvkey, FIELD_REQUEST_HEADERS, key) == 1 { skip = 1 }
        if skip == 0 {
            line = string_concat(key, ": ")
            line = string_concat(line, val)
            collected = string_concat(collected, line)
            collected = string_concat(collected, "\n")
        }
        i = i + 1
    }
    if drop_transport == 1 { collected = cred_mask_block_k(srvkey, collected) }
    return sort_join_lines(collected)
}
normalize_live_headers(req: ptr) -> string {
    return normalize_live_headers_k(cur_key(), req)
}

request_header_value(req: ptr, name: string) -> string {
    count = http.request_header_count(req)
    i = 0
    while i < count {
        key = http.request_header_name(req, i)
        if string.length(key) > 0 && icmp_rt(key, name) == 0 {
            return http.request_header_value(req, i)
        }
        i = i + 1
    }
    return ""
}

request_accepts_gzip(req: ptr) -> int {
    ae = request_header_value(req, "Accept-Encoding")
    return ascii_ci_contains(ae, "gzip")
}

// ---- url / path builders ----

build_recorded_path(req: ptr) -> string {
    path = http_request_path(req)
    if string.length(path) == 0 { path = "/" }
    query = http_request_query(req)
    out = string.copy(path)
    if string.length(query) > 0 {
        // http_request_query returns the query WITHOUT its leading '?'; restore
        // it so the recorded/matched path is a canonical "path?query".
        if string.char_at(query, 0) != 63 { out = string_concat(out, "?") }  // 63 == '?'
        out = string_concat(out, query)
    }
    return out
}

build_upstream_url(base: string, req: ptr) -> string {
    path = http_request_path(req)
    if string.length(path) == 0 { path = "/" }
    query = http_request_query(req)
    out = string.copy(base)
    if string.length(base) > 0 && string.char_at(path, 0) != 47 {
        out = string_concat(out, "/")
    }
    out = string_concat(out, path)
    if string.length(query) > 0 {
        // Restore the '?' the accessor strips (see build_recorded_path).
        if string.char_at(query, 0) != 63 { out = string_concat(out, "?") }  // 63 == '?'
        out = string_concat(out, query)
    }
    return out
}

expected_path_includes_query(path: string) -> int {
    if string.index_of(path, "?") >= 0 { return 1 }
    return 0
}

// ---- request-target equivalence (playback matching) ----
//
// Playback matches a live request's path (and query, when the tape has one)
// against the recorded one. Byte equality is too strict across HTTP clients:
// a normalized token such as {{uuid-2}} is replayed verbatim, and a client
// that sends it back through Java's URI (and many others) puts %7B%7B...%7D%7D
// on the wire. So both sides are compared in a canonical form that keeps
// every distinction a server could act on and drops only spelling:
//   - percent-escapes get uppercase hex (RFC 3986 6.2.2.1);
//   - an escape of a byte that is never a delimiter is decoded: the
//     unreserved set ALPHA DIGIT - . _ ~ (RFC 3986 6.2.2.2), the characters
//     that may not appear raw in a URI at all and so mean the same encoded
//     or not (" < > \ ^ ` { | }), and non-ASCII bytes;
//   - in the query only, %20 and + are both a space (form encoding).
// Reserved characters (: / ? # [ ] @ ! $ & ' ( ) * + , ; =), %25, controls
// and space stay escaped: /a%2Fb is not /a/b, and q=a%26b is not q=a&b.
uri_never_delimiter(c: int) -> int {
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) { return 1 }
    if c == 45 || c == 46 || c == 95 || c == 126 { return 1 }
    if c == 34 || c == 60 || c == 62 || c == 92 || c == 94 || c == 96 { return 1 }
    if c == 123 || c == 124 || c == 125 { return 1 }
    if c >= 128 { return 1 }
    return 0
}

uri_canonical(s: string) -> string {
    digits = "0123456789ABCDEF"
    out = string.copy("")
    n = string.length(s)
    in_query = 0
    i = 0
    while i < n {
        c = string.char_at(s, i)
        if c == 63 { in_query = 1 }
        if c == 37 && i + 2 < n {
            a = hex_digit(string.char_at(s, i + 1))
            b = hex_digit(string.char_at(s, i + 2))
            if a >= 0 && b >= 0 {
                v = a * 16 + b
                if in_query == 1 && v == 32 { out = string_concat(out, "+") }
                else if uri_never_delimiter(v) == 1 { out = string_concat(out, string.from_char(v)) }
                else {
                    out = string_concat(out, "%")
                    out = string_concat(out, string.substring(digits, a, a + 1))
                    out = string_concat(out, string.substring(digits, b, b + 1))
                }
                i = i + 3
                continue
            }
        }
        out = string_concat(out, string.substring(s, i, i + 1))
        i = i + 1
    }
    return out
}

// 1 when the live request target `got` matches the recorded `expected`
// under uri_canonical (byte equality first; escapes are the only spelling
// the canonical form changes, so without a '%' anywhere it can't differ).
request_paths_equal(got: string, expected: string) -> int {
    if string.equals(got, expected) == 1 { return 1 }
    if string.index_of(got, "%") < 0 && string.index_of(expected, "%") < 0 { return 0 }
    return string.equals(uri_canonical(got), uri_canonical(expected))
}

// ---- response-header block helpers (record mode) ----

response_header_value_from_block(headers: string, name: string) -> string {
    if string.length(headers) == 0 { return "" }
    name_len = string.length(name)
    cursor = 0
    h_len = string.length(headers)
    while cursor < h_len {
        nl = string.index_of_from(headers, "\n", cursor)
        line_end = h_len
        if nl >= 0 { line_end = nl }
        line = string.substring(headers, cursor, line_end)
        colon = string.index_of(line, ":")
        if colon == name_len {
            cand = string.substring(line, 0, colon)
            if icmp_rt(cand, name) == 0 {
                val = string.substring(line, colon + 1, string.length(line))
                // trim leading ws and trailing ws/CR
                val = trim_ws_cr(val)
                return val
            }
        }
        if nl < 0 { break }
        cursor = nl + 1
    }
    return ""
}

trim_ws_cr(s: string) -> string {
    n = string.length(s)
    start = 0
    while start < n {
        c = string.char_at(s, start)
        if c != 32 && c != 9 { break }
        start = start + 1
    }
    end = n
    while end > start {
        c = string.char_at(s, end - 1)
        if c != 32 && c != 9 && c != 13 { break }
        end = end - 1
    }
    return string.substring(s, start, end)
}

header_block_has_token_value(headers: string, name: string, token: string) -> int {
    v = response_header_value_from_block(headers, name)
    return ascii_ci_contains(v, token)
}

// Build a response-headers blob from the upstream's raw headers, without
// the status line. For the tape (drop_hop 0) every header the service sent
// is kept, but for Content-Encoding and Content-Length when the tape stores
// the body decoded (strip_content_encoding 1): they describe bytes the tape
// does not hold. For the record-mode echo to the caller (drop_hop 1) the
// hop-by-hop headers go, since the live response frames itself.
response_headers_for_tape(raw_headers: string, strip_content_encoding: int, drop_hop: int) -> string {
    if string.length(raw_headers) == 0 { return string.copy("") }
    // skip the first line (status line)
    first_nl = string.index_of(raw_headers, "\n")
    start = 0
    if first_nl >= 0 { start = first_nl + 1 }
    out = string.copy("")
    cursor = start
    h_len = string.length(raw_headers)
    while cursor < h_len {
        nl = string.index_of_from(raw_headers, "\n", cursor)
        line_end = h_len
        if nl >= 0 { line_end = nl }
        line = string.substring(raw_headers, cursor, line_end)
        ll = string.length(line)
        if ll > 0 && string.char_at(line, ll - 1) == 13 {
            line = string.substring(line, 0, ll - 1)
        }
        colon = string.index_of(line, ":")
        if colon > 0 {
            name = string.substring(line, 0, colon)
            drop = 0
            if drop_hop == 1 && is_hop_by_hop_header(name) == 1 { drop = 1 }
            if drop == 0 && strip_content_encoding == 1 && icmp_rt(name, "Content-Encoding") == 0 { drop = 1 }
            if drop == 0 && strip_content_encoding == 1 && icmp_rt(name, "Content-Length") == 0 { drop = 1 }
            if drop == 0 {
                out = string_concat(out, line)
                out = string_concat(out, "\n")
            }
        }
        if nl < 0 { break }
        cursor = nl + 1
    }
    return out
}

// Emit recorded caller headers verbatim to the live response (record
// mode echoes them back). Mirrors emit_recorded_headers_to_response.
emit_recorded_headers_to_response(res: ptr, headers: string) {
    http_response_clear_headers(res)
    if string.length(headers) == 0 { return }
    cursor = 0
    h_len = string.length(headers)
    while cursor < h_len {
        nl = string.index_of_from(headers, "\n", cursor)
        line_end = h_len
        if nl >= 0 { line_end = nl }
        line = string.substring(headers, cursor, line_end)
        ll = string.length(line)
        if ll > 0 && string.char_at(line, ll - 1) == 13 {
            line = string.substring(line, 0, ll - 1)
        }
        colon = string.index_of(line, ":")
        if colon > 0 {
            name = string.substring(line, 0, colon)
            val = string.substring(line, colon + 1, string.length(line))
            // skip a single leading space/tab
            val = trim_leading_ws(val)
            http_response_add_header(res, name, val)
        }
        if nl < 0 { break }
        cursor = nl + 1
    }
}

trim_leading_ws(s: string) -> string {
    n = string.length(s)
    start = 0
    while start < n {
        c = string.char_at(s, start)
        if c != 32 && c != 9 { break }
        start = start + 1
    }
    return string.substring(s, start, n)
}

// ---- base64 decode (binary-safe via std.cryptography) ----

decode_base64_body(src: string) -> {
    decoded, err = encoding.base64_decode(src)
    if err != "" { return "", 0, 0 }
    return decoded, string.length(decoded), 1
}

// Public base64 decode helper (the subversion_interop byte-faithful
// replay test reads this to verify base64-marked bodies decode to the
// expected bytes). Returns the decoded string (length-bearing) or ""
// on decode failure. Replaces the old C vcr_decode_base64_body_raw.
vcr_decode_base64_body_raw(body: string) -> string {
    decoded, n, ok = decode_base64_body(body)
    if ok == 0 { return "" }
    return decoded
}

// ---- JSON-semantic request-body matching (opt-in) ----
//
// Deep structural equality over two parsed JSON trees. Objects compare
// key-by-key regardless of key order; arrays compare element-by-element in
// order (JSON array order is significant). Numbers compare by value, so
// 1 == 1.0. Mirrors the intent of Vcr.HttpRecorder's RulesMatcher.ByJsonContent.
// (Portions copyright Giannis Georgopoulos — MIT.)
json_deep_equal(a: ptr, b: ptr) -> int {
    ta = json.json_type(a)
    tb = json.json_type(b)
    if ta != tb { return 0 }
    if ta == 0 { return 1 }                                    // JSON_NULL
    if ta == 1 {                                               // JSON_BOOL
        if json.json_get_bool(a) == json.json_get_bool(b) { return 1 }
        return 0
    }
    if ta == 2 {                                               // JSON_NUMBER
        if json.json_get_number(a) == json.json_get_number(b) { return 1 }
        return 0
    }
    if ta == 3 {                                               // JSON_STRING
        return string.equals(json.json_get_string_raw(a), json.json_get_string_raw(b))
    }
    if ta == 4 {                                               // JSON_ARRAY
        na = json.json_array_size(a)
        nb = json.json_array_size(b)
        if na != nb { return 0 }
        i = 0
        while i < na {
            if json_deep_equal(json.json_array_get_raw(a, i), json.json_array_get_raw(b, i)) == 0 {
                return 0
            }
            i = i + 1
        }
        return 1
    }
    if ta == 5 {                                               // JSON_OBJECT
        na = json.json_object_size_raw(a)
        nb = json.json_object_size_raw(b)
        if na != nb { return 0 }
        i = 0
        while i < na {
            k = json.json_object_key_at(a, i)
            if json.json_object_has(b, k) == 0 { return 0 }
            if json_deep_equal(json.json_object_get_raw(a, k), json.json_object_get_raw(b, k)) == 0 {
                return 0
            }
            i = i + 1
        }
        return 1
    }
    return 0
}

// Parse both bodies as JSON and compare semantically. Returns 1 only if BOTH
// parse and are deep-equal; 0 otherwise (including when either side isn't valid
// JSON), so the caller safely falls back to the byte-exact verdict.
json_bodies_equal(live: string, recorded: string) -> int {
    va, _ = json.parse(live)
    if va == null { return 0 }
    vb, _ = json.parse(recorded)
    if vb == null {
        json.json_free(va)
        return 0
    }
    result = json_deep_equal(va, vb)
    json.json_free(va)
    json.json_free(vb)
    return result
}

// Canonicalise an XML document into a normalised event-stream string, or ""
// if it doesn't parse. The normalisation is what makes two SOAP envelopes
// "semantically equal" (field report #10): element nesting and order are kept
// (order IS significant in XML), attributes are sorted by name so their source
// order doesn't matter, and whitespace-only text between elements is dropped
// while text inside an element is trimmed. It does NOT ignore a chosen volatile
// element (e.g. a WS-Addressing MessageID) — the caller makes those
// deterministic with redact_whole_tape / a fixed clock, as before; this closes
// the key-order / indentation / insignificant-whitespace gap that bytewise
// matching trips on. On any parse error it returns "", so xml_bodies_equal
// falls back to the byte-exact verdict and never loosens non-XML matching.
xml_canonicalize(src: string) -> string {
    p = xml.parser(src)
    if p == null { return "" }
    out = string.copy("")
    ok = 1
    done = 0
    while done == 0 {
        ev = xml.next(p)
        if ev == xml.EVENT_EOF { break }
        if ev == xml.EVENT_ERROR { ok = 0; break }
        if ev == xml.EVENT_START {
            out = string_concat(out, string_concat("<", xml.name(p)))
            // Sort attribute (name=value) pairs so source order is irrelevant.
            // Build a \n-joined blob and reuse sort_lines (same insertion sort
            // the recorded-header normaliser uses); the sorted blob keeps its
            // trailing \n, which we fold into the canonical form unchanged.
            nattr = xml.attr_count(p)
            if nattr > 0 {
                blob = string.copy("")
                i = 0
                while i < nattr {
                    an = xml.attr_name(p, i)
                    av = xml.attr_value(p, i)
                    blob = string_concat(blob, string_concat(an, string_concat("=", av)))
                    blob = string_concat(blob, "\n")
                    i = i + 1
                }
                out = string_concat(out, string_concat(" ", sort_lines(blob)))
            }
            out = string_concat(out, ">")
        } else {
            if ev == xml.EVENT_END {
                out = string_concat(out, string_concat("</", string_concat(xml.name(p), ">")))
            } else {
                if ev == xml.EVENT_TEXT {
                    t = rtrim(trim_leading_ws(xml.text(p)))
                    if string.length(t) > 0 {
                        out = string_concat(out, string_concat("#", string_concat(t, "#")))
                    }
                }
            }
        }
    }
    xml.free(p)
    if ok == 0 { return "" }
    return out
}

// Parse both bodies as XML and compare semantically. Returns 1 only if BOTH
// canonicalise (parse) and their canonical forms are equal; 0 otherwise
// (including when either side isn't valid XML), so the caller safely falls
// back to the byte-exact verdict.
xml_bodies_equal(live: string, recorded: string) -> int {
    ca = xml_canonicalize(live)
    if string.length(ca) == 0 { return 0 }
    cb = xml_canonicalize(recorded)
    if string.length(cb) == 0 { return 0 }
    if string.equals(ca, cb) == 1 { return 1 }
    return 0
}

// ---- error helper for record dispatch ----

// Apply every literal / header / query redaction rule's pattern->replacement to
// a FREE-FORM string, ignoring field scope (an error string or body can mix a
// path, a header value and a body fragment). The JSON-field kind is skipped: it
// requires a whole valid-JSON document, which a diagnostic string is not. Used
// to scrub record-mode failure output, where the in-memory request still holds
// the real (not-yet-emitted) secret — a weekly record run that pulls vault
// credentials must not leak them into an error body or log when a request fails.
redact_all_fields_k(key: string, s: string) -> string {
    out = s
    l = redactions_k(key)
    i = 0
    while i < list_size(l) {
        r = list_get_raw(l, i) as *Redaction
        if r.kind == 0 { out = str_replace_all(out, r.pattern, r.replacement) }
        if r.kind == 1 { out = redact_header_text(out, r.pattern, r.replacement) }
        if r.kind == 2 { out = redact_query_text(out, r.pattern, r.replacement) }
        i = i + 1
    }
    return out
}

record_dispatch_error_k(srvkey: string, res: ptr, status: int, msg: string) {
    // Scrub configured secrets from BOTH the diagnostic (last_error) and the
    // error body returned to the caller. Redaction normally happens at
    // tape-emit time; a failure can occur before any emit, so the raw secret
    // would otherwise survive here.
    safe = redact_all_fields_k(srvkey, msg)
    set_last_error_k(srvkey, safe)
    set_last_kind_k(srvkey, KIND_RECORD_ERROR)
    set_last_index_k(srvkey, -1)
    http_response_set_status(res, status)
    http_response_set_body(res, safe)
}

// ---- record-mode setup (per-server) ----
// Stash the upstream base + mode under the server's key; the single
// wildcard dispatcher (registered by register_routes) reads them.
vcr_register_record_routes(server: ptr, upstream_base: string) -> int {
    if server == null || string.length(upstream_base) == 0 {
        set_load_err("vcr.record mode: null server or upstream_base")
        return 0
    }
    key = key_for(server)
    set_record_upstream_base_k(key, strip_trailing_slash(upstream_base))
    set_mode_k(key, "record")
    register_routes(server)
    return 1
}

// ---- static-content file serving (folded into the dispatcher) ----
// Serve `path` from static mount `m`. mime detection + traversal guard
// preserved from the old vcr_static_dispatch.
serve_static_file(m: *StaticMount, req: ptr, res: ptr) {
    path = http_request_path(req)
    mlen = string.length(m.mount_path)
    rel = string.substring(path, mlen, string.length(path))
    if string.length(rel) > 0 && string.char_at(rel, 0) == 47 {
        rel = string.substring(rel, 1, string.length(rel))
    }
    if string.length(rel) == 0 { rel = "index.html" }
    // traversal guard
    bad = 0
    if string.index_of(rel, "..") >= 0 { bad = 1 }
    if string.index_of(rel, "%2e") >= 0 { bad = 1 }
    if string.index_of(rel, "%2E") >= 0 { bad = 1 }
    if string.index_of(rel, "%2f") >= 0 { bad = 1 }
    if string.index_of(rel, "%2F") >= 0 { bad = 1 }
    if string.index_of(rel, "%5c") >= 0 { bad = 1 }
    if string.index_of(rel, "%5C") >= 0 { bad = 1 }
    if string.index_of(rel, "\\") >= 0 { bad = 1 }
    if bad == 1 {
        http_response_set_status(res, 403)
        http_response_set_body(res, "403 - Forbidden")
        return
    }
    filepath = string_concat(m.fs_dir, "/")
    filepath = string_concat(filepath, rel)
    http_serve_file(res, filepath)
}

// Read the WHOLE request body, regardless of how std.http buffered it.
//
// Since aether 0.269.0 (#626) the HTTP server no longer buffers a
// request body whole when its Content-Length exceeds one connection
// buffer (16 KiB): such a request is handed over *streaming*, with
// `http_request_body(req)` returning "" and the payload pulled window
// by window off the socket via http.request_body_read. Small bodies
// keep the legacy fully-buffered path. libservirtium_vcr reads each live body
// exactly once (record: forward upstream; replay: compare against the
// tape), so a single sequential drain is correct for both. We
// accumulate into a std.bytes buffer (O(n), binary-safe, embedded-NUL
// preserving) and hand back a length-bearing AetherString, exactly
// like the gzip/base64 wrappers elsewhere in libservirtium_vcr. The legacy
// accessor would silently truncate a >16 KiB body to empty — a SOAP /
// GraphQL / JSON / file-upload POST is well within that range — so
// every body must come through here, never http_request_body directly.
read_full_request_body(req: ptr) -> string {
    total = http_request_body_length(req)
    if total <= 0 { return "" }
    buf = bytes.new(total)
    if buf == null { return http_request_body(req) }
    off = 0
    while off < total {
        chunk, n, err = http.request_body_read(req, off, 65536)
        if err != "" { break }
        if n == 0 { break }
        bytes.copy_from_string(buf, off, chunk, n)
        off = off + n
    }
    return bytes.finish(buf, off)
}

// ---- record path (per-server) ----

do_record(srvkey: string, req: ptr, res: ptr) {
    base = record_upstream_base_k(srvkey)
    if string.length(base) == 0 {
        record_dispatch_error_k(srvkey, res, 500, "vcr record mode: upstream base not configured")
        return
    }
    url = build_upstream_url(base, req)
    method = http_request_method(req)
    if string.length(method) == 0 { method = "GET" }

    creq = http_request_raw(method, url)
    if creq == null {
        record_dispatch_error_k(srvkey, res, 500, "vcr record mode: failed to build client request")
        return
    }

    count = http.request_header_count(req)
    i = 0
    while i < count {
        key = http.request_header_name(req, i)
        val = http.request_header_value(req, i)
        if string.length(key) > 0 && is_hop_by_hop_header(key) == 0 {
            http_request_set_header_raw(creq, key, val)
        }
        i = i + 1
    }

    live_body = read_full_request_body(req)
    body_len = string.length(live_body)
    if body_len > 0 {
        ctype = request_header_value(req, "Content-Type")
        http_request_set_body_raw(creq, string.bytes(live_body), body_len, ctype)
    }
    http_request_set_timeout_raw(creq, 30)
    upstream_ca = cfg_get_str(slot(srvkey, "upstream_cafile"))
    if string.length(upstream_ca) > 0 { http_request_set_cafile_raw(creq, upstream_ca) }

    cresp = http_send_raw(creq)
    http_request_free_raw(creq)
    if cresp == null {
        record_dispatch_error_k(srvkey, res, 502, "vcr record mode: upstream request failed")
        return
    }
    cerr = http_response_error(cresp)
    if string.length(cerr) > 0 {
        msg = string_concat("vcr record mode: upstream transport error: ", cerr)
        http_response_free(cresp)
        record_dispatch_error_k(srvkey, res, 502, msg)
        return
    }

    body = http_response_body(cresp)
    resp_body_len = http_response_body_length(cresp)
    raw_headers = http_response_headers(cresp)
    caller_headers = response_headers_for_tape(raw_headers, 0, 1)
    upstream_gzip = header_block_has_token_value(caller_headers, "Content-Encoding", "gzip")
    resp_headers = response_headers_for_tape(raw_headers, upstream_gzip, 0)
    content_type = response_header_value_from_block(resp_headers, "Content-Type")
    req_headers = tape_live_headers_k(srvkey, req)

    body_for_tape = body
    if upstream_gzip == 1 {
        if zlib_backend_available() == 0 {
            http_response_free(cresp)
            record_dispatch_error_k(srvkey, res, 500, "vcr record mode: gzip response but zlib unavailable")
            return
        }
        // ae 0.758 (#2301): zlib takes a byte[] slice. The body is a retained
        // AetherString, so string.bytes() is bounded by its real (binary-safe)
        // length -- the same view std.http.client's response_body_bytes hands out.
        inflated, _inflated_len, ierr = zlib.gzip_inflate(string.bytes(body))
        if ierr != "" {
            http_response_free(cresp)
            record_dispatch_error_k(srvkey, res, 500, "vcr record mode: failed to decode gzip response")
            return
        }
        body_for_tape = inflated
    }

    recorded_path = build_recorded_path(req)
    req_body_for_tape = ""
    if body_len > 0 { req_body_for_tape = live_body }

    rec_ok = record_interaction_full_k(srvkey, method, recorded_path,
                                       http_response_status(cresp),
                                       content_type, body_for_tape,
                                       req_headers, req_body_for_tape)
    if rec_ok == 0 {
        http_response_free(cresp)
        record_dispatch_error_k(srvkey, res, 500, "vcr record mode: failed to record interaction")
        return
    }
    set_resp_headers_k(srvkey, list_size(tape_list_k(srvkey)) - 1, resp_headers)

    http_response_set_status(res, http_response_status(cresp))
    emit_recorded_headers_to_response(res, caller_headers)
    http_response_set_body_n(res, string.bytes(body), resp_body_len)

    set_last_error_k(srvkey, "")
    set_last_kind_k(srvkey, KIND_OK)
    set_last_index_k(srvkey, list_size(tape_list_k(srvkey)) - 1)

    http_response_free(cresp)
}

// ---- playback path (per-server) ----

// Emit a matched interaction's recorded response (status + headers + body,
// with the base64/gzip handling) onto `res`. Shared by the ordered and the
// match-multiple playback paths. Does NOT touch cursor / last_* — the caller
// owns those.
emit_playback_response(srvkey: string, e: *Interaction, req: ptr, res: ptr) {
    http_response_set_status(res, e.status)
    http_response_clear_headers(res)

    // Response-side substitution (playback-only): fill {{request.host}}/
    // {{request.scheme}}/{{baseUrl}} from the live request and apply any
    // registered (pattern -> replacement) rules, so taped nextLink/id/absolute
    // URLs resolve against the test's own host. Done once here into locals;
    // the loops below read these instead of the raw e.* fields.
    resp_headers = apply_substitutions_k(srvkey, req, e.resp_headers, FIELD_RESPONSE_HEADERS)
    resp_body = apply_substitutions_k(srvkey, req, e.body, FIELD_RESPONSE_BODY)

    // Record any {{...}} placeholder left UNFILLED in what we're about to send
    // (a typo like {{valut}}, or a placeholder no rule covers — it would reach
    // the client as literal text). assert_no_unfilled_placeholders reports these.
    if string.index_of(resp_headers, "{{") >= 0 || string.index_of(resp_body, "{{") >= 0 {
        note_unfilled_placeholder_k(srvkey, e.method, e.path)
    }

    // Emit recorded response headers verbatim (post-substitution).
    emitted_ct = 0
    if string.length(resp_headers) > 0 {
        cursor2 = 0
        rh_len = string.length(resp_headers)
        while cursor2 < rh_len {
            nl = string.index_of_from(resp_headers, "\n", cursor2)
            line_end = rh_len
            if nl >= 0 { line_end = nl }
            line = string.substring(resp_headers, cursor2, line_end)
            ll = string.length(line)
            if ll > 0 && string.char_at(line, ll - 1) == 13 {
                line = string.substring(line, 0, ll - 1)
            }
            colon = string.index_of(line, ":")
            if colon > 0 {
                name = string.substring(line, 0, colon)
                val = string.substring(line, colon + 1, string.length(line))
                val = trim_leading_ws(val)
                if icmp_rt(name, "Content-Type") == 0 { emitted_ct = 1 }
                // Content-Length, Transfer-Encoding, Connection and the other
                // hop-by-hop headers are on the tape as the service sent them,
                // but this response frames itself; Content-Encoding is set
                // below when the body is gzipped here.
                if is_hop_by_hop_header(name) == 0 && icmp_rt(name, "Content-Encoding") != 0 {
                    http_response_add_header(res, name, val)
                }
            }
            if nl < 0 { break }
            cursor2 = nl + 1
        }
    }
    if emitted_ct == 0 && e.has_content_type == 1 && string.length(e.content_type) > 0 {
        http_response_add_header(res, "Content-Type", e.content_type)
    }

    if ascii_ci_contains(e.content_type, "base64 below") == 1 {
        // Binary body: e.body is base64 text, so substitute on the DECODED
        // bytes (as text), not on the base64. resp_body above substituted the
        // base64 string, which is meaningless here — recompute from e.body.
        decoded, dlen, dok = decode_base64_body(e.body)
        if dok == 1 {
            sub = apply_substitutions_k(srvkey, req, decoded, FIELD_RESPONSE_BODY)
            http_response_set_body_n(res, string.bytes(sub), string.length(sub))
        } else {
            http_response_set_body(res, resp_body)
        }
    } else {
        if request_accepts_gzip(req) == 1 && zlib_backend_available() == 1 {
            gz_owned, gz_len, gerr = zlib.gzip_deflate(string.bytes(resp_body), -1)
            if gerr == "" {
                http_response_set_body_n(res, string.bytes(gz_owned), gz_len)
                http_response_set_header(res, "Content-Encoding", "gzip")
                http_response_set_header(res, "Vary", "Accept-Encoding")
            } else {
                http_response_set_body(res, resp_body)
            }
        } else {
            http_response_set_body(res, resp_body)
        }
    }
}

// Boolean "does this interaction satisfy the request?" — the same method/path
// (+ optional header / body / json rules) the ordered path checks, but as a
// pure predicate with no diagnostics. Live values are pre-read once by the
// caller so the request body isn't consumed per candidate.
interaction_matches_pre(srvkey: string, index: int, e: *Interaction, req: ptr, got_method: string,
                        got_path_plain: string, got_path_q: string,
                        live_headers: string, live_body: string) -> int {
    expected_path = rt_apply_unredactions_for_k(srvkey, e.path, FIELD_PATH)
    got_path = got_path_plain
    if expected_path_includes_query(expected_path) == 1 { got_path = got_path_q }
    got_path = secret_canonical_live_k(srvkey, index, FIELD_PATH, got_path)
    if string.equals(got_method, e.method) == 0 { return 0 }
    if string.length(got_path) == 0 || request_paths_equal(got_path, expected_path) == 0 { return 0 }

    expected_req_headers = rt_apply_unredactions_for_k(srvkey, e.req_headers, FIELD_REQUEST_HEADERS)
    expected_req_headers = remove_headers_from_block_k(srvkey, expected_req_headers, FIELD_REQUEST_HEADERS)
    expected_req_headers = strip_transport_headers(expected_req_headers)
    expected_req_headers = cred_mask_block_k(srvkey, expected_req_headers)
    // Full-block header match applies when strict is on, or when the tape
    // carries request headers AND the fixture didn't opt into surgical ByHeader
    // matching (which matches only the named headers, ignoring the rest).
    have_by_header = list_size(match_headers_k(srvkey)) > 0
    if vcr_get_strict_headers_k(srvkey) == 1 || (is_blank(expected_req_headers) == 0 && have_by_header == 0) {
        if string.equals(live_headers, expected_req_headers) == 0 { return 0 }
    }
    if match_headers_diff_k(srvkey, expected_req_headers, req) != "" { return 0 }

    expected_req_body = rt_apply_unredactions_for_k(srvkey, e.req_body, FIELD_REQUEST_BODY)
    if is_blank(expected_req_body) == 0 {
        canonical_body = secret_canonical_live_k(srvkey, index, FIELD_REQUEST_BODY, live_body)
        bm = string.equals(canonical_body, expected_req_body)
        if bm == 0 && vcr_get_match_json_body_k(srvkey) == 1 {
            bm = json_bodies_equal(live_body, expected_req_body)
        }
        if bm == 0 && vcr_get_match_xml_body_k(srvkey) == 1 {
            bm = xml_bodies_equal(live_body, expected_req_body)
        }
        if bm == 0 { return 0 }
    }
    return 1
}

// Match-multiple playback: search ALL interactions for the first that fits the
// request, replay it WITHOUT consuming it (reusable, order-independent).
do_playback_multiple(srvkey: string, req: ptr, res: ptr) {
    n = list_size(tape_list_k(srvkey))
    got_method = http_request_method(req)
    got_path_plain = http_request_path(req)
    got_path_q = build_recorded_path(req)
    live_headers = normalize_live_headers_k(srvkey, req)
    live_body = read_full_request_body(req)          // read once, reused per candidate

    found = -1
    i = 0
    while i < n {
        e = tape_get_k(srvkey, i)
        if interaction_matches_pre(srvkey, i, e, req, got_method, got_path_plain, got_path_q, live_headers, live_body) == 1 {
            found = i
            break
        }
        i = i + 1
    }

    if found < 0 {
        gp = got_path_q
        if string.length(gp) == 0 { gp = "(null)" }
        msg = "no recorded interaction matches ${got_method} ${gp}"
        set_last_error_k(srvkey, msg)
        set_last_kind_k(srvkey, KIND_PATH_OR_METHOD_DIFF)
        set_last_index_k(srvkey, -1)
        candidate_index = -1
        candidate_entry = null as *Interaction
        j = 0
        while j < n {
            entry = tape_get_k(srvkey, j)
            if entry.method == got_method { candidate_index = j; candidate_entry = entry; break }
            j = j + 1
        }
        if candidate_entry == null && n > 0 { candidate_index = 0; candidate_entry = tape_get_k(srvkey, 0) }
        retain_replay_mismatch_k(srvkey, KIND_PATH_OR_METHOD_DIFF, candidate_index, candidate_entry, req, live_body, 1)
        emit_mismatch_response(res, msg, KIND_PATH_OR_METHOD_DIFF)
        return
    }

    e2 = tape_get_k(srvkey, found)
    e2.used = 1
    emit_playback_response(srvkey, e2, req, res)
    set_last_error_k(srvkey, "")
    set_last_kind_k(srvkey, KIND_OK)
    set_last_index_k(srvkey, found)
    // Deliberately no cursor advance — the interaction stays available.
}

// Answer a no-match the way a browser-driven test can SEE (field report #3):
// a distinctive 599 status, the human reason as the body (verbatim, never
// masked — a dev wanting the real diff must get it), plus a machine-readable
// `X-Servirtium-Mismatch` header carrying the outcome kind so the reason shows
// up in the page's own network/traffic log without anyone parsing the body.
// Every playback no-match path funnels through here so the three stay in step.
emit_mismatch_response(res: ptr, msg: string, kind: int) {
    http_response_set_status(res, 599)
    http_response_set_header(res, "X-Servirtium-Mismatch", "kind=${kind}")
    http_response_set_body(res, msg)
}

do_playback(srvkey: string, req: ptr, res: ptr) {
    if vcr_get_match_multiple_k(srvkey) == 1 {
        do_playback_multiple(srvkey, req, res)
        return
    }
    cur = cursor_k(srvkey)
    n = list_size(tape_list_k(srvkey))
    if cur >= n {
        msg = "tape exhausted — SUT made more requests than the tape contains"
        set_last_error_k(srvkey, msg)
        set_last_kind_k(srvkey, KIND_TAPE_EXHAUSTED)
        set_last_index_k(srvkey, cur)
        retain_replay_mismatch_k(srvkey, KIND_TAPE_EXHAUSTED, cur, null, req, read_full_request_body(req), 0)
        emit_mismatch_response(res, msg, KIND_TAPE_EXHAUSTED)
        return
    }
    e = tape_get_k(srvkey, cur)
    expected_path = rt_apply_unredactions_for_k(srvkey, e.path, FIELD_PATH)
    expected_req_headers = rt_apply_unredactions_for_k(srvkey, e.req_headers, FIELD_REQUEST_HEADERS)
    expected_req_body = rt_apply_unredactions_for_k(srvkey, e.req_body, FIELD_REQUEST_BODY)
    expected_req_headers = remove_headers_from_block_k(srvkey, expected_req_headers, FIELD_REQUEST_HEADERS)
    expected_req_headers = strip_transport_headers(expected_req_headers)
    expected_req_headers = cred_mask_block_k(srvkey, expected_req_headers)

    got_method = http_request_method(req)
    got_path = http_request_path(req)
    if expected_path_includes_query(expected_path) == 1 {
        got_path = build_recorded_path(req)
    }
    got_path = secret_canonical_live_k(srvkey, cur, FIELD_PATH, got_path)
    if string.length(got_method) == 0 || string.equals(got_method, e.method) == 0 ||
       string.length(got_path) == 0 || request_paths_equal(got_path, expected_path) == 0 {
        gm = got_method
        if string.length(gm) == 0 { gm = "(null)" }
        gp = got_path
        if string.length(gp) == 0 { gp = "(null)" }
        msg = "tape mismatch at interaction ${cur}: expected ${e.method} ${expected_path}, got ${gm} ${gp}"
        set_last_error_k(srvkey, msg)
        set_last_kind_k(srvkey, KIND_PATH_OR_METHOD_DIFF)
        set_last_index_k(srvkey, cur)
        retain_replay_mismatch_k(srvkey, KIND_PATH_OR_METHOD_DIFF, cur, e, req, read_full_request_body(req), 0)
        emit_mismatch_response(res, msg, KIND_PATH_OR_METHOD_DIFF)
        return
    }

    // ByHeader: opt-in match on specific named request headers (independent of
    // strict-header mode).
    bh_diff = match_headers_diff_k(srvkey, expected_req_headers, req)
    if bh_diff != "" {
        msg = "interaction ${cur}: ${bh_diff}"
        set_last_error_k(srvkey, msg)
        set_last_kind_k(srvkey, KIND_HEADER_VALUE_DIFF)
        set_last_index_k(srvkey, cur)
        retain_replay_mismatch_k(srvkey, KIND_HEADER_VALUE_DIFF, cur, e, req, read_full_request_body(req), 0)
        emit_mismatch_response(res, msg, KIND_HEADER_VALUE_DIFF)
        return
    }

    strict = vcr_get_strict_headers_k(srvkey)
    have_by_header = list_size(match_headers_k(srvkey)) > 0
    if strict == 1 || (is_blank(expected_req_headers) == 0 && have_by_header == 0) {
        live = normalize_live_headers_k(srvkey, req)
        if string.equals(live, expected_req_headers) == 0 {
            diag_ok = 0
            kind = KIND_HEADER_MISSING
            msg = ""

            // First sweep: recorded lines not present in live.
            p = 0
            eh_len = string.length(expected_req_headers)
            while p < eh_len && diag_ok == 0 {
                eol = string.index_of_from(expected_req_headers, "\n", p)
                line_end = eh_len
                if eol >= 0 { line_end = eol }
                rline = string.substring(expected_req_headers, p, line_end)
                if string.length(rline) > 0 {
                    needle = string_concat(rline, "\n")
                    if string.index_of(live, needle) < 0 {
                        // check same-name value-diff
                        colon = string.index_of(rline, ":")
                        if colon > 0 {
                            name_colon = string.substring(rline, 0, colon + 1)
                            // live always renders "Name: ..." — search for
                            // "Name:" at a line start.
                            mpos = find_line_start_token(live, name_colon)
                            if mpos >= 0 {
                                hdr = first_header_name(rline)
                                msg = "interaction ${cur}: '${hdr}' request header value differed"
                                kind = KIND_HEADER_VALUE_DIFF
                                diag_ok = 1
                            }
                        }
                        if diag_ok == 0 {
                            hdr = first_header_name(rline)
                            msg = "interaction ${cur}: '${hdr}' request header was expected but not encountered"
                            kind = KIND_HEADER_MISSING
                            diag_ok = 1
                        }
                    }
                }
                if eol < 0 { break }
                p = eol + 1
            }

            // Second sweep: live lines not in recorded → unexpected.
            if diag_ok == 0 {
                lp = 0
                l_len = string.length(live)
                while lp < l_len && diag_ok == 0 {
                    eol = string.index_of_from(live, "\n", lp)
                    line_end = l_len
                    if eol >= 0 { line_end = eol }
                    lline = string.substring(live, lp, line_end)
                    if string.length(lline) > 0 {
                        needle = string_concat(lline, "\n")
                        if string.index_of(expected_req_headers, needle) < 0 {
                            hdr = first_header_name(lline)
                            msg = "interaction ${cur}: '${hdr}' request header encountered but not expected"
                            kind = KIND_HEADER_UNEXPECTED
                            diag_ok = 1
                        }
                    }
                    if eol < 0 { break }
                    lp = eol + 1
                }
            }

            if diag_ok == 0 {
                msg = "interaction ${cur}: request headers differ — recorded:\n${expected_req_headers}\nlive:\n${live}"
                kind = KIND_HEADER_MISSING
            }
            set_last_error_k(srvkey, msg)
            set_last_kind_k(srvkey, kind)
            set_last_index_k(srvkey, cur)
            retain_replay_mismatch_k(srvkey, kind, cur, e, req, read_full_request_body(req), 0)
            emit_mismatch_response(res, msg, kind)
            return
        }
    }

    // Request-body comparison. Byte-exact by default; if the fixture opted into
    // JSON matching, a byte-differing body gets a second chance at semantic
    // equality (key order / whitespace ignored) before being called a mismatch.
    if is_blank(expected_req_body) == 0 {
        live_body = read_full_request_body(req)
        canonical_body = secret_canonical_live_k(srvkey, cur, FIELD_REQUEST_BODY, live_body)
        bodies_match = string.equals(canonical_body, expected_req_body)
        if bodies_match == 0 && vcr_get_match_json_body_k(srvkey) == 1 {
            bodies_match = json_bodies_equal(live_body, expected_req_body)
        }
        if bodies_match == 0 && vcr_get_match_xml_body_k(srvkey) == 1 {
            bodies_match = xml_bodies_equal(live_body, expected_req_body)
        }
        if bodies_match == 0 {
            rlen = string.length(expected_req_body)
            llen = string.length(live_body)
            msg = "interaction ${cur}: request body different to expectation — recorded=${rlen} bytes, live=${llen} bytes"
            set_last_error_k(srvkey, msg)
            set_last_kind_k(srvkey, KIND_BODY_DIFF)
            set_last_index_k(srvkey, cur)
            retain_replay_mismatch_k(srvkey, KIND_BODY_DIFF, cur, e, req, live_body, 0)
            emit_mismatch_response(res, msg, KIND_BODY_DIFF)
            return
        }
    }

    e.used = 1
    emit_playback_response(srvkey, e, req, res)

    set_last_error_k(srvkey, "")
    set_last_kind_k(srvkey, KIND_OK)
    set_last_index_k(srvkey, cur)
    set_cursor_k(srvkey, cur + 1)
}

// ---- the single per-server wildcard dispatcher ----
// ud = the server handle. Recover the key, then per request:
//   (a) path in this server's untaped list  -> 404 (no cursor consumed)
//   (b) path under a static mount           -> serve file
//   (c) else: record mode -> forward+capture ; playback -> tape match
@c_callback
vcr_dispatch(req: ptr, res: ptr, ud: ptr) {
    srvkey = key_for(ud)
    path = http_request_path(req)
    if path_is_untaped_k(srvkey, path) == 1 {
        http_response_set_status(res, 404)
        http_response_set_body(res, "")
        return
    }
    m = static_mount_for_k(srvkey, path)
    if m != null {
        // Static mounts are GET-only (mirrors the old GET-route registration).
        method = http_request_method(req)
        if string.length(method) == 0 || string.equals(method, "GET") == 1 {
            serve_static_file(m, req, res)
            return
        }
    }
    if string.equals(mode_k(srvkey), "record") == 1 {
        do_record(srvkey, req, res)
    } else {
        do_playback(srvkey, req, res)
    }
}

// Find `token` (e.g. "Name:") where it is at the start of the blob
// or preceded by '\n'. Returns index or -1.
find_line_start_token(haystack: string, token: string) -> int {
    cursor = 0
    h_len = string.length(haystack)
    while cursor <= h_len {
        idx = string.index_of_from(haystack, token, cursor)
        if idx < 0 { return -1 }
        if idx == 0 { return idx }
        if string.char_at(haystack, idx - 1) == 10 { return idx }
        cursor = idx + 1
    }
    return -1
}


// Kind-of-outcome enum. Returned by vcr.last_kind() after each
// dispatch to tell the test which branch the dispatcher took.
// These numeric values are libservirtium_vcr's stable Outcome contract,
// mirrored by the VCR_KIND_* / Outcome ints in the C ABI (embed.ae)
// and every binding.
const KIND_OK                  = 0
const KIND_PATH_OR_METHOD_DIFF = 1
const KIND_HEADER_MISSING      = 2
const KIND_HEADER_VALUE_DIFF   = 3
const KIND_HEADER_UNEXPECTED   = 4
const KIND_TAPE_EXHAUSTED      = 5
const KIND_BODY_DIFF           = 6
const KIND_RECORD_ERROR        = 7

// Aether-side wrappers around the runtime accessors. Call shape
// matches the rest of the vcr.* surface (e.g. vcr.tape_length()).
last_kind() -> int { return vcr_last_kind() }
last_index() -> int { return vcr_last_index() }
set_strict_headers(on: int) { vcr_set_strict_headers(on) }
reset_cursor() { vcr_reset_cursor() }

// Direct concat extern — interpolation recycles a backing buffer
// and corrupts when the same `out` variable is rebuilt many times
// in sequence (the kind of pattern a markdown-emitter hammers).
// string_concat returns a freshly-allocated AetherString every
// call, side-stepping the issue. Tracked alongside #234 / closure
// lifetime work.
extern string_concat(a: string, b: string) -> string

// String concat for the recheck error path — used by flush_or_check
// and flush_and_fail_if_changed to pin the return type to string.
// Same shape stdlib wrappers
// elsewhere use to dodge tuple-inference confusion.
extern string_concat(a: string, b: string) -> string

// ---- Aether-side surface ----

// Load a tape, create + bind a server on `port`, register the
// dispatcher for each unique path the tape mentions, and return
// the raw server pointer. Caller spawns its own server-actor and
// sends the start message — the actor pattern can't be encapsulated
// inside this module today because Aether's module merger doesn't
// transitively merge actor declarations.
//
// Returns null on tape parse failure or port-bind failure; the
// reason is printed via println before the null return.
// Load-path diagnostic. Suppressed under quiet mode (set by the embed
// ABI) so an embedded VCR never writes to the host's stdout; the same
// reason stays retrievable via load_error() / last_error(). Foreground
// `import std.http.server.vcr` callers (quiet off) still see the line.
diag(msg: string) {
    // Record the reason so load_error() reflects every load failure
    // (parse, fetch, and bind), not just parse errors — an embedded
    // host needs it when stdout is suppressed.
    vcr_aether_set_load_err(msg)
    if vcr_quiet() == 0 {
        println(msg)
    }
}

// Suppress (1) or restore (0) the load-path stdout diagnostics above.
// Embedded hosts (the embed ABI) turn this on so the library stays
// silent; the failure reason is still available via load_error().
set_quiet(on: int) {
    vcr_set_quiet(on)
}

// The most recent load / load_url / load_record failure reason ("" if
// none). Same text that the diagnostics print in non-quiet mode, so an
// embedded host can surface *why* a start returned null without parsing
// stdout. Populated by the parser via vcr_aether_set_load_err.
load_error() -> string {
    return vcr_load_err()
}

// Per-listener lifecycle: create + bind the server FIRST so its handle
// (and thus its state key) exists, set that key current, then parse the
// tape into THIS server's state. The wildcard dispatcher (ud = handle)
// is registered here; serving is NOT started (the caller wires that, as
// before). Config calls (redact/static_content/untaped/...) take the
// handle and run AFTER load. Returns null (and leaves a load_error) on
// server_create or parse failure.
load(tape_path: string, port: int) -> ptr {
    raw = http.server_create(port)
    if raw == 0 {
        // No handle yet — report under the default key so load_error()
        // (no-handle) surfaces it.
        set_cur_key("0")
        diag("vcr.load: server_create on port ${port} returned 0")
        return null
    }
    key = key_for(raw)
    set_cur_key(key)
    diagnostic_open_h(raw, tape_path, tape_path)
    set_mode_k(key, "playback")

    perr = parse_tape_file(key, tape_path)
    if perr != "" {
        diag("vcr.load: ${perr}")
        http.server_stop(raw)
        return null
    }

    register_routes(raw)
    return raw
}

// Load a Servirtium markdown tape from an HTTP URL, parse it, and
// bind a playback server to the given port. Useful for centralized
// tape libraries — the tape doesn't need to be on the local filesystem.
//
// Returns a server pointer on success, null on failure. Failures
// include network errors (DNS, connection refused, timeout) and
// parse errors (invalid markdown format). Call eject(server) when done.
load_url(tape_url: string, port: int) -> ptr {
    raw = http.server_create(port)
    if raw == 0 {
        set_cur_key("0")
        diag("vcr.load_url: server_create on port ${port} returned 0")
        return null
    }
    key = key_for(raw)
    set_cur_key(key)
    diagnostic_open_h(raw, tape_url, tape_url)
    set_mode_k(key, "playback")
    vcr_aether_clear_tape_k(key)

    // Fetch the tape over HTTP using raw client (30s timeout)
    resp = http_get_with_timeout_raw(tape_url, 30000)
    if resp == null {
        diag("vcr.load_url: failed to fetch ${tape_url}")
        http.server_stop(raw)
        return null
    }

    err = http_response_error(resp)
    if err != "" && string.length(err) > 0 {
        diag("vcr.load_url: ${err}")
        http_response_free(resp)
        http.server_stop(raw)
        return null
    }

    // http_response_body returns a pointer borrowed from resp; copy it
    // out before freeing the response, or the parser below reads freed
    // memory (the bug the embed-ABI start_playback_url test caught — the
    // fetched tape would parse as empty: "no '## Interaction ' headers").
    tape_markdown = string.copy(http_response_body(resp))
    http_response_free(resp)

    // Parse the fetched markdown using the same path as load()
    perr = parse_tape_text(key, "http-sourced", tape_markdown)
    if perr != "" {
        diag("vcr.load_url: ${perr}")
        http.server_stop(raw)
        return null
    }

    register_routes(raw)
    return raw
}

// Eject the tape and shut the VCR's server down. Future versions
// will also assert "every tape entry got consumed" so an
// over-prescribed tape fails loudly.
eject(server: ptr) {
    http.server_stop(server)
    dump_unretrieved_k(key_for(server))
}

// ---- background start that returns only once the accept loop is live ----
//
// http_server_start_background_raw spawns the server thread and returns at
// once; the thread then enters http_server_start_raw, whose FIRST act is
// `is_running = 1`. A stop that lands before that line has its
// `is_running = 0` overwritten, and the loop then polls a closed socket
// forever. Before ae 0.799 that was a leaked thread spinning on a one-second
// poll, invisible: the thread was detached. Since ae 0.799 (#2672)
// http_server_stop JOINS the background thread, so the same open -> start ->
// stop with no request in between (cpp/'s "close is idempotent" fact; any
// binding test that fails before its first request) HANGS the host
// process. The root fix is upstream (start_raw must not clobber a stop that
// arrived first); this handshake makes start mean "serving", which is the
// embed contract anyway: std.http fires the monitor's listening event on the
// server thread after is_running is set and before the accept loop, so once
// it has fired a stop is never lost. Waits up to `timeout_ms`; returns 0, or -1 on a failed
// spawn or a thread that never reached the loop.
//
// The signal is a config key that exists only once the hook has run, polled
// with config.has: config.get hands back a BORROWED value that a concurrent
// put of the same key frees, so flipping one key "0" -> "1" under a polling
// reader would be a use-after-free. Each start gets its own key (a
// per-server generation, in the key the listening closure captures), so a
// restarted handle -- or a freed one whose address is reused -- never sees an
// earlier start's signal. Cost: one tiny config entry per start.
bg_started_key(server: ptr, gen: long) -> string {
    return slot(key_for(server), string_concat("bg_started.", string.from_long(gen)))
}

start_background_h(server: ptr, timeout_ms: int) -> int {
    // Apply any staged TLS config BEFORE the server goes live. set_tls_h only
    // stashes the cert/key paths (configure-before-start, like every other
    // handle setter); the actual std.http TLS context is built here, once, at
    // the one point where the server exists but has not yet bound. A TLS
    // failure (unreadable/parse/mismatched PEM, or a build without OpenSSL)
    // fails the start -- the handle's last_error carries the reason.
    terr = apply_tls_h(server)
    if terr != "" {
        set_last_error_k(key_for(server), string_concat("tls: ", terr))
        return -1
    }
    gen_slot = slot(key_for(server), "bg_gen")
    gen = cfg_get_int(gen_slot, 0) + 1
    cfg_set_int(gen_slot, gen)
    started = bg_started_key(server, gen)
    http.monitor(server) {
        listening() | host: string, port: int | { config.put(started, "1") }
    }
    if http.http_server_start_background_raw(server) < 0 {
        return -1
    }
    waited = 0
    while config.has(started) == 0 {
        if waited >= timeout_ms {
            return -1
        }
        sleep(1)
        waited = waited + 1
    }
    return 0
}

// ---- handle-based surface (per-listener) -----------------------------
//
// These take the server handle and act on THAT server's state, so a
// test can run N VCRs at once and address each independently. They are
// the surface the embed ABI / bindings call. The no-handle forms above
// remain for the record-without-a-server tests (they act on the default
// "current" key) and as the single-server convenience.

// Select the server whose state the subsequent no-handle calls address.
// (Mostly internal; the handle-based wrappers below set it themselves.)
use_handle(server: ptr) { set_cur_key(key_for(server)) }

redact_h(server: ptr, field: int, pattern: string, replacement: string) -> string {
    set_cur_key(key_for(server))
    return redact(field, pattern, replacement)
}
unredact_h(server: ptr, field: int, pattern: string, replacement: string) -> string {
    set_cur_key(key_for(server))
    return unredact(field, pattern, replacement)
}

// Response-side substitution: on playback, rewrite `pattern` -> `replacement`
// in the RESPONSE body (field=ResponseBody) or RESPONSE headers
// (field=ResponseHeaders) just before the recorded response is sent. Lets a
// taped `nextLink`/`id`/absolute URL point back at the test's own host so
// paging and HATEOAS links resolve. Three request-derived placeholders are
// ALSO filled automatically on every playback response, without registering
// anything: {{request.host}} (the live Host header), {{request.scheme}}
// (http/https — https when TLS is on) and {{baseUrl}} (scheme://host). This
// is playback-only and request-side matching is unaffected. Keyed: a concrete
// handle, never the ambient cur_key().
// field: FIELD_RESPONSE_BODY (2), FIELD_RESPONSE_HEADERS (5), or FIELD_RESPONSE
// (6) = "anywhere in the response" (body AND headers), one rule counted once.
// required: 1 = report via assert_all_redactions_used if never used; 0 = optional
// (a shared fixture's safeguard a given tape may not exercise).
substitute_h(server: ptr, field: int, pattern: string, replacement: string, required: int) -> string {
    if field != FIELD_RESPONSE_BODY && field != FIELD_RESPONSE_HEADERS && field != FIELD_RESPONSE {
        return "substitute: field must be ResponseBody, ResponseHeaders or Response"
    }
    if string.length(pattern) == 0 {
        return "substitute: pattern is empty"
    }
    r = malloc(sizeof(Redaction)) as *Redaction
    r.kind = 0
    r.field = field
    r.pattern = string.copy(pattern)
    r.replacement = string.copy(replacement)
    r.used = 0
    r.required = required
    list_add_raw(substitutions_k(key_for(server)), r)
    return ""
}

clear_substitutions_h(server: ptr) { list_reset(slot(key_for(server), "substitutions")) }

// Apply response-side substitutions for `field` to `text`, against THIS
// handle's live request `req`: the built-in {{request.*}} tokens first, then
// the registered (pattern -> replacement) rules for that field.
apply_substitutions_k(key: string, req: ptr, text: string, field: int) -> string {
    if string.length(text) == 0 { return text }
    out = text

    // Built-in request-derived tokens (cheap; only touch when present).
    if string.index_of(out, "{{request.") >= 0 || string.index_of(out, "{{baseUrl}}") >= 0 {
        host = request_header_value(req, "Host")
        scheme = "http"
        if tls_enabled_h_key(key) != 0 { scheme = "https" }
        base = string_concat(scheme, string_concat("://", host))
        out = str_replace_all(out, "{{request.host}}", host)
        out = str_replace_all(out, "{{request.scheme}}", scheme)
        out = str_replace_all(out, "{{baseUrl}}", base)
    }

    // Caller-registered substitutions for this field.
    l = substitutions_k(key)
    n = list_size(l)
    i = 0
    while i < n {
        r = list_get_raw(l, i) as *Redaction
        // FIELD_RESPONSE matches BOTH response fields (apply_substitutions_k is
        // only called with ResponseBody or ResponseHeaders), so the one rule
        // fires wherever the placeholder appears and is counted used once.
        if r.field == field || r.field == FIELD_RESPONSE {
            before = out
            out = str_replace_all(out, r.pattern, r.replacement)
            if out != before { r.used = 1 }
        }
        i = i + 1
    }
    return out
}
normalize_whole_tape_h(server: ptr, pattern: string, name: string) -> string {
    set_cur_key(key_for(server))
    return normalize_whole_tape(pattern, name)
}
redact_whole_tape_h(server: ptr, pattern: string, replacement: string) -> string {
    set_cur_key(key_for(server))
    return redact_whole_tape(pattern, replacement)
}
// The same two, with a description the recording-rules footer shows in place
// of the pattern: for a pattern that holds a per-run value (a mapped port),
// which would otherwise make the footer differ run to run, or one a reader
// is better told in words.
normalize_whole_tape_described_h(server: ptr, pattern: string, name: string, description: string) -> string {
    err = normalize_whole_tape_h(server, pattern, name)
    if err == "" { describe_last_normalization_k(key_for(server), description) }
    return err
}
redact_whole_tape_described_h(server: ptr, pattern: string, replacement: string, description: string) -> string {
    err = redact_whole_tape_h(server, pattern, replacement)
    if err == "" { describe_last_normalization_k(key_for(server), description) }
    return err
}
clear_normalizations_h(server: ptr) {
    set_cur_key(key_for(server))
    clear_normalizations()
}
remove_header_h(server: ptr, field: int, name: string) -> string {
    set_cur_key(key_for(server))
    return remove_header(field, name)
}
// ---- header presets (opt-in) -----------------------------------------
//
// Each preset is one call that registers ordinary rules, so a recording
// made with one says so in its recording-rules footer (set_rules_footer_h),
// grouped under the preset's name. None is on by default: a recording keeps
// what was sent unless the test asks otherwise.
//
// Servirtium records HTTP messages, not connections. Playback is a real HTTP
// server that frames its own replies (Content-Length, Connection, chunking,
// compression, TLS), so nothing a preset removes has to be replayed.

// Register a header removal on behalf of preset `origin`.
add_preset_removal_k(key: string, field: int, name: string, origin: string) {
    h = malloc(sizeof(HeaderRemoval)) as *HeaderRemoval
    h.field = field
    h.name = string.copy(name)
    h.origin = string.copy(origin)
    list_add_raw(header_removals_k(key), h)
}

// Register a removal for each name in a comma-separated list.
add_preset_removals_k(key: string, field: int, names: string, origin: string) {
    i = 0
    n = string.length(names)
    while i < n {
        end = string.index_of_from(names, ",", i)
        if end < 0 { end = n }
        name = trim_ws_cr(string.substring(names, i, end))
        if string.length(name) > 0 { add_preset_removal_k(key, field, name, origin) }
        i = end + 1
    }
}

// The headers that describe the recording connection, not the conversation:
// Host, Connection, Content-Length and the other hop-by-hop headers, and the
// request's Accept-Encoding. Matching already skips them; this leaves them
// out of the recording too (Servirtium 1's behaviour). Playback makes its
// own.
remove_transport_headers_h(server: ptr) -> string {
    key = key_for(server)
    add_preset_removals_k(key, FIELD_REQUEST_HEADERS, "Host, Connection, Content-Length, Transfer-Encoding, Keep-Alive, TE, Trailer, Upgrade, Accept-Encoding", "transport")
    add_preset_removals_k(key, FIELD_RESPONSE_HEADERS, "Connection, Content-Length, Transfer-Encoding, Keep-Alive, Trailer, Upgrade, Proxy-Authenticate", "transport")
    return ""
}

const CLOUD_VENDORS = "aws, azure, cloudflare, fastly, gcp"

// The tracing and cache-status headers a vendor's CDN, load balancer or API
// gateway adds to responses: headers the app maker never agreed to and that
// differ on every request. Deliberately NOT in any list, though CDNs set or
// change them: Age, Via, Cache-Control, ETag, Last-Modified, Date and Vary.
// HTTP cache libraries act on those (Age with Cache-Control decides
// freshness), so removing them could change what the app under test does.
cloud_vendor_headers(vendor: string) -> string {
    if icmp_rt(vendor, "aws") == 0 { return "X-Amz-Cf-Id, X-Amz-Cf-Pop, X-Amzn-Trace-Id, X-Amzn-RequestId, X-Amz-Apigw-Id, X-Cache" }
    if icmp_rt(vendor, "azure") == 0 { return "X-Azure-Ref, X-MSEdge-Ref" }
    if icmp_rt(vendor, "cloudflare") == 0 { return "CF-Ray, CF-Cache-Status, cf-request-id" }
    if icmp_rt(vendor, "fastly") == 0 { return "X-Served-By, X-Cache, X-Cache-Hits, X-Timer" }
    if icmp_rt(vendor, "gcp") == 0 { return "X-Cloud-Trace-Context, X-GUploader-UploadID" }
    return ""
}

// Leave a cloud vendor's added response headers out of the recording
// (and out of matching). `vendor` is one of CLOUD_VENDORS; call once per
// vendor in front of the service. AWS's X-Amzn-Trace-Id is also dropped from
// requests, since AWS SDKs and X-Ray send it.
remove_cloud_headers_h(server: ptr, vendor: string) -> string {
    names = cloud_vendor_headers(vendor)
    if string.length(names) == 0 {
        return "remove_cloud_headers: unknown vendor '${vendor}' (known: ${CLOUD_VENDORS})"
    }
    key = key_for(server)
    origin = "cloud: ${string.to_lower(vendor)}"
    add_preset_removals_k(key, FIELD_RESPONSE_HEADERS, names, origin)
    if icmp_rt(vendor, "aws") == 0 { add_preset_removal_k(key, FIELD_REQUEST_HEADERS, "X-Amzn-Trace-Id", origin) }
    return ""
}

// The identity headers stock HTTP clients attach (User-Agent, Accept,
// Accept-Encoding, Connection), left out of the recording and out of
// matching, for a test whose recording and playback clients differ.
strict_ignore_common_headers_h(server: ptr) -> string {
    add_preset_removals_k(key_for(server), FIELD_REQUEST_HEADERS, "User-Agent, Accept, Accept-Encoding, Connection", "common client headers")
    return ""
}

// The per-request tracing and correlation headers clients and service meshes
// inject (traceparent, tracestate, Request-Id, X-Request-Id,
// X-Correlation-Id, baggage), left out of the recording and out of matching.
ignore_volatile_headers_h(server: ptr) -> string {
    add_preset_removals_k(key_for(server), FIELD_REQUEST_HEADERS, "traceparent, tracestate, Request-Id, X-Request-Id, X-Correlation-Id, baggage", "tracing headers")
    return ""
}

// ---- redact_credentials ----
//
// The values of the usual credential headers, written as numbered tokens:
//
//   Authorization: Bearer AUTHORIZATION_1        (the scheme kept)
//   Proxy-Authorization: Basic PROXY_AUTHORIZATION_1
//   Cookie: sid=COOKIE_1; theme=COOKIE_2         (each cookie's value)
//   Set-Cookie: sid=COOKIE_1; Path=/; HttpOnly   (attributes kept)
//   X-Api-Key: API_KEY_1
//   X-Auth-Token: AUTH_TOKEN_1
//
// Each distinct value gets its own number, the same one wherever it appears,
// so a cookie the service set and the client sent back read as the same
// COOKIE_1, and a guest session and a logged-in one stay told apart. A value
// of 8 characters or more is also replaced wherever else it appears in the
// recording (a token echoed in a body); a shorter one only in its header,
// since "en" or "1" would hit ordinary text.
//
// Playback matches these headers on presence, not value: a test's live
// token rarely equals the recorded one, and a replayed Set-Cookie: sid=COOKIE_1
// comes back as Cookie: sid=COOKIE_1 anyway. Register the preset on the
// playback handle too, as with every rule.
redact_credentials_h(server: ptr) -> string {
    key = key_for(server)
    add_cred_header_k(key, "Authorization", 1, "AUTHORIZATION")
    add_cred_header_k(key, "Proxy-Authorization", 1, "PROXY_AUTHORIZATION")
    add_cred_header_k(key, "Cookie", 2, "COOKIE")
    add_cred_header_k(key, "Set-Cookie", 3, "COOKIE")
    add_cred_header_k(key, "X-Api-Key", 0, "API_KEY")
    add_cred_header_k(key, "X-Auth-Token", 0, "AUTH_TOKEN")
    return ""
}

// One more credential header for the same treatment, its whole value a
// numbered token named after it (X-Vault-Token: X_VAULT_TOKEN_1).
redact_credential_header_h(server: ptr, name: string) -> string {
    if string.length(name) == 0 { return "redact_credential_header: name is empty" }
    i = 0
    prefix = ""
    while i < string.length(name) {
        c = string.char_at(name, i)
        if c <= 32 || c >= 127 || c == 58 { return "redact_credential_header: invalid header name" }
        if c == 45 { prefix = string_concat(prefix, "_") } else { prefix = string_concat(prefix, string.substring(name, i, i + 1)) }
        i = i + 1
    }
    add_cred_header_k(key_for(server), name, 0, string.to_upper(prefix))
    return ""
}

add_cred_header_k(key: string, name: string, kind: int, prefix: string) {
    if cred_find_k(key, name) != null { return }
    c = malloc(sizeof(CredHeader)) as *CredHeader
    c.name = string.copy(name)
    c.kind = kind
    c.prefix = string.copy(prefix)
    list_add_raw(credheaders_k(key), c)
}

cred_find_k(key: string, name: string) -> *CredHeader {
    l = credheaders_k(key)
    i = 0
    while i < list_size(l) {
        c = list_get_raw(l, i) as *CredHeader
        if icmp_rt(c.name, name) == 0 { return c }
        i = i + 1
    }
    return null
}

// Whether credential header `c` is looked for in header block `field`.
cred_applies(c: *CredHeader, field: int) -> int {
    if c.kind == 2 { return field == FIELD_REQUEST_HEADERS }
    if c.kind == 3 { return field == FIELD_RESPONSE_HEADERS }
    return 1
}

cred_lookup_k(key: string, value: string) -> string {
    l = credtokens_k(key)
    i = 0
    while i < list_size(l) {
        t = list_get_raw(l, i) as *NormToken
        if string.equals(t.value, value) == 1 { return t.token }
        i = i + 1
    }
    return ""
}

// mode 0: register `secret` (first appearance numbers it); 1: its token.
cred_secret_k(key: string, secret: string, prefix: string, mode: int) -> string {
    if string.length(secret) == 0 { return secret }
    tok = cred_lookup_k(key, secret)
    if mode == 1 {
        if string.length(tok) > 0 { return tok }
        return secret
    }
    if string.length(tok) > 0 { return secret }
    counter_slot = slot(key, "credn.${prefix}")
    n = cfg_get_int(counter_slot, 0) + 1
    cfg_set_int(counter_slot, n)
    t = malloc(sizeof(NormToken)) as *NormToken
    t.value = string.copy(secret)
    t.token = "${prefix}_${n}"
    list_add_raw(credtokens_k(key), t)
    return secret
}

// "name=value" with the value through cred_secret_k; anything else as is.
cred_cookie_pair_k(key: string, pair: string, prefix: string, mode: int) -> string {
    eq = string.index_of(pair, "=")
    if eq <= 0 { return pair }
    return string_concat(string.substring(pair, 0, eq + 1), cred_secret_k(key, string.substring(pair, eq + 1, string.length(pair)), prefix, mode))
}

// One credential header value, its secret parts registered (mode 0),
// replaced by their tokens (1) or the whole value masked as "*" (2).
cred_value_k(key: string, c: *CredHeader, value: string, mode: int) -> string {
    if mode == 2 { return "*" }
    if c.kind == 1 {
        sp = string.index_of(value, " ")
        if sp > 0 {
            return string_concat(string.substring(value, 0, sp + 1), cred_secret_k(key, trim_ws_cr(string.substring(value, sp + 1, string.length(value))), c.prefix, mode))
        }
        return cred_secret_k(key, value, c.prefix, mode)
    }
    if c.kind == 2 {
        out = ""
        i = 0
        n = string.length(value)
        while i <= n {
            end = string.index_of_from(value, ";", i)
            if end < 0 { end = n }
            part = string.substring(value, i, end)
            lead = ""
            while string.length(part) > 0 && string.char_at(part, 0) == 32 {
                lead = string_concat(lead, " ")
                part = string.substring(part, 1, string.length(part))
            }
            out = string_concat(out, lead)
            out = string_concat(out, cred_cookie_pair_k(key, part, c.prefix, mode))
            if end < n { out = string_concat(out, ";") }
            i = end + 1
        }
        return out
    }
    if c.kind == 3 {
        semi = string.index_of(value, ";")
        if semi < 0 { return cred_cookie_pair_k(key, value, c.prefix, mode) }
        return string_concat(cred_cookie_pair_k(key, string.substring(value, 0, semi), c.prefix, mode), string.substring(value, semi, string.length(value)))
    }
    return cred_secret_k(key, value, c.prefix, mode)
}

// Run every credential header line in a header block through cred_value_k.
cred_rewrite_block_k(key: string, headers: string, field: int, mode: int) -> string {
    if list_size(credheaders_k(key)) == 0 || string.length(headers) == 0 { return headers }
    out = string.copy("")
    cursor = 0
    h_len = string.length(headers)
    while cursor < h_len {
        nl_idx = string.index_of_from(headers, "\n", cursor)
        line_end = h_len
        if nl_idx >= 0 { line_end = nl_idx }
        content_end = line_end
        if content_end > cursor && string.char_at(headers, content_end - 1) == 13 { content_end = content_end - 1 }
        line = string.substring(headers, cursor, content_end)
        colon_idx = string.index_of(line, ":")
        if colon_idx > 0 {
            c = cred_find_k(key, string.substring(line, 0, colon_idx))
            if c != null && cred_applies(c, field) == 1 {
                v = trim_ws_cr(string.substring(line, colon_idx + 1, string.length(line)))
                line = string_concat(string.substring(line, 0, colon_idx), ": ${cred_value_k(key, c, v, mode)}")
            }
        }
        out = string_concat(out, line)
        out = string_concat(out, string.substring(headers, content_end, line_end))
        if nl_idx >= 0 { out = string_concat(out, "\n") }
        if nl_idx < 0 { break }
        cursor = nl_idx + 1
    }
    return out
}

// Request headers for matching: credential values masked as "*".
cred_mask_block_k(key: string, headers: string) -> string {
    return cred_rewrite_block_k(key, headers, FIELD_REQUEST_HEADERS, 2)
}

// Number every credential value across the tape, in order of appearance.
build_credential_map_k(key: string) {
    list_reset(slot(key, "credtokens"))
    cl = credheaders_k(key)
    if list_size(cl) == 0 { return }
    ci = 0
    while ci < list_size(cl) {
        c = list_get_raw(cl, ci) as *CredHeader
        cfg_set_int(slot(key, "credn.${c.prefix}"), 0)
        ci = ci + 1
    }
    n = list_size(tape_list_k(key))
    i = 0
    while i < n {
        e = tape_get_k(key, i)
        _r1 = cred_rewrite_block_k(key, string.copy(e.req_headers), FIELD_REQUEST_HEADERS, 0)
        _r2 = cred_rewrite_block_k(key, string.copy(e.resp_headers), FIELD_RESPONSE_HEADERS, 0)
        i = i + 1
    }
}

// Replace each credential value of 8 or more characters wherever it appears
// in `s`, longest first (so a value inside a longer one cannot split it).
cred_apply_values_k(key: string, s: string) -> string {
    if string.length(s) == 0 { return s }
    l = credtokens_k(key)
    out = s
    below = 2147483647
    while 1 == 1 {
        best = -1
        i = 0
        while i < list_size(l) {
            t = list_get_raw(l, i) as *NormToken
            len = string.length(t.value)
            if len >= 8 && len < below && len > best { best = len }
            i = i + 1
        }
        if best < 0 { break }
        i = 0
        while i < list_size(l) {
            t = list_get_raw(l, i) as *NormToken
            if string.length(t.value) == best { out = str_replace_all(out, t.value, t.token) }
            i = i + 1
        }
        below = best
    }
    return out
}

// ---- licence notice ---------------------------------------------------
//
// add_license_notice_h(server, text): plain text written at the top of every
// tape this handle records, under a "## LICENSE NOTICE" heading, before
// "## Interaction 0". It is for the licence or terms the recorded service is
// under (for example a vendor's "no reverse engineering" clause), so whoever
// reads or replays the tape sees them. Servirtium writes the text as given:
// the developer puts in any line breaks they want. Several calls add several
// paragraphs, in call order. Playback ignores the section: tapes are parsed
// from the first "## Interaction " heading. So the text may not contain a
// line starting "## Interaction " or the rules-footer heading.
const LICENSE_NOTICE_HEADING = "## LICENSE NOTICE"
add_license_notice_h(server: ptr, text: string) -> string {
    return add_license_notice_k(key_for(server), text)
}
add_license_notice(text: string) -> string {
    return add_license_notice_k(cur_key(), text)
}
add_license_notice_k(key: string, text: string) -> string {
    if string.length(string.trim(text)) == 0 { return "add_license_notice: text is empty" }
    t = normalize_tape_bytes(text)
    bad = 0
    if string.starts_with(t, "## Interaction ") == 1 || string.index_of(t, "\n## Interaction ") >= 0 { bad = 1 }
    if string.starts_with(t, RULES_FOOTER_HEADING) == 1 || string.index_of(t, string_concat("\n", RULES_FOOTER_HEADING)) >= 0 { bad = 1 }
    if bad == 1 {
        return "add_license_notice: a line may not start with '## Interaction ' or '${RULES_FOOTER_HEADING}' (playback reads those as tape structure)"
    }
    prev = cfg_get_str(slot(key, "license_notice"))
    para = string.trim(t)
    if string.length(prev) > 0 { para = "${prev}\n\n${para}" }
    config.put(slot(key, "license_notice"), para)
    return ""
}

note_h(server: ptr, title: string, body: string) -> string {
    set_cur_key(key_for(server))
    return note(title, body)
}
static_content_h(server: ptr, mount_path: string, fs_dir: string) -> string {
    set_cur_key(key_for(server))
    return static_content(mount_path, fs_dir)
}
untaped_h(server: ptr, path: string) -> string {
    set_cur_key(key_for(server))
    return untaped(path)
}

// ---- HTTPS listener (TLS termination) --------------------------------
//
// An increasing number of HTTP client libraries refuse plain http:// to
// anything but localhost, so the VCR can terminate TLS and the SUT points
// at https://<host>:<port>. TLS is a std.http server capability
// (server_set_tls); libservirtium_vcr just threads the PEM cert+key paths
// through and applies them at start. Like every other config call, set it
// AFTER open and BEFORE start.
//
// set_tls_h stashes the paths in per-handle config; apply_tls_h (called by
// start_background_h) builds the TLS context once the server exists but has
// not yet bound. Both paths must be PEM files and must match; the cert+key
// validation and OpenSSL-availability check are std.http's, surfaced as the
// returned error string. Passing one path without the other is an error.
// Record mode: verify an https upstream against this CA (a PEM file) rather
// than the system store, for a service with its own CA (Elasticsearch 8
// generates one). Verification and hostname checks stay on. Connection-level
// only: nothing about it reaches the recording.
set_upstream_cafile_h(server: ptr, path: string) -> string {
    if string.length(path) == 0 { return "set_upstream_cafile: path is empty (need a PEM CA file)" }
    cfg_set_str(slot(key_for(server), "upstream_cafile"), path)
    return ""
}

set_tls_h(server: ptr, cert_path: string, key_path: string) -> string {
    if string.length(cert_path) == 0 {
        return "cert_path is empty (need a PEM certificate file)"
    }
    if string.length(key_path) == 0 {
        return "key_path is empty (need a PEM private-key file)"
    }
    key = key_for(server)
    cfg_set_str(slot(key, "tls_cert"), cert_path)
    cfg_set_str(slot(key, "tls_key"), key_path)
    return ""
}

// Like set_tls_h, but the certificate and key are PEM TEXT passed in memory
// (not file paths), so a test never writes a private key to disk. Applied at
// start via http.server_set_tls_pem (aether #3362), which runs the same
// set-time checks as the path form. Configure after open, before start.
set_tls_pem_h(server: ptr, cert_pem: string, key_pem: string) -> string {
    if string.length(cert_pem) == 0 {
        return "cert_pem is empty (need a PEM certificate)"
    }
    if string.length(key_pem) == 0 {
        return "key_pem is empty (need a PEM private key)"
    }
    key = key_for(server)
    cfg_set_str(slot(key, "tls_cert_pem"), cert_pem)
    cfg_set_str(slot(key, "tls_key_pem"), key_pem)
    return ""
}

// The TLS protocol this listener serves over, so a test can assert the server
// side (not just that the client was set to TLS 1.3). "TLSv1.3" when TLS is on
// — libservirtium_vcr's HTTPS is the pure-Aether TLS 1.3 server (RFC 8446), which
// negotiates only 1.3 — else "" (plain HTTP). Read after start.
last_tls_protocol_h(server: ptr) -> string {
    if tls_enabled_h(server) != 0 { return "TLSv1.3" }
    return ""
}

// 1 when a TLS cert has been staged on this handle (so base_url returns the
// https:// scheme), 0 otherwise.
tls_enabled_h_key(key: string) -> int {
    cert = cfg_get_str(slot(key, "tls_cert"))
    if string.length(cert) > 0 { return 1 }
    cert_pem = cfg_get_str(slot(key, "tls_cert_pem"))
    if string.length(cert_pem) > 0 { return 1 }
    return 0
}
tls_enabled_h(server: ptr) -> int {
    return tls_enabled_h_key(key_for(server))
}

// Build the staged TLS context on `server`, if any. "" when there is nothing
// to do or TLS was enabled successfully; the std.http error string otherwise.
apply_tls_h(server: ptr) -> string {
    key = key_for(server)
    // In-memory PEM wins if set (the private key never touched disk).
    cert_pem = cfg_get_str(slot(key, "tls_cert_pem"))
    if string.length(cert_pem) > 0 {
        key_pem = cfg_get_str(slot(key, "tls_key_pem"))
        return http.server_set_tls_pem(server, cert_pem, key_pem)
    }
    cert = cfg_get_str(slot(key, "tls_cert"))
    if string.length(cert) == 0 { return "" }
    tkey = cfg_get_str(slot(key, "tls_key"))
    return http.server_set_tls(server, cert, tkey)
}
set_strict_headers_h(server: ptr, on: int) { vcr_set_strict_headers_k(key_for(server), on) }
set_rules_footer_h(server: ptr, on: int) { vcr_set_rules_footer_k(key_for(server), on) }
get_rules_footer_h(server: ptr) -> int { return vcr_get_rules_footer_k(key_for(server)) }
set_match_json_body_h(server: ptr, on: int) { vcr_set_match_json_body_k(key_for(server), on) }
set_match_xml_body_h(server: ptr, on: int) { vcr_set_match_xml_body_k(key_for(server), on) }
set_pretty_xml_h(server: ptr, indent: int) { vcr_set_pretty_xml_k(key_for(server), indent) }
get_pretty_xml_h(server: ptr) -> int { return vcr_get_pretty_xml_k(key_for(server)) }
set_pretty_json_h(server: ptr, indent: int) { vcr_set_pretty_json_k(key_for(server), indent) }
get_pretty_json_h(server: ptr) -> int { return vcr_get_pretty_json_k(key_for(server)) }
sort_json_keys_h(server: ptr, on: int) { vcr_set_sort_json_keys_k(key_for(server), on) }
get_sort_json_keys_h(server: ptr) -> int { return vcr_get_sort_json_keys_k(key_for(server)) }
sort_json_array_h(server: ptr, path: string, by: string) -> string { return vcr_sort_json_array_k(key_for(server), path, by) }
sort_response_headers_h(server: ptr, on: int) { vcr_set_sort_response_headers_k(key_for(server), on) }
get_sort_response_headers_h(server: ptr) -> int { return vcr_get_sort_response_headers_k(key_for(server)) }
sort_header_value_h(server: ptr, name: string) -> string { return vcr_sort_header_value_k(key_for(server), name) }
clear_stable_order_h(server: ptr) { vcr_clear_stable_order_k(key_for(server)) }
// Bare (current-key) forms, for record()/flush() without a handle.
sort_json_keys(on: int) { vcr_set_sort_json_keys_k(cur_key(), on) }
sort_json_array(path: string, by: string) -> string { return vcr_sort_json_array_k(cur_key(), path, by) }
sort_response_headers(on: int) { vcr_set_sort_response_headers_k(cur_key(), on) }
sort_header_value(name: string) -> string { return vcr_sort_header_value_k(cur_key(), name) }
clear_stable_order() { vcr_clear_stable_order_k(cur_key()) }
set_match_multiple_h(server: ptr, on: int) { vcr_set_match_multiple_k(key_for(server), on) }
add_match_header_h(server: ptr, name: string) { set_cur_key(key_for(server)); vcr_add_match_header(name) }
clear_match_headers_h(server: ptr) { set_cur_key(key_for(server)); vcr_clear_match_headers() }
indent_code_blocks_h(server: ptr) { set_cur_key(key_for(server)); indent_code_blocks() }
emphasize_http_verbs_h(server: ptr) { set_cur_key(key_for(server)); emphasize_http_verbs() }
clear_redactions_h(server: ptr) { set_cur_key(key_for(server)); clear_redactions() }
clear_unredactions_h(server: ptr) { set_cur_key(key_for(server)); clear_unredactions() }
clear_header_removals_h(server: ptr) { set_cur_key(key_for(server)); clear_header_removals() }
clear_static_content_h(server: ptr) { set_cur_key(key_for(server)); clear_static_content() }
clear_untaped_h(server: ptr) { set_cur_key(key_for(server)); clear_untaped() }
clear_format_options_h(server: ptr) { set_cur_key(key_for(server)); clear_format_options() }

// diagnostics / lifecycle (handle-based, no shared current-key reliance)
last_error_h(server: ptr) -> string { return replay_last_error_k(key_for(server), 1) }
last_kind_h(server: ptr) -> int { return vcr_last_kind_k(key_for(server)) }
last_index_h(server: ptr) -> int { return vcr_last_index_k(key_for(server)) }
clear_last_error_h(server: ptr) { vcr_clear_last_error_k(key_for(server)) }
tape_length_h(server: ptr) -> int { return list_size(tape_list_k(key_for(server))) }
reset_cursor_h(server: ptr) { vcr_reset_cursor_k(key_for(server)) }

// "" if every registered redaction / unredaction / substitution rule actually
// matched something, else a message listing the rules that never fired (the
// verifyNoMoreInteractions() analogue for scrubbing rules). Catches a stale
// test config — an .Unredact/.Redact/.Substitute whose pattern no longer
// appears in the tape, so it silently does nothing. Call at end of test.
// Accumulate a "served response still had a {{placeholder}}" record for this
// handle (deduped by method+path). Stored as a newline-joined string in config.
note_unfilled_placeholder_k(key: string, method: string, path: string) {
    entry = "${method} ${path}"
    existing = cfg_get_str(slot(key, "unfilled_placeholders"))
    // Dedupe: a tape entry hit repeatedly (MatchMultiple) records once.
    if string.index_of(existing, "\n  ${entry}") >= 0 { return }
    cfg_set_str(slot(key, "unfilled_placeholders"), "${existing}\n  ${entry}")
}

// "" if every served response had all its {{...}} placeholders filled, else a
// message listing the interactions (method + path) that still contained a
// placeholder when sent to the SUT — a typo like {{valut}}, or a placeholder no
// Substitute/{{request.*}} rule covers. Catches the mistake that a passing test
// can otherwise hide: the raw marker is served to the client as literal text.
// Works the same with a shared fixture or per-test rules. Call at end of test.
assert_no_unfilled_placeholders_h(server: ptr) -> string {
    detail = cfg_get_str(slot(key_for(server), "unfilled_placeholders"))
    if string.length(detail) == 0 { return "" }
    return "vcr: a served response still contained an unfilled {{placeholder}} in:${detail}"
}

assert_all_redactions_used_h(server: ptr) -> string {
    key = key_for(server)
    unused = 0
    detail = ""
    detail, unused = _collect_unused_rules(redactions_k(key), "redact", detail, unused)
    detail, unused = _collect_unused_rules(unredactions_k(key), "unredact", detail, unused)
    detail, unused = _collect_unused_rules(substitutions_k(key), "substitute", detail, unused)
    if unused == 0 { return "" }
    return "vcr: ${unused} configured scrubbing rule(s) never matched anything:${detail}"
}

// Human field name for a diagnostic message (so AssertAllRedactionsUsed reads
// "substitute(ResponseHeaders, ...)" rather than "field 5").
field_name(field: int) -> string {
    if field == FIELD_PATH { return "Path" }
    if field == FIELD_RESPONSE_BODY { return "ResponseBody" }
    if field == FIELD_REQUEST_HEADERS { return "RequestHeaders" }
    if field == FIELD_REQUEST_BODY { return "RequestBody" }
    if field == FIELD_RESPONSE_HEADERS { return "ResponseHeaders" }
    return "field ${field}"
}

_collect_unused_rules(l: ptr, label: string, detail: string, unused: int) -> (string, int) {
    n = list_size(l)
    i = 0
    while i < n {
        r = list_get_raw(l, i) as *Redaction
        // Only count rules the caller asked to be required. Optional rules
        // (required=0) — e.g. a shared fixture's safeguard substitution that a
        // given tape doesn't exercise — are never reported as unused.
        if r.used == 0 && r.required != 0 {
            unused = unused + 1
            detail = string_concat(detail, "\n  ${label}(${field_name(r.field)}, \"${r.pattern}\")")
        }
        i = i + 1
    }
    return detail, unused
}

// "" if EVERY recorded interaction was replayed at least once since load/reset,
// else a message listing the ones that were not (index + method + path). Lets a
// test fail when the SUT skipped a taped step — e.g. it never performed the
// recorded 401 sign-in — which a per-request outcome check cannot catch. Works
// in both ordered and MatchMultiple playback (the `used` flag is set at either
// match point). Call after the SUT has finished driving the server.
assert_all_consumed_h(server: ptr) -> string {
    key = key_for(server)
    tl = tape_list_k(key)
    n = list_size(tl)
    unused = 0
    detail = ""
    i = 0
    while i < n {
        e = list_get_raw(tl, i) as *Interaction
        if e.used == 0 {
            unused = unused + 1
            detail = string_concat(detail, "\n  [${i}] ${e.method} ${e.path}")
        }
        i = i + 1
    }
    if unused == 0 { return "" }
    return "vcr: ${unused} of ${n} recorded interaction(s) were never replayed:${detail}"
}
load_error_h(server: ptr) -> string { return vcr_load_err_k(key_for(server)) }

// How many entries the loaded tape has (or, in record mode, how
// many interactions have been captured so far). Useful for
// sanity-checking in test setup and after-record verification.
tape_length() -> int { return vcr_tape_length() }

// Record mode: create a VCR server that listens like playback, but
// forwards each request to `upstream_base` with std.http.client,
// returns the real response to the SUT, and records the interaction
// into the in-memory tape. Call eject_record(server, tape_path) when
// the run is complete; it writes the markdown tape to the same path
// vcr.load(tape_path, port) later replays from.
load_record(tape_path: string, upstream_base: string, port: int) -> ptr {
    raw = http.server_create(port)
    if raw == 0 {
        set_cur_key("0")
        diag("vcr.load_record: server_create on port ${port} returned 0")
        return null
    }
    key = key_for(raw)
    set_cur_key(key)
    diagnostic_open_h(raw, tape_path, tape_path)
    vcr_aether_clear_tape_k(key)

    ok = vcr_register_record_routes(raw, upstream_base)
    if ok == 0 {
        diag("vcr.load_record: ${vcr_load_err()}")
        http.server_stop(raw)
        return null
    }

    return raw
}

// Stop the record-mode server and write the captured markdown tape
// to `tape_path`. This deliberately overwrites the playback tape:
// the developer reviews git diff to decide whether upstream changed
// legitimately or unexpectedly.
eject_record(server: ptr, tape_path: string) -> string {
    key = key_for(server)
    http.server_stop(server)
    dump_unretrieved_k(key)
    return flush_k(key, tape_path)
}

// Handle-based flush drift variants for the embed ABI. They stop the server,
// then flush/check THAT server's captured tape via the keyed flush path — no
// ambient cur_key(), so a concurrent flush on another handle can't interleave.
stop_and_flush_h(server: ptr, tape_path: string) -> string {
    key = key_for(server)
    http.server_stop(server)
    dump_unretrieved_k(key)
    return flush_k(key, tape_path)
}
stop_and_flush_fail_if_changed_h(server: ptr, tape_path: string) -> string {
    key = key_for(server)
    http.server_stop(server)
    dump_unretrieved_k(key)
    return flush_and_fail_if_changed_k(key, tape_path)
}
stop_and_flush_or_check_h(server: ptr, tape_path: string) -> string {
    key = key_for(server)
    http.server_stop(server)
    dump_unretrieved_k(key)
    return flush_or_check_k(key, tape_path)
}
// Record-mode DISCARD (field report #5): stop the server and drop the in
// memory recording WITHOUT writing a tape. A binding calls this instead of
// stop_and_flush when the test failed, so a half-finished recording can never
// become a tape that later replays as the truth. The two-phase contract is:
// run the test, flush (commit) only on success, discard on failure. Returns ""
// always — there is nothing to fail, and a double-stop is harmless.
discard_h(server: ptr, tape_path: string) -> string {
    key = key_for(server)
    http.server_stop(server)
    dump_unretrieved_k(key)
    vcr_aether_clear_tape_k(key)
    return ""
}

// ---- Record mode -----------------------------------------------------
//
// The recorder is driven from test code: it registers its own
// handler against the routing layer, that handler forwards the
// request to upstream via std.http.client, captures the response,
// echoes it back to the SUT, and calls record() to add it to the
// in-memory capture list. When the test is done, the test calls
// flush(tape_path) to write everything out in canonical Servirtium
// markdown. The next run of the test can replay from the same tape
// without internet involvement.
//
// Capture an interaction. Called by the test's recorder handler
// after it's forwarded the request and read the upstream response.
// Returns "" on success, error string otherwise.
record(method: string, path: string, status: int, content_type: string, body: string) -> string {
    ok = vcr_record_interaction(method, path, status, content_type, body)
    if ok == 0 { return "vcr.record failed" }
    return ""
}

// Clear the in-memory tape used by direct recorder tests. load_record()
// calls this automatically before binding its server; this wrapper is
// for tests that drive record()/record_full*() without a server.
clear_recording() {
    vcr_aether_clear_tape_k(cur_key())
}

// Ensure the parent directory of `path` exists before we write to it.
// Every README example writes a tape under a subdir (e.g. "tapes/foo.md")
// without a prior mkdir, so a first write to a not-yet-existing directory
// used to fail with a bare "cannot open file for writing". mkdir -p the
// parent so the common case just works; path_dirname is pure (a bare
// filename yields ".", and mkdir_p(".") is a harmless no-op).
ensure_parent_dir(path: string) -> string {
    dir = fs.path_dirname(path)
    if string.length(dir) == 0 { return "" }
    return fs.mkdir_p(dir)
}

// Write every captured interaction to `tape_path` in canonical
// Servirtium markdown. Overwrites any existing file at that path.
// Returns "" on success, error string otherwise.
//
// Implementation: Aether-side. The full markdown blob is built by
// emit_tape() and written via fs.write. The pre-port C path (still
// shipped as vcr_flush_to_tape) is unused by this surface but
// retained as a fallback during the C→Aether migration.
flush_k(key: string, tape_path: string) -> string {
    blob = emit_tape_k(key)
    emit_err = config.get(slot(key, "emit_error"))
    if emit_err != "" { return emit_err }
    derr = ensure_parent_dir(tape_path)
    if derr != "" { return derr }
    // Crash-safe write (field report #5): build the full blob, write it to a
    // sibling temp file, then rename over the target. A process that dies mid
    // write can no longer leave a half-written tape that later replays as the
    // truth. The emit-error check above is the other half of the same promise —
    // a recording whose emit failed never reaches disk at all. (A test that
    // FAILED and should write nothing calls discard_h, not flush.)
    tmp = string_concat(tape_path, ".tmp")
    werr = fs.write(tmp, blob)
    if werr != "" { return werr }
    rerr = fs.rename(tmp, tape_path)
    if rerr != "" {
        // Best-effort cleanup so a failed rename doesn't orphan the temp file.
        fs.unlink(tmp)
        return rerr
    }
    return ""
}
flush(tape_path: string) -> string {
    return flush_k(cur_key(), tape_path)
}

// ---- HAR import (HTTP Archive JSON -> Servirtium markdown tape) ----
//
// Convert a HAR 1.2 capture (Chrome DevTools / Fiddler / Charles / mitmproxy /
// Postman export) into a Servirtium markdown tape, reusing the SAME emitter as
// record mode so the output is byte-consistent with a natively recorded tape.
// The field mapping mirrors Vcr.HttpRecorder's HAR model (portions copyright
// Giannis Georgopoulos, MIT).
//
// Deliberate choices for a *replayable* tape: Servirtium matches a non-empty
// recorded request-headers block by default, and a browser's volatile headers
// (User-Agent, Cookie, sec-ch-*) would never match a test client's — so request
// headers are NOT imported; matching is method + path (+ request body). The
// request BODY is imported (it distinguishes POSTs to one path; pair it with
// set_match_json_body for JSON APIs). The full response — status, headers (minus
// hop-by-hop / Content-Encoding, since the body is stored decoded), and body
// (base64-marked when the HAR entry is base64-encoded) — is imported.

// A JSON string field of `obj`, or "" when absent / wrong type / null container.
har_str(obj: ptr, key: string) -> string {
    if obj == null { return "" }
    v = json.json_object_get_raw(obj, key)
    if v == null { return "" }
    if json.json_type(v) != 3 { return "" }             // 3 == JSON_STRING
    return string.copy(json.json_get_string_raw(v))
}

// A JSON integer field of `obj`, or 0 when absent / wrong type.
har_int(obj: ptr, key: string) -> int {
    if obj == null { return 0 }
    v = json.json_object_get_raw(obj, key)
    if v == null { return 0 }
    if json.json_type(v) != 2 { return 0 }              // 2 == JSON_NUMBER
    return json.json_get_int(v)
}

// Path (+query) of an absolute URL: "https://h/a/b?x=1" -> "/a/b?x=1".
har_url_path(url: string) -> string {
    if string.length(url) == 0 { return "/" }
    scheme = string.index_of(url, "://")
    if scheme >= 0 {
        rest = scheme + 3
        slash = string.index_of_from(url, "/", rest)
        if slash < 0 { return "/" }
        return string.substring(url, slash, string.length(url))
    }
    return url
}

// Headers that must not land in a tape: HTTP/2 pseudo-headers (":authority",
// ...) and hop-by-hop / transport headers the recorder also omits.
har_skip_header(name: string) -> int {
    if string.length(name) == 0 { return 1 }
    if string.char_at(name, 0) == 58 { return 1 }       // 58 == ':'
    if icmp_rt(name, "Connection") == 0 { return 1 }
    if icmp_rt(name, "Content-Length") == 0 { return 1 }
    if icmp_rt(name, "Transfer-Encoding") == 0 { return 1 }
    if icmp_rt(name, "Content-Encoding") == 0 { return 1 }  // body stored decoded
    if icmp_rt(name, "Keep-Alive") == 0 { return 1 }
    return 0
}

// ---- Bruno (.bru) request parsing --------------------------------------
//
// A .bru file is a small block DSL of request DEFINITIONS (no responses):
//   meta { name: ...  seq: N }
//   get  { url: {{baseUrl}}/path  body: none }   (block name IS the method)
//   headers { Accept: application/json }
//   body:json { {"k": "v"} }
// These parse the request-half; the CLI's `import-bru` then HYDRATES it by
// firing each request through record mode against a real upstream, so the
// captured responses fill the tape. (Like har_import, request headers are NOT
// carried into the match — a collection's headers would not match a test
// client's; matching is method + path + body.)

// Trim ASCII space / tab / CR / LF from both ends.
bru_trim(s: string) -> string {
    n = string.length(s)
    a = 0
    while a < n {
        c = string.char_at(s, a)
        if c != 32 && c != 9 && c != 13 && c != 10 { break }
        a = a + 1
    }
    b = n
    while b > a {
        c = string.char_at(s, b - 1)
        if c != 32 && c != 9 && c != 13 && c != 10 { break }
        b = b - 1
    }
    return string.substring(s, a, b)
}

// The inner text of a single-level `name { ... \n}` block, or "" if absent.
bru_block_body(text: string, name: string) -> string {
    hdr = string.concat(name, " {")
    at = string.index_of(text, hdr)
    if at < 0 { return "" }
    open = at + string.length(hdr)
    close = string.index_of_from(text, "\n}", open)
    if close < 0 { return "" }
    return string.substring(text, open, close)
}

// The trimmed value of `key:` within a block body (first occurrence), or "".
bru_kv(body: string, key: string) -> string {
    needle = string.concat(key, ":")
    at = string.index_of(body, needle)
    if at < 0 { return "" }
    vs = at + string.length(needle)
    nl = string.index_of_from(body, "\n", vs)
    if nl < 0 { nl = string.length(body) }
    return bru_trim(string.substring(body, vs, nl))
}

// The HTTP method = whichever verb block is present. "" if none.
bru_method_of(text: string) -> string {
    if string.index_of(text, "get {") >= 0 { return "GET" }
    if string.index_of(text, "post {") >= 0 { return "POST" }
    if string.index_of(text, "put {") >= 0 { return "PUT" }
    if string.index_of(text, "patch {") >= 0 { return "PATCH" }
    if string.index_of(text, "delete {") >= 0 { return "DELETE" }
    if string.index_of(text, "head {") >= 0 { return "HEAD" }
    if string.index_of(text, "options {") >= 0 { return "OPTIONS" }
    return ""
}

// The lowercase verb-block name for a method (the block bru_block_body reads).
bru_verb_block(method: string) -> string {
    if string.equals(method, "GET") == 1 { return "get" }
    if string.equals(method, "POST") == 1 { return "post" }
    if string.equals(method, "PUT") == 1 { return "put" }
    if string.equals(method, "PATCH") == 1 { return "patch" }
    if string.equals(method, "DELETE") == 1 { return "delete" }
    if string.equals(method, "HEAD") == 1 { return "head" }
    if string.equals(method, "OPTIONS") == 1 { return "options" }
    return ""
}

// bru_body_block(declared) — the block name holding the payload for a Bruno
// `body: <declared>` line, or "" when there is nothing to send. Bruno names the
// block after the type (`body: xml` -> a `body:xml { ... }` block).
bru_body_block(declared: string) -> string {
    if string.equals(declared, "json") == 1 { return "body:json" }
    if string.equals(declared, "xml") == 1 { return "body:xml" }
    if string.equals(declared, "text") == 1 { return "body:text" }
    if string.equals(declared, "sparql") == 1 { return "body:sparql" }
    return ""
}

// bru_body_content_type(declared) — the Content-Type to send a Bruno body under.
// "" when the type has no single literal payload (formUrlEncoded, multipartForm,
// graphql and file all need real serialisation — k=v joining, multipart framing,
// a GraphQL envelope — rather than shipping the block verbatim).
bru_body_content_type(declared: string) -> string {
    if string.equals(declared, "json") == 1 { return "application/json" }
    if string.equals(declared, "xml") == 1 { return "application/xml" }
    if string.equals(declared, "text") == 1 { return "text/plain" }
    if string.equals(declared, "sparql") == 1 { return "application/sparql-query" }
    return ""
}

// bru_body_needs_work(declared) — 1 when the collection declares a body this
// engine cannot serialise yet, so a caller should leave the dev a TODO rather
// than send an empty body and record a plausible-looking wrong answer. "none"
// and "" are NOT work: they mean there is genuinely no body.
bru_body_needs_work(declared: string) -> int {
    if string.length(declared) == 0 { return 0 }
    if string.equals(declared, "none") == 1 { return 0 }
    if string.length(bru_body_block(declared)) > 0 { return 0 }
    return 1
}

// "Name: value\n..." block from a HAR message's headers[] array (filtered).
har_headers_block(msg: ptr) -> string {
    if msg == null { return "" }
    arr = json.json_object_get_raw(msg, "headers")
    if arr == null { return "" }
    if json.json_type(arr) != 4 { return "" }           // 4 == JSON_ARRAY
    out = string.copy("")
    n = json.json_array_size(arr)
    i = 0
    while i < n {
        h = json.json_array_get_raw(arr, i)
        name = har_str(h, "name")
        if har_skip_header(name) == 0 {
            line = string_concat(name, ": ")
            line = string_concat(line, har_str(h, "value"))
            out = string_concat(out, line)
            out = string_concat(out, "\n")
        }
        i = i + 1
    }
    return out
}

// request.postData.text verbatim, or "".
har_post_body(req: ptr) -> string {
    if req == null { return "" }
    pd = json.json_object_get_raw(req, "postData")
    if pd == null { return "" }
    return har_str(pd, "text")
}

// Import `har_path` and write the equivalent tape to `tape_path`. Returns "" on
// success, else a human-readable error.
har_import(har_path: string, tape_path: string) -> string {
    src, rerr = fs.read(har_path)
    if rerr != "" { return string_concat("har import: cannot read har file: ", rerr) }
    root, perr = json.parse(src)
    if root == null { return string_concat("har import: invalid JSON: ", perr) }

    log = json.json_object_get_raw(root, "log")
    if log == null { json.json_free(root); return "har import: missing 'log' object" }
    entries = json.json_object_get_raw(log, "entries")
    if entries == null || json.json_type(entries) != 4 {
        json.json_free(root)
        return "har import: missing 'log.entries' array"
    }

    key = "__har_import__"
    list_reset(slot(key, "tape"))

    n = json.json_array_size(entries)
    i = 0
    while i < n {
        entry = json.json_array_get_raw(entries, i)
        req = json.json_object_get_raw(entry, "request")
        resp = json.json_object_get_raw(entry, "response")

        method = har_str(req, "method")
        path = har_url_path(har_str(req, "url"))
        req_body = har_post_body(req)

        status = har_int(resp, "status")
        content = json.json_object_get_raw(resp, "content")
        mime = har_str(content, "mimeType")
        enc = har_str(content, "encoding")
        body = har_str(content, "text")
        ctype = mime
        if string.equals(enc, "base64") == 1 {
            base = mime
            if string.length(base) == 0 { base = "application/octet-stream" }
            ctype = string_concat(base, " base64 below")
        }
        has_ct = 0
        if string.length(ctype) > 0 { has_ct = 1 }

        // Request headers intentionally omitted (see the header note above).
        tape_append_k(key, method, path, status, body, ctype, has_ct, "", req_body)
        set_resp_headers_k(key, i, har_headers_block(resp))
        i = i + 1
    }
    json.json_free(root)

    set_cur_key(key)
    blob = emit_tape()
    emit_err = config.get(slot(cur_key(), "emit_error"))
    if emit_err != "" { return emit_err }
    derr = ensure_parent_dir(tape_path)
    if derr != "" {
        list_reset(slot(key, "tape"))
        return string_concat("har import: cannot create tape dir: ", derr)
    }
    werr = fs.write(tape_path, blob)
    list_reset(slot(key, "tape"))                       // leave the scratch key clean
    if werr != "" { return string_concat("har import: cannot write tape: ", werr) }
    return ""
}

// ---- HAR export (Servirtium markdown tape -> HTTP Archive JSON) ----
//
// The inverse of har_import: parse a tape (reusing the record/playback parser)
// and serialise its interactions as a HAR 1.2 log via std.json — so a tape can
// be opened in a HAR viewer / DevTools / Postman or fed to HAR-based tooling.
// A tape carries only the path (not an absolute URL) and no timings, so those
// are synthesised (host `localhost`, zero timings) — HAR consumers key off
// method / path / headers / body, which round-trip faithfully.

// A HAR headers[] array built from a "Name: value\n..." block.
har_headers_to_json(block: string) -> ptr {
    a = json.arr()
    blen = string.length(block)
    cursor = 0
    while cursor < blen {
        nl = string.index_of_from(block, "\n", cursor)
        line_end = blen
        if nl >= 0 { line_end = nl }
        line = string.substring(block, cursor, line_end)
        if string.length(line) > 0 {
            colon = string.index_of(line, ":")
            if colon > 0 {
                name = string.substring(line, 0, colon)
                vstart = colon + 1
                if vstart < string.length(line) && string.char_at(line, vstart) == 32 {
                    vstart = vstart + 1                 // skip the ": " space
                }
                value = string.substring(line, vstart, string.length(line))
                h = json.obj()
                json.set(h, "name", json.str(name))
                json.set(h, "value", json.str(value))
                json.push(a, h)
            }
        }
        if nl < 0 { break }
        cursor = nl + 1
    }
    return a
}

// Strip libservirtium_vcr's " base64 below" marker off a content-type, yielding the
// bare MIME type for HAR's content.mimeType.
strip_base64_marker(ctype: string) -> string {
    idx = string.index_of(ctype, " base64 below")
    if idx < 0 { idx = string.index_of(ctype, "base64 below") }
    if idx < 0 { return ctype }
    return rtrim(string.substring(ctype, 0, idx))
}

// Export the tape at `tape_path` as a HAR file at `har_path`. Returns "" on
// success, else a human-readable error.
har_export(tape_path: string, har_path: string) -> string {
    key = "__har_export__"
    set_cur_key(key)
    list_reset(slot(key, "tape"))
    perr = parse_tape_file(key, tape_path)
    if perr != "" { return string_concat("har export: cannot parse tape: ", perr) }

    entries = json.arr()
    n = vcr_get_tape_count()
    i = 0
    while i < n {
        method = vcr_get_method(i)
        path = vcr_get_path(i)
        status = vcr_get_status(i)
        ctype = vcr_get_content_type(i)
        body = vcr_get_body(i)
        req_headers = vcr_get_req_headers(i)
        req_body = vcr_get_req_body(i)
        resp_headers = vcr_get_resp_headers(i)

        reqo = json.obj()
        json.set(reqo, "method", json.str(method))
        json.set(reqo, "url", json.str(string_concat("http://localhost", path)))
        json.set(reqo, "httpVersion", json.str("HTTP/1.1"))
        json.set(reqo, "headers", har_headers_to_json(req_headers))
        json.set(reqo, "queryString", json.arr())
        json.set(reqo, "headersSize", json.from_int(-1))
        json.set(reqo, "bodySize", json.from_int(string.length(req_body)))
        if string.length(req_body) > 0 {
            pd = json.obj()
            json.set(pd, "mimeType", json.str(""))
            json.set(pd, "text", json.str(req_body))
            json.set(reqo, "postData", pd)
        }

        is_b64 = ascii_ci_contains(ctype, "base64 below")
        mime = ctype
        if is_b64 == 1 { mime = strip_base64_marker(ctype) }
        content = json.obj()
        json.set(content, "size", json.from_int(string.length(body)))
        json.set(content, "mimeType", json.str(mime))
        json.set(content, "text", json.str(body))
        if is_b64 == 1 { json.set(content, "encoding", json.str("base64")) }

        respo = json.obj()
        json.set(respo, "status", json.from_int(status))
        json.set(respo, "statusText", json.str(""))
        json.set(respo, "httpVersion", json.str("HTTP/1.1"))
        json.set(respo, "headers", har_headers_to_json(resp_headers))
        json.set(respo, "content", content)
        json.set(respo, "redirectURL", json.str(""))
        json.set(respo, "headersSize", json.from_int(-1))
        json.set(respo, "bodySize", json.from_int(string.length(body)))

        tim = json.obj()
        json.set(tim, "send", json.from_int(0))
        json.set(tim, "wait", json.from_int(0))
        json.set(tim, "receive", json.from_int(0))

        entry = json.obj()
        json.set(entry, "startedDateTime", json.str("1970-01-01T00:00:00.000Z"))
        json.set(entry, "time", json.from_int(0))
        json.set(entry, "request", reqo)
        json.set(entry, "response", respo)
        json.set(entry, "cache", json.obj())
        json.set(entry, "timings", tim)
        json.push(entries, entry)
        i = i + 1
    }

    creator = json.obj()
    json.set(creator, "name", json.str("servirtium-vcr"))
    json.set(creator, "version", json.str("1"))
    log = json.obj()
    json.set(log, "version", json.str("1.2"))
    json.set(log, "creator", creator)
    json.set(log, "entries", entries)
    root = json.obj()
    json.set(root, "log", log)

    text, eerr = json.encode(root)
    json.json_free(root)
    list_reset(slot(key, "tape"))
    if eerr != "" { return string_concat("har export: JSON encode failed: ", eerr) }
    derr = ensure_parent_dir(har_path)
    if derr != "" { return string_concat("har export: cannot create har dir: ", derr) }
    werr = fs.write(har_path, text)
    if werr != "" { return string_concat("har export: cannot write har file: ", werr) }
    return ""
}

// ---- Tape lint (the standalone CLI's `servirtium check`) ----
//
// Parse-check a tape without binding a server: (interactions, "") when
// the tape parses clean, else (0, error). Same scratch-key pattern as
// har_export, so no listener state is touched.
check_tape(tape_path: string) -> (int, string) {
    key = "__check__"
    set_cur_key(key)
    list_reset(slot(key, "tape"))
    perr = parse_tape_file(key, tape_path)
    if perr != "" { return 0, perr }
    n = vcr_get_tape_count()
    list_reset(slot(key, "tape"))
    return n, ""
}

// Canonical-form check: "" when the on-disk bytes are exactly what this
// libservirtium_vcr's emitter writes for the tape's content (the compact/tight
// canonical form, default format options), else a description. A tape
// can parse clean yet not be canonical — the parser is deliberately
// lenient and accepts other Servirtium implementations' looser spacing.
// Normalize by re-recording, or by round-tripping the tape through the
// emitter (e.g. the CLI's HAR export/import).
canonical_check_tape(tape_path: string) -> string {
    key = "__check__"
    set_cur_key(key)
    list_reset(slot(key, "tape"))
    perr = parse_tape_file(key, tape_path)
    if perr != "" { return perr }
    blob = emit_tape()
    emit_err = config.get(slot(cur_key(), "emit_error"))
    if emit_err != "" { return emit_err }
    list_reset(slot(key, "tape"))
    existing, eerr = fs.read(tape_path)
    if eerr != "" { return eerr }
    if existing == blob { return "" }
    canonical_len = string.length(blob)
    file_len = string.length(existing)
    return "not canonical: emitter form is ${canonical_len} bytes, file is ${file_len} bytes"
}

// Re-record check (Servirtium roadmap step 4). If `tape_path`
// doesn't exist on disk, behaves identically to flush(). If it
// does exist, writes the in-memory tape to a sibling `.actual`
// file then byte-compares against the on-disk tape:
//   - identical → deletes the .actual sibling, returns ""
//   - different → leaves the .actual sibling on disk for the
//     developer to diff, returns an error string with the diff
//     offset
//
// Use this in CI to catch upstream drift (the upstream now returns
// different bytes than when the tape was first recorded — so either
// the tape needs updating, the upstream has changed semantically, or
// the client's wire format drifted).
flush_or_check_k(key: string, tape_path: string) -> string {
    actual_path = "${tape_path}.actual"

    // First-record case: no on-disk tape yet → just flush.
    existing, eerr = fs.read(tape_path)
    if eerr != "" {
        return flush_k(key, tape_path)
    }

    // On-disk tape present. Build the in-memory tape and write to
    // the .actual sibling for inspection.
    blob = emit_tape_k(key)
    emit_err = config.get(slot(key, "emit_error"))
    if emit_err != "" { return emit_err }
    werr = fs.write(actual_path, blob)
    if werr != "" { return werr }

    if existing == blob {
        // Match — clean up the .actual sibling.
        fs.delete(actual_path)
        return ""
    }

    // Mismatch — surface a diff offset so the developer knows
    // where to look. The .actual sibling stays on disk.
    expected_len = string.length(existing)
    actual_len   = string.length(blob)
    return "tape mismatch: expected=${expected_len} bytes, actual=${actual_len} bytes; .actual sibling left at ${actual_path}"
}
flush_or_check(tape_path: string) -> string {
    return flush_or_check_k(cur_key(), tape_path)
}

// Servirtium-style re-record check. Unlike flush_or_check(), this
// writes the newly recorded tape to `tape_path` even when bytes differ,
// so a normal git diff shows the drift. The non-empty return value lets
// the test fail loudly after preserving the new recording.
flush_and_fail_if_changed_k(key: string, tape_path: string) -> string {
    existing, eerr = fs.read(tape_path)
    blob = emit_tape_k(key)
    emit_err = config.get(slot(key, "emit_error"))
    if emit_err != "" { return emit_err }

    derr = ensure_parent_dir(tape_path)
    if derr != "" { return derr }
    werr = fs.write(tape_path, blob)
    if werr != "" { return werr }

    if eerr != "" {
        return ""
    }

    if existing == blob {
        return ""
    }

    expected_len = string.length(existing)
    actual_len   = string.length(blob)
    return "tape mismatch: expected=${expected_len} bytes, actual=${actual_len} bytes; updated tape written to ${tape_path}"
}
flush_and_fail_if_changed(tape_path: string) -> string {
    return flush_and_fail_if_changed_k(cur_key(), tape_path)
}

// ---- Mutation mode (Servirtium roadmap step 8) -----------------------
//
// Test code can scrub sensitive values (Authorization tokens, session
// cookies, server-issued ids, API keys baked into URLs) out of the
// tape *before* it lands on disk, so committing a recorded tape to a
// public repo doesn't leak secrets.
//
// Redactions are applied at flush() / flush_or_check() time only —
// the in-memory capture stays untouched, so the same VCR can keep
// serving replays mid-test using the original bytes while still
// writing a scrubbed tape at the end.
//
// Usage:
//   vcr.redact(vcr.FIELD_RESPONSE_BODY, "Bearer abc123", "Bearer REDACTED")
//   vcr.redact(vcr.FIELD_PATH,           "session=xyz",   "session=REDACTED")
//   ... drive SUT, capture interactions ...
//   vcr.flush(tape_path)
//
// Field selectors for recording redactions and playback
// unredactions. Redactions are applied only when writing a tape;
// unredactions are applied only when comparing an incoming request
// to a loaded tape.
const FIELD_PATH             = 1
const FIELD_RESPONSE_BODY    = 2
const FIELD_REQUEST_HEADERS  = 3
const FIELD_REQUEST_BODY     = 4
const FIELD_RESPONSE_HEADERS = 5
// A substitution-only pseudo-field: "anywhere in the response" (body AND
// headers). One rule, counted once by assert_all_redactions_used.
const FIELD_RESPONSE         = 6

// Register a redaction. Every occurrence of `pattern` in the
// designated field is replaced with `replacement` at flush time.
// Returns "" on success, error string otherwise.
redact(field: int, pattern: string, replacement: string) -> string {
    ok = vcr_add_redaction(field, pattern, replacement)
    if ok == 0 { return vcr_load_err() }
    return ""
}

// Structured recording rules share storage, reset behaviour and registration
// order with literal rules. Only the emitter applies them; forwarding is intact.
structured_redaction(kind: int, field: int, name: string, replacement: string) -> string {
    if string.length(name) == 0 { return "redaction name must not be empty" }
    if kind == 1 && field != FIELD_REQUEST_HEADERS && field != FIELD_RESPONSE_HEADERS {
        return "header redaction requires a header field"
    }
    if kind == 3 && field != FIELD_REQUEST_BODY && field != FIELD_RESPONSE_BODY {
        return "JSON redaction requires a body field"
    }
    if kind == 1 {
        i = 0
        while i < string.length(name) {
            c = string.char_at(name, i)
            if c <= 32 || c >= 127 || c == 92 || string.contains("()<>@,;:\"/[]?={}", string.substring(name, i, i + 1)) == 1 {
                return "invalid header name"
            }
            i = i + 1
        }
        if string.contains(replacement, "\r") == 1 || string.contains(replacement, "\n") == 1 {
            return "header replacement must be a single line"
        }
    }
    r = malloc(sizeof(Redaction)) as *Redaction
    r.kind = kind
    r.field = field
    r.pattern = string.copy(name)
    r.replacement = string.copy(replacement)
    r.used = 0
    r.required = 1
    list_add_raw(redactions(), r)
    return ""
}
redact_header(field: int, name: string, replacement: string) -> string {
    return structured_redaction(1, field, name, replacement)
}
redact_query_param(name: string, replacement: string) -> string {
    return structured_redaction(2, FIELD_PATH, name, replacement)
}
redact_json_field(field: int, name: string, replacement: string) -> string {
    return structured_redaction(3, field, name, replacement)
}
redact_header_h(h: ptr, field: int, name: string, replacement: string) -> string {
    set_cur_key(key_for(h))
    return redact_header(field, name, replacement)
}
redact_query_param_h(h: ptr, name: string, replacement: string) -> string {
    set_cur_key(key_for(h))
    return redact_query_param(name, replacement)
}
redact_json_field_h(h: ptr, field: int, name: string, replacement: string) -> string {
    set_cur_key(key_for(h))
    return redact_json_field(field, name, replacement)
}

// Drop all registered redactions. Call between tests in the same
// process so a redaction set from one test doesn't leak into the
// next.
clear_redactions() {
    vcr_clear_redactions()
    list_reset(slot(cur_key(), "credheaders"))
}

// Register a whole-tape normalization: every distinct match of `pattern`
// (across all fields and interactions) is rewritten to a stable {{name-N}}
// token on flush, so server-minted values that recur collapse to one token
// and re-records stay byte-identical. Returns "" on success, else load_err.
normalize_whole_tape(pattern: string, name: string) -> string {
    ok = vcr_add_normalization(pattern, name, "")
    if ok == 0 { return vcr_load_err() }
    return ""
}

// Collapse every whole-tape match of `pattern` to the constant `replacement`
// (a plain regex replace_all across all fields/interactions). For volatile
// values you never correlate — Date headers, request ids — where a per-value
// token would not be byte-stable. Returns "" on success, else load_err.
redact_whole_tape(pattern: string, replacement: string) -> string {
    ok = vcr_add_normalization(pattern, "", replacement)
    if ok == 0 { return vcr_load_err() }
    return ""
}

clear_normalizations() {
    vcr_clear_normalizations()
}

// Register a playback-side replacement. Use this when a committed
// tape intentionally contains redacted values, but the live SUT still
// sends the real value. For example, a tape may contain
// `Authorization: Bearer REDACTED`; the test can call:
//
//   vcr.unredact(vcr.FIELD_REQUEST_HEADERS, "Bearer REDACTED", real_token)
//
// before vcr.load(). The dispatcher applies the replacement to the
// recorded expectation before comparing path / request headers / body.
// Response fields are accepted for symmetry but are not used by
// playback matching today.
unredact(field: int, pattern: string, replacement: string) -> string {
    ok = vcr_add_unredaction(field, pattern, replacement)
    if ok == 0 { return vcr_load_err() }
    return ""
}

clear_unredactions() {
    vcr_clear_unredactions()
}

// Remove a header by name from request/response header blocks.
// Recording flush applies this to the emitted tape; playback applies
// request-header removals to both the recorded expectation and the
// live incoming request before strict matching. Header-name matching
// is case-insensitive and exact.
//
// IGNORE-A-HEADER-WHEN-MATCHING: because the removal is applied to
// *both* sides before comparison, this is also the lever for telling
// strict matching to ignore a header. Real HTTP clients attach headers
// the tape never recorded — Go/Java/Rust/.NET each add their own
// `User-Agent`, `Accept`, `Accept-Encoding`, `Connection` — and strict
// matching (correctly) rejects them as unexpected. Drop them from the
// comparison with, e.g.:
//
//   vcr.remove_header(vcr.FIELD_REQUEST_HEADERS, "User-Agent")
//
// (Host is already stripped during normalization, so it never needs
// this.) The embed ABI bundles the common volatile set into one call,
// vcr_embed_strict_ignore_common_headers().
remove_header(field: int, name: string) -> string {
    ok = vcr_add_header_removal(field, name)
    if ok == 0 { return vcr_load_err() }
    return ""
}

clear_header_removals() {
    vcr_clear_header_removals()
}

// ---- Notes (Servirtium roadmap step 9) -------------------------------
//
// Record-only annotation. Stage a (title, body) note before driving
// the SUT; the next recorded interaction picks it up and the on-disk
// tape carries a `## [Note] <title>:` block between the interaction
// heading and its ### sections. Playback ignores notes — they exist
// purely as inline documentation for a human reading the tape.
//
//   vcr.note("Mary", "Mary had a little lamb...")
//   ... recorder fires next interaction ...   <- note attaches here
//   ... recorder fires another interaction ...  <- no note (already drained)
//
// Calling note() twice in a row replaces the staged note (last writer
// wins). Notes do not survive vcr.load() — record/replay are mutually
// exclusive per-run anyway.
//
// Returns "" on success, error string otherwise.
note(title: string, body: string) -> string {
    ok = vcr_add_note(title, body)
    if ok == 0 { return vcr_load_err() }
    return ""
}

// ---- Strict request matching (Servirtium roadmap step 10) ------------
//
// Step-7-era recorder captured method/path/status/body and the
// dispatcher matched on (method, path) only. Step 10 adds opt-in
// matching against request headers + request body — when a tape
// entry has non-empty request_headers / request_body code blocks,
// the dispatcher hard-fails any incoming request that diverges
// from them and the failure detail is exposed via vcr.last_error()
// so a test's tearDown can confirm the right thing went wrong.
//
// Header normalization: headers are sorted by name (case-insensitive)
// and Host is stripped before comparison — Host is always test-host-
// controlled and would cause false positives on every record/replay.
// Both sides reduce to a "Name: Value\n..." canonical blob; the
// recorder is responsible for emitting the blob in canonical form
// (the dispatcher only normalizes the live incoming side).
//
// Failure shape (from the spec's broken_recordings/ examples):
//   Missing/extra header → "<name> request header (en|ex)countered
//                          but not (expected|encountered)"
//   Wrong header value   → "<name> request header value differed ..."
//   Wrong body           → "request body different to expectation ..."
//
// Use case: step-10 hostile-tape tests confirm the framework
// fails when a tape lies about what the server saw.

// Capture an interaction with full request shape — headers + body
// in addition to method/path/status/content_type/response_body.
// `req_headers` should be canonical-form: "Name: Value\n..."
// sorted by name, Host stripped. Pass "" for either req field
// to opt that field out of mismatch detection (tape entry won't
// constrain it on later replay).
record_full(method: string, path: string, status: int, content_type: string, body: string, req_headers: string, req_body: string) -> string {
    ok = vcr_record_interaction_full(method, path, status, content_type, body, req_headers, req_body)
    if ok == 0 { return "vcr.record_full failed" }
    return ""
}

// Capture a full interaction including response headers. This is
// primarily what record-mode uses internally, but tests can drive it
// directly when no live HTTP server is needed.
record_full_response(method: string, path: string, status: int, content_type: string, body: string, req_headers: string, req_body: string, resp_headers: string) -> string {
    ok = vcr_record_interaction_full(method, path, status, content_type, body, req_headers, req_body)
    if ok == 0 { return "vcr.record_full_response failed" }
    idx = vcr_tape_length() - 1
    vcr_aether_set_resp_headers(idx, resp_headers)
    return ""
}

// Most-recent playback mismatch diagnostic. Empty string when no
// mismatch has been flagged since the last load() / clear_last_error().
// Read this from a test's tearDown to confirm the framework
// detected the divergence the test was set up to provoke.
last_error() -> string {
    return replay_last_error_k(cur_key(), 1)
}

// Drop the last-error slot — call between subtests so a flagged
// mismatch doesn't bleed forward.
clear_last_error() {
    vcr_clear_last_error()
}

// ---- Static-content mounts (Servirtium roadmap step 11) --------------
//
// Mark an on-disk directory as bypass-the-tape territory. Every
// incoming GET whose path starts with `mount_path` is served from
// disk (with the http_serve_file mime-type detection and traversal-
// prevention) and never consulted against the tape.
//
// Use case: Selenium/Cypress/Playwright UI tests where the page
// is the SUT — letting the tape capture every CSS/JS/image asset
// is noise. Point the static-content config at the local build
// artifacts directory; the tape stays focused on the actual
// domain-API exchanges the test cares about.
//
// Configure mounts BEFORE calling vcr.load() — the tape loader is
// what wires routes against the http server. Mounts persist across
// vcr.load() calls in the same process; clear_static_content()
// is the explicit reset.
//
//   vcr.static_content("/assets", "build/static")
//   raw = vcr.load(tape_path, port)
//   ... drives SUT, /assets/* served from disk, /api/* from tape ...
//
// Returns "" on success, error string otherwise.
static_content(mount_path: string, fs_dir: string) -> string {
    ok = vcr_add_static_content(mount_path, fs_dir)
    if ok == 0 { return vcr_load_err() }
    return ""
}

// Drop all static-content mounts. The route registrations against
// a running http server are NOT removed (the http_server module
// has no remove_route surface today) — call this between tests
// only when reusing the same VCR config across very different
// scenarios. Recommended pattern is one VCR per test.
clear_static_content() {
    vcr_clear_static_content()
}

// ---- Untaped paths (Servirtium "don't record / 404") ----------------
//
// Mark a path the SUT/browser hits incidentally but that has no place
// on the tape — /favicon.ico is the canonical case for browser-driven
// (Selenium/Cypress) tests. A matching request gets a bare 404 from the
// VCR without ever touching the tape: on playback it doesn't advance the
// cursor or trip a mismatch (so the favicon GET stops reporting
// TAPE_EXHAUSTED); on record it isn't forwarded upstream or written out.
//
// Exact path match; the server strips the query first, so "/favicon.ico"
// also covers "/favicon.ico?v=2". Configure BEFORE vcr.load() (same as
// static_content). Persists across load() in the same process;
// clear_untaped() is the explicit reset.
//
//   vcr.untaped("/favicon.ico")
//   raw = vcr.load(tape_path, port)
//
// Returns "" on success, error string otherwise.
untaped(path: string) -> string {
    ok = vcr_add_untaped(path)
    if ok == 0 { return vcr_load_err() }
    return ""
}

clear_untaped() {
    vcr_clear_untaped()
}

// ---- Optional markdown formatting (Servirtium roadmap step 12) -------
//
// Two recorder-only toggles for the on-disk tape format. Playback
// tolerates either form regardless of these toggles — a tape
// recorded by another Servirtium implementation in either form
// loads cleanly here, and a tape we wrote in one form can be
// loaded by any other implementation that meets the spec.
//
//   indent_code_blocks() — emit code blocks as 4-space-indented
//   text instead of triple-backtick fences. Idiomatic for some
//   markdown editors and avoids the open-fence/close-fence
//   ambiguity when bodies happen to contain ``` lines.
//
//   emphasize_http_verbs() — emit the method in interaction
//   headings as *GET* instead of bare GET. Some markdown
//   renderers display this in italics, making the method visually
//   distinct from the path.
//
// Default off; existing tapes round-trip byte-identical when no
// toggle is set.
indent_code_blocks() {
    vcr_set_indent_code_blocks(1)
}

emphasize_http_verbs() {
    vcr_set_emphasize_http_verbs(1)
}

// Reset toggles back to defaults (fenced blocks, bare verbs).
// Useful between tests in the same process.
clear_format_options() {
    vcr_set_indent_code_blocks(0)
    vcr_set_emphasize_http_verbs(0)
    vcr_set_pretty_xml(0)
    vcr_set_pretty_json(0)
    vcr_clear_stable_order_k(cur_key())
}

// ---- Aether-side tape emitter ---------------------------------------
//
// Ported from the original C-side emit_tape_to_fp + emit_code_block.
// Pure string assembly + file I/O — nothing here needed C, it just
// happened to start there. Storage stays in C (the dispatcher reads
// it directly); the emitter walks the tape via accessor externs.
//
// Behavior must match the C emitter byte-for-byte for tapes flushed
// without redactions / format toggles, since existing tests assert
// against canonical Servirtium output.

// Replace every (non-overlapping) occurrence of `pattern` in `src`
// with `replacement`. Empty pattern is a no-op (returns src unchanged).
// Mirrors the C str_replace_all this replaces.
str_replace_all(src: string, pattern: string, replacement: string) -> string {
    plen = string.length(pattern)
    if plen == 0 { return src }

    out = string.copy("")
    cursor = 0
    src_len = string.length(src)
    while cursor < src_len {
        idx = string.index_of_from(src, pattern, cursor)
        if idx < 0 {
            tail = string.substring(src, cursor, src_len)
            out = string_concat(out, tail)
            return out
        }
        chunk = string.substring(src, cursor, idx)
        out = string_concat(out, chunk)
        out = string_concat(out, replacement)
        cursor = idx + plen
    }
    return out
}

// Apply every registered redaction whose field matches `field` to
// `s`. No-op when no redactions registered.
// JSON bodies are validated before emission. Scan validated tokens to preserve
// every byte outside selected values (including duplicate/escaped object keys).
json_string_end(s: string, start: int) -> int {
    i = start + 1
    while i < string.length(s) {
        c = string.char_at(s, i)
        if c == 92 { i = i + 2 }
        else if c == 34 { return i + 1 }
        else { i = i + 1 }
    }
    return i
}
json_skip_space(s: string, start: int) -> int {
    i = start
    while i < string.length(s) {
        c = string.char_at(s, i)
        if c != 32 && c != 9 && c != 10 && c != 13 { return i }
        i = i + 1
    }
    return i
}
json_value_end(s: string, start: int) -> int {
    i = start
    depth = 0
    while i < string.length(s) {
        c = string.char_at(s, i)
        if c == 34 { i = json_string_end(s, i) }
        else {
            if depth == 0 && (c == 44 || c == 93 || c == 125 || c == 32 || c == 9 || c == 10 || c == 13) { return i }
            if c == 91 || c == 123 { depth = depth + 1 }
            if c == 93 || c == 125 { depth = depth - 1 }
            i = i + 1
            if depth == 0 && (c == 93 || c == 125) { return i }
        }
    }
    return i
}
redact_json_text(s: string, name: string, replacement: string) -> string {
    value = json.str(replacement)
    quoted, _ = json.encode(value)
    json.json_free(value)
    out = string.copy("")
    copied = 0
    i = 0
    while i < string.length(s) {
        if string.char_at(s, i) == 34 {
            end = json_string_end(s, i)
            colon = json_skip_space(s, end)
            if colon < string.length(s) && string.char_at(s, colon) == 58 {
                key, _ = json.parse(string.substring(s, i, end))
                matches = string.equals(json.json_get_string_raw(key), name)
                json.json_free(key)
                if matches == 1 {
                    start = json_skip_space(s, colon + 1)
                    end = json_value_end(s, start)
                    out = string_concat(out, string.substring(s, copied, start))
                    out = string_concat(out, quoted)
                    copied = end
                }
            }
            i = end
        } else { i = i + 1 }
    }
    return string_concat(out, string.substring(s, copied, string.length(s)))
}

hex_digit(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 65 && c <= 70 { return c - 55 }
    if c >= 97 && c <= 102 { return c - 87 }
    return -1
}
query_decode(s: string) -> string {
    out = string.copy("")
    i = 0
    while i < string.length(s) {
        c = string.char_at(s, i)
        if c == 43 { out = string_concat(out, " ") }
        else if c == 37 && i + 2 < string.length(s) {
            a = hex_digit(string.char_at(s, i + 1))
            b = hex_digit(string.char_at(s, i + 2))
            if a >= 0 && b >= 0 {
                out = string_concat(out, string.from_char(a * 16 + b))
                i = i + 2
            } else { out = string_concat(out, "%") }
        } else { out = string_concat(out, string.substring(s, i, i + 1)) }
        i = i + 1
    }
    return out
}
query_encode(s: string) -> string {
    out = string.copy("")
    digits = "0123456789ABCDEF"
    i = 0
    while i < string.length(s) {
        c = string.char_at(s, i)
        if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 46 || c == 95 || c == 126 {
            out = string_concat(out, string.substring(s, i, i + 1))
        } else {
            out = string_concat(out, "%")
            a = c / 16
            b = c % 16
            out = string_concat(out, string.substring(digits, a, a + 1))
            out = string_concat(out, string.substring(digits, b, b + 1))
        }
        i = i + 1
    }
    return out
}
redact_query_text(s: string, name: string, replacement: string) -> string {
    q = string.index_of(s, "?")
    if q < 0 { return s }
    limit = string.index_of_from(s, "#", q)
    if limit < 0 { limit = string.length(s) }
    out = string.substring(s, 0, q + 1)
    i = q + 1
    while i < limit {
        end = string.index_of_from(s, "&", i)
        if end < 0 || end > limit { end = limit }
        eq = string.index_of_from(s, "=", i)
        if eq < 0 || eq > end { eq = end }
        if query_decode(string.substring(s, i, eq)) == name {
            out = string_concat(out, string.substring(s, i, eq))
            out = string_concat(out, "=")
            out = string_concat(out, query_encode(replacement))
        } else { out = string_concat(out, string.substring(s, i, end)) }
        if end < limit { out = string_concat(out, "&") }
        i = end + 1
    }
    return string_concat(out, string.substring(s, limit, string.length(s)))
}
redact_header_text(s: string, name: string, replacement: string) -> string {
    out = string.copy("")
    i = 0
    n = string.length(s)
    while i < n {
        end = string.index_of_from(s, "\n", i)
        if end < 0 { end = n }
        line_end = end
        if line_end > i && string.char_at(s, line_end - 1) == 13 { line_end = line_end - 1 }
        colon = string.index_of_from(s, ":", i)
        if colon >= i && colon < line_end && icmp_aether(string.substring(s, i, colon), name) == 0 {
            out = string_concat(out, string.substring(s, i, colon + 1))
            out = string_concat(out, " ")
            out = string_concat(out, replacement)
            out = string_concat(out, string.substring(s, line_end, end))
        } else { out = string_concat(out, string.substring(s, i, end)) }
        if end < n { out = string_concat(out, "\n") }
        i = end + 1
    }
    return out
}
apply_redactions_for_k(key: string, s: string, field: int) -> string {
    out = s
    l = redactions_k(key)
    i = 0
    while i < list_size(l) {
        r = list_get_raw(l, i) as *Redaction
        if r.field == field {
            before = out
            if r.kind == 0 { out = str_replace_all(out, r.pattern, r.replacement) }
            if r.kind == 1 { out = redact_header_text(out, r.pattern, r.replacement) }
            if r.kind == 2 { out = redact_query_text(out, r.pattern, r.replacement) }
            if r.kind == 3 && string.length(out) > 0 {
                tree, err = json.parse(out)
                if err != "" || tree == null {
                    config.put(slot(key, "emit_error"), "JSON field redaction requires valid JSON")
                    return ""
                }
                json.json_free(tree)
                out = redact_json_text(out, r.pattern, r.replacement)
            }
            // "Used" = this rule actually rewrote something (its pattern was
            // present), for assert_all_redactions_used.
            if out != before { r.used = 1 }
        }
        i = i + 1
    }
    return out
}
apply_redactions_for(s: string, field: int) -> string {
    return apply_redactions_for_k(cur_key(), s, field)
}

// Apply every registered playback unredaction whose field matches
// `field` to `s`. Used before registering route paths so tapes with
// redacted URLs still create the route the live client will request.
apply_unredactions_for(s: string, field: int) -> string {
    n = vcr_get_unredaction_count()
    if n == 0 { return s }
    out = s
    i = 0
    while i < n {
        if vcr_get_unredaction_field(i) == field {
            out = str_replace_all(out, vcr_get_unredaction_pattern(i),
                                       vcr_get_unredaction_replacement(i))
        }
        i = i + 1
    }
    return out
}

// Convert a tape path into the route key expected by std.http's
// router. The dispatcher still compares the full path+query when
// the tape expects one; routing itself needs only the path segment.
route_path_for(path: string) -> string {
    p = apply_unredactions_for(path, FIELD_PATH)
    q = string.index_of(p, "?")
    if q >= 0 {
        p = string.substring(p, 0, q)
    }
    if string.length(p) == 0 { return "/" }
    return p
}

route_already_registered(method: string, route_path: string, before: int) -> int {
    j = 0
    while j < before {
        prev_method = string.copy(vcr_get_method(j))
        prev_path = route_path_for(string.copy(vcr_get_path(j)))
        if prev_method == method && prev_path == route_path {
            return 1
        }
        j = j + 1
    }
    return 0
}

// Register the single wildcard dispatcher with ud = the server handle.
// Per-listener: the dispatcher recovers the server's state key from ud
// (= the handle) and folds untaped / static-content / tape-match /
// record-forward into the one route — so config can happen AFTER the
// handle exists (load -> config(handle) -> serve), and N servers in one
// process keep disjoint state. No per-tape-path routes are needed: the
// wildcard matches every method+path and the dispatcher does the work.
register_routes(server: ptr) {
    http.server_add_route(server, "*", "*", vcr_dispatch, server)
}

header_removed_for(field: int, name: string) -> int {
    n = vcr_get_header_removal_count()
    i = 0
    while i < n {
        if vcr_get_header_removal_field(i) == field {
            if icmp_aether(vcr_get_header_removal_name(i), name) == 0 {
                return 1
            }
        }
        i = i + 1
    }
    return 0
}

remove_headers_for_k(key: string, headers: string, field: int) -> string {
    if string.length(headers) == 0 { return headers }
    out = string.copy("")
    cursor = 0
    h_len = string.length(headers)
    while cursor < h_len {
        nl_idx = string.index_of_from(headers, "\n", cursor)
        line_end = h_len
        if nl_idx >= 0 { line_end = nl_idx }
        line = string.substring(headers, cursor, line_end)
        line_len = string.length(line)
        if line_len > 0 && string.char_at(line, line_len - 1) == 13 {
            line = string.substring(line, 0, line_len - 1)
        }
        keep = 1
        colon_idx = string.index_of(line, ":")
        if colon_idx > 0 {
            name = string.substring(line, 0, colon_idx)
            if header_removed_for_field_k(key, field, name) == 1 { keep = 0 }
        }
        if keep == 1 && string.length(line) > 0 {
            out = string_concat(out, line)
            out = string_concat(out, "\n")
        }
        if nl_idx < 0 { break }
        cursor = nl_idx + 1
    }
    return out
}
remove_headers_for(headers: string, field: int) -> string {
    return remove_headers_for_k(cur_key(), headers, field)
}

// Emit one fenced or indented code block. Body may be empty —
// the form has to land valid markdown either way (an empty fenced
// block is "```\n```\n", an empty indented block is one 4-space
// line so the parser has something to anchor on).
emit_code_block(body: string) -> string {
    if vcr_get_indent_code_blocks() == 1 {
        if string.length(body) == 0 {
            return "    \n"
        }
        // Indented: prefix every line with 4 spaces.
        out = string.copy("")
        body_len = string.length(body)
        cursor = 0
        while cursor < body_len {
            nl_idx = string.index_of_from(body, "\n", cursor)
            if nl_idx < 0 {
                line = string.substring(body, cursor, body_len)
                out = string_concat(out, "    ")
                out = string_concat(out, line)
                out = string_concat(out, "\n")
                return out
            }
            line = string.substring(body, cursor, nl_idx)
            out = string_concat(out, "    ")
            out = string_concat(out, line)
            out = string_concat(out, "\n")
            cursor = nl_idx + 1
        }
        return string_concat(out, "    \n")
    }
    // Fenced default.
    if string.length(body) == 0 {
        return "```\n```\n"
    }
    // The separator before the closing fence is not part of the payload.
    // Always add it, including when the payload itself ends in a newline.
    out = string_concat("```\n", body)
    return string_concat(out, "\n```\n")
}

// Header-block newlines delimit header lines; they are not payload bytes.
// Keep their canonical form while body blocks preserve terminal newlines.
emit_header_block(headers: string) -> string {
    const NEWLINE = 10
    end = string.length(headers)
    while end > 0 && string.char_at(headers, end - 1) == NEWLINE { end -= 1 }
    return emit_code_block(string.substring(headers, 0, end))
}

// Emit one Interaction at index `i` as a markdown chunk.
//
// Implementation note: every accumulator step uses string_concat
// rather than "${out}..." interpolation. Interpolation recycles a
// backing buffer in v0.90 and rebuild-in-loop overwrites earlier
// content. string_concat returns a fresh AetherString each call.
// ---- Opt-in XML pretty-printing at record time (pretty_xml) ----------
//
// True when `ctype` (a Content-Type value, parameters allowed) names XML:
// application/xml, text/xml, or any <type>/<subtype>+xml (soap+xml, atom+xml,
// xhtml+xml, ...). A base64-marked content type is binary, never XML.
content_type_is_xml(ctype: string) -> int {
    if ascii_ci_contains(ctype, "base64 below") == 1 { return 0 }
    mime = ctype
    semi = string.index_of(mime, ";")
    if semi >= 0 { mime = string.substring(mime, 0, semi) }
    mime = rtrim(trim_leading_ws(mime))
    if icmp_rt(mime, "application/xml") == 0 { return 1 }
    if icmp_rt(mime, "text/xml") == 0 { return 1 }
    n = string.length(mime)
    if n > 4 && icmp_rt(string.substring(mime, n - 4, n), "+xml") == 0 { return 1 }
    return 0
}

// Reformat a RESPONSE `body` with xml.pretty when pretty_xml is on and `ctype`
// is XML. Called LAST in emit_one_interaction_k, after redactions, secret
// patches and normalizations, so those all act on the raw bytes the SUT
// exchanged and a secret cannot slip through by being split across the added
// line breaks. Any xml.pretty error (malformed XML, ...) keeps the body
// byte-exact: the recording is never failed and a body is never partially
// rewritten. REQUEST bodies are deliberately never touched: default
// request-body matching is byte-exact, so a re-indented recorded request
// would no longer match the SUT's live (usually compact) request.
pretty_xml_body_k(key: string, ctype: string, body: string) -> string {
    indent = vcr_get_pretty_xml_k(key)
    if indent <= 0 { return body }
    if string.length(body) == 0 { return body }
    if content_type_is_xml(ctype) == 0 { return body }
    formatted, err = xml.pretty(body, indent)
    if err != "" || string.length(formatted) == 0 { return body }
    // xml.pretty ends its output with a newline; don't add one the original
    // body didn't have (the tape block would gain a stray blank line).
    flen = string.length(formatted)
    if string.char_at(formatted, flen - 1) == 10 && string.char_at(body, string.length(body) - 1) != 10 {
        return string.substring(formatted, 0, flen - 1)
    }
    return formatted
}

// ---- Opt-in JSON pretty-printing at record time (pretty_json) --------
//
// True when `ctype` names JSON: application/json, text/json, or any
// <type>/<subtype>+json (problem+json, ld+json, vnd.api+json, ...). A
// base64-marked content type is binary, never JSON.
content_type_is_json(ctype: string) -> int {
    if ascii_ci_contains(ctype, "base64 below") == 1 { return 0 }
    mime = ctype
    semi = string.index_of(mime, ";")
    if semi >= 0 { mime = string.substring(mime, 0, semi) }
    mime = rtrim(trim_leading_ws(mime))
    if icmp_rt(mime, "application/json") == 0 { return 1 }
    if icmp_rt(mime, "text/json") == 0 { return 1 }
    n = string.length(mime)
    if n > 5 && icmp_rt(string.substring(mime, n - 5, n), "+json") == 0 { return 1 }
    return 0
}

// Reformat a RESPONSE `body` with json.pretty when pretty_json is on and
// `ctype` is JSON, under the same rules as pretty_xml_body_k: last, after
// redactions, secret patches and normalizations, so they act on the raw
// bytes; any json.pretty error keeps the body byte-exact; request bodies are
// never touched. json.pretty re-indents the text itself, so key order and
// number spellings stay as the service sent them.
pretty_json_body_k(key: string, ctype: string, body: string) -> string {
    indent = vcr_get_pretty_json_k(key)
    if indent <= 0 { return body }
    if string.length(body) == 0 { return body }
    if content_type_is_json(ctype) == 0 { return body }
    formatted, err = json.pretty(body, indent)
    if err != "" || string.length(formatted) == 0 { return body }
    // Keep a trailing newline the original body had (json.pretty writes none).
    if string.char_at(body, string.length(body) - 1) == 10 { return string_concat(formatted, "\n") }
    return formatted
}

// ---- Opt-in stable order at record time (stable order) ----------------
//
// Some services send the same response in a different order on every run:
// a Go map or a Java set behind a JSON object or array, a Rust server's
// response headers, a list ordered by a random id. A re-record then differs
// byte for byte and `check` fails, and the only cure without these options
// is to throw content away (leave a header out, collapse a whole list). The
// stable-order options write such a response in one order instead. Every one
// is OFF by default and registered explicitly, like every other rule: a tape
// recorded without them is byte-exact as before.
//
//   sort_json_keys_h(h, 1)          JSON object keys, at every depth, sorted
//                                   by their bytes as written. Safe: key order
//                                   carries no meaning in JSON (RFC 8259), so
//                                   a client sees the same value on replay.
//   sort_json_array_h(h, path, by)  the arrays `path` selects, their elements
//                                   sorted by the member `by` names (or, when
//                                   `by` is "", by each element's canonical
//                                   JSON). Array order often IS meaning (a
//                                   ranked search result, a history), so
//                                   this is per array, never global, and it
//                                   deliberately changes the recorded
//                                   response: replay serves the sorted order.
//   sort_response_headers_h(h, 1)   response header lines sorted by name
//                                   (case-insensitive); the lines of a
//                                   repeated header (Set-Cookie, Vary) keep
//                                   their relative order. Header order carries
//                                   no meaning but for a repeated header's
//                                   lines (RFC 9110 5.3), which stay.
//   sort_header_value_h(h, name)    one response header's comma-separated
//                                   items sorted (`Allow` from a Java set):
//                                   written "a, b, c". Only for a header whose
//                                   items are a set; never for one where order
//                                   is preference (Accept) or a quoted value
//                                   may hold a comma.
//
// `path` selects arrays by JSON pointer (RFC 6901) from the body's root,
// with `*` matching any one member name or index: "" is the root array,
// "/value" the root object's "value", "/items/*/tags" every item's tags. A
// path without a leading "/" names a member: "versions" is every array that
// is the value of a member called versions, at any depth. `by` is a member
// name ("name") or a JSON pointer inside each element ("/db_name/L"); two
// integers compare as numbers, anything else by its canonical JSON's bytes.
// If any element lacks `by` (or is not an object), that array is left as
// sent. The sort is stable, so equal keys keep the order they came in; pick
// a `by` that is unique. The first registered rule that selects an array
// sorts it.
//
// Where it runs: first, on the values as sent, before redactions,
// credentials, normalizations, collapses and pretty_json. So
//   - a value that is later collapsed (a creation time) can still order an
//     array (sort the versions of a secret by "/attributes/created");
//   - normalize's {{name-N}} tokens are numbered in the sorted order, so the
//     numbering is as stable as the order (build_normalization_map_k reads
//     the ordered fields);
//   - sort by a value that is the same each run: sorting by a random id
//     gives a random order, normalized or not;
//   - pretty_json then lays out the sorted body; json.pretty keeps key order.
// Sorting keeps every byte of the body but its order (the whitespace between
// members stays where it was, by position), so a body's length does not
// change and neither does its Content-Length; were it ever to, the rewrite
// below would follow it as for any other rewritten body.
//
// Record side only: the tape is what is written, and playback serves the
// tape as it is. Request bodies are never reordered: the app under test sent
// them, playback compares the live request with the recorded one, and a
// client's serializer is deterministic; a test whose client really does send
// keys in a varying order turns on set_match_json_body_h instead (JSON-
// semantic matching). Request headers are already written sorted by name.
// A body that is not JSON by its Content-Type, or does not parse, is left
// byte-exact. The recording-rules footer lists each ordering rule ("ordered")
// with the interactions it applies to (not those whose order it happened to
// change: that would make the footer itself differ run to run).

struct ArraySort {
    path: string
    by: string
}

struct HeaderValueSort {
    name: string
}

array_sorts_k(key: string) -> ptr        { return list_handle(slot(key, "array_sorts")) }
header_value_sorts_k(key: string) -> ptr { return list_handle(slot(key, "header_value_sorts")) }

vcr_set_sort_json_keys_k(key: string, on: int) {
    if on != 0 { cfg_set_int(slot(key, "sort_json_keys"), 1) } else { cfg_set_int(slot(key, "sort_json_keys"), 0) }
}
vcr_get_sort_json_keys_k(key: string) -> int { return cfg_get_int(slot(key, "sort_json_keys"), 0) }
vcr_set_sort_response_headers_k(key: string, on: int) {
    if on != 0 { cfg_set_int(slot(key, "sort_response_headers"), 1) } else { cfg_set_int(slot(key, "sort_response_headers"), 0) }
}
vcr_get_sort_response_headers_k(key: string) -> int { return cfg_get_int(slot(key, "sort_response_headers"), 0) }

// "" or why the rule was refused.
vcr_sort_json_array_k(key: string, path: string, by: string) -> string {
    if string.length(path) > 0 && string.char_at(path, 0) != 47 && string.index_of(path, "/") >= 0 {
        return "sort_json_array: a path is a JSON pointer starting with '/', or one member name without '/' (got '${path}')"
    }
    if string.length(by) > 0 && string.char_at(by, 0) != 47 && string.index_of(by, "/") >= 0 {
        return "sort_json_array: 'by' is a JSON pointer starting with '/', one member name, or \"\" (got '${by}')"
    }
    r = malloc(sizeof(ArraySort)) as *ArraySort
    r.path = string.copy(path)
    r.by = string.copy(by)
    list_add_raw(array_sorts_k(key), r)
    return ""
}

vcr_sort_header_value_k(key: string, name: string) -> string {
    if string.length(name) == 0 || string.index_of(name, ":") >= 0 || string.index_of(name, "\n") >= 0 {
        return "sort_header_value: '${name}' is not a header name"
    }
    r = malloc(sizeof(HeaderValueSort)) as *HeaderValueSort
    r.name = string.copy(name)
    list_add_raw(header_value_sorts_k(key), r)
    return ""
}

vcr_clear_stable_order_k(key: string) {
    vcr_set_sort_json_keys_k(key, 0)
    vcr_set_sort_response_headers_k(key, 0)
    list_reset(slot(key, "array_sorts"))
    list_reset(slot(key, "header_value_sorts"))
}

// A member name as a JSON pointer segment: "~" -> "~0", "/" -> "~1".
json_pointer_escape(s: string) -> string {
    return replace_all(replace_all(s, "~", "~0"), "/", "~1")
}

// Whether rule path `rp` selects the array at JSON pointer `p`.
array_path_matches(rp: string, p: string) -> int {
    rl = string.length(rp)
    pl = string.length(p)
    if rl == 0 {
        if pl == 0 { return 1 }
        return 0
    }
    if pl == 0 { return 0 }
    if string.char_at(rp, 0) != 47 {
        // A bare member name: the array's own (last) segment.
        k = pl - 1
        while k > 0 && string.char_at(p, k) != 47 { k = k - 1 }
        if string.equals(string.substring(p, k + 1, pl), json_pointer_escape(rp)) == 1 { return 1 }
        return 0
    }
    i = 1
    j = 1
    while 1 == 1 {
        ei = string.index_of_from(rp, "/", i)
        if ei < 0 { ei = rl }
        ej = string.index_of_from(p, "/", j)
        if ej < 0 { ej = pl }
        a = string.substring(rp, i, ei)
        b = string.substring(p, j, ej)
        if string.equals(a, "*") == 0 && string.equals(a, b) == 0 { return 0 }
        if ei >= rl && ej >= pl { return 1 }
        if ei >= rl || ej >= pl { return 0 }
        i = ei + 1
        j = ej + 1
    }
    return 0
}

// The first array rule that selects pointer `p`, or -1.
array_rule_for_k(key: string, p: string) -> int {
    l = array_sorts_k(key)
    n = list_size(l)
    i = 0
    while i < n {
        r = list_get_raw(l, i) as *ArraySort
        if array_path_matches(r.path, p) == 1 { return i }
        i = i + 1
    }
    return -1
}

// An optional '-' then digits only.
json_is_integer(s: string) -> int {
    n = string.length(s)
    if n == 0 { return 0 }
    i = 0
    if string.char_at(s, 0) == 45 { i = 1 }
    if i >= n { return 0 }
    while i < n {
        c = string.char_at(s, i)
        if c < 48 || c > 57 { return 0 }
        i = i + 1
    }
    return 1
}

// Order of two sort keys (canonical JSON texts): integers by value (any
// size, by sign, length and digits), anything else by bytes. -1 / 0 / 1.
sort_key_compare(a: string, b: string) -> int {
    if json_is_integer(a) == 1 && json_is_integer(b) == 1 {
        na = 0
        nb = 0
        if string.char_at(a, 0) == 45 { na = 1 }
        if string.char_at(b, 0) == 45 { nb = 1 }
        if na != nb {
            if na == 1 { return -1 }
            return 1
        }
        da = string.substring(a, na, string.length(a))
        db = string.substring(b, nb, string.length(b))
        // Leading zeros are not JSON, so length orders magnitudes.
        c = 0
        if string.length(da) < string.length(db) { c = -1 }
        else if string.length(da) > string.length(db) { c = 1 }
        else { c = string.compare(da, db) }
        if na == 1 { return 0 - c }
        return c
    }
    return string.compare(a, b)
}

// Rewrite the JSON value at s[i] (no whitespace before it): object keys
// sorted when sort_keys is 1, the arrays an array rule selects sorted when
// rules is 1, and whitespace kept by position (compact 0) or dropped
// (compact 1, the canonical form). Returns the text and the index just past
// the value in `s`. `p` is the value's JSON pointer. `s` has been checked to
// parse as JSON.
so_value(key: string, s: string, i: int, p: string, sort_keys: int, compact: int, rules: int) -> (string, int) {
    n = string.length(s)
    if i >= n { return "", i }
    c = string.char_at(s, i)
    if c == 123 { return so_object(key, s, i, p, sort_keys, compact, rules) }
    if c == 91 { return so_array(key, s, i, p, sort_keys, compact, rules) }
    end = json_value_end(s, i)
    return string.substring(s, i, end), end
}

so_object(key: string, s: string, i: int, p: string, sort_keys: int, compact: int, rules: int) -> (string, int) {
    q = json_skip_space(s, i + 1)
    if string.char_at(s, q) == 125 {
        if compact == 1 { return "{}", q + 1 }
        return string.substring(s, i, q + 1), q + 1
    }
    string[] gaps = []
    string[] keys = []
    string[] bodies = []
    gap_from = i + 1
    tail = ""
    end = q + 1
    while 1 == 1 {
        gaps.push(string.substring(s, gap_from, q))
        kend = json_string_end(s, q)
        rawkey = string.substring(s, q + 1, kend - 1)
        colon = json_skip_space(s, kend)
        vstart = json_skip_space(s, colon + 1)
        v, vend = so_value(key, s, vstart, "${p}/${json_pointer_escape(rawkey)}", sort_keys, compact, rules)
        keys.push(rawkey)
        if compact == 1 {
            bodies.push("${string.substring(s, q, kend)}:${v}")
        } else {
            bodies.push(string_concat(string.substring(s, q, vstart), v))
        }
        after = json_skip_space(s, vend)
        if after < string.length(s) && string.char_at(s, after) == 44 {
            gap_from = vend
            q = json_skip_space(s, after + 1)
        } else {
            tail = string.substring(s, vend, after)
            end = after + 1
            break
        }
    }
    m = keys.len
    int[] order = []
    k = 0
    while k < m { order.push(k); k = k + 1 }
    if sort_keys == 1 {
        // Stable insertion sort by the key's bytes as written.
        a = 1
        while a < m {
            cur = order[a]
            b = a - 1
            while b >= 0 && string.compare(keys[order[b]], keys[cur]) > 0 {
                order[b + 1] = order[b]
                b = b - 1
            }
            order[b + 1] = cur
            a = a + 1
        }
    }
    out = "{"
    k = 0
    while k < m {
        if compact == 1 {
            if k > 0 { out = string_concat(out, ",") }
        } else {
            out = string_concat(out, gaps[k])
        }
        out = string_concat(out, bodies[order[k]])
        k = k + 1
    }
    if compact == 0 { out = string_concat(out, tail) }
    out = string_concat(out, "}")
    return out, end
}

so_array(key: string, s: string, i: int, p: string, sort_keys: int, compact: int, rules: int) -> (string, int) {
    q = json_skip_space(s, i + 1)
    if string.char_at(s, q) == 93 {
        if rules == 1 { so_mark_hit_k(key, p) }
        if compact == 1 { return "[]", q + 1 }
        return string.substring(s, i, q + 1), q + 1
    }
    string[] gaps = []
    string[] items = []
    gap_from = i + 1
    tail = ""
    end = q + 1
    idx = 0
    while 1 == 1 {
        gaps.push(string.substring(s, gap_from, q))
        v, vend = so_value(key, s, q, "${p}/${idx}", sort_keys, compact, rules)
        items.push(v)
        idx = idx + 1
        after = json_skip_space(s, vend)
        if after < string.length(s) && string.char_at(s, after) == 44 {
            gap_from = vend
            q = json_skip_space(s, after + 1)
        } else {
            tail = string.substring(s, vend, after)
            end = after + 1
            break
        }
    }
    m = items.len
    int[] order = []
    k = 0
    while k < m { order.push(k); k = k + 1 }
    if rules == 1 {
        ri = array_rule_for_k(key, p)
        if ri >= 0 {
            r = list_get_raw(array_sorts_k(key), ri) as *ArraySort
            by = r.by
            string[] sk = []
            all = 1
            k = 0
            while k < m && all == 1 {
                kv, found = so_sort_key(items[k], by)
                if found == 0 { all = 0 }
                sk.push(kv)
                k = k + 1
            }
            if all == 1 {
                so_mark_hit_k(key, p)
                a = 1
                while a < m {
                    cur = order[a]
                    b = a - 1
                    while b >= 0 && sort_key_compare(sk[order[b]], sk[cur]) > 0 {
                        order[b + 1] = order[b]
                        b = b - 1
                    }
                    order[b + 1] = cur
                    a = a + 1
                }
            }
        }
    }
    out = "["
    k = 0
    while k < m {
        if compact == 1 {
            if k > 0 { out = string_concat(out, ",") }
        } else {
            out = string_concat(out, gaps[k])
        }
        out = string_concat(out, items[order[k]])
        k = k + 1
    }
    if compact == 0 { out = string_concat(out, tail) }
    out = string_concat(out, "]")
    return out, end
}

// Record that an array rule sorted an array: it selected the array and every
// element has its `by` (for the rules footer; content, not order, decides).
so_mark_hit_k(key: string, p: string) {
    ri = array_rule_for_k(key, p)
    if ri >= 0 { cfg_set_int(slot(key, "so_hit.${ri}"), 1) }
}

// The canonical JSON of a value's text: no insignificant whitespace, object
// keys sorted. Number and string spellings are kept as written.
json_canonical(s: string) -> string {
    v, _ = so_value("", s, json_skip_space(s, 0), "", 1, 1, 0)
    return v
}

// The sort key of one array element (already rewritten, valid JSON): the
// canonical JSON of the member `by` names, or of the whole element when
// `by` is "". (key, 1), or ("", 0) when the element has no such member.
so_sort_key(el: string, by: string) -> (string, int) {
    if string.length(by) == 0 { return json_canonical(el), 1 }
    ptr_s = by
    if string.char_at(by, 0) != 47 { ptr_s = "/${json_pointer_escape(by)}" }
    cur = el
    i = 1
    pl = string.length(ptr_s)
    while i <= pl {
        e = string.index_of_from(ptr_s, "/", i)
        if e < 0 { e = pl }
        seg = string.substring(ptr_s, i, e)
        sub, found = json_child(cur, seg)
        if found == 0 { return "", 0 }
        cur = sub
        i = e + 1
    }
    return json_canonical(cur), 1
}

// The text of an object's member (segment = escaped name) or an array's
// element (segment = index) inside JSON text `s`.
json_child(s: string, seg: string) -> (string, int) {
    q = json_skip_space(s, 0)
    if q >= string.length(s) { return "", 0 }
    c = string.char_at(s, q)
    if c != 123 && c != 91 { return "", 0 }
    close = 125
    if c == 91 { close = 93 }
    q = json_skip_space(s, q + 1)
    if string.char_at(s, q) == close { return "", 0 }
    idx = 0
    while 1 == 1 {
        vstart = q
        match_ = 0
        if c == 123 {
            kend = json_string_end(s, q)
            if string.equals(json_pointer_escape(string.substring(s, q + 1, kend - 1)), seg) == 1 { match_ = 1 }
            vstart = json_skip_space(s, json_skip_space(s, kend) + 1)
        } else if string.equals(string.from_int(idx), seg) == 1 {
            match_ = 1
        }
        vend = json_value_end(s, vstart)
        if match_ == 1 { return string.substring(s, vstart, vend), 1 }
        after = json_skip_space(s, vend)
        if after >= string.length(s) || string.char_at(s, after) != 44 { return "", 0 }
        q = json_skip_space(s, after + 1)
        idx = idx + 1
    }
    return "", 0
}

// Whether any ordering rule is registered for this handle.
stable_order_on_k(key: string) -> int {
    if vcr_get_sort_json_keys_k(key) == 1 { return 1 }
    if vcr_get_sort_response_headers_k(key) == 1 { return 1 }
    if list_size(array_sorts_k(key)) > 0 { return 1 }
    if list_size(header_value_sorts_k(key)) > 0 { return 1 }
    return 0
}

// A response body in stable order, or byte-exact when no JSON rule is on,
// the content type is not JSON, or the body does not parse.
stable_order_body_k(key: string, ctype: string, body: string) -> string {
    sk = vcr_get_sort_json_keys_k(key)
    if sk == 0 && list_size(array_sorts_k(key)) == 0 { return body }
    if string.length(body) == 0 { return body }
    if content_type_is_json(ctype) == 0 { return body }
    tree, err = json.parse(body)
    if err != "" || tree == null { return body }
    json.json_free(tree)
    st = json_skip_space(body, 0)
    v, end = so_value(key, body, st, "", sk, 0, 1)
    out = string_concat(string.substring(body, 0, st), v)
    return string_concat(out, string.substring(body, end, string.length(body)))
}

// "a, b, c" from a comma-separated header value, its items trimmed and
// sorted by bytes (stable). An empty item is dropped.
sort_comma_items(v: string) -> string {
    string[] items = []
    cursor = 0
    n = string.length(v)
    while cursor <= n {
        c = string.index_of_from(v, ",", cursor)
        e = n
        if c >= 0 { e = c }
        it = rtrim(trim_leading_ws(string.substring(v, cursor, e)))
        if string.length(it) > 0 { items.push(it) }
        if c < 0 { break }
        cursor = c + 1
    }
    m = items.len
    a = 1
    while a < m {
        cur = items[a]
        b = a - 1
        while b >= 0 && string.compare(items[b], cur) > 0 {
            items[b + 1] = items[b]
            b = b - 1
        }
        items[b + 1] = cur
        a = a + 1
    }
    out = ""
    k = 0
    while k < m {
        if k > 0 { out = string_concat(out, ", ") }
        out = string_concat(out, items[k])
        k = k + 1
    }
    return out
}

header_value_sorted_k(key: string, name: string) -> int {
    l = header_value_sorts_k(key)
    i = 0
    while i < list_size(l) {
        r = list_get_raw(l, i) as *HeaderValueSort
        if icmp_rt(r.name, name) == 0 { return 1 }
        i = i + 1
    }
    return 0
}

// A response header block in stable order: the registered headers' values'
// items sorted, then (sort_response_headers) the lines sorted by name,
// case-insensitively and stably, so a repeated header's lines keep their
// order. A trailing newline stays as it was.
stable_order_headers_k(key: string, block: string) -> string {
    sort_lines_on = vcr_get_sort_response_headers_k(key)
    if sort_lines_on == 0 && list_size(header_value_sorts_k(key)) == 0 { return block }
    n = string.length(block)
    if n == 0 { return block }
    string[] lines = []
    string[] names = []
    cursor = 0
    while cursor < n {
        nl = string.index_of_from(block, "\n", cursor)
        e = n
        if nl >= 0 { e = nl }
        line = string.substring(block, cursor, e)
        colon = string.index_of(line, ":")
        name = ""
        if colon > 0 { name = string.substring(line, 0, colon) }
        if colon > 0 && header_value_sorted_k(key, name) == 1 {
            line = "${name}: ${sort_comma_items(string.substring(line, colon + 1, string.length(line)))}"
        }
        lines.push(line)
        names.push(name)
        if nl < 0 { break }
        cursor = nl + 1
    }
    m = lines.len
    int[] order = []
    k = 0
    while k < m { order.push(k); k = k + 1 }
    if sort_lines_on == 1 {
        a = 1
        while a < m {
            cur = order[a]
            b = a - 1
            while b >= 0 && icmp_rt(names[order[b]], names[cur]) > 0 {
                order[b + 1] = order[b]
                b = b - 1
            }
            order[b + 1] = cur
            a = a + 1
        }
    }
    out = ""
    k = 0
    while k < m {
        if k > 0 { out = string_concat(out, "\n") }
        out = string_concat(out, lines[order[k]])
        k = k + 1
    }
    if string.char_at(block, n - 1) == 10 { out = string_concat(out, "\n") }
    return out
}

// One recorded field as the tape writes it before any rewriting: in stable
// order when an ordering rule applies (response headers and body only),
// otherwise exactly as recorded.
ordered_field_k(key: string, e: *Interaction, field: int) -> string {
    if field == FIELD_PATH { return e.path }
    if field == FIELD_REQUEST_HEADERS { return e.req_headers }
    if field == FIELD_REQUEST_BODY { return e.req_body }
    if field == FIELD_RESPONSE_HEADERS { return stable_order_headers_k(key, e.resp_headers) }
    if field == FIELD_RESPONSE_BODY {
        ct = e.content_type
        if string.length(ct) == 0 { ct = header_value_in_block(e.resp_headers, "Content-Type") }
        return stable_order_body_k(key, ct, e.body)
    }
    return ""
}

// Rules-footer rows for the ordering rules: each with the interactions it
// applies to (response headers present; the named header present; a JSON
// body that parses; a JSON body with an array the rule selects and every
// element of which has its `by`).
stable_order_footer_rows_k(key: string) -> string {
    n = list_size(tape_list_k(key))
    rows = ""
    if vcr_get_sort_response_headers_k(key) == 1 {
        hits = ""
        ii = 0
        while ii < n {
            e = tape_get_k(key, ii)
            if string.length(e.resp_headers) > 0 { hits = string_concat(hits, "1") } else { hits = string_concat(hits, "0") }
            ii = ii + 1
        }
        rows = string_concat(rows, "| ordered | response headers | every header | sorted by name; a repeated header's lines keep their order | ${interaction_ranges(hits)} |\n")
    }
    hl = header_value_sorts_k(key)
    hi = 0
    while hi < list_size(hl) {
        r = list_get_raw(hl, hi) as *HeaderValueSort
        hits = ""
        ii = 0
        while ii < n {
            e = tape_get_k(key, ii)
            if header_line_present(e.resp_headers, r.name) == 1 { hits = string_concat(hits, "1") } else { hits = string_concat(hits, "0") }
            ii = ii + 1
        }
        rows = string_concat(rows, "| ordered | response headers | ${md_cell_code(r.name)} | its comma-separated items sorted | ${interaction_ranges(hits)} |\n")
        hi = hi + 1
    }
    al = array_sorts_k(key)
    na = list_size(al)
    // One pass per interaction marks which array rules selected an array.
    string[] ahits = []
    ai = 0
    while ai < na { ahits.push(""); ai = ai + 1 }
    khits = ""
    ii = 0
    while ii < n {
        e = tape_get_k(key, ii)
        ai = 0
        while ai < na { cfg_set_int(slot(key, "so_hit.${ai}"), 0); ai = ai + 1 }
        ct = e.content_type
        if string.length(ct) == 0 { ct = header_value_in_block(e.resp_headers, "Content-Type") }
        is_json = 0
        if string.length(e.body) > 0 && content_type_is_json(ct) == 1 {
            tree, err = json.parse(e.body)
            if err == "" && tree != null {
                is_json = 1
                json.json_free(tree)
            }
        }
        if is_json == 1 && na > 0 { stable_order_body_k(key, ct, e.body) }
        if is_json == 1 { khits = string_concat(khits, "1") } else { khits = string_concat(khits, "0") }
        ai = 0
        while ai < na {
            if is_json == 1 && cfg_get_int(slot(key, "so_hit.${ai}"), 0) == 1 {
                ahits[ai] = string_concat(ahits[ai], "1")
            } else {
                ahits[ai] = string_concat(ahits[ai], "0")
            }
            ai = ai + 1
        }
        ii = ii + 1
    }
    if vcr_get_sort_json_keys_k(key) == 1 {
        rows = string_concat(rows, "| ordered | response body | JSON object keys | sorted, at every depth | ${interaction_ranges(khits)} |\n")
    }
    ai = 0
    while ai < na {
        ar = list_get_raw(al, ai) as *ArraySort
        where = "the root array"
        if string.length(ar.path) > 0 && string.char_at(ar.path, 0) == 47 { where = "JSON arrays at ${md_cell_code(ar.path)}" }
        if string.length(ar.path) > 0 && string.char_at(ar.path, 0) != 47 { where = "JSON arrays named ${md_cell_code(ar.path)}" }
        how = "sorted by their elements' canonical JSON"
        if string.length(ar.by) > 0 { how = "sorted by ${md_cell_code(ar.by)}" }
        rows = string_concat(rows, "| ordered | response body | ${where} | ${how} | ${interaction_ranges(ahits[ai])} |\n")
        ai = ai + 1
    }
    return rows
}

emit_one_interaction_k(key: string, i: int) -> string {
    // Read fields from THIS handle's tape via the keyed struct accessor — no
    // ambient cur_key(), so a concurrent flush on another handle cannot change
    // which tape we serialize. Copy each string: the struct's strings may be
    // rewritten by the redaction/normalization steps below.
    e = tape_get_k(key, i)
    method   = string.copy(e.method)
    path     = string.copy(e.path)
    status   = e.status
    ctype    = string.copy(e.content_type)
    // Response headers and body in stable order (opt-in; a no-op copy when
    // no ordering rule is registered), before any other rewriting.
    body     = string.copy(ordered_field_k(key, e, FIELD_RESPONSE_BODY))
    req_h    = string.copy(e.req_headers)
    req_b    = string.copy(e.req_body)
    resp_h   = string.copy(ordered_field_k(key, e, FIELD_RESPONSE_HEADERS))
    note_present = e.has_note
    note_title_v = string.copy(e.note_title)
    note_body_v  = string.copy(e.note_body)

    path_out   = apply_redactions_for_k(key, path, FIELD_PATH)
    body_out   = apply_redactions_for_k(key, body, FIELD_RESPONSE_BODY)
    req_h_out  = apply_redactions_for_k(key, req_h, FIELD_REQUEST_HEADERS)
    req_b_out  = apply_redactions_for_k(key, req_b, FIELD_REQUEST_BODY)
    resp_h_out = apply_redactions_for_k(key, resp_h, FIELD_RESPONSE_HEADERS)
    req_h_out  = remove_headers_for_k(key, req_h_out, FIELD_REQUEST_HEADERS)
    resp_h_out = remove_headers_for_k(key, resp_h_out, FIELD_RESPONSE_HEADERS)

    // redact_credentials: each credential header's secret becomes its
    // numbered token, and a long enough secret is replaced wherever else it
    // appears (a token echoed in a body).
    if list_size(credheaders_k(key)) > 0 {
        req_h_out  = cred_rewrite_block_k(key, req_h_out, FIELD_REQUEST_HEADERS, 1)
        resp_h_out = cred_rewrite_block_k(key, resp_h_out, FIELD_RESPONSE_HEADERS, 1)
        path_out   = cred_apply_values_k(key, path_out)
        req_h_out  = cred_apply_values_k(key, req_h_out)
        req_b_out  = cred_apply_values_k(key, req_b_out)
        resp_h_out = cred_apply_values_k(key, resp_h_out)
        body_out   = cred_apply_values_k(key, body_out)
    }

    path_out = secret_emission_field_k(key, i, FIELD_PATH, path_out)
    req_h_out = secret_emission_field_k(key, i, FIELD_REQUEST_HEADERS, req_h_out)
    req_b_out = secret_emission_field_k(key, i, FIELD_REQUEST_BODY, req_b_out)
    resp_h_out = secret_emission_field_k(key, i, FIELD_RESPONSE_HEADERS, resp_h_out)
    body_out = secret_emission_field_k(key, i, FIELD_RESPONSE_BODY, body_out)

    // Whole-tape normalization runs last, on the post-redaction text, so the
    // value->token table (built across the whole tape in emit_tape) collapses
    // every recurrence of a server-minted value to one stable token.
    path_out   = apply_normalizations_k(key, path_out)
    body_out   = apply_normalizations_k(key, body_out)
    req_h_out  = apply_normalizations_k(key, req_h_out)
    req_b_out  = apply_normalizations_k(key, req_b_out)
    resp_h_out = apply_normalizations_k(key, resp_h_out)

    // Pretty-print the response body last (opt-in; see pretty_xml_body_k).
    resp_ct = ctype
    if string.length(resp_ct) == 0 { resp_ct = header_value_in_block(resp_h, "Content-Type") }
    body_out = pretty_xml_body_k(key, resp_ct, body_out)
    body_out = pretty_json_body_k(key, resp_ct, body_out)

    // A Content-Length on the tape describes the body the tape holds: when a
    // redaction, normalization or pretty-print changed a body, its recorded
    // Content-Length follows (or a collapsed timestamp of varying width would
    // make the tape differ run to run). An untouched body keeps the value as
    // sent; a base64 body is left alone.
    if string.equals(body_out, body) == 0 && ascii_ci_contains(ctype, "base64 below") == 0 {
        resp_h_out = set_content_length_in_block(resp_h_out, string.length(body_out))
    }
    if string.equals(req_b_out, req_b) == 0 {
        req_h_out = set_content_length_in_block(req_h_out, string.length(req_b_out))
    }

    heading = "## Interaction ${i}: ${method} ${path_out}\n\n"
    if vcr_get_emphasize_http_verbs_k(key) == 1 {
        heading = "## Interaction ${i}: *${method}* ${path_out}\n\n"
    }
    out = string.copy(heading)

    if note_present == 1 {
        title = note_title_v
        nbody = note_body_v
        note_head = "## [Note] ${title}:\n\n"
        out = string_concat(out, note_head)
        if string.length(nbody) > 0 {
            out = string_concat(out, nbody)
            last_idx = string.length(nbody) - 1
            if string.char_at(nbody, last_idx) != 10 {
                out = string_concat(out, "\n")
            }
        }
        out = string_concat(out, "\n")
    }

    rh_block = emit_header_block(req_h_out)
    rb_block = emit_code_block(req_b_out)
    out = string_concat(out, "### Request headers recorded for playback:\n\n")
    out = string_concat(out, rh_block)
    out = string_concat(out, "### Request body recorded for playback ():\n\n")
    out = string_concat(out, rb_block)

    out = string_concat(out, "### Response headers recorded for playback:\n\n")
    if string.length(resp_h_out) > 0 {
        rsp_h_block = emit_header_block(resp_h_out)
        out = string_concat(out, rsp_h_block)
    } else if string.length(ctype) > 0 {
        ct_line = "Content-Type: ${ctype}"
        rsp_h_block = emit_header_block(ct_line)
        out = string_concat(out, rsp_h_block)
    } else {
        rsp_h_block = emit_code_block("")
        out = string_concat(out, rsp_h_block)
    }

    ct_for_header = ctype
    if string.length(ct_for_header) == 0 {
        ct_for_header = "text/plain"
    }
    rsp_b_header = "### Response body recorded for playback (${status}: ${ct_for_header}):\n\n"
    out = string_concat(out, rsp_b_header)
    rsp_b_block = emit_code_block(body_out)
    out = string_concat(out, rsp_b_block)
    out = string_concat(out, "\n")
    return out
}

// Bare (no-handle) interaction emitter, for the record()/flush() convenience
// API that operates on cur_key()'s tape.
emit_one_interaction(i: int) -> string {
    return emit_one_interaction_k(cur_key(), i)
}

// Emit the entire in-memory tape as one big markdown blob.
// Equivalent to the old C emit_tape_to_fp(fp), just delivering a
// string instead of writing to FILE*. Keyed so concurrent flushes on
// different handles each serialize THEIR OWN tape.
emit_tape_k(key: string) -> string {
    config.put(slot(key, "emit_error"), "")
    secret_state = config.get(slot(key, "secret_state"))
    if cfg_get_int(slot(key, "secret_materialized"), 0) != 0 {
        config.put(slot(key, "emit_error"), "resolved playback secrets cannot be emitted")
        return ""
    }
    if secret_state == "pending" || secret_state == "failed" {
        config.put(slot(key, "emit_error"), "secret callback staging did not complete; tape was not written")
        return ""
    }
    build_normalization_map_k(key)
    build_credential_map_k(key)
    n = list_size(tape_list_k(key))
    out = string.copy("")
    lic = cfg_get_str(slot(key, "license_notice"))
    if string.length(lic) > 0 { out = "${LICENSE_NOTICE_HEADING}\n\n${lic}\n\n" }
    i = 0
    while i < n {
        chunk = emit_one_interaction_k(key, i)
        out = string_concat(out, chunk)
        i = i + 1
    }
    if vcr_get_rules_footer_k(key) == 1 {
        out = string_concat(out, emit_rules_footer_k(key))
    }
    return out
}
emit_tape() -> string {
    return emit_tape_k(cur_key())
}

// ---- the recording-rules footer --------------------------------------
//
// Opt-in (set_rules_footer_h). After the last interaction, a section that
// says what the test asked Servirtium to leave out or rewrite when it wrote
// the recording: removed headers, redactions, normalizations and collapses,
// each with the interactions it touched ("none" flags a rule that matched
// nothing). Everything not listed is as sent. Markdown that GitHub renders
// as a table.
//
// The parser stops at RULES_FOOTER_HEADING by design (parse_tape_text_append
// cuts the text there before it looks for interactions), so playback never
// reads the footer, whatever it contains.
//
// A literal redaction's pattern is never printed: it is often the secret
// itself. The other redaction kinds name a header, query parameter or JSON
// key, which is printed.
const RULES_FOOTER_HEADING = "## [Recording rules]"

// "0–3, 5" for the interaction indices whose flag is set in `hits`
// (a string of '0'/'1' per interaction); "none" if none.
interaction_ranges(hits: string) -> string {
    out = ""
    n = string.length(hits)
    i = 0
    while i < n {
        if string.char_at(hits, i) == 49 {
            j = i
            while j + 1 < n && string.char_at(hits, j + 1) == 49 { j = j + 1 }
            part = string.from_int(i)
            if j > i + 1 { part = "${i}–${j}" }
            if j == i + 1 { part = "${i}, ${j}" }
            if string.length(out) > 0 { out = string_concat(out, ", ") }
            out = string_concat(out, part)
            i = j + 1
        } else {
            i = i + 1
        }
    }
    if string.length(out) == 0 { return "none" }
    return out
}

// `s` as a code span safe inside a GitHub table cell: pipes escaped, and a
// double-backtick span when the text itself holds a backtick.
md_cell_code(s: string) -> string {
    t = replace_all(s, "|", "\\|")
    if string.index_of(t, "`") >= 0 { return "`` ${t} ``" }
    return "`${t}`"
}

raw_field_k(e: *Interaction, field: int) -> string {
    if field == FIELD_PATH { return e.path }
    if field == FIELD_REQUEST_HEADERS { return e.req_headers }
    if field == FIELD_REQUEST_BODY { return e.req_body }
    if field == FIELD_RESPONSE_HEADERS { return e.resp_headers }
    if field == FIELD_RESPONSE_BODY { return e.body }
    return ""
}

// Whether one redaction rule would rewrite `s` (without marking it used).
redaction_touches(r: *Redaction, s: string) -> int {
    if string.length(s) == 0 { return 0 }
    out = s
    if r.kind == 0 { out = str_replace_all(s, r.pattern, r.replacement) }
    if r.kind == 1 { out = redact_header_text(s, r.pattern, r.replacement) }
    if r.kind == 2 { out = redact_query_text(s, r.pattern, r.replacement) }
    if r.kind == 3 {
        tree, err = json.parse(s)
        if err != "" || tree == null { return 0 }
        json.json_free(tree)
        out = redact_json_text(s, r.pattern, r.replacement)
    }
    if out != s { return 1 }
    return 0
}

redaction_kind_label(kind: int) -> string {
    if kind == 1 { return "redacted header" }
    if kind == 2 { return "redacted query parameter" }
    if kind == 3 { return "redacted JSON key" }
    return "redacted"
}

field_label(field: int) -> string {
    if field == FIELD_PATH { return "path" }
    if field == FIELD_REQUEST_HEADERS { return "request headers" }
    if field == FIELD_REQUEST_BODY { return "request body" }
    if field == FIELD_RESPONSE_HEADERS { return "response headers" }
    if field == FIELD_RESPONSE_BODY { return "response body" }
    return "field ${field}"
}

emit_rules_footer_k(key: string) -> string {
    n = list_size(tape_list_k(key))
    rows = ""

    rl = header_removals_k(key)
    ri = 0
    while ri < list_size(rl) {
        h = list_get_raw(rl, ri) as *HeaderRemoval
        if string.length(h.origin) == 0 {
            hits = ""
            ii = 0
            while ii < n {
                e = tape_get_k(key, ii)
                if header_line_present(raw_field_k(e, h.field), h.name) == 1 { hits = string_concat(hits, "1") } else { hits = string_concat(hits, "0") }
                ii = ii + 1
            }
            rows = string_concat(rows, "| removed | ${field_label(h.field)} | ${md_cell_code(h.name)} | (left out) | ${interaction_ranges(hits)} |\n")
        } else if removal_group_seen_k(key, ri) == 0 {
            // A preset's removals for one field: one row, every name, the
            // interactions any of them was in.
            names = ""
            hits = ""
            ii = 0
            while ii < n { hits = string_concat(hits, "0"); ii = ii + 1 }
            rj = ri
            while rj < list_size(rl) {
                g = list_get_raw(rl, rj) as *HeaderRemoval
                if g.field == h.field && string.equals(g.origin, h.origin) == 1 {
                    if string.length(names) > 0 { names = string_concat(names, ", ") }
                    names = string_concat(names, md_cell_code(g.name))
                    nh = ""
                    ii = 0
                    while ii < n {
                        e = tape_get_k(key, ii)
                        if string.char_at(hits, ii) == 49 || header_line_present(raw_field_k(e, g.field), g.name) == 1 { nh = string_concat(nh, "1") } else { nh = string_concat(nh, "0") }
                        ii = ii + 1
                    }
                    hits = nh
                }
                rj = rj + 1
            }
            rows = string_concat(rows, "| removed (${h.origin}) | ${field_label(h.field)} | ${names} | (left out) | ${interaction_ranges(hits)} |\n")
        }
        ri = ri + 1
    }

    cl = credheaders_k(key)
    ci = 0
    while ci < list_size(cl) {
        c = list_get_raw(cl, ci) as *CredHeader
        hits = ""
        ii = 0
        while ii < n {
            e = tape_get_k(key, ii)
            hit = 0
            if cred_applies(c, FIELD_REQUEST_HEADERS) == 1 && header_line_present(e.req_headers, c.name) == 1 { hit = 1 }
            if cred_applies(c, FIELD_RESPONSE_HEADERS) == 1 && header_line_present(e.resp_headers, c.name) == 1 { hit = 1 }
            if hit == 1 { hits = string_concat(hits, "1") } else { hits = string_concat(hits, "0") }
            ii = ii + 1
        }
        applies = "request and response headers"
        written = md_cell_code("${c.prefix}_N")
        if c.kind == 1 { written = md_cell_code("<scheme> ${c.prefix}_N") }
        if c.kind == 2 { applies = "request headers"; written = md_cell_code("<name>=${c.prefix}_N") }
        if c.kind == 3 { applies = "response headers"; written = md_cell_code("<name>=${c.prefix}_N; <attributes>") }
        rows = string_concat(rows, "| redacted credential | ${applies} | ${md_cell_code(c.name)} | ${written} | ${interaction_ranges(hits)} |\n")
        ci = ci + 1
    }

    dl = redactions_k(key)
    di = 0
    while di < list_size(dl) {
        r = list_get_raw(dl, di) as *Redaction
        hits = ""
        ii = 0
        while ii < n {
            e = tape_get_k(key, ii)
            if redaction_touches(r, raw_field_k(e, r.field)) == 1 { hits = string_concat(hits, "1") } else { hits = string_concat(hits, "0") }
            ii = ii + 1
        }
        what = "(not shown: it may be the secret)"
        if r.kind != 0 { what = md_cell_code(r.pattern) }
        rows = string_concat(rows, "| ${redaction_kind_label(r.kind)} | ${field_label(r.field)} | ${what} | ${md_cell_code(r.replacement)} | ${interaction_ranges(hits)} |\n")
        di = di + 1
    }

    nl = normalizations_k(key)
    ni = 0
    while ni < list_size(nl) {
        nrm = list_get_raw(nl, ni) as *Normalization
        hits = ""
        re, cerr = regex.compile(nrm.pattern)
        ii = 0
        while ii < n {
            hit = 0
            if cerr == "" {
                e = tape_get_k(key, ii)
                fi = 0
                fields = [e.path, e.req_headers, e.req_body, e.resp_headers, e.body]
                while fi < 5 && hit == 0 {
                    if string.length(fields[fi]) > 0 && regex.matches(re, fields[fi]) == 1 { hit = 1 }
                    fi = fi + 1
                }
            }
            if hit == 1 { hits = string_concat(hits, "1") } else { hits = string_concat(hits, "0") }
            ii = ii + 1
        }
        if cerr == "" { regex.free(re) }
        label = "collapsed"
        written = md_cell_code(nrm.replacement)
        if string.length(nrm.replacement) == 0 {
            label = "normalized"
            written = md_cell_code("{{${nrm.name}-N}}")
        }
        matching = md_cell_code(nrm.pattern)
        if string.length(nrm.description) > 0 { matching = "*${replace_all(nrm.description, "|", "\\|")}*" }
        rows = string_concat(rows, "| ${label} | whole recording | ${matching} | ${written} | ${interaction_ranges(hits)} |\n")
        ni = ni + 1
    }

    rows = string_concat(rows, stable_order_footer_rows_k(key))

    out = "\n${RULES_FOOTER_HEADING}\n\n"
    if string.length(rows) == 0 {
        out = string_concat(out, "The test registered no rules: this recording is as sent. Playback does not read this section.\n")
        return out
    }
    out = string_concat(out, "What the test asked Servirtium to leave out or rewrite when it wrote this recording; everything else is as sent. Playback does not read this section.\n\n")
    out = string_concat(out, "| Rule | Applies to | Matching | Written as | Interactions |\n")
    out = string_concat(out, "|---|---|---|---|---|\n")
    out = string_concat(out, rows)
    if list_size(cl) > 0 {
        out = string_concat(out, "\nA credential's `N` numbers each distinct value: the same value has the same number wherever it appears, and one of 8 characters or more is replaced in bodies and paths too. Playback matches credential headers on presence, not value.\n")
    }
    return out
}

// Whether an earlier removal shares removal `ri`'s preset and field (its row
// was written with that one's).
removal_group_seen_k(key: string, ri: int) -> int {
    rl = header_removals_k(key)
    h = list_get_raw(rl, ri) as *HeaderRemoval
    j = 0
    while j < ri {
        g = list_get_raw(rl, j) as *HeaderRemoval
        if g.field == h.field && string.equals(g.origin, h.origin) == 1 { return 1 }
        j = j + 1
    }
    return 0
}

// Whether a "Name:" line for `name` is in the header block (an empty value
// counts).
header_line_present(headers: string, name: string) -> int {
    cursor = 0
    h_len = string.length(headers)
    while cursor < h_len {
        nl_idx = string.index_of_from(headers, "\n", cursor)
        line_end = h_len
        if nl_idx >= 0 { line_end = nl_idx }
        line = string.substring(headers, cursor, line_end)
        colon_idx = string.index_of(line, ":")
        if colon_idx > 0 && icmp_rt(string.substring(line, 0, colon_idx), name) == 0 { return 1 }
        if nl_idx < 0 { break }
        cursor = nl_idx + 1
    }
    return 0
}


// ---- Aether-side tape parser ---------------------------------------
//
// Ported from the C-side parse_interaction / parse_interaction_header /
// parse_response_body_header / extract_code_block / extract_indented_block
// / normalize_recorded_headers / vcr_load_tape. All pure string slicing
// + dispatch — nothing here needs C, it just happened to start there.
// Storage stays in C (see Interaction struct + g_tape); this code calls
// the vcr_aether_append_interaction setter to populate it.
//
// The parser must accept tapes recorded by any Servirtium implementation
// (Java, Kotlin, Python, Go, ...) — interop is the entire point of the
// canonical markdown format. Both fenced (```) and indented (4-space)
// code blocks are handled; emphasized HTTP verbs (*GET*, _GET_) are
// unwrapped; method+path matching is strict but headers/body matching
// is opt-in (empty fields = "no constraint").

// Find the next occurrence of `needle` in `haystack` starting at
// `from`, but only if it's at the start of a line (i.e. preceded
// by '\n' or it's at index 0). Returns -1 if not found.
find_at_line_start(haystack: string, needle: string, from: int) -> int {
    cursor = from
    h_len = string.length(haystack)
    while cursor <= h_len {
        idx = string.index_of_from(haystack, needle, cursor)
        if idx < 0 { return -1 }
        if idx == 0 { return idx }
        prev = string.char_at(haystack, idx - 1)
        if prev == 10 { return idx }  // 10 == '\n'
        cursor = idx + 1
    }
    return -1
}

// Trim trailing whitespace (spaces, tabs, CR, LF) from `s`.
rtrim(s: string) -> string {
    n = string.length(s)
    while n > 0 {
        c = string.char_at(s, n - 1)
        if c != 32 && c != 9 && c != 10 && c != 13 { return string.substring(s, 0, n) }
        n = n - 1
    }
    return ""
}

// Extract the body of a fenced or indented code block starting at
// `from` and ending no later than `to`. Returns ("", -1) if no block
// could be parsed; otherwise (body, end_index) where end_index is
// the position just past the close fence (or just past the last
// indented line for the indented form).
//
// Mirrors the C extract_code_block which falls through to
// extract_indented_block when no triple-backtick fence is found
// at the next non-blank line.
extract_code_block_at(src: string, from: int, to: int) -> {
    src_len = to
    cursor = from

    // Skip blank lines (lines containing only whitespace).
    while cursor < src_len {
        nl_idx = string.index_of_from(src, "\n", cursor)
        line_end = src_len
        if nl_idx >= 0 {
            if nl_idx < src_len { line_end = nl_idx } else { line_end = src_len }
        }
        line = string.substring(src, cursor, line_end)
        trimmed = rtrim(line)
        // Empty? skip.
        if string.length(trimmed) == 0 {
            if nl_idx < 0 { return "", -1 }
            cursor = nl_idx + 1
            continue
        }
        // Triple-backtick fence?
        if string.starts_with(trimmed, "```") == 1 {
            // Body starts on the next line; close fence is the next
            // line that starts with "```".
            if nl_idx < 0 { return "", -1 }
            body_start = nl_idx + 1
            close_idx = find_at_line_start(src, "```", body_start)
            if close_idx < 0 || close_idx >= src_len { return "", -1 }
            // Trim a single trailing \n before the close fence to
            // match the C behavior (the body's own trailing \n is
            // consumed by the close-fence line break).
            body_end = close_idx
            if body_end > body_start {
                last = string.char_at(src, body_end - 1)
                if last == 10 { body_end = body_end - 1 }
            }
            body = string.substring(src, body_start, body_end)
            // Find end of the close-fence line.
            close_line_end = string.index_of_from(src, "\n", close_idx)
            if close_line_end < 0 { close_line_end = src_len }
            else { close_line_end = close_line_end + 1 }
            return body, close_line_end
        }
        // Not a fence — try indented form. First non-blank line must
        // start with 4 spaces or a tab to qualify.
        first_char = string.char_at(src, cursor)
        if first_char == 9 {
            return extract_indented_at(src, cursor, src_len)
        }
        if cursor + 4 <= src_len {
            c0 = string.char_at(src, cursor)
            c1 = string.char_at(src, cursor + 1)
            c2 = string.char_at(src, cursor + 2)
            c3 = string.char_at(src, cursor + 3)
            if c0 == 32 && c1 == 32 && c2 == 32 && c3 == 32 {
                return extract_indented_at(src, cursor, src_len)
            }
        }
        // Neither form — section has no code block.
        return "", -1
    }
    return "", -1
}

// Extract an indented code block starting at `from`. Body lines
// are 4-space-indented (or 1-tab); blank lines are kept verbatim;
// block ends at the first non-blank non-indented line.
extract_indented_at(src: string, from: int, to: int) -> {
    out = string.copy("")
    cursor = from
    end_pos = from
    while cursor < to {
        nl_idx = string.index_of_from(src, "\n", cursor)
        line_end = to
        if nl_idx >= 0 && nl_idx < to { line_end = nl_idx }
        // Determine indented / blank / dedented.
        indented = 0
        is_blank = 0
        // Check blank: only ws between cursor and line_end.
        ws_only = 1
        scan = cursor
        while scan < line_end {
            c = string.char_at(src, scan)
            if c != 32 && c != 9 { ws_only = 0; scan = line_end ; break }
            scan = scan + 1
        }
        if ws_only == 1 { is_blank = 1 }
        // Check indented.
        if line_end - cursor >= 1 {
            first = string.char_at(src, cursor)
            if first == 9 { indented = 1 }
        }
        if line_end - cursor >= 4 && indented == 0 {
            c0 = string.char_at(src, cursor)
            c1 = string.char_at(src, cursor + 1)
            c2 = string.char_at(src, cursor + 2)
            c3 = string.char_at(src, cursor + 3)
            if c0 == 32 && c1 == 32 && c2 == 32 && c3 == 32 { indented = 1 }
        }
        if is_blank == 0 && indented == 0 { break }
        if indented == 1 {
            // Strip leading 4 spaces or 1 tab.
            strip_n = 4
            if string.char_at(src, cursor) == 9 { strip_n = 1 }
            line = string.substring(src, cursor + strip_n, line_end)
            out = string_concat(out, line)
            out = string_concat(out, "\n")
        } else {
            // Blank line.
            out = string_concat(out, "\n")
        }
        if nl_idx < 0 { end_pos = to ; break }
        end_pos = nl_idx + 1
        cursor = nl_idx + 1
    }
    // Trim trailing \n to match the fenced form.
    out_len = string.length(out)
    if out_len > 0 && string.char_at(out, out_len - 1) == 10 {
        out = string.substring(out, 0, out_len - 1)
    }
    return out, end_pos
}

// Parse the interaction-header "tail" — the chunk after "## Interaction N: ".
// Returns (method, path, ok). Method has any wrapping * / _ stripped.
parse_interaction_header_aether(line: string) -> {
    line_t = rtrim(line)
    sp_idx = string.index_of(line_t, " ")
    if sp_idx < 0 { return "", "", 0 }
    raw_method = string.substring(line_t, 0, sp_idx)
    path = string.substring(line_t, sp_idx + 1, string.length(line_t))
    // Strip emphasis markers from method.
    ml = string.length(raw_method)
    while ml >= 2 {
        first = string.char_at(raw_method, 0)
        last  = string.char_at(raw_method, ml - 1)
        f_emph = first == 42 || first == 95   // * or _
        l_emph = last  == 42 || last  == 95
        if f_emph != 1 || l_emph != 1 { break }
        raw_method = string.substring(raw_method, 1, ml - 1)
        ml = ml - 2
    }
    return raw_method, path, 1
}

// Parse "(N: content/type)" out of "Response body recorded for playback (200: text/plain)".
// Returns (status, content_type, ok).
parse_response_body_header_aether(line: string) -> {
    open_idx = string.index_of(line, "(")
    if open_idx < 0 { return 0, "", 0 }
    close_idx = string.index_of_from(line, ")", open_idx)
    if close_idx < 0 { return 0, "", 0 }
    inside = string.substring(line, open_idx + 1, close_idx)
    colon_idx = string.index_of(inside, ":")
    if colon_idx < 0 { return 0, "", 0 }
    status_str = string.substring(inside, 0, colon_idx)
    status, serr = string.to_int(status_str)
    if serr != "" { return 0, "", 0 }
    ct = string.substring(inside, colon_idx + 1, string.length(inside))
    // Trim leading whitespace from ct.
    ctl = string.length(ct)
    pos = 0
    while pos < ctl {
        c = string.char_at(ct, pos)
        if c != 32 && c != 9 { break }
        pos = pos + 1
    }
    ct = string.substring(ct, pos, ctl)
    return status, ct, 1
}

// Lowercase ASCII compare. -1 / 0 / 1.
icmp_aether(a: string, b: string) -> int {
    al = string.length(a)
    bl = string.length(b)
    i = 0
    minl = al
    if bl < minl { minl = bl }
    while i < minl {
        ca = string.char_at(a, i)
        cb = string.char_at(b, i)
        if ca >= 65 && ca <= 90 { ca = ca + 32 }
        if cb >= 65 && cb <= 90 { cb = cb + 32 }
        if ca != cb {
            if ca < cb { return -1 }
            return 1
        }
        i = i + 1
    }
    if al < bl { return -1 }
    if al > bl { return 1 }
    return 0
}

// Insertion sort lines in a "Name: Value\n..." blob, case-insensitively.
// The line count is always tiny (<20 in practice for HTTP headers) so
// the O(n²) cost is irrelevant; insertion sort is the simplest thing.
//
// Algorithm: extract lines into a parallel pair of arrays (heap-
// allocated) of (string-content, sort-key); insertion-sort by key;
// rejoin with \n. We avoid std.list because boxing strings as ptrs
// adds friction with no benefit at this size.
sort_lines(blob: string) -> string {
    if string.length(blob) == 0 { return blob }
    // Step 1: split into lines + drop empties. We rebuild as a
    // \n-joined string after sort, so just collect into a single
    // sorted-as-we-go output (insertion sort directly on the
    // accumulated form).
    out = string.copy("")
    cursor = 0
    blob_len = string.length(blob)
    while cursor < blob_len {
        nl_idx = string.index_of_from(blob, "\n", cursor)
        line_end = blob_len
        if nl_idx >= 0 { line_end = nl_idx }
        line = string.substring(blob, cursor, line_end)
        if string.length(line) > 0 {
            // Insert `line` into `out` (which is already \n-terminated
            // sorted lines) at the right position.
            ins_pos = 0
            o_len = string.length(out)
            while ins_pos < o_len {
                nl2 = string.index_of_from(out, "\n", ins_pos)
                exists_end = o_len
                if nl2 >= 0 { exists_end = nl2 }
                exists = string.substring(out, ins_pos, exists_end)
                if icmp_aether(exists, line) > 0 { break }
                if nl2 < 0 { ins_pos = o_len ; break }
                ins_pos = nl2 + 1
            }
            // Build new out: prefix + line + "\n" + suffix.
            prefix = string.substring(out, 0, ins_pos)
            suffix = string.substring(out, ins_pos, o_len)
            out = string_concat(prefix, line)
            out = string_concat(out, "\n")
            out = string_concat(out, suffix)
        }
        if nl_idx < 0 { break }
        cursor = nl_idx + 1
    }
    return out
}

// Strip Host header from a "Name: Value\n..." blob, then sort.
// Mirrors the C normalize_recorded_headers used at parse time.
normalize_recorded_headers(raw: string) -> string {
    if string.length(raw) == 0 { return string.copy("") }
    // Walk lines; drop Host:; collect rest into a blob.
    out = string.copy("")
    cursor = 0
    rl = string.length(raw)
    while cursor < rl {
        nl_idx = string.index_of_from(raw, "\n", cursor)
        line_end = rl
        if nl_idx >= 0 { line_end = nl_idx }
        line = string.substring(raw, cursor, line_end)
        // Trim trailing CR.
        line_t_len = string.length(line)
        if line_t_len > 0 && string.char_at(line, line_t_len - 1) == 13 {
            line = string.substring(line, 0, line_t_len - 1)
        }
        // Drop empty lines and Host: ...
        keep = 1
        if string.length(line) == 0 { keep = 0 }
        if keep == 1 {
            colon_idx = string.index_of(line, ":")
            if colon_idx > 0 {
                name = string.substring(line, 0, colon_idx)
                if icmp_aether(name, "Host") == 0 { keep = 0 }
            }
        }
        if keep == 1 {
            out = string_concat(out, line)
            out = string_concat(out, "\n")
        }
        if nl_idx < 0 { break }
        cursor = nl_idx + 1
    }
    return sort_lines(out)
}

// Parse one interaction chunk — text starting just after "## Interaction N: "
// and ending at the start of the next "## Interaction " (or end of file).
// On success, calls vcr_aether_append_interaction. Returns "" on
// success, error string otherwise.
parse_one_interaction(key: string, chunk: string) -> string {
    chunk_len = string.length(chunk)
    nl_idx = string.index_of(chunk, "\n")
    if nl_idx < 0 { return "interaction missing header line" }

    // Skip the leading "N: " digits + colon + space.
    cursor = 0
    while cursor < nl_idx {
        c = string.char_at(chunk, cursor)
        if c < 48 || c > 57 { break }   // 0-9
        cursor = cursor + 1
    }
    if cursor < nl_idx && string.char_at(chunk, cursor) == 58 { cursor = cursor + 1 }
    while cursor < nl_idx && string.char_at(chunk, cursor) == 32 { cursor = cursor + 1 }

    header_line = string.substring(chunk, cursor, nl_idx)
    method, path, hok = parse_interaction_header_aether(header_line)
    if hok != 1 { return "malformed interaction header" }

    // Walk ### sections.
    status = 0
    ctype = ""
    body = ""
    req_h = ""
    req_b = ""
    resp_h = ""

    // Cursor for section walk starts at first byte after the heading line.
    p = nl_idx + 1
    while p < chunk_len {
        // Find the next "### " at line start (or right at p).
        sect_idx = -1
        if p + 4 <= chunk_len {
            head = string.substring(chunk, p, p + 4)
            if head == "### " { sect_idx = p }
        }
        if sect_idx < 0 {
            sect_idx = find_at_line_start(chunk, "### ", p)
        }
        if sect_idx < 0 { break }
        if sect_idx >= chunk_len { break }

        // Section header line: from sect_idx+4 to next \n.
        sect_nl = string.index_of_from(chunk, "\n", sect_idx)
        if sect_nl < 0 { break }
        sect_name_start = sect_idx + 4
        sect_name = string.substring(chunk, sect_name_start, sect_nl)

        // Find next "### " at line start to bound this section's body.
        next_sect = find_at_line_start(chunk, "### ", sect_nl + 1)
        sect_body_end = chunk_len
        if next_sect >= 0 && next_sect < chunk_len { sect_body_end = next_sect }

        // Dispatch on section name prefix.
        if string.starts_with(sect_name, "Request headers recorded") == 1 {
            block, _ = extract_code_block_at(chunk, sect_nl + 1, sect_body_end)
            if string.length(block) > 0 {
                req_h = normalize_recorded_headers(block)
            }
        } else if string.starts_with(sect_name, "Request body recorded") == 1 {
            block, _ = extract_code_block_at(chunk, sect_nl + 1, sect_body_end)
            req_b = string.copy(block)
        } else if string.starts_with(sect_name, "Response headers recorded") == 1 {
            // Capture the block. Stored verbatim — the dispatcher
            // walks line-by-line and emits each as a real response
            // header. Same shape we already use for req_headers,
            // just plumbed through to a per-interaction setter
            // because the C-side append takes a fixed positional
            // arg list.
            block, _ = extract_code_block_at(chunk, sect_nl + 1, sect_body_end)
            if string.length(block) > 0 {
                resp_h = string.copy(block)
            }
        } else if string.starts_with(sect_name, "Response body recorded") == 1 {
            st, ct, ok = parse_response_body_header_aether(sect_name)
            if ok != 1 { return "malformed response body header" }
            status = st
            ctype = string.copy(ct)
            block, _ = extract_code_block_at(chunk, sect_nl + 1, sect_body_end)
            body = string.copy(block)
        }

        p = sect_body_end
    }

    if status == 0 { return "interaction has no Response body section" }

    // Append. note_title="" → setter doesn't stage a note.
    ok = vcr_aether_append_interaction_k(key, method, path, status, ctype, body, req_h, req_b, "", "")
    if ok == 0 { return "OOM appending parsed interaction" }
    // Attach response headers to the just-appended interaction.
    // tape count after the append, so the new entry's index is count - 1.
    // Empty resp_h → setter is still safe (writes "" = no-op).
    if string.length(resp_h) > 0 {
        idx = list_size(tape_list_k(key)) - 1
        set_resp_headers_k(key, idx, resp_h)
    }
    return ""
}

// Top-level parser — reads the tape file via fs.read, splits into
// interaction chunks, dispatches each. Returns "" on success or an
// error message.
// Parse a Servirtium markdown string into the in-memory tape.
// Used by both load (filesystem) and load_url (HTTP) to avoid duplication.
// Label is for error messages (e.g., "http-sourced" or a file path).
parse_tape_text(key: string, label: string, contents: string) -> string {
    vcr_aether_clear_tape_k(key)
    return parse_tape_text_append(key, label, contents)
}

// Append-parse: like parse_tape_text but WITHOUT clearing the in-memory
// tape first, so several markdown files concatenate into one interaction
// list (the multi-tape loader, load_append_h). Ordered playback then
// treats the result as one long script; MatchMultiple as one union store.
// Tolerate two things a tape file picks up in the wild and that otherwise
// break parsing silently (reported from the field): a leading UTF-8 BOM
// (EF BB BF — Notepad/PowerShell `>` add it), and CRLF line endings (a git
// checkout with autocrlf, or a hand-edit on Windows). Both are normalised to
// the canonical LF/no-BOM form the rest of the parser and emitter assume. The
// emitter still writes compact LF-only output; this only loosens what we READ,
// in the same spirit as the parser already accepting the looser blank-line
// style other Servirtium tools emit.
normalize_tape_bytes(contents: string) -> string {
    s = contents
    // Strip a leading UTF-8 BOM if present.
    if string.length(s) >= 3 &&
       string.char_at(s, 0) == 239 &&
       string.char_at(s, 1) == 187 &&
       string.char_at(s, 2) == 191 {
        s = string.substring(s, 3, string.length(s))
    }
    // CRLF -> LF, decided once per tape from its STRUCTURE, not per line.
    // The recorder writes every structural line (interaction headings,
    // section headings, fences) with a bare LF, but copies body bytes as
    // they came: a service that separates rows with CRLF (CouchDB views,
    // _find, _changes; nginx error pages; multipart request bodies) leaves
    // CRs inside the fenced blocks, and those are payload. So the first
    // "## Interaction " heading line is the witness: when it ends in CRLF
    // the whole file was converted (autocrlf checkout, Windows editor) and
    // every CRLF folds back to LF, exactly as before; when it ends in LF the
    // tape is as recorded and any CR in it belongs to a body, so nothing is
    // touched and playback serves (and matches) the recorded bytes. A
    // converted tape can't tell its body CRs from converted ones, so those
    // still come back as LF; keep tapes byte-exact in git with
    // `-text` in .gitattributes. A bare CR (classic-Mac) is left alone.
    if string.index_of(s, "\r\n") >= 0 && tape_structure_is_crlf(s) == 1 {
        s = replace_all(s, "\r\n", "\n")
    }
    return s
}

// 1 when the tape's first "## Interaction " heading line ends in CRLF (see
// normalize_tape_bytes). With no heading at all the tape is unparseable
// anyway; fold as the old reader did so its error is unchanged.
tape_structure_is_crlf(s: string) -> int {
    h = -1
    if string.starts_with(s, "## Interaction ") == 1 { h = 0 }
    else {
        at = string.index_of(s, "\n## Interaction ")
        if at >= 0 { h = at + 1 }
    }
    if h < 0 { return 1 }
    nl = string.index_of_from(s, "\n", h)
    if nl <= h { return 0 }
    if string.char_at(s, nl - 1) == 13 { return 1 }
    return 0
}

// The tape text before its recording-rules footer (RULES_FOOTER_HEADING at
// a line start), or all of it when there is none. The footer documents the
// recording for people; playback must never read it, so it is cut off here,
// before interactions are looked for, rather than left for the last
// interaction's parser to skip over.
strip_rules_footer(contents: string) -> string {
    if string.starts_with(contents, RULES_FOOTER_HEADING) == 1 { return string.copy("") }
    at = string.index_of(contents, string_concat("\n", RULES_FOOTER_HEADING))
    if at < 0 { return contents }
    return string.substring(contents, 0, at + 1)
}

parse_tape_text_append(key: string, label: string, contents0: string) -> string {
    contents = strip_rules_footer(normalize_tape_bytes(contents0))
    start_count = list_size(tape_list_k(key))

    delim = "\n## Interaction "
    cursor = 0
    n = string.length(contents)

    // Special case: file starts with "## Interaction " on the first line.
    first_chunk_start = -1
    if n >= 15 && string.starts_with(contents, "## Interaction ") == 1 {
        first_chunk_start = 15
    } else {
        d = string.index_of(contents, delim)
        if d < 0 { return "tape (${label}) contains no '## Interaction ' headers" }
        first_chunk_start = d + string.length(delim)
    }

    cursor = first_chunk_start
    while cursor < n {
        next_idx = string.index_of_from(contents, delim, cursor)
        chunk_end = n
        if next_idx >= 0 { chunk_end = next_idx }
        chunk = string.substring(contents, cursor, chunk_end)
        err = parse_one_interaction(key, chunk)
        if err != "" {
            set_load_err_k(key, err)
            return err
        }
        if next_idx < 0 { break }
        cursor = next_idx + string.length(delim)
    }

    if list_size(tape_list_k(key)) == start_count {
        return "tape (${label}) parsed but yielded zero interactions"
    }
    return ""
}

parse_tape_file(key: string, tape_path: string) -> string {
    contents, rerr = fs.read(tape_path)
    if rerr != "" { return rerr }
    return parse_tape_text(key, tape_path, contents)
}

// Append another tape's interactions to an already-loaded server (the
// CLI's comma-separated `serve a.md,b.md,...`): parse `tape_path` without
// clearing, concatenating onto the server's existing in-memory tape.
// Returns "" on success, else the parse/read error. The playback cursor
// and all config are untouched.
load_append_h(server: ptr, tape_path: string) -> string {
    key = key_for(server)
    contents, rerr = fs.read(tape_path)
    if rerr != "" { return rerr }
    return parse_tape_text_append(key, tape_path, contents)
}

// Valid UTF-8 is kept intact; invalid binary bytes never reach JSON strings.
diagnostic_utf8_width(s: string, i: int) -> int {
    c = string.char_at(s, i)
    if c < 128 { return 1 }
    width = 0
    if c >= 194 && c <= 223 { width = 2 }
    if c >= 224 && c <= 239 { width = 3 }
    if c >= 240 && c <= 244 { width = 4 }
    if width == 0 || i + width > string.length(s) { return 0 }
    j = 1
    while j < width {
        next = string.char_at(s, i + j)
        if next < 128 || next > 191 { return 0 }
        j = j + 1
    }
    second = string.char_at(s, i + 1)
    if c == 224 && second < 160 { return 0 }
    if c == 237 && second > 159 { return 0 }
    if c == 240 && second < 144 { return 0 }
    if c == 244 && second > 143 { return 0 }
    return width
}

// ---- retained replay diagnostics (side channel; single test invocation) ----
// Reads acknowledge only the events they return. Observer reads never acknowledge.
// latest kind/index stay per-request; events survive subsequent successful requests.
struct ReplayDiagnostic {
    reported: int
    sequence: int
    kind: int
    interaction: int
    retrieved: int
    test_name: string
    source_file: string
    source_line: int
    tape: string
    expected_method: string
    expected_path: string
    expected_headers: string
    expected_body: string
    actual_method: string
    actual_path: string
    actual_headers: string
    actual_body: string
    detail: string
    candidate: int
}
replay_diagnostics_k(key: string) -> ptr { return list_handle(slot(key, "replay_diagnostics")) }

// Escape control bytes, bound each excerpt, and avoid terminal escape sequences.
diagnostic_text(s: string, limit: int) -> string {
    out = string.copy("")
    i = 0
    n = string.length(s)
    while i < n && i < limit {
        c = string.char_at(s, i)
        if c >= 128 {
            width = diagnostic_utf8_width(s, i)
            if width == 0 { out = string_concat(out, "[invalid byte]") }
            else {
                if i + width > limit { break }
                out = string_concat(out, string.substring(s, i, i + width))
                i = i + width - 1
            }
        }
        else if c == 10 { out = string_concat(out, "\n") }
        else if c == 9 { out = string_concat(out, "\\t") }
        else if c == 13 { out = string_concat(out, "\\r") }
        else if c < 32 || c == 127 { out = string_concat(out, "[control]") }
        else { out = string_concat(out, string.substring(s, i, i + 1)) }
        i = i + 1
    }
    if i < n { out = string_concat(out, "\n[truncated]") }
    return out
}

// Never expose a credential restored by unredact(), even in a different field.
// Mask conventional credential fields as well. This is a diagnostic projection;
// it does not change the values supplied to the matcher.
diagnostic_safe_k(key: string, src: string, field: int) -> string {
    out = src
    rules = unredactions_k(key)
    i = 0
    while i < list_size(rules) {
        r = list_get_raw(rules, i) as *Redaction
        if string.length(r.replacement) > 0 {
            out = str_replace_all(out, r.replacement, "[REDACTED]")
        }
        i = i + 1
    }
    if field == FIELD_REQUEST_HEADERS {
        out = redact_header_text(out, "Authorization", "[REDACTED]")
        out = redact_header_text(out, "Proxy-Authorization", "[REDACTED]")
        out = redact_header_text(out, "Cookie", "[REDACTED]")
        out = redact_header_text(out, "X-Api-Key", "[REDACTED]")
        out = redact_header_text(out, "X-Auth-Token", "[REDACTED]")
    }
    if field == FIELD_PATH {
        out = redact_query_text(out, "password", "[REDACTED]")
        out = redact_query_text(out, "token", "[REDACTED]")
        out = redact_query_text(out, "access_token", "[REDACTED]")
        out = redact_query_text(out, "api_key", "[REDACTED]")
        out = redact_query_text(out, "secret", "[REDACTED]")
    }
    if field == FIELD_REQUEST_BODY && string.length(out) > 0 {
        parsed, err = json.parse(out)
        if parsed != null && err == "" {
            json.json_free(parsed)
            out = redact_json_text(out, "password", "[REDACTED]")
            out = redact_json_text(out, "secret", "[REDACTED]")
            out = redact_json_text(out, "secretKey", "[REDACTED]")
            out = redact_json_text(out, "token", "[REDACTED]")
            out = redact_json_text(out, "access_token", "[REDACTED]")
            out = redact_json_text(out, "api_key", "[REDACTED]")
        } else {
            if parsed != null { json.json_free(parsed) }
        }
    }
    resolved = secret_values_k(key); ri = 0
    while ri < list_size(resolved) {
        item = list_get_raw(resolved, ri) as *SecretValue
        if item.value != "" { out = str_replace_all(out, item.value, "[REDACTED]") }
        ri = ri + 1
    }
    return out
}
first_difference(a: string, b: string) -> int {
    i = 0
    while i < string.length(a) && i < string.length(b) {
        if string.char_at(a, i) != string.char_at(b, i) { return i }
        i = i + 1
    }
    return i
}
diagnostic_binary(s: string) -> int {
    i = 0
    while i < string.length(s) {
        c = string.char_at(s, i)
        if (c < 32 && c != 9 && c != 10 && c != 13) || c == 127 { return 1 }
        if c >= 128 {
            width = diagnostic_utf8_width(s, i)
            if width == 0 { return 1 }
            i = i + width - 1
        }
        i = i + 1
    }
    return 0
}
// Compact context around the first differing line. The offset is byte-based;
// unlike an LCS, this is bounded for large/binary input and needs no UI support.
diagnostic_diff(title: string, expected: string, actual: string) -> string {
    if expected == actual { return "" }
    offset = first_difference(expected, actual)
    if diagnostic_binary(expected) == 1 || diagnostic_binary(actual) == 1 {
        a_len = string.length(expected)
        b_len = string.length(actual)
        return "${title}: binary values differ at byte ${offset} (expected ${a_len} bytes, actual ${b_len} bytes)\n"
    }
    line = 1
    i = 0
    start_a = 0
    while i < offset {
        if string.char_at(expected, i) == 10 { line = line + 1; start_a = i + 1 }
        i = i + 1
    }
    start_b = 0
    i = 0
    while i < offset && i < string.length(actual) {
        if string.char_at(actual, i) == 10 { start_b = i + 1 }
        i = i + 1
    }
    end_a = string.index_of_from(expected, "\n", offset)
    if end_a < 0 { end_a = string.length(expected) }
    end_b = string.index_of_from(actual, "\n", offset)
    if end_b < 0 { end_b = string.length(actual) }
    if start_a < offset - 128 { start_a = offset - 128 }
    if start_b < offset - 128 { start_b = offset - 128 }
    if end_a > offset + 384 { end_a = offset + 384 }
    if end_b > offset + 384 { end_b = offset + 384 }
    a = diagnostic_text(string.substring(expected, start_a, end_a), 512)
    b = diagnostic_text(string.substring(actual, start_b, end_b), 512)
    return "${title}\n--- expected\n+++ actual\n@@ line ${line}, byte ${offset} @@\n- ${a}\n+ ${b}\n"
}
replay_diagnostic_text(e: *ReplayDiagnostic) -> string {
    seq = e.sequence
    idx = e.interaction
    kind = e.kind
    test_name = diagnostic_text(e.test_name, 512)
    file = diagnostic_text(e.source_file, 512)
    line = e.source_line
    tape = diagnostic_text(e.tape, 512)
    heading = "Servirtium replay mismatch #${seq} (kind ${kind})\ntest: ${test_name}\nsource: ${file}:${line}\ntape: ${tape}\ninteraction: ${idx}\n"
    if e.candidate == 1 { heading = string_concat(heading, "expected values are from a candidate interaction (match_multiple)\n") }
    request_method = e.actual_method
    request_path = e.actual_path
    heading = string_concat(heading, "request: ${request_method} ${request_path}\n")
    return string_concat(heading, e.detail)
}
replay_diagnostic_json(e: *ReplayDiagnostic, server_key: string) -> ptr {
    obj = json.obj()
    json.set(obj, "sequence", json.from_int(e.sequence))
    json.set(obj, "kind", json.from_int(e.kind))
    json.set(obj, "interaction", json.from_int(e.interaction))
    json.set(obj, "retrieved", json.from_int(e.retrieved))
    json.set(obj, "reported", json.from_int(e.reported))
    json.set(obj, "server", json.str(server_key))
    json.set(obj, "test", json.str(e.test_name))
    json.set(obj, "source_file", json.str(e.source_file))
    json.set(obj, "source_line", json.from_int(e.source_line))
    json.set(obj, "tape", json.str(e.tape))
    json.set(obj, "candidate", json.from_int(e.candidate))
    expected = json.obj()
    json.set(expected, "method", json.str(e.expected_method))
    json.set(expected, "path", json.str(e.expected_path))
    json.set(expected, "headers", json.str(e.expected_headers))
    json.set(expected, "body", json.str(e.expected_body))
    actual = json.obj()
    json.set(actual, "method", json.str(e.actual_method))
    json.set(actual, "path", json.str(e.actual_path))
    json.set(actual, "headers", json.str(e.actual_headers))
    json.set(actual, "body", json.str(e.actual_body))
    json.set(obj, "expected", expected)
    json.set(obj, "actual", actual)
    json.set(obj, "diff", json.str(e.detail))
    return obj
}
diagnostic_headers_k(key: string, block: string) -> string {
    names = match_headers_k(key)
    if list_size(names) == 0 || vcr_get_strict_headers_k(key) == 1 { return block }
    out = string.copy("")
    i = 0
    while i < string.length(block) {
        end = string.index_of_from(block, "\n", i)
        if end < 0 { end = string.length(block) }
        line = string.substring(block, i, end)
        colon = string.index_of(line, ":")
        if colon > 0 {
            name = string.substring(line, 0, colon)
            j = 0
            while j < list_size(names) {
                wanted = list_get_raw(names, j) as *MatchHeaderName
                if icmp_rt(name, wanted.name) == 0 {
                    out = string_concat(out, string_concat(line, "\n"))
                    break
                }
                j = j + 1
            }
        }
        i = end + 1
    }
    return out
}
retain_replay_mismatch_k(key: string, kind: int, index: int, expected: *Interaction,
                          req: ptr, actual_body: string, candidate: int) {
    e = malloc(sizeof(ReplayDiagnostic)) as *ReplayDiagnostic
    seq = cfg_get_int(slot(key, "diagnostic_sequence"), 0) + 1
    cfg_set_int(slot(key, "diagnostic_sequence"), seq)
    e.sequence = seq
    e.kind = kind
    e.interaction = index
    e.retrieved = 0
    e.reported = 0
    e.test_name = string.copy(config.get(slot(key, "diagnostic_test")))
    e.source_file = string.copy(config.get(slot(key, "diagnostic_file")))
    e.source_line = cfg_get_int(slot(key, "diagnostic_line"), 0)
    e.tape = string.copy(config.get(slot(key, "diagnostic_tape")))
    e.candidate = candidate
    e.expected_method = ""
    e.expected_path = ""
    e.expected_headers = ""
    e.expected_body = ""
    if expected != null {
        e.expected_method = diagnostic_text(expected.method, 128)
        e.expected_path = diagnostic_safe_k(key, rt_apply_unredactions_for_k(key, expected.path, FIELD_PATH), FIELD_PATH)
        // The tape holds placeholders, not the credentials restored for matching.
        e.expected_headers = diagnostic_safe_k(key, diagnostic_headers_k(key, remove_headers_from_block_k(key, rt_apply_unredactions_for_k(key, expected.req_headers, FIELD_REQUEST_HEADERS), FIELD_REQUEST_HEADERS)), FIELD_REQUEST_HEADERS)
        e.expected_body = diagnostic_safe_k(key, rt_apply_unredactions_for_k(key, expected.req_body, FIELD_REQUEST_BODY), FIELD_REQUEST_BODY)
    }
    e.actual_method = diagnostic_text(http_request_method(req), 128)
    actual_path = build_recorded_path(req)
    if expected != null && expected_path_includes_query(expected.path) == 0 { actual_path = http_request_path(req) }
    e.actual_path = diagnostic_safe_k(key, actual_path, FIELD_PATH)
    e.actual_headers = diagnostic_safe_k(key, diagnostic_headers_k(key, normalize_live_headers_k(key, req)), FIELD_REQUEST_HEADERS)
    if diagnostic_binary(actual_body) == 1 {
        n = string.length(actual_body)
        e.actual_body = "[binary body: ${n} bytes]"
    } else { e.actual_body = diagnostic_safe_k(key, actual_body, FIELD_REQUEST_BODY) }
    if expected != null && diagnostic_binary(expected.req_body) == 1 {
        n = string.length(expected.req_body)
        e.expected_body = "[binary body: ${n} bytes]"
    }
    detail = string.copy("")
    if expected == null {
        detail = "no expected interaction available\n"
    } else {
        detail = diagnostic_diff("method", e.expected_method, e.actual_method)
        detail = string_concat(detail, diagnostic_diff("path", e.expected_path, e.actual_path))
        header_diff = kind >= KIND_HEADER_MISSING && kind <= KIND_HEADER_UNEXPECTED
        if candidate == 1 && (vcr_get_strict_headers_k(key) == 1 || is_blank(expected.req_headers) == 0 || list_size(match_headers_k(key)) > 0) { header_diff = true }
        if header_diff {
            detail = string_concat(detail, diagnostic_diff("request headers", e.expected_headers, e.actual_headers))
        }
        if kind == KIND_BODY_DIFF || (candidate == 1 && is_blank(expected.req_body) == 0) {
            if diagnostic_binary(expected.req_body) == 1 || diagnostic_binary(actual_body) == 1 {
                offset = first_difference(expected.req_body, actual_body)
                detail = string_concat(detail, "request body: binary values differ at byte ${offset} (body bytes omitted)\n")
            } else {
                detail = string_concat(detail, diagnostic_diff("request body", e.expected_body, e.actual_body))
            }
        }
        if detail == "" { detail = "values differ outside displayed excerpts or before diagnostic masking\n" }
    }
    if kind == KIND_BODY_DIFF && expected != null {
        expected_size = string.length(rt_apply_unredactions_for_k(key, expected.req_body, FIELD_REQUEST_BODY))
        actual_size = string.length(actual_body)
        summary = "request body different to expectation — recorded=${expected_size} bytes, live=${actual_size} bytes\n"
        detail = string_concat(summary, detail)
    }
    e.detail = string.copy(detail)
    e.expected_path = diagnostic_text(e.expected_path, 4096)
    e.actual_path = diagnostic_text(e.actual_path, 4096)
    e.expected_headers = diagnostic_text(e.expected_headers, 4096)
    e.actual_headers = diagnostic_text(e.actual_headers, 4096)
    e.expected_body = diagnostic_text(e.expected_body, 4096)
    e.actual_body = diagnostic_text(e.actual_body, 4096)
    list_add_raw(replay_diagnostics_k(key), e)
}
replay_last_error_k(key: string, consume: int) -> string {
    events = replay_diagnostics_k(key)
    n = list_size(events)
    if n == 0 { return vcr_last_error_k(key) }
    e = list_get_raw(events, n - 1) as *ReplayDiagnostic
    if consume != 0 { e.retrieved = 1 }
    return replay_diagnostic_text(e)
}
diagnostics_json_k(key: string, consume: int) -> string {
    arr = json.arr()
    events = replay_diagnostics_k(key)
    i = 0
    while i < list_size(events) {
        e = list_get_raw(events, i) as *ReplayDiagnostic
        if consume != 0 { e.retrieved = 1 }
        json.push(arr, replay_diagnostic_json(e, key))
        i = i + 1
    }
    text, _ = json.encode(arr)
    json.json_free(arr)
    return text
}
assert_no_mismatches_k(key: string) -> string {
    out = string.copy("")
    events = replay_diagnostics_k(key)
    i = 0
    while i < list_size(events) {
        e = list_get_raw(events, i) as *ReplayDiagnostic
        e.retrieved = 1
        out = string_concat(out, replay_diagnostic_text(e))
        out = string_concat(out, "\n")
        i = i + 1
    }
    return out
}
dump_unretrieved_k(key: string) {
    events = replay_diagnostics_k(key)
    i = 0
    while i < list_size(events) {
        e = list_get_raw(events, i) as *ReplayDiagnostic
        if e.retrieved == 0 && e.reported == 0 {
            report = string_concat("Servirtium: UNRETRIEVED REPLAY MISMATCH (not retrieved by lastError or a consuming diagnostic read)\n", replay_diagnostic_text(e))
            io.stderr_write(string_concat(report, "\n"))
            e.reported = 1
        }
        i = i + 1
    }
}
test_context_h(h: ptr, test_name: string, source_file: string, source_line: int) {
    key = key_for(h)
    dump_unretrieved_k(key)
    list_reset(slot(key, "replay_diagnostics"))
    vcr_clear_last_error_k(key)
    cfg_set_str(slot(key, "diagnostic_test"), test_name)
    cfg_set_str(slot(key, "diagnostic_file"), source_file)
    cfg_set_int(slot(key, "diagnostic_line"), source_line)
}
diagnostic_open_h(h: ptr, test_name: string, tape: string) {
    key = key_for(h)
    test_context_h(h, test_name, "", 0)
    cfg_set_str(slot(key, "diagnostic_tape"), tape)
    cfg_set_int(slot(key, "diagnostic_sequence"), 0)
    cfg_set_str(slot(key, "secret_state"), "")
    list_reset(slot(key, "secret_values"))
    cfg_set_int(slot(key, "secret_materialized"), 0)
}
last_error_ex_h(h: ptr, consume: int) -> string { return replay_last_error_k(key_for(h), consume) }
diagnostics_json_h(h: ptr, consume: int) -> string { return diagnostics_json_k(key_for(h), consume) }
assert_no_mismatches_h(h: ptr) -> string { return assert_no_mismatches_k(key_for(h)) }

// ---- staged named secrets: no HLL callbacks execute on HTTP worker threads ----
struct SecretCandidate {
    interaction: int; field: int; start: int; end: int; style: int
    key: string; path: string; format: string; token: string; indent: string
    applied: int; replacement: string; resolved_value: string; ordinal: int
}
struct SecretValue { value: string }
secret_candidates_k(key: string) -> ptr { return list_handle(slot(key, "secret_candidates")) }
secret_values_k(key: string) -> ptr { return list_handle(slot(key, "secret_values")) }
secret_current_k(key: string) -> *SecretCandidate {
    index = cfg_get_int(slot(key, "secret_cursor"), -1); items = secret_candidates_k(key)
    if index < 0 || index >= list_size(items) { return null }
    return list_get_raw(items, index) as *SecretCandidate
}
secret_raw_field(e: *Interaction, field: int) -> string {
    if field == FIELD_PATH { return e.path }
    if field == FIELD_REQUEST_HEADERS { return e.req_headers }
    if field == FIELD_RESPONSE_HEADERS { return e.resp_headers }
    if field == FIELD_REQUEST_BODY { return e.req_body }
    return e.body
}
secret_source_k(key: string, index: int, field: int) -> string {
    src = secret_raw_field(tape_get_k(key, index), field)
    if cfg_get_int(slot(key, "secret_resolving"), 0) == 0 {
        // Called only on the test thread after stopping recording. The
        // emitter's own first steps: stable order, redactions, removals.
        src = ordered_field_k(key, tape_get_k(key, index), field)
        src = apply_redactions_for(src, field)
        if field == FIELD_REQUEST_HEADERS || field == FIELD_RESPONSE_HEADERS { src = remove_headers_for(src, field) }
    }
    return src
}
secret_valid_name(name: string) -> int {
    if string.length(name) == 0 || string.length(name) > 128 { return 0 }
    i = 0
    while i < string.length(name) {
        c = string.char_at(name, i)
        if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 45 || c == 46 || c == 58) { return 0 }
        i = i + 1
    }
    return 1
}
secret_parse_marker(value: string, fallback_style: int) -> {
    if string.substring(value, 0, 9) != "{{secret:" { return "", fallback_style, "" }
    n = string.length(value)
    if n < 12 || string.substring(value, n - 2, n) != "}}" { return "", 0, "invalid named secret marker" }
    inner = string.substring(value, 9, n - 2); bar = string.index_of(inner, "|"); style = fallback_style; name = inner
    if bar >= 0 {
        name = string.substring(inner, 0, bar); digits = string.substring(inner, bar + 1, string.length(inner))
        if digits == "" { return "", 0, "secret marker has no encoding" }
        style = 0; i = 0
        while i < string.length(digits) { c = string.char_at(digits, i); if c < 48 || c > 57 { return "", 0, "invalid secret marker encoding" }; style = style * 10 + c - 48; i = i + 1 }
        if style < 1 || style > 13 { return "", 0, "unknown secret marker encoding" }
    }
    if secret_valid_name(name) == 0 { return "", 0, "invalid named secret identifier" }
    return name, style, ""
}
secret_body_format(e: *Interaction, field: int, src: string, resolving: int) -> string {
    mime = e.content_type
    if field == FIELD_REQUEST_BODY { mime = header_value_in_block(e.req_headers, "Content-Type") }
    // Explicit MIME wins. JSON/XML can also be identified after volatile headers
    // were removed. YAML/form inference is restricted to designated markers.
    if ascii_ci_contains(mime, "json") == 1 { return "json" }
    if ascii_ci_contains(mime, "xml") == 1 { return "xml" }
    if ascii_ci_contains(mime, "yaml") == 1 || ascii_ci_contains(mime, "yml") == 1 { return "yaml" }
    if ascii_ci_contains(mime, "application/x-www-form-urlencoded") == 1 { return "form" }
    if ascii_ci_contains(mime, "multipart/form-data") == 1 {
        start = 0
        while start + 9 <= string.length(mime) && icmp_rt(string.substring(mime, start, start + 9), "boundary=") != 0 { start = start + 1 }
        if start + 9 > string.length(mime) { return "multipart:" }
        start = start + 9; end = string.length(mime)
        if string.char_at(mime, start) == 34 { start = start + 1; end = string.index_of_from(mime, "\"", start); if end < 0 { return "multipart:" } }
        else { semicolon = string.index_of_from(mime, ";", start); if semicolon >= 0 { end = semicolon } }
        return string_concat("multipart:", rtrim(string.substring(mime, start, end)))
    }
    first = json_skip_space(src, 0)
    if first < string.length(src) {
        c = string.char_at(src, first)
        if c == 123 || c == 91 {
            node, err = json.parse(src)
            if node != null && err == "" { json.json_free(node); return "json" }
            if node != null { json.json_free(node) }
            if resolving == 1 && string.contains(src, "{{secret:") == 1 { return "yaml" }
        }
        if c == 60 { return "xml" }
    }
    if resolving == 1 {
        if ascii_ci_contains(src, "%7B%7Bsecret%3A") == 1 { return "form" }
        if string.contains(src, "{{secret:") == 1 && string.contains(src, ":") == 1 {
            // Markers themselves contain a colon: require a mapping separator.
            if string.contains(src, ": ") == 1 || string.contains(src, ":\n") == 1 { return "yaml" }
        }
    }
    return "opaque"
}
secret_begin_h(h: ptr, resolving: int) -> string {
    key = key_for(h); set_cur_key(key)
    if config.get(slot(key, "secret_state")) == "pending" { return "secret staging is already in progress" }
    if resolving != 0 && cfg_get_int(slot(key, "secret_materialized"), 0) != 0 { return "playback secrets have already been resolved" }
    if resolving != 0 && mode_k(key) == "record" { return "secret resolver requires playback mode" }
    if resolving == 0 && mode_k(key) != "record" { return "secret redactor requires record mode" }
    if resolving == 0 { http.server_stop(h) }
    generic = resolving == 1
    if resolving != 0 { resolving = 1 }
    cfg_set_int(slot(key, "secret_resolving"), resolving)
    cfg_set_str(slot(key, "secret_state"), "pending")
    cfg_set_int(slot(key, "secret_cursor"), -1)
    list_reset(slot(key, "secret_candidates"))
    config.put(slot(key, "emit_error"), "")
    items = secret_candidates_k(key); index = 0
    while index < list_size(tape_list_k(key)) {
        e = tape_get_k(key, index); order = 0
        while order < 5 {
            field = FIELD_PATH
            if order == 1 { field = FIELD_REQUEST_HEADERS }
            if order == 2 { field = FIELD_REQUEST_BODY }
            if order == 3 { field = FIELD_RESPONSE_HEADERS }
            if order == 4 { field = FIELD_RESPONSE_BODY }
            src = secret_source_k(key, index, field)
            if config.get(slot(key, "emit_error")) != "" { return secret_fail_k(key, "pre-existing redaction failed") }
            if src != "" {
                format = "query"
                if field == FIELD_REQUEST_HEADERS || field == FIELD_RESPONSE_HEADERS { format = "header" }
                if field == FIELD_REQUEST_BODY || field == FIELD_RESPONSE_BODY { format = secret_body_format(e, field, src, resolving) }
                spans = list_new(); err = ""
                has_marker = string.contains(src, "{{secret:") == 1 || ascii_ci_contains(src, "%7B%7Bsecret%3A") == 1
                if generic && (string.contains(src, "[REDACTED]") == 1 || ascii_ci_contains(src, "%5BREDACTED%5D") == 1) { has_marker = true }
                if resolving == 0 || has_marker { spans, err = secret_fields.scan(src, format) }
                if err != "" { return secret_fail_k(key, "interaction ${index}: secret field extraction failed (${format}): ${err}") }
                i = 0
                while i < secret_fields.count(spans) {
                    name = ""; style = secret_fields.style_at(spans, i)
                    if resolving != 0 {
                        value = secret_fields.value_at(spans, i)
                        original_style = style
                        name, style, err = secret_parse_marker(value, style)
                        if generic && value == "[REDACTED]" { name = string.copy(secret_fields.key_at(spans, i)) }
                        compatible = style == original_style || ((original_style == 3 || original_style == 8) && (style == 3 || style == 4 || style == 8 || style == 10))
                        if name != "" && !compatible { return secret_fail_k(key, "secret marker encoding does not match its field") }
                        if err != "" { return secret_fail_k(key, "interaction ${index}: ${err}") }
                    }
                    if resolving == 0 || name != "" {
                        candidate = malloc(sizeof(SecretCandidate)) as *SecretCandidate
                        candidate.interaction = index; candidate.field = field
                        candidate.start = secret_fields.begin_at(spans, i); candidate.end = secret_fields.end_at(spans, i)
                        candidate.style = style; candidate.key = string.copy(secret_fields.key_at(spans, i)); candidate.path = string.copy(secret_fields.path_at(spans, i))
                        candidate.format = string.copy(format); candidate.token = string.copy(name); candidate.indent = string.copy(secret_fields.indent_at(spans, i))
                        candidate.applied = 0; candidate.replacement = ""; candidate.resolved_value = ""; candidate.ordinal = i
                        list_add_raw(items, candidate)
                    }
                    i = i + 1
                }
            }
            order = order + 1
        }
        index = index + 1
    }
    return ""
}
secret_fail_k(key: string, error: string) -> string { cfg_set_str(slot(key, "secret_state"), "failed"); cfg_set_str(slot(key, "load_err"), error); return error }
secret_next_h(h: ptr) -> int {
    key = key_for(h)
    if config.get(slot(key, "secret_state")) != "pending" { return -1 }
    index = cfg_get_int(slot(key, "secret_cursor"), -1) + 1
    cfg_set_int(slot(key, "secret_cursor"), index)
    if index >= list_size(secret_candidates_k(key)) { return 0 }
    return 1
}
secret_get_h(h: ptr, part: int) -> string {
    key = key_for(h); current = secret_current_k(key)
    if current == null { return "" }
    if part == 1 { return current.key }
    if part == 2 { return current.token }
    e = tape_get_k(key, current.interaction)
    if part == 3 { return e.method }
    if part == 4 { return e.path }
    if part == 5 {
        if current.field == FIELD_PATH { return "request.query" }
        if current.field == FIELD_REQUEST_HEADERS { return "request.headers" }
        if current.field == FIELD_RESPONSE_HEADERS { return "response.headers" }
        if current.field == FIELD_REQUEST_BODY { return "request.body" }
        return "response.body"
    }
    if part == 6 { return current.format }
    if part == 7 { return current.path }
    return ""
}
secret_interaction_h(h: ptr) -> int { current = secret_current_k(key_for(h)); if current == null { return -1 }; return current.interaction }
secret_apply_h(h: ptr, value: string) -> string {
    key = key_for(h); current = secret_current_k(key)
    if current == null || config.get(slot(key, "secret_state")) != "pending" { return "no current secret candidate" }
    if current.applied == 1 { return secret_fail_k(key, "secret candidate already has a decision") }
    resolving = cfg_get_int(slot(key, "secret_resolving"), 0)
    replacement = value
    if resolving == 0 {
        if secret_valid_name(value) == 0 { return secret_fail_k(key, "invalid secret token name (use letters, digits, dot, underscore, dash or colon)") }
        style = current.style
        replacement = "{{secret:${value}|${style}}}"
        current.token = string.copy(value)
    }
    if string.substring(current.format, 0, 10) == "multipart:" && string.contains(replacement, "\n--") == 1 { return secret_fail_k(key, "multipart secret would introduce a delimiter") }
    encoded, err = secret_fields.render(replacement, current.style, 1 - resolving, current.indent)
    if err != "" { return secret_fail_k(key, err) }
    current.replacement = string.copy(encoded); current.applied = 1
    if resolving != 0 { current.resolved_value = string.copy(value) }
    if resolving != 0 && value != "" {
        secret = malloc(sizeof(SecretValue)) as *SecretValue; secret.value = string.copy(value); list_add_raw(secret_values_k(key), secret)
        // Diagnostics can contain the wire encoding instead of the decoded value.
        wire_value = encoded
        if current.style == 3 || current.style == 8 || current.style == 9 { wire_value = string.substring(encoded, 1, string.length(encoded) - 1) }
        secret = malloc(sizeof(SecretValue)) as *SecretValue; secret.value = string.copy(wire_value); list_add_raw(secret_values_k(key), secret)
        url_value = secret_fields.encode_url(value)
        secret = malloc(sizeof(SecretValue)) as *SecretValue; secret.value = string.copy(url_value); list_add_raw(secret_values_k(key), secret)
        secret = malloc(sizeof(SecretValue)) as *SecretValue; secret.value = str_replace_all(url_value, "%20", "+"); list_add_raw(secret_values_k(key), secret)
    }
    return ""
}
secret_patch_k(key: string, index: int, field: int, source: string) -> string {
    out = string.copy(""); cursor = 0; items = secret_candidates_k(key); i = 0
    while i < list_size(items) {
        item = list_get_raw(items, i) as *SecretCandidate
        if item.interaction == index && item.field == field && item.applied == 1 {
            if item.start < cursor { cfg_set_str(slot(key, "secret_state"), "failed"); return "" }
            out = string_concat(out, string.substring(source, cursor, item.start)); out = string_concat(out, item.replacement); cursor = item.end
        }
        i = i + 1
    }
    return string_concat(out, string.substring(source, cursor, string.length(source)))
}
secret_finish_h(h: ptr) -> string {
    key = key_for(h); set_cur_key(key)
    if config.get(slot(key, "secret_state")) != "pending" { return "secret staging did not complete" }
    items = secret_candidates_k(key); resolving = cfg_get_int(slot(key, "secret_resolving"), 0); i = 0
    if cfg_get_int(slot(key, "secret_cursor"), -1) < list_size(items) { return secret_fail_k(key, "not all secret candidates were visited") }
    while i < list_size(items) {
        item = list_get_raw(items, i) as *SecretCandidate
        if resolving != 0 && item.applied == 0 {
            name = item.token; index = item.interaction; path = item.path
            return secret_fail_k(key, "unresolved secret '${name}' at interaction ${index}, field ${path}")
        }
        i = i + 1
    }
    if resolving != 0 {
        // Decisions and all encodings have been validated before mutating any
        // playback expectation. Each patch is scoped to its original occurrence.
        i = 0
        while i < list_size(tape_list_k(key)) {
            e = tape_get_k(key, i)
            e.path = secret_patch_k(key, i, FIELD_PATH, e.path)
            e.req_headers = secret_patch_k(key, i, FIELD_REQUEST_HEADERS, e.req_headers)
            e.req_body = secret_patch_k(key, i, FIELD_REQUEST_BODY, e.req_body)
            e.resp_headers = secret_patch_k(key, i, FIELD_RESPONSE_HEADERS, e.resp_headers)
            e.body = secret_patch_k(key, i, FIELD_RESPONSE_BODY, e.body)
            i = i + 1
        }
    }
    if resolving != 0 && list_size(items) > 0 { cfg_set_int(slot(key, "secret_materialized"), 1) }
    cfg_set_str(slot(key, "secret_state"), "ready")
    return ""
}
secret_abort_h(h: ptr) { cfg_set_str(slot(key_for(h), "secret_state"), "failed") }
secret_emission_field_k(key: string, index: int, field: int, source: string) -> string {
    if cfg_get_int(slot(key, "secret_resolving"), 0) == 0 && config.get(slot(key, "secret_state")) == "ready" { return secret_patch_k(key, index, field, source) }
    return source
}
secret_emission_field(index: int, field: int, source: string) -> string {
    return secret_emission_field_k(cur_key(), index, field, source)
}

secret_check_ready_h(h: ptr) -> string {
    key = key_for(h)
    if mode_k(key) == "record" { return "" }
    state = config.get(slot(key, "secret_state"))
    if state == "ready" { return "" }
    if state != "" { return "secret resolution did not complete" }
    err = secret_begin_h(h, 2)
    if err != "" { return err }
    while secret_next_h(h) > 0 {}
    return secret_finish_h(h)
}

// Only resolved secret values receive encoding equivalence. The surrounding
// path/body, other fields, scalar types and field order remain byte-exact.
secret_canonical_live_k(key: string, index: int, field: int, source: string) -> string {
    if cfg_get_int(slot(key, "secret_materialized"), 0) == 0 { return source }
    items = secret_candidates_k(key); i = 0; format = ""
    while i < list_size(items) {
        item = list_get_raw(items, i) as *SecretCandidate
        if item.interaction == index && item.field == field { format = item.format; break }
        i = i + 1
    }
    if format == "" { return source }
    spans, err = secret_fields.scan(source, format)
    if err != "" { return source }
    out = string.copy(""); cursor = 0; i = 0
    while i < list_size(items) {
        item = list_get_raw(items, i) as *SecretCandidate
        if item.interaction == index && item.field == field && item.applied == 1 {
            n = item.ordinal
            if n < secret_fields.count(spans) && secret_fields.path_at(spans, n) == item.path &&
                secret_fields.style_at(spans, n) == item.style && secret_fields.value_at(spans, n) == item.resolved_value {
                start = secret_fields.begin_at(spans, n); end = secret_fields.end_at(spans, n)
                if start >= cursor {
                    out = string_concat(out, string.substring(source, cursor, start))
                    out = string_concat(out, item.replacement); cursor = end
                }
            }
        }
        i = i + 1
    }
    return string_concat(out, string.substring(source, cursor, string.length(source)))
}
