// ---- redaction / unredaction / header-removal storage ----

valid_redaction_field(field: int) -> int {
    if field == FIELD_PATH { return 1 }
    if field == FIELD_RESPONSE_BODY { return 1 }
    if field == FIELD_REQUEST_HEADERS { return 1 }
    if field == FIELD_REQUEST_BODY { return 1 }
    if field == FIELD_RESPONSE_HEADERS { return 1 }
    return 0
}

redaction_add(l: ptr, field: int, pattern: string, replacement: string, api: string) -> int {
    if valid_redaction_field(field) == 0 {
        set_load_err("unsupported field selector")
        return 0
    }
    r = malloc(sizeof(Redaction)) as *Redaction
    r.kind = 0
    r.field = field
    r.pattern = string.copy(pattern)
    r.replacement = string.copy(replacement)
    r.used = 0
    r.required = 1
    list_add_raw(l, r)
    return 1
}

vcr_add_redaction(field: int, pattern: string, replacement: string) -> int {
    return redaction_add(redactions(), field, pattern, replacement, "redaction")
}
vcr_add_unredaction(field: int, pattern: string, replacement: string) -> int {
    return redaction_add(unredactions(), field, pattern, replacement, "unredaction")
}
vcr_clear_redactions() { list_reset(slot(cur_key(), "redactions")) }
vcr_clear_unredactions() { list_reset(slot(cur_key(), "unredactions")) }

vcr_get_redaction_count() -> int { return list_size(redactions()) }
vcr_get_redaction_field(i: int) -> int {
    if i < 0 || i >= list_size(redactions()) { return 0 }
    return (list_get_raw(redactions(), i) as *Redaction).field
}
vcr_get_redaction_pattern(i: int) -> string {
    if i < 0 || i >= list_size(redactions()) { return "" }
    return (list_get_raw(redactions(), i) as *Redaction).pattern
}
vcr_get_redaction_replacement(i: int) -> string {
    if i < 0 || i >= list_size(redactions()) { return "" }
    return (list_get_raw(redactions(), i) as *Redaction).replacement
}
vcr_get_unredaction_count() -> int { return list_size(unredactions()) }
