// servirtium — the standalone tape CLI. A pure-Aether static binary over
// core/vcr.ae (no .so, no SERVIRTIUM_VCR_LIB): serve a tape as a live stub
// server, lint tapes, and convert to/from HAR 1.2. Everything smart lives
// in libservirtium_vcr (the one rule); this file is argv parsing and printlns.
//
//   servirtium serve  <tape.md>[,more.md...] [port] [--ordered]   replay tape(s) as a live server (default port 8080)
//   servirtium check  [--canonical] <tape.md> ...    lint tapes: parse clean? (exit 0/1)
//   servirtium import <in.har> <out.md>              HAR capture -> Servirtium tape
//   servirtium export <in.md>  <out.har>             Servirtium tape -> HAR capture
//
// `serve` defaults to MatchMultiple playback (order-independent and
// non-consuming, so repeated identical requests keep answering) because a
// hand-driven stub server is exactly the demo/polling case; `--ordered`
// restores libservirtium_vcr default (strictly ordered, each interaction consumed
// once, then 599 tape-exhausted).
//
// `check` exits 0 only if every tape parses; `--canonical` additionally
// requires byte-identity with this libservirtium_vcr's compact emitter form (what the
// */example/tapes goldens are). The parser itself stays lenient.
//
// (`import`/`export` absorbed the old `servirtium-har` binary — same
// vcr.har_import / vcr.har_export underneath.)
//
// Build:  ae build core/cli.ae -o servirtium
// (aeb builds it via core/.cli.ae -> target/servirtium)

import core.vcr
import std.os
import std.string
import std.fs
import std.http.client
import std.intarr

extern exit(code: int)
extern http_server_start_raw(server: ptr) -> int

// Actor plumbing for `import-bru`: the record server's accept loop
// (http_server_start_raw) blocks, so it runs in its own actor while main()
// drives the parsed requests through it as a client. SchedHelper is the
// documented scheduler-nudge companion (see the record-in-process recipe in
// core/vcr.ae). Both mirror std.http.server.vcr's canonical pattern.
message StartVCR { raw: ptr }
message Noop {}
actor VCRActor { state s = 0
    receive { StartVCR(raw) -> { s = raw; http_server_start_raw(raw) } } }
actor SchedHelper { state x = 0
    receive { Noop() -> { x = 1 } } }

usage() {
    println("servirtium — serve, lint, and convert Servirtium markdown tapes")
    println("")
    println("usage:")
    println("  servirtium serve  <tape.md>[,more.md...] [port] [--ordered]")
    println("                                                   replay tape(s) as a live server (default port 8080)")
    println("  servirtium check  [--canonical] <tape.md> ...    lint: tapes parse clean (exit 0/1)")
    println("  servirtium import <in.har> <out.md>              HAR capture -> Servirtium tape")
    println("  servirtium export <in.md>  <out.har>             Servirtium tape -> HAR capture")
    println("  servirtium import-bru <bru-dir> <upstream> <out.md> [--var NAME] [--port N]")
    println("                                                   Bruno collection -> hydrate vs upstream -> tape")
    println("")
    println("serve replays repeatably and order-independently (MatchMultiple);")
    println("--ordered restores strict one-shot tape order. check --canonical also")
    println("requires the file to be byte-identical to libservirtium_vcr's emitter form.")
}

// serve <tape.md>[,more.md...] [port] [--ordered] — bind a playback server
// and block in the accept loop until killed (Ctrl-C). Flags and positionals
// may mix. A comma-separated tape list concatenates into one tape.
run_serve(argc: int) {
    tape = ""
    port = 0
    ordered = 0
    i = 2
    while i < argc {
        a = os.aether_args_get(i)
        if string.equals(a, "--ordered") == 1 {
            ordered = 1
        } else {
            if tape == "" {
                tape = a
            } else {
                p, perr = string.to_int(a)
                if perr != "" || p <= 0 || p > 65535 {
                    println("servirtium serve: bad port '${a}'")
                    exit(2)
                }
                port = p
            }
        }
        i = i + 1
    }
    if tape == "" { usage(); exit(2) }
    if port == 0 { port = 8080 }

    // `tape` may be a comma-separated list: load the first tape (binds the
    // server), then append the rest onto the same interaction list. Ordered
    // mode plays the concatenation as one long script; the default
    // MatchMultiple mode treats it as one union store (first match wins).
    remaining = tape
    first = remaining
    c = string.index_of(remaining, ",")
    if c >= 0 {
        first = string.substring(remaining, 0, c)
        remaining = string.substring(remaining, c + 1, string.length(remaining))
    } else {
        remaining = ""
    }

    raw = vcr.load(first, port)
    if raw == null {
        println("servirtium serve: ${vcr.load_error()}")
        exit(1)
    }
    while remaining != "" {
        nxt = remaining
        c = string.index_of(remaining, ",")
        if c >= 0 {
            nxt = string.substring(remaining, 0, c)
            remaining = string.substring(remaining, c + 1, string.length(remaining))
        } else {
            remaining = ""
        }
        if nxt != "" {
            aerr = vcr.load_append_h(raw, nxt)
            if aerr != "" {
                println("servirtium serve: ${nxt}: ${aerr}")
                exit(1)
            }
        }
    }
    if ordered == 0 { vcr.set_match_multiple_h(raw, 1) }

    n = vcr.tape_length_h(raw)
    mode = "repeatable, order-independent (--ordered for strict tape order)"
    if ordered == 1 { mode = "strict tape order, each interaction consumed once" }
    println("servirtium: serving ${tape} on http://127.0.0.1:${port}")
    println("servirtium: ${n} interaction(s); ${mode}")
    println("servirtium: Ctrl-C to stop")

    rc = http_server_start_raw(raw)
    vcr.eject(raw)
    if rc != 0 { exit(1) }
    exit(0)
}

// check [--canonical] <tape.md> ... — exit 0 only if every tape passes.
run_check(argc: int) {
    canonical = 0
    checked = 0
    fails = 0
    i = 2
    while i < argc {
        a = os.aether_args_get(i)
        if string.equals(a, "--canonical") == 1 {
            canonical = 1
        } else {
            checked = checked + 1
            n, err = vcr.check_tape(a)
            if err != "" {
                println("servirtium check: ${a}: FAIL — ${err}")
                fails = fails + 1
            } else {
                if canonical == 1 {
                    cerr = vcr.canonical_check_tape(a)
                    if cerr != "" {
                        println("servirtium check: ${a}: FAIL — ${cerr}")
                        fails = fails + 1
                    } else {
                        println("servirtium check: ${a}: ok — ${n} interaction(s), canonical")
                    }
                } else {
                    println("servirtium check: ${a}: ok — ${n} interaction(s)")
                }
            }
        }
        i = i + 1
    }
    if checked == 0 { usage(); exit(2) }
    if fails > 0 {
        println("servirtium check: ${fails} of ${checked} tape(s) failed")
        exit(1)
    }
    exit(0)
}

// import-bru <bru-dir> <upstream-base> <out.md> [--var NAME] [--port N]
//
// Import a Bruno collection (request DEFINITIONS, no responses) and HYDRATE it:
// each .bru's request is fired through a record-mode proxy at `upstream-base`,
// and the real responses are captured into `out.md` — a replayable tape.
//
// The collection's base-url variable (default {{baseUrl}}) is rewritten to the
// local record proxy. Request headers are intentionally not forwarded into the
// tape's match block (a collection's headers wouldn't match a test client's;
// matching is method + path + body — same policy as HAR import).
//
// WARNING: this makes REAL calls to `upstream-base` (side effects on POST/PUT/
// DELETE, auth, rate limits). It is the "poke the service to fill the blanks"
// step; run it against a service you intend to hit.
run_import_bru(argc: int) {
    dir = ""
    upstream = ""
    out = ""
    basevar = "baseUrl"
    port = 8099
    i = 2
    npos = 0
    while i < argc {
        a = os.aether_args_get(i)
        if string.equals(a, "--var") == 1 {
            i = i + 1
            if i < argc { basevar = os.aether_args_get(i) }
        } else if string.equals(a, "--port") == 1 {
            i = i + 1
            if i < argc {
                p, perr = string.to_int(os.aether_args_get(i))
                if perr == "" && p > 0 && p <= 65535 { port = p }
            }
        } else {
            if npos == 0 { dir = a } else if npos == 1 { upstream = a } else if npos == 2 { out = a }
            npos = npos + 1
        }
        i = i + 1
    }
    if dir == "" || upstream == "" || out == "" { usage(); exit(2) }

    files, gerr = fs.glob(string.concat(dir, "/*.bru"))
    if string.length(gerr) > 0 { println("servirtium import-bru: ${gerr}"); exit(1) }
    nfiles = fs.dir_list_count(files)
    if nfiles == 0 { println("servirtium import-bru: no .bru files under ${dir}"); fs.dir_list_free(files); exit(1) }

    raw = vcr.load_record(out, upstream, port)
    if raw == null { println("servirtium import-bru: ${vcr.load_error()}"); exit(1) }

    // Keep the promise the header comment above makes. client.set_body() below
    // sets a Content-Type on every request that carries a body, and the record
    // proxy would otherwise write it into the tape's REQUEST MATCH BLOCK — so a
    // hydrated POST/PUT/PATCH could never be matched by a real client (its own
    // Content-Type, or absence of one, would differ). GET/DELETE were unaffected
    // because they send no body and so no Content-Type, which is exactly why
    // this was invisible until a collection with a body was imported.
    _rh = vcr.remove_header_h(raw, vcr.FIELD_REQUEST_HEADERS, "Content-Type")

    spawn(SchedHelper())
    // NB: deliberately NOT `a` — the arg-parsing loop above binds `a` as a
    // string, and a local first bound inside a branch/loop is ONE variable for
    // the whole function, so reusing it here as an ActorRef is a type conflict
    // (ae 0.706 rejects it as E0200; older ae leaked it to gcc as an
    // "incompatible pointer type" on the generated C).
    vcr_actor = spawn(VCRActor())
    vcr_actor ! StartVCR { raw: raw }
    sleep(500)

    proxy = "http://127.0.0.1:${port}"
    varneedle = "{{${basevar}}}"
    hydrated = 0
    // Selection sort on meta.seq so interactions are hydrated in the collection's
    // intended order (fs.glob returns alphabetical, not seq order). n is small (a
    // collection is tens of requests) so O(n^2) is fine, and it sidesteps a
    // parallel-array sort in ae. Each round picks the not-yet-done file with the
    // lowest seq; ties and missing seq (->0) fall back to glob/alphabetical order
    // because the scan keeps the FIRST file at a given seq and marks indices done.
    // done_flags[i] != 0 once file i is processed.
    done_flags, dferr = intarr.new(nfiles)
    if string.length(dferr) > 0 { println("servirtium import-bru: ${dferr}"); fs.dir_list_free(files); exit(1) }
    processed = 0
    while processed < nfiles {
        pick = -1
        pick_seq = 0
        gi = 0
        while gi < nfiles {
            gflag, _gfe = intarr.get(done_flags, gi)
            if gflag == 0 {
                gp = fs.dir_list_get(files, gi)
                gt, ge = fs.read(gp)
                gseq = 0
                if string.length(ge) == 0 {
                    s, serr = string.to_int(vcr.bru_kv(vcr.bru_block_body(gt, "meta"), "seq"))
                    if serr == "" { gseq = s }
                }
                if pick < 0 || gseq < pick_seq { pick = gi; pick_seq = gseq }
            }
            gi = gi + 1
        }
        if pick < 0 { break }
        _sfe = intarr.set(done_flags, pick, 1)
        processed = processed + 1
        path = fs.dir_list_get(files, pick)
        text, rerr = fs.read(path)
        if string.length(rerr) > 0 { println("  skip ${path}: ${rerr}"); continue }
        method = vcr.bru_method_of(text)
        if method == "" { println("  skip ${path}: no http verb block"); continue }
        vb = vcr.bru_block_body(text, vcr.bru_verb_block(method))
        url = vcr.bru_kv(vb, "url")
        if url == "" { println("  skip ${path}: no url"); continue }
        // rewrite the collection's base-url var to the record proxy
        vat = string.index_of(url, varneedle)
        if vat >= 0 {
            url = string.concat(proxy, string.substring(url, vat + string.length(varneedle), string.length(url)))
        }
        body = vcr.bru_trim(vcr.bru_block_body(text, "body:json"))

        req = client.request(method, url)
        if string.length(body) > 0 {
            _sb = client.set_body(req, body, string.length(body), "application/json")
        }
        resp, cerr = client.send_request(req)
        if string.length(cerr) > 0 {
            println("  ${method} ${url}: request failed: ${cerr}")
        } else {
            println("  ${method} ${url} -> ${client.response_status(resp)}")
            client.response_free(resp)
            hydrated = hydrated + 1
        }
        client.request_free(req)
    }

    fs.dir_list_free(files)
    e = vcr.eject_record(raw, out)
    if string.length(e) > 0 { println("servirtium import-bru: ${e}"); exit(1) }
    println("servirtium: import-bru hydrated ${hydrated} interaction(s) from ${dir} -> ${out}")
    exit(0)
}

main() {
    // aether_args_get(0) is argv0; the sub-command and its args follow.
    argc = os.aether_args_count()
    if argc < 2 {
        usage()
        exit(2)
    }
    cmd = os.aether_args_get(1)

    if string.equals(cmd, "serve") == 1 { run_serve(argc) }
    if string.equals(cmd, "check") == 1 { run_check(argc) }
    if string.equals(cmd, "import-bru") == 1 { run_import_bru(argc) }

    if string.equals(cmd, "import") == 1 {
        if argc < 4 { usage(); exit(2) }
        src = os.aether_args_get(2)
        dst = os.aether_args_get(3)
        err = vcr.har_import(src, dst)
        if err != "" { println("servirtium: ${err}"); exit(1) }
        println("servirtium: imported ${src} -> ${dst}")
        exit(0)
    }
    if string.equals(cmd, "export") == 1 {
        if argc < 4 { usage(); exit(2) }
        src = os.aether_args_get(2)
        dst = os.aether_args_get(3)
        err = vcr.har_export(src, dst)
        if err != "" { println("servirtium: ${err}"); exit(1) }
        println("servirtium: exported ${src} -> ${dst}")
        exit(0)
    }

    println("servirtium: unknown command '${cmd}'")
    usage()
    exit(2)
}
