// std.http.server.vcr.embed — a thin C-ABI embedding wrapper over the
// std.http.server.vcr surface, for hosting the Aether VCR as a
// record/playback server behind an FFI layer (e.g. servirtium-dotnet's
// P/Invoke). vcr_embed_abi_wish.md Part B.
//
// Build it as a shared library and dlsym the exports:
//
//     ae build --emit=lib --with=fs,net,extern \
//         core/embed.ae --extra core/_embed_strdup.c -o libvcr.so
//
// No new VCR semantics — record / playback / mutation / parse all stay
// exactly as the vcr module implements them. This layer adds only the
// embedding seam the raw module surface lacks:
//
//   * starts the accept loop on a detached background thread
//     (`http_server_start_background_raw`) — the vcr module's `load()`
//     deliberately doesn't listen, pushing actor-wiring onto the caller,
//     which an FFI host can't do;
//   * binds synchronously *before* starting the thread so an
//     OS-assigned port (port 0) is resolved by the time the start call
//     returns and `vcr_embed_port` can report it;
//   * returns caller-owned C strings (every string result is duplicated
//     via `vcr_embed_dup`; the host frees it with `vcr_embed_free_string`).
//
// Export naming: every function is prefixed `vcr_embed_`, so under
// `--emit=lib` it lands as `aether_vcr_embed_<name>`.
//
// PER-LISTENER contract: N independent VCR servers can run concurrently
// in one process. The opaque handle is the VCR's own record; every
// config / diagnostic / lifecycle call takes the handle and addresses
// THAT VCR's state (tape / cursor / rules / diagnostics), and nothing about
// any VCR is kept outside its record. Lifecycle is
// open -> check -> configure -> start -> stop -> (read diagnostics) -> destroy:
//   1. vcr_embed_open_playback / _open_playback_url / _open_record
//      create + bind the server and return a handle (NOT serving yet);
//   2. vcr_embed_open_error(handle) is "" if it opened, else the reason;
//   3. config calls (redact / static_content / untaped / strict / ...)
//      take the handle;
//   4. vcr_embed_start(handle) begins serving on a background thread;
//   5. vcr_embed_stop / _stop_and_flush* / _discard stop serving;
//   6. vcr_embed_destroy(handle) frees it (every handle, failed or not).

import vcr
import bru_convert
import std.http
// Pulls Aether's PURE-Aether TLS 1.3 server (RFC 8446, NO OpenSSL) into the
// link: server_set_tls reaches it through weak symbols (aether_pure_tls_server_*)
// that only resolve when this module is imported. Without it, TLS falls back to
// OpenSSL, and the cross-built release libs — built with no OpenSSL in the zig
// sysroot — fail at runtime with "built without OpenSSL". This makes HTTPS work
// on every platform with zero native TLS dependency. Needs --with=fs (the cert
// and key are read with std.fs); core/.build.ae already declares caps(fs,…).
// The pure server accepts ECDSA P-256/P-384/P-521, Ed25519 and RSA 2048-16384
// keys (aether #3326); an unusable key is refused at set_tls time (#3328).
import std.cryptography.tls13_server

// Caller-owned-string helpers (core/_embed_strdup.c). malloc/strdup-style
// dup + free for the caller-owned-return contract.
//
// They speak `ptr`, not `string`, on the way out. Since Aether 0.819 an
// --emit=lib export returning `string` hands the host an Aether string
// handle, and a malloc'd C string returned as `string` is first copied into
// a new counted string: the host would get the handle, not these bytes,
// vcr_embed_free_string would free() the wrong block, and the copy would
// leak. A `ptr` result crosses as the pointer itself: the plain,
// NUL-terminated char* this ABI has always promised every binding.
extern vcr_embed_dup(s: string) -> ptr
extern vcr_embed_free(s: ptr)

// ---- lifecycle: open (create + bind + register, NOT serving) ----
//
// Every open returns a handle (null only if memory ran out). Check it with
// vcr_embed_open_error(handle): "" means it opened; anything else is why it
// did not, and that handle is a dead VCR carrying only its reason (start
// fails on it). Either way the caller owns the handle and frees it with
// vcr_embed_destroy. Nothing about a failed open is kept anywhere else.

// Bind a freshly opened VCR to host:port, or turn it into a failed-open handle.
bind_opened(h: @into ptr, err: string, label: string, tape: string, host: string, port: int) -> ptr {
    if h == null { return vcr.failed_open_h(err) }
    vcr.diagnostic_open_h(h, label, tape)
    http_server_set_host(vcr.server_of(h), host)
    rc = http_server_bind_raw(vcr.server_of(h), host, port)
    if rc < 0 {
        vcr.destroy_h(h)
        return vcr.failed_open_h("vcr: cannot bind ${host}:${port}")
    }
    return h
}

// Parse `tape_path`, create + bind `host:port` (port 0 = OS-assigned),
// register the per-server wildcard dispatcher, and return the handle.
// `label` is human-facing (logs/diagnostics), never the state key.
// Does NOT start serving — call vcr_embed_start(handle) after config.
vcr_embed_open_playback(label: string, tape_path: string, host: string, port: int) -> ptr {
    h, err = vcr.open_playback(tape_path, port)
    return bind_opened(h, err, label, tape_path, host, port)
}

// As vcr_embed_open_playback, but the tape is fetched over HTTP from
// `tape_url` instead of read from disk.
vcr_embed_open_playback_url(label: string, tape_url: string, host: string, port: int) -> ptr {
    h, err = vcr.open_playback_url(tape_url, port)
    return bind_opened(h, err, label, tape_url, host, port)
}

// Record mode: create + bind `host:port`; the dispatcher will forward
// each request to `upstream_base`, return the live response, and capture
// the interaction. Flush with vcr_embed_stop_and_flush. Does NOT start
// serving — call vcr_embed_start(handle).
vcr_embed_open_record(label: string, tape_path: string, upstream_base: string, host: string, port: int) -> ptr {
    h, err = vcr.open_record(tape_path, upstream_base, port)
    return bind_opened(h, err, label, tape_path, host, port)
}

// "" if the handle's open succeeded, else why it failed. Caller frees.
vcr_embed_open_error(s: ptr) -> ptr {
    return vcr_embed_dup(vcr.open_error_h(s))
}

// Begin serving: start the accept loop on a background thread. Returns
// >= 0 on success, < 0 on failure (including a failed-open handle).
vcr_embed_start(s: ptr) -> int {
    if s == null { return -1 }
    if vcr.server_of(s) == null { return -1 }
    // Returns once the accept loop is live (not merely spawned), so an
    // immediate stop is never lost -- see vcr.start_background_h.
    if vcr.secret_check_ready_h(s) != "" { return -1 }
    return vcr.start_background_h(s, 10000)
}

// Stop the accept loop. The handle stays valid (diagnostics, flush) until
// vcr_embed_destroy.
vcr_embed_stop(s: ptr) {
    if s == null { return }
    vcr.eject(s)
}

// Free the VCR: stops it if it is still serving, then frees its server and
// its record. Every handle an open returned, failed or not, must be
// destroyed exactly once; the handle is invalid afterwards. Read
// diagnostics (and flush) before destroying.
vcr_embed_destroy(s: ptr) {
    if s == null { return }
    vcr.destroy_h(s)
}

// Record handles: stop + flush the captured markdown to `tape_path`.
// Returns "" on success, else an error (caller frees the string).
vcr_embed_stop_and_flush(s: ptr, tape_path: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.stop_and_flush_h(s, tape_path))
}

// Stop + flush, overwriting the tape AND returning a non-empty drift
// error when the new recording differs (Servirtium step-4 contract).
vcr_embed_stop_and_flush_fail_if_changed(s: ptr, tape_path: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.stop_and_flush_fail_if_changed_h(s, tape_path))
}

// Stop + the non-destructive drift variant: writes the freshly recorded
// tape to a `<tape_path>.actual` sibling and byte-compares against the
// committed tape WITHOUT overwriting it. Caller frees.
vcr_embed_stop_and_flush_or_check(s: ptr, tape_path: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.stop_and_flush_or_check_h(s, tape_path))
}

// Record-mode DISCARD: stop the server and drop the in-memory recording
// WITHOUT writing a tape. A binding calls this instead of a stop_and_flush*
// when the test failed, so a half-finished recording never becomes a tape
// that later replays as the truth (two-phase: flush = commit on success,
// discard on failure). `tape_path` is accepted for call-site symmetry with
// the flush family and ignored. Returns "" (nothing to fail). Caller frees.
vcr_embed_discard(s: ptr, tape_path: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.discard_h(s, tape_path))
}

// ---- introspection (handle-based) ----

// Resolved listening port (the OS-assigned port when started with 0).
vcr_embed_port(s: ptr) -> int {
    if s == null { return 0 }
    if vcr.server_of(s) == null { return 0 }
    return http_server_port(vcr.server_of(s))
}

// "http://<host>:<port>" (or "https://…" when TLS is enabled on this handle)
// for the running server — caller frees.
vcr_embed_base_url(s: ptr, host: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    if vcr.server_of(s) == null { return vcr_embed_dup("") }
    p = http_server_port(vcr.server_of(s))
    scheme = "http"
    if vcr.tls_enabled_h(s) != 0 { scheme = "https" }
    url = "${scheme}://${host}:${p}"
    return vcr_embed_dup(url)
}

// Terminate TLS on this listener: the VCR serves https:// instead of http://,
// for client libraries that refuse plain HTTP. cert_path/key_path are PEM
// files (certificate and its matching private key). Configure AFTER open and
// BEFORE start. Returns "" on success or an error string (empty path, a PEM
// that is unreadable / unparseable / mismatched, or a core built without
// OpenSSL). On error, start() also fails and last_error carries the reason.
vcr_embed_set_tls(s: ptr, cert_path: string, key_path: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.set_tls_h(s, cert_path, key_path))
}

// Like vcr_embed_set_tls, but the certificate and key are PEM TEXT passed in
// memory instead of file paths, so a test never writes a private key to disk.
// Same contract ("" = OK / error string), applied at start via
// http.server_set_tls_pem (aether #3362). Configure before start.
vcr_embed_set_tls_pem(s: ptr, cert_pem: string, key_pem: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.set_tls_pem_h(s, cert_pem, key_pem))
}

// Response-side substitution (playback): rewrite `pattern` -> `replacement` in
// the recorded RESPONSE body (field=2 ResponseBody) or RESPONSE headers
// (field=5 ResponseHeaders) before the response is sent, so a taped
// nextLink/id/absolute URL can point at the test's own host (paging/HATEOAS).
// The {{request.host}}/{{request.scheme}}/{{baseUrl}} tokens are filled from
// the live request automatically, no registration needed. "" = OK, else error
// (e.g. a non-response field). Configure before start.
// field: 2 ResponseBody, 5 ResponseHeaders, 6 Response (body AND headers, one
// rule). required: 1 = assert_all_redactions_used reports it if never used; 0 =
// optional (a shared fixture's safeguard a given tape may not exercise).
vcr_embed_substitute(s: ptr, field: int, pattern: string, replacement: string, required: int) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.substitute_h(s, field, pattern, replacement, required))
}

// The TLS protocol this listener serves over: "TLSv1.3" when TLS is on (the
// pure-Aether TLS 1.3 server), "" for plain HTTP. Lets a test assert the server
// negotiated 1.3, not just that the client was configured for it. Caller frees.
vcr_embed_last_tls_protocol(s: ptr) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.last_tls_protocol_h(s))
}

vcr_embed_clear_substitutions(s: ptr) {
    if s == null { return }
    vcr.clear_substitutions_h(s)
}

// "" if every recorded interaction was replayed at least once since load/reset,
// else a message listing the unused ones (index + method + path). Bindings
// surface this as an AssertAllConsumed()/RequireAllConsumed() check so a test
// fails when the SUT skipped a taped step. Caller frees.
vcr_embed_assert_all_consumed(s: ptr) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.assert_all_consumed_h(s))
}

// "" if every registered redaction / unredaction / substitution rule actually
// matched something, else a message listing the rules that never fired (a
// verifyNoMoreInteractions()-style check for scrubbing config). Caller frees.
vcr_embed_assert_all_redactions_used(s: ptr) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.assert_all_redactions_used_h(s))
}

// "" if every served response had all its {{...}} placeholders filled, else a
// message listing the interactions that still contained one when sent to the SUT
// (a typo, or a placeholder no rule covers). Works with a shared fixture or
// per-test rules. Caller frees.
vcr_embed_assert_no_unfilled_placeholders(s: ptr) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.assert_no_unfilled_placeholders_h(s))
}

vcr_embed_tape_length(s: ptr) -> int {
    if s == null { return 0 }
    return vcr.tape_length_h(s)
}

vcr_embed_reset_cursor(s: ptr) {
    if s == null { return }
    vcr.reset_cursor_h(s)
}

// ---- diagnostics (drain after a request to assert outcomes) ----

// The last match-failure detail, or — when no match failure is pending —
// the last load failure reason (fetch/parse/bind).
vcr_embed_last_error(s: ptr) -> ptr {
    if s == null { return vcr_embed_dup("") }
    e = vcr.last_error_h(s)
    if e == "" {
        e = vcr.load_error_h(s)
    }
    return vcr_embed_dup(e)
}

// Additive ABI: consume acknowledges retrieval without deleting the event.
vcr_embed_last_error_ex(s: ptr, consume: int) -> ptr {
    if s == null { return vcr_embed_dup("") }
    e = vcr.last_error_ex_h(s, consume)
    if e == "" { e = vcr.load_error_h(s) }
    return vcr_embed_dup(e)
}
vcr_embed_diagnostics_json(s: ptr, consume: int) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.diagnostics_json_h(s, consume))
}
vcr_embed_assert_no_mismatches(s: ptr) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.assert_no_mismatches_h(s))
}
vcr_embed_test_context(s: ptr, test_name: string, source_file: string, source_line: int) {
    if s == null { return }
    vcr.test_context_h(s, test_name, source_file, source_line)
}

vcr_embed_last_kind(s: ptr) -> int {
    if s == null { return 0 }
    return vcr.last_kind_h(s)
}

vcr_embed_last_index(s: ptr) -> int {
    if s == null { return -1 }
    return vcr.last_index_h(s)
}

vcr_embed_clear_last_error(s: ptr) {
    if s == null { return }
    vcr.clear_last_error_h(s)
}

// ---- mutations / config (handle 1st arg; call BEFORE start) ----

vcr_embed_redact(s: ptr, field: int, pattern: string, replacement: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.redact_h(s, field, pattern, replacement))
}

// Structured redaction: explicit header/body scope; query rules target the URL.
vcr_embed_redact_header(s: ptr, field: int, name: string, replacement: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.redact_header_h(s, field, name, replacement))
}
vcr_embed_redact_query_param(s: ptr, field: int, name: string, replacement: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    if field != vcr.FIELD_PATH { return vcr_embed_dup("query redaction requires the path field") }
    return vcr_embed_dup(vcr.redact_query_param_h(s, name, replacement))
}
vcr_embed_redact_json_field(s: ptr, field: int, name: string, replacement: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.redact_json_field_h(s, field, name, replacement))
}

// Convert a HAR 1.2 capture to a Servirtium markdown tape (no server handle —
// this is a pure file->file transform). Returns "" on success, else an error.
vcr_embed_har_import(har_path: string, tape_path: string) -> ptr {
    return vcr_embed_dup(vcr.har_import(har_path, tape_path))
}

// Convert a Bruno collection's examples into tapes under out_dir (no network,
// no server handle): `servirtium convert bru`. env names an environment
// ("" for none). Returns "" on success, else the error; the summary of what
// was written is out_dir/CONVERSION.md.
vcr_embed_convert_bru(collection_dir: string, out_dir: string, env: string) -> ptr {
    _summary, err = bru_convert.convert_collection(collection_dir, out_dir, env)
    return vcr_embed_dup(err)
}

// Inverse of vcr_embed_har_import: a Servirtium tape -> HAR 1.2 JSON file.
vcr_embed_har_export(tape_path: string, har_path: string) -> ptr {
    return vcr_embed_dup(vcr.har_export(tape_path, har_path))
}

vcr_embed_unredact(s: ptr, field: int, pattern: string, replacement: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.unredact_h(s, field, pattern, replacement))
}

vcr_embed_remove_header(s: ptr, field: int, name: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.remove_header_h(s, field, name))
}

// Volatile values (docs/volatile-values.md). Plain strings throughout; each
// returns "" or the error, caller-owned. Configure after open, before start
// (a later call re-prepares a started playback VCR).
//
// One rule: scope (request path, request headers, response headers,
// headers, request body, response body, body), kind ("template" or
// "regex"), pattern (a template with {{name}} / {{name:regex}}
// placeholders, or a PCRE2 regex whose named groups are placeholders).
vcr_embed_volatile_rule(s: ptr, scope: string, kind: string, pattern: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.volatile_rule_h(s, scope, kind, pattern))
}

// Bind a real value to a placeholder's tokens: "name" binds every token of
// the name that nothing else bound, "name-N" that one token.
vcr_embed_volatile_bind(s: ptr, name_or_token: string, value: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.volatile_bind_h(s, name_or_token, value))
}

// Rules from a profile file (first line "Markers: <style>", then a
// "## Volatile values" block).
vcr_embed_volatile_profile(s: ptr, path: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.volatile_profile_h(s, path))
}

// The marker style: 0 Mustache {{ }} (default), 1 DollarCurly ${ }, 2
// Wikilink [[ ]]. Set it before any rule.
vcr_embed_set_volatile_markers(s: ptr, style: int) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.set_volatile_markers_h(s, style))
}

// The rules, values, current bindings and warnings, one per line
// ("rule: …", "bind: …", "binding: …", "warning: …"). Caller frees.
vcr_embed_volatile_report(s: ptr) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.volatile_report_h(s))
}

// Whole-tape redaction: every match of the regex `pattern`, in every field,
// is written as the constant `replacement` (values the test never sends
// back; values that must correlate are volatile values). Configure before
// start.
vcr_embed_redact_whole_tape(s: ptr, pattern: string, replacement: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.redact_whole_tape_h(s, pattern, replacement))
}

// redact_whole_tape with a description the recording-rules footer shows in
// place of the pattern (a pattern holding a per-run value, a mapped port).
vcr_embed_redact_whole_tape_described(s: ptr, pattern: string, replacement: string, description: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.redact_whole_tape_described_h(s, pattern, replacement, description))
}

// One-call opt-in for the headers stock HTTP clients attach but a tape
// never recorded — User-Agent, Accept, Accept-Encoding, Connection. Each
// is dropped from BOTH the recorded expectation and the live request
// before strict matching. Returns "" on success, else the first error.
vcr_embed_strict_ignore_common_headers(s: ptr) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.strict_ignore_common_headers_h(s))
}

// One-call opt-in for the per-request VOLATILE headers modern clients and
// service meshes inject on EVERY call — distributed-tracing context and
// correlation ids that change run to run and would otherwise make a confusing
// first strict-match failure (field report #6: .NET's HttpClient adds
// traceparent / tracestate / Request-Id). Each is dropped from BOTH the
// recorded expectation and the live request before matching. Distinct from
// strict_ignore_common_headers (User-Agent/Accept/…): that one covers stock
// client identity headers; this covers tracing/correlation. Call both for the
// full default-ignore set. Returns "" on success, else the first error.
vcr_embed_ignore_volatile_headers(s: ptr) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.ignore_volatile_headers_h(s))
}

// Opt-in header presets (see core/vcr.ae "header presets"): each registers
// ordinary rules, listed under the preset's name in the recording-rules
// footer. Each returns "" on success, else an error.
vcr_embed_remove_transport_headers(s: ptr) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.remove_transport_headers_h(s))
}
// vendor: one of "aws", "azure", "cloudflare", "fastly", "gcp".
vcr_embed_remove_cloud_headers(s: ptr, vendor: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.remove_cloud_headers_h(s, vendor))
}
// Record mode: verify an https upstream against this PEM CA file.
vcr_embed_set_upstream_cafile(s: ptr, path: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.set_upstream_cafile_h(s, path))
}
// Record mode: send the upstream the client's Host header (on = 1).
vcr_embed_set_forward_host(s: ptr, on: int) {
    if s == null { return }
    vcr.set_forward_host_h(s, on)
}
vcr_embed_redact_credentials(s: ptr) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.redact_credentials_h(s))
}
vcr_embed_redact_credential_header(s: ptr, name: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.redact_credential_header_h(s, name))
}

vcr_embed_add_license_notice(s: ptr, text: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.add_license_notice_h(s, text))
}

vcr_embed_note(s: ptr, title: string, body: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.note_h(s, title, body))
}

vcr_embed_static_content(s: ptr, mount_path: string, fs_dir: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.static_content_h(s, mount_path, fs_dir))
}

// Mark an incidental path (e.g. "/favicon.ico") as never-on-the-tape:
// the VCR answers it 404 without consuming the playback cursor or, in
// record mode, forwarding/recording it. Configure before start.
vcr_embed_untaped(s: ptr, path: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.untaped_h(s, path))
}

vcr_embed_set_strict_headers(s: ptr, on: int) {
    if s == null { return }
    vcr.set_strict_headers_h(s, on)
}

// Opt-in: write a "## [Recording rules]" footer after the last interaction,
// listing what the test left out or rewrote (removed headers, redactions,
// volatile values) and where. Playback does not read it.
vcr_embed_set_rules_footer(s: ptr, on: int) {
    if s == null { return }
    vcr.set_rules_footer_h(s, on)
}

// Opt-in: match request bodies by semantic JSON equality (key order /
// whitespace ignored) instead of byte-for-byte. Off by default; non-JSON
// bodies always fall back to the byte-exact comparison.
vcr_embed_set_match_json_body(s: ptr, on: int) {
    if s == null { return }
    vcr.set_match_json_body_h(s, on)
}

// Opt-in: match request bodies by semantic XML equality (attribute order and
// insignificant whitespace ignored; element order significant) instead of
// byte-for-byte. Off by default; non-XML bodies always fall back to the
// byte-exact comparison. The twin of set_match_json_body for SOAP/XML APIs.
vcr_embed_set_match_xml_body(s: ptr, on: int) {
    if s == null { return }
    vcr.set_match_xml_body_h(s, on)
}

// Opt-in pretty XML (docs/pretty-xml.md): recording indents XML request
// and response bodies; playback compares XML requests in canonical form.
// indent 0 = off (default), 1..16 = spaces per level (>16 clamps to 16).
vcr_embed_set_pretty_xml(s: ptr, indent: int) {
    if s == null { return }
    vcr.set_pretty_xml_h(s, indent)
}
vcr_embed_get_pretty_xml(s: ptr) -> int {
    if s == null { return 0 }
    return vcr.get_pretty_xml_h(s)
}

// Opt-in (record side): pretty-print recorded JSON RESPONSE bodies when the
// tape is written, keeping key order and number spellings. indent 0 = off
// (default), 1..16 = spaces per level (>16 clamps to 16). Request bodies are
// never changed.
vcr_embed_set_pretty_json(s: ptr, indent: int) {
    if s == null { return }
    vcr.set_pretty_json_h(s, indent)
}
vcr_embed_get_pretty_json(s: ptr) -> int {
    if s == null { return 0 }
    return vcr.get_pretty_json_h(s)
}

// Opt-in stable order (record side; see "Stable order" in core/vcr.ae and
// AGENTS.md). All off by default; the tape is byte-exact without them.
// JSON object keys sorted at every depth in recorded JSON response bodies.
vcr_embed_set_sort_json_keys(s: ptr, on: int) {
    if s == null { return }
    vcr.sort_json_keys_h(s, on)
}
vcr_embed_get_sort_json_keys(s: ptr) -> int {
    if s == null { return 0 }
    return vcr.get_sort_json_keys_h(s)
}

// The JSON response arrays `path` selects (JSON pointer from the root, "*"
// for any one segment, "" the root array; or a bare member name: every array
// that member holds) sorted by member `by` (a name or a JSON pointer inside
// each element, or several comma-separated, the next breaking the first's
// ties; "" sorts by each element's canonical JSON). Replay serves
// the sorted order. Returns "" on success or the reason the
// rule was refused (caller frees).
vcr_embed_sort_json_array(s: ptr, path: string, by: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.sort_json_array_h(s, path, by))
}

// The same, only for interactions whose request path (query included, as
// sent) matches the regex `request` (one endpoint's list). Returns "" or the
// reason the rule was refused (caller frees).
vcr_embed_sort_json_array_at(s: ptr, request: string, path: string, by: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.sort_json_array_at_h(s, request, path, by))
}

// Response header lines sorted by name (case-insensitive); a repeated
// header's lines keep their order.
vcr_embed_set_sort_response_headers(s: ptr, on: int) {
    if s == null { return }
    vcr.sort_response_headers_h(s, on)
}
vcr_embed_get_sort_response_headers(s: ptr) -> int {
    if s == null { return 0 }
    return vcr.get_sort_response_headers_h(s)
}

// One response header's comma-separated items sorted ("Allow"). Returns ""
// or the reason the name was refused (caller frees).
vcr_embed_sort_header_value(s: ptr, name: string) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.sort_header_value_h(s, name))
}

// Every stable-order rule off.
vcr_embed_clear_stable_order(s: ptr) {
    if s == null { return }
    vcr.clear_stable_order_h(s)
}

// Opt-in: match playback by searching all interactions (reusable, order-
// independent) instead of consuming them in strict recorded order. Off by
// default (strict ordered playback).
vcr_embed_set_match_multiple(s: ptr, on: int) {
    if s == null { return }
    vcr.set_match_multiple_h(s, on)
}

// Playback range (opt-in): replay only interactions `from`..`to` (inclusive,
// the tape's `## Interaction N` numbers; `to` < 0 = through the last one).
// Set after open, before start. The cursor starts at `from`; interactions
// outside the range are never served (a request that fits only one of them
// fails, and the diagnostics name it); assert_all_consumed counts the range.
// Playback only: a record handle refuses it. Returns "" or the reason it
// was refused (caller frees).
vcr_embed_set_playback_range(s: ptr, from: int, to: int) -> ptr {
    if s == null { return vcr_embed_dup("") }
    return vcr_embed_dup(vcr.set_playback_range_h(s, from, to))
}
vcr_embed_clear_playback_range(s: ptr) {
    if s == null { return }
    vcr.clear_playback_range_h(s)
}
// The range in force: first and last interaction, or -1 when none is set.
vcr_embed_get_playback_range_from(s: ptr) -> int {
    if s == null { return 0 }
    return vcr.playback_range_from_h(s)
}
vcr_embed_get_playback_range_to(s: ptr) -> int {
    if s == null { return 0 }
    return vcr.playback_range_to_h(s)
}

// ByHeader: require a specific named request header's live value to equal the
// recorded interaction's value during playback matching (opt-in, additive to
// any other rules). Call once per header name; clear resets the set.
vcr_embed_match_header(s: ptr, name: string) {
    if s == null { return }
    vcr.add_match_header_h(s, name)
}
vcr_embed_clear_match_headers(s: ptr) {
    if s == null { return }
    vcr.clear_match_headers_h(s)
}

vcr_embed_indent_code_blocks(s: ptr) {
    if s == null { return }
    vcr.indent_code_blocks_h(s)
}

vcr_embed_emphasize_http_verbs(s: ptr) {
    if s == null { return }
    vcr.emphasize_http_verbs_h(s)
}

vcr_embed_clear_redactions(s: ptr) {
    if s == null { return }
    vcr.clear_redactions_h(s)
}

vcr_embed_clear_unredactions(s: ptr) {
    if s == null { return }
    vcr.clear_unredactions_h(s)
}

vcr_embed_clear_header_removals(s: ptr) {
    if s == null { return }
    vcr.clear_header_removals_h(s)
}

vcr_embed_clear_static_content(s: ptr) {
    if s == null { return }
    vcr.clear_static_content_h(s)
}

vcr_embed_clear_untaped(s: ptr) {
    if s == null { return }
    vcr.clear_untaped_h(s)
}

vcr_embed_clear_format_options(s: ptr) {
    if s == null { return }
    vcr.clear_format_options_h(s)
}

// ---- string ownership ----

// Free any char* returned by a vcr_embed_* function above.
vcr_embed_free_string(s: ptr) {
    if s == null { return }
    vcr_embed_free(s)
}

// Staged secret callbacks: the host invokes its callback between these calls.
vcr_embed_secret_begin(s: ptr, resolving: int) -> ptr { if s == null { return vcr_embed_dup("") }; return vcr_embed_dup(vcr.secret_begin_h(s, resolving)) }
vcr_embed_secret_next(s: ptr) -> int { if s == null { return 0 }; return vcr.secret_next_h(s) }
vcr_embed_secret_get(s: ptr, part: int) -> ptr { if s == null { return vcr_embed_dup("") }; return vcr_embed_dup(vcr.secret_get_h(s, part)) }
vcr_embed_secret_interaction(s: ptr) -> int { if s == null { return 0 }; return vcr.secret_interaction_h(s) }
vcr_embed_secret_apply(s: ptr, value: string) -> ptr { if s == null { return vcr_embed_dup("") }; return vcr_embed_dup(vcr.secret_apply_h(s, value)) }
vcr_embed_secret_finish(s: ptr) -> ptr { if s == null { return vcr_embed_dup("") }; return vcr_embed_dup(vcr.secret_finish_h(s)) }
vcr_embed_secret_abort(s: ptr) { if s == null { return }; vcr.secret_abort_h(s) }
