// Release-only producer for the eight portable NuGet RIDs, copied from THIS
// tag's release/dist and laid out under the canonical runtimes/<rid>/native/
// filenames a multi-RID nupkg expects. FreeBSD is omitted: it has no standard
// NuGet RID. Used only by the official tag workflow (dotnet/Servirtium.Vcr's
// release pack deps this via --overrideDep and stages each as a native_runtime).
//
// Modelled on selenium_core/.releaseNugetMatrix.ae; adapted to libservirtium_vcr
// + SERVIRTIUM_VCR_VERSION. svcr's musl assets are named ...-linux-<arch>-musl.so
// (same convention selenium uses), so the source paths line up.
import bldr
import std.fs
import std.string

aeb(cap) {
    bldr.build() {
        srcdir = bldr.source_dir(builder_context())
        root = string.concat(srcdir, "/..")
        tag_text, read_err = fs.read(string.concat(root, "/SERVIRTIUM_VCR_VERSION"))
        if string.length(read_err) > 0 {
            bldr.fail(builder_context(), "cannot read SERVIRTIUM_VCR_VERSION")
        }
        tag = string.trim(tag_text)
        target = bldr.target_dir(builder_context())
        libdir = string.concat(target, "/lib")
        _d1 = fs.mkdir_p(string.concat(libdir, "/linux-x64"))
        _d2 = fs.mkdir_p(string.concat(libdir, "/linux-arm64"))
        _d3 = fs.mkdir_p(string.concat(libdir, "/linux-musl-x64"))
        _d4 = fs.mkdir_p(string.concat(libdir, "/linux-musl-arm64"))
        _d5 = fs.mkdir_p(string.concat(libdir, "/osx-x64"))
        _d6 = fs.mkdir_p(string.concat(libdir, "/osx-arm64"))
        _d7 = fs.mkdir_p(string.concat(libdir, "/win-x64"))
        _d8 = fs.mkdir_p(string.concat(libdir, "/win-arm64"))

        p1 = string.concat(root, string.concat("/release/dist/libservirtium_vcr-", string.concat(tag, "-linux-x86_64.so")))
        p2 = string.concat(root, string.concat("/release/dist/libservirtium_vcr-", string.concat(tag, "-linux-arm64.so")))
        p3 = string.concat(root, string.concat("/release/dist/libservirtium_vcr-", string.concat(tag, "-linux-x86_64-musl.so")))
        p4 = string.concat(root, string.concat("/release/dist/libservirtium_vcr-", string.concat(tag, "-linux-arm64-musl.so")))
        p5 = string.concat(root, string.concat("/release/dist/libservirtium_vcr-", string.concat(tag, "-macos-x86_64.dylib")))
        p6 = string.concat(root, string.concat("/release/dist/libservirtium_vcr-", string.concat(tag, "-macos-arm64.dylib")))
        p7 = string.concat(root, string.concat("/release/dist/libservirtium_vcr-", string.concat(tag, "-windows-x86_64.dll")))
        p8 = string.concat(root, string.concat("/release/dist/libservirtium_vcr-", string.concat(tag, "-windows-arm64.dll")))
        if fs.exists(p1) == 0 { bldr.fail(builder_context(), string.concat("release NuGet library missing: ", p1)) }
        if fs.exists(p2) == 0 { bldr.fail(builder_context(), string.concat("release NuGet library missing: ", p2)) }
        if fs.exists(p3) == 0 { bldr.fail(builder_context(), string.concat("release NuGet library missing: ", p3)) }
        if fs.exists(p4) == 0 { bldr.fail(builder_context(), string.concat("release NuGet library missing: ", p4)) }
        if fs.exists(p5) == 0 { bldr.fail(builder_context(), string.concat("release NuGet library missing: ", p5)) }
        if fs.exists(p6) == 0 { bldr.fail(builder_context(), string.concat("release NuGet library missing: ", p6)) }
        if fs.exists(p7) == 0 { bldr.fail(builder_context(), string.concat("release NuGet library missing: ", p7)) }
        if fs.exists(p8) == 0 { bldr.fail(builder_context(), string.concat("release NuGet library missing: ", p8)) }

        o1 = string.concat(libdir, "/linux-x64/libservirtium_vcr.so")
        o2 = string.concat(libdir, "/linux-arm64/libservirtium_vcr.so")
        o3 = string.concat(libdir, "/linux-musl-x64/libservirtium_vcr.so")
        o4 = string.concat(libdir, "/linux-musl-arm64/libservirtium_vcr.so")
        o5 = string.concat(libdir, "/osx-x64/libservirtium_vcr.dylib")
        o6 = string.concat(libdir, "/osx-arm64/libservirtium_vcr.dylib")
        o7 = string.concat(libdir, "/win-x64/servirtium_vcr.dll")
        o8 = string.concat(libdir, "/win-arm64/servirtium_vcr.dll")
        _c1 = fs.copy(p1, o1)
        _c2 = fs.copy(p2, o2)
        _c3 = fs.copy(p3, o3)
        _c4 = fs.copy(p4, o4)
        _c5 = fs.copy(p5, o5)
        _c6 = fs.copy(p6, o6)
        _c7 = fs.copy(p7, o7)
        _c8 = fs.copy(p8, o8)

        publish_artifact("linux_x64", o1)
        publish_artifact("linux_arm64", o2)
        publish_artifact("linux_musl_x64", o3)
        publish_artifact("linux_musl_arm64", o4)
        publish_artifact("osx_x64", o5)
        publish_artifact("osx_arm64", o6)
        publish_artifact("win_x64", o7)
        publish_artifact("win_arm64", o8)
        publish_artifact("shared_lib", o1)
    }
}
