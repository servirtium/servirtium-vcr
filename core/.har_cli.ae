// Build the standalone `servirtium-har` CLI (core/har_cli.ae) — a thin argv
// shim over vcr.har_import / vcr.har_export. It statically links the pure-Aether
// `vcr` module (no .so, no SERVIRTIUM_VCR_LIB), so it's a self-contained binary.
//
//   servirtium-har import <in.har> <out.md>    HAR capture   -> Servirtium tape
//   servirtium-har export <in.md>  <out.har>   Servirtium tape -> HAR capture
//
// Output: target/servirtium-har

import build
import std.os

aeb(cap) {
    b = build.start()
    root = build._get(b, "root")
    dest = "${root}/target"
    _m = os.system("mkdir -p \"${dest}\"")
    rc = os.system("cd \"${root}\" && ae build core/har_cli.ae -o \"${dest}/servirtium-har\"")
    if rc != 0 {
        println("servirtium-har: build failed")
        return 1
    }
    println("servirtium-har: built target/servirtium-har")
    return 0
}
