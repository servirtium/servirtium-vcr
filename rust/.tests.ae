// Rust binding tests. libloading loads the shared engine via SERVIRTIUM_VCR_LIB
// (tests serialized by the crate's internal global Mutex).
import bldr
import rust
import bldr (env)
aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        rust.cargo_test_existing() { env("SERVIRTIUM_VCR_LIB", lib) }
    }
}
