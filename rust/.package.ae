// Third-party-consumer PACKAGE stage for the Rust binding.
//
// Rust consumes `servirtium` as a Cargo dependency (source-consumed like a
// crates.io crate). The binding loads its .so at runtime via libloading, from
// env!("CARGO_MANIFEST_DIR")/native — which, for a dependent crate, resolves to
// the servirtium crate's OWN dir. So "packaging" stages the freshly-built
// engine .so into rust/native/, where a consumer's build of the crate finds it.
// Deps core/.build.ae; publishes the rust crate dir on "crate_dir".
import bldr
import copy
import copy (from, to)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")

        // copy.file auto-creates the dest parent; `to` resolves against this
        // leaf's source_dir (rust/), so no ${root}/rust hardcode.
        copy.file() {
            from(lib)
            to("native/libservirtium_vcr.so")
        }

        publish_artifact("crate_dir", "${_get("root")}/rust")
        println("rust package: staged engine .so into rust/native/ (Cargo crate ready)")
        return 0
    }
}
