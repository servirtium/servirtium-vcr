// The C++ client's test binary: compiles test/playback_test.cpp (C++17,
// header-only over cpp/include/servirtium.hpp) and links (1) the C client's
// object from c/.objects.ae — compiled AS C so its `extern "C"` symbols aren't
// C++-mangled — via cpp's dep-object collection, and (2) the engine .so by
// absolute artifact path with an rpath. Publishes the binary on the
// program_binary edge for cpp/.tests.ae to run.
//
// The C++ client is a header-only RAII wrapper over the C client, which is
// itself the ergonomic layer over the engine's flat C ABI: no second FFI, no
// second .so. Skipped by preflight when a C++ compiler is absent (prereq gcc —
// g++ ships with it).
import bldr
import cpp
import cpp (source, include, std, link_flag, output)
aeb(cap) {
    bldr.build() {
        prereq("gcc")
        dep("core/.build.ae")
        dep("c/.objects.ae")
        // Engine .so by ABSOLUTE artifact path + rpath its dir (the compile
        // runs from the module dir; an absolute path is layout-robust).
        lib = dep_artifact("core/.build.ae", "shared_lib")
        libdir = bldr._dirname(lib)
        cpp.program() {
            std("c++17")
            source("test/playback_test.cpp")
            include("include")
            include("../c/include")
            link_flag(lib)
            link_flag("-Wl,-rpath,${libdir}")
            output("servirtium_cpp_test")
        }
    }
}
