// Janet binding tests, on aeb's Janet SDK (lib/janet, aeb v0.343+). It deps
// libservirtium_vcr and the shared test tools, then runs the suite with `janet`.
//
// Janet's built-in FFI (`ffi/native`, since 1.23) calls libservirtium_vcr's flat
// C ABI (aether_vcr_embed_*) directly: no C extension, no compiler, nothing to
// stage. The library is located via SERVIRTIUM_VCR_LIB, injected here from
// libservirtium_vcr's shared_lib artifact. test/run_all.janet runs playback +
// record (record, redaction, secrets, drift, HAR) in fresh processes; the HTTP
// client is Janet's own net/*, the record upstream a compiled Aether server.
//
// Needs `janet` >= 1.23 on PATH (bootstrap.sh skips this leaf when it is
// absent; the SDK fails the node with an install hint if it is missing).
import bldr
import janet
import bldr (env)
aeb(cap) {
    bldr.build() {
        dep("core_tests/.fixtures.ae")
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        janet.test() {
            env("SERVIRTIUM_VCR_LIB", lib)
            script("test/run_all.janet")
        }
    }
}
