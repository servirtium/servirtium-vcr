{
    "name": "servirtium",
    "version": "2.0.0",
    "description": "Record/replay for HTTP service tests in the Servirtium markdown tape format \u2014 a thin D binding over libservirtium_vcr.",
    "authors": [
        "Paul Hammant"
    ],
    "license": "MIT",
    "targetType": "library",
    "importPaths": [
        "src"
    ],
    "sourcePaths": [
        "src"
    ],
    "lflags": [
        "-L$PACKAGE_DIR/native",
        "-lservirtium_vcr",
        "-rpath",
        "$PACKAGE_DIR/native"
    ]
}
