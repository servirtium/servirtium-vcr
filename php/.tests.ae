// PHP binding tests. FFI loads the shared engine via SERVIRTIUM_VCR_LIB.
import build
import php
import build (env)
import php (phpunit_phar_url, config)
aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    lib = build.dep_artifact(b, "core/.build.ae", "shared_lib")
    php.test(b) {
        env("SERVIRTIUM_VCR_LIB", lib)
        phpunit_phar_url("https://phar.phpunit.de/phpunit-11.phar")
        config("phpunit.xml")
    }
}
