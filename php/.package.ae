// Third-party-consumer PACKAGE stage for the PHP binding.
//
// PHP/Composer packages are source-consumed (no built artifact like a wheel):
// a consumer adds this as a `path` repository and Composer copies it into
// vendor/. So "packaging" here is just staging the freshly-built engine .so
// into php/native/ (where the loader's bundled fallback looks, and which
// Composer carries along in the copy). Deps core/.build.ae; publishes the php
// package dir on the "package_dir" edge for php/.example.ae.
import bldr
import copy
import copy (from, to)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")

        // copy.file auto-creates the dest parent; `to` resolves against this
        // leaf's source_dir (php/), so no ${root}/php hardcode.
        copy.file() {
            from(lib)
            to("native/libservirtium_vcr.so")
        }

        publish_artifact("package_dir", "${_get("root")}/php")
        println("php package: staged engine .so into php/native/ (Composer path package ready)")
        return 0
    }
}
