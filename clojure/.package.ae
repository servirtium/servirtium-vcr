// Third-party-consumer PACKAGE stage for the Clojure binding.
// mvn-installs the Clojure layer (servirtium-vcr-clojure — a jar carrying
// servirtium.clj on the classpath) to ~/.m2; deps java/.package.ae so the Java
// jar (with the bundled engine .so) is present and rides along transitively for
// a deps.edn consumer.
import bldr
import maven

aeb(cap) {
    bldr.build() {
        dep("java/.package.ae")

        // maven.install runs `mvn -q -DskipTests install` in this leaf's
        // module_dir (clojure/) — no ${root}/clojure hardcode.
        maven.install()

        publish_artifact("maven_gav", "com.paulhammant.servirtium:servirtium-vcr-clojure:2.0.0-SNAPSHOT")
        println("clojure package: installed servirtium-vcr-clojure jar to ~/.m2")
        return 0
    }
}
