// Third-party-consumer EXAMPLE test for the Clojure binding. A deps.edn project
// depending only on the installed servirtium-vcr-clojure jar (~/.m2); replays
// the canonical tape via `servirtium/playback`. The engine .so is transitive
// from the servirtium-vcr jar resource; no SERVIRTIUM_VCR_LIB. Clojure needs the
// FFM flag passed to its JVM (-J--enable-native-access).
import bldr
import std.os

aeb(cap) {
    bldr.build() {
        dep("clojure/.package.ae")
        _gav = dep_artifact("clojure/.package.ae", "maven_gav")
        root = _get("root")
        exdir = "${root}/clojure/example"
    
        rc = os.system("cd \"${exdir}\" && env -u SERVIRTIUM_VCR_LIB clojure -J--enable-native-access=ALL-UNNAMED -M -m consumer-example")
        if rc != 0 {
            println("clojure example: consumer run against the installed clojure jar failed")
            return 1
        }
        println("clojure example: PASS — installed Clojure jar replayed the canonical tape (discovery)")
        return 0
    }
}
