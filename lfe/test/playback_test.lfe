;;;; playback_test.lfe — smoke test for the LFE Servirtium binding.
;;;;
;;;; Mirrors the Erlang twin (erlang/test/playback.escript) fact-for-fact:
;;;; start a playback VCR over the one-interaction canonical tape
;;;; (GET /ok -> 200 text/plain "ok-body"), drive it with curl, and assert the
;;;; body plus a clean match ('ok). Proves the LFE binding drives the ONE
;;;; Erlang NIF (servirtium_nif) — no second FFI, no second .so.
;;;;
;;;; A plain `(main args)` conformance runner (no test framework), run via
;;;; `lfe -eval`. The NIF .so resolves via ERL_LIBS (the erlang/.build.ae app)
;;;; the standard OTP way (code:priv_dir). Run from lfe/ so tapes/ resolves.
(defmodule playback_test
  (export (main 1)))

(defun main (_args)
  (volatile-values)
  (open-failure-and-lifecycle)
  (named-secrets)
  (stable-order)
  (playback-range)

  (let* ((directory (++ "/tmp/vcr-helpers-lfe-" (os:getpid)))
         (fixture "../target/test-tools/redaction_fixture "))
    (file:make_dir directory)
    (let* ((upstream (string:trim (os:cmd (++ fixture "start '" directory "'"))))
           (rec (servirtium_lfe:record (++ directory "/tape.md") upstream)))
      (try
        (progn
          (require-ok (servirtium_lfe:redact_header rec "Authorization"))
          (require-ok (servirtium_lfe:redact_query_param rec "password"))
          (require-ok (servirtium_lfe:redact_json_field rec "secretKey"))
          (let ((out (os:cmd (++ fixture "drive '" directory "' '" (servirtium_lfe:base_url rec) "' && echo DRIVE_OK"))))
            (case (string:find out "DRIVE_OK") ('nomatch (erlang:error (tuple 'redaction_fixture out))) (_ 'ok))) )
        (after (servirtium_lfe:close rec))))
    (let ((out (os:cmd (++ fixture "check '" directory "' && echo CHECK_OK"))))
      (case (string:find out "CHECK_OK")
        ('nomatch (erlang:error (tuple 'redaction_fixture out)))
        (_ 'ok)))
    (let (((tuple 'ok files) (file:list_dir directory)))
      (lists:foreach (lambda (name) (file:delete (++ directory "/" name))) files))
    (file:del_dir directory))

  (let ((server (servirtium_lfe:playback "../core_tests/diagnostics/playback.md")))
    (servirtium_lfe:test_context server "LFE scenario" "scenario.test" 123)
    (let ((out (os:cmd (++ "../target/test-tools/diagnostic_fixture '" (servirtium_lfe:base_url server) "' && echo DRIVER_OK"))))
      (require-found out "DRIVER_OK"))
    (require-found (servirtium_lfe:last_error server 'false) "owner")
    (require-found (servirtium_lfe:last_error server 'false) "scenario.test:123")
    (case (string:find (servirtium_lfe:diagnostics_json server 'false) "\"retrieved\":1")
      ('nomatch 'ok)
      (_ (erlang:error 'observer_consumed)))
    (require-found (servirtium_lfe:last_error server) "owner")
    (require-found (servirtium_lfe:diagnostics_json server 'false) "\"retrieved\":0")
    (case (catch (servirtium_lfe:assert_no_mismatches server))
      ((tuple 'EXIT _) 'ok)
      (_ (erlang:error 'expected_mismatch)))
    (servirtium_lfe:test_context server "next test" "" 0)
    (require-ok (servirtium_lfe:assert_no_mismatches server))
    (case (servirtium_lfe:diagnostics_json server 'false)
      ("[]" 'ok)
      (_ (erlang:error 'expected_empty_events)))
    (servirtium_lfe:close server))
  (let* ((tape "tapes/single_get.md")
         (vcr (servirtium_lfe:playback tape))
         (url (servirtium_lfe:base_url vcr)))
    (io:format "base_url = ~s~n" (list url))
    (let* ((body (string:trim (os:cmd (++ "curl -s " url "/ok")) 'trailing "\n"))
           (kind (servirtium_lfe:last_kind vcr))
           (len (servirtium_lfe:tape_length vcr)))
      (io:format "body = ~p, last_kind = ~p, tape_length = ~p~n"
                 (list body kind len))
      ;; close BEFORE asserting, so a failed assertion never leaks the server;
      ;; its return value is itself one of the facts under test.
      (let* ((closed (servirtium_lfe:close vcr))
             (fails (+ (ck "body is ok-body" (=:= body "ok-body"))
                       (ck "last_kind is ok" (=:= kind 'ok))
                       (ck "tape_length is 1" (=:= len 1))
                       (ck "close returns ok" (=:= closed 'ok)))))
        (if (=:= fails 0)
            (progn (io:format "PASS: lfe servirtium playback~n") (halt 0))
            (progn (io:format "FAILED: ~p lfe test(s)~n" (list fails)) (halt 1)))))))

;; A missing tape surfaces its reason via open_error; open/start/close 50 times,
;; and a second close is harmless.
(defun open-failure-and-lifecycle ()
  (case (catch (servirtium_lfe:playback "tapes/definitely_missing.md"))
    ((tuple 'EXIT (tuple (tuple 'servirtium (tuple 'playback_open_failed _ why)) _))
     (require-found why "definitely_missing"))
    (other (erlang:error (tuple 'expected_open_failure other))))
  (lists:foreach
   (lambda (_)
     (let ((vcr (servirtium_lfe:playback "tapes/single_get.md")))
       (case (> (servirtium_lfe:port vcr) 0)
         ('true 'ok)
         (_ (erlang:error 'no_port)))
       (require-ok (servirtium_lfe:close vcr))
       (require-ok (servirtium_lfe:close vcr))))
   (lists:seq 1 50)))

;; return 0 on pass, 1 on fail (summed in main — no mutable state).
(defun ck (label cond)
  (if cond
      (progn (io:format "  ok: ~s~n" (list label)) 0)
      (progn (io:format "FAIL: ~s~n" (list label)) 1)))

(defun require-ok (value)
  (case value
    ('ok 'ok)
    (err (erlang:error (tuple 'redaction_config err)))))

(defun require-found (text needle)
  (case (string:find text needle)
    ('nomatch (erlang:error (tuple 'missing needle text)))
    (_ 'ok)))

(defun secret-run (action arg)
  (let* ((out (os:cmd (++ "../target/test-tools/secret_fixture " action " '" arg "' 2>&1 && echo SECRET_OK"))))
    (require-found out "SECRET_OK")
    (string:trim (string:replace out "SECRET_OK" "" 'all))))
(defun named-secrets ()
  (let* ((dir (++ "/tmp/vcr-secrets-lfe-" (os:getpid)))
         (tape (++ dir "/tape.md"))
         (upstream (secret-run "start" dir))
         (rec (servirtium_lfe:secret_redactor (servirtium_lfe:record tape upstream)
           (lambda (key request)
             (if (=:= key #"password")
               (let* ((parts (binary:split (maps:get 'path request) #"/" '(global)))
                      (service (lists:nth 2 parts)))
                 (iolist_to_binary (list (string:uppercase service) #"_PASSWORD")))
               'undefined)))))
    (secret-run "drive" (servirtium_lfe:base_url rec))
    (require-ok (servirtium_lfe:close rec))
    (secret-run "check" tape)
    (let ((replay (servirtium_lfe:playback_with_secrets tape
          (lambda (token)
            (let* ((parts (binary:split token #"_PASSWORD"))
                   (service (car parts)))
              (iolist_to_binary (list #"pw-" (string:lowercase service) #"&secret")))))))
      (secret-run "drive" (servirtium_lfe:base_url replay))
      (require-ok (servirtium_lfe:assert_no_mismatches replay))
      (require-ok (servirtium_lfe:close replay)))
    (secret-run "check" tape)
    (let (((tuple 'ok files) (file:list_dir dir)))
      (lists:foreach (lambda (name) (file:delete (++ dir "/" name))) files))
    (file:del_dir dir)))

;; A gen_tcp upstream answering every request with a JSON body.
(defun json-upstream (body)
  (let* (((tuple 'ok listen) (gen_tcp:listen 0 (list 'binary (tuple 'active 'false)
                                                     (tuple 'reuseaddr 'true) (tuple 'packet 'raw))))
         ((tuple 'ok port) (inet:port listen))
         (pid (spawn (lambda () (json-loop listen body)))))
    (tuple pid listen (++ "http://127.0.0.1:" (integer_to_list port)))))

(defun json-loop (listen body)
  (case (gen_tcp:accept listen)
    ((tuple 'ok sock)
     (gen_tcp:recv sock 0 2000)
     (gen_tcp:send sock (list "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: "
                              (integer_to_list (byte_size body))
                              "\r\nConnection: close\r\n\r\n" body))
     (gen_tcp:close sock)
     (json-loop listen body))
    (_ 'ok)))

;; Record one request through the VCR (CONFIGURE sets options first) and
;; return what close/1 returned.
(defun record-json (tape configure)
  (let (((tuple pid listen upstream)
         (json-upstream #"{\"b\":1,\"a\":{\"z\":2,\"y\":3}}")))
    (let ((rec (servirtium_lfe:record tape upstream)))
      (try
        (progn
          (funcall configure rec)
          (os:cmd (++ "curl -s " (servirtium_lfe:base_url rec) "/data"))
          (servirtium_lfe:close rec))
        (after (progn (exit pid 'kill) (gen_tcp:close listen)))))))

;; Stable ordering: (a) sort_json_keys + pretty_json writes sorted, pretty
;; JSON; (b) sort_json_keys without pretty_json is refused at write time.
(defun stable-order ()
  (let ((dir (++ "/tmp/vcr-stable-lfe-" (os:getpid))))
    (file:make_dir dir)
    (let ((sorted (++ dir "/sorted.md")))
      (require-ok (record-json sorted
                    (lambda (r)
                      (require-ok (servirtium_lfe:set_sort_json_keys r 'true))
                      (case (servirtium_lfe:get_sort_json_keys r)
                        ('true 'ok)
                        (_ (erlang:error 'sort_json_keys_not_set)))
                      (servirtium_lfe:set_pretty_json r 2))))
      (let (((tuple 'ok bin) (file:read_file sorted)))
        (require-found (binary_to_list bin)
                       "\"a\": {\n    \"y\": 3,\n    \"z\": 2\n  },\n  \"b\": 1")))
    (case (record-json (++ dir "/refused.md")
            (lambda (r) (servirtium_lfe:set_sort_json_keys r 'true)))
      ((tuple 'error msg) (require-found msg "sort_json_keys needs pretty_json"))
      (other (erlang:error (tuple 'expected_refusal other))))
    (let ((probe (servirtium_lfe:record (++ dir "/probe.md") "http://127.0.0.1:1")))
      (case (catch (servirtium_lfe:sort_header_value probe ""))
        ((tuple 'EXIT _) 'ok)
        (_ (erlang:error 'expected_header_refusal)))
      (servirtium_lfe:set_sort_response_headers probe 'true)
      (servirtium_lfe:clear_stable_order probe)
      (case (servirtium_lfe:get_sort_response_headers probe)
        ('false 'ok)
        (_ (erlang:error 'stable_order_not_cleared)))
      (servirtium_lfe:close probe))
    (let (((tuple 'ok files) (file:list_dir dir)))
      (lists:foreach (lambda (name) (file:delete (++ dir "/" name))) files))
    (file:del_dir dir)))

;; Playback range: skip the first interaction, serve a later one; a record
;; server refuses a range.
(defun playback-range ()
  (let ((vcr (servirtium_lfe:playback "tapes/range.md")))
    (case (servirtium_lfe:get_playback_range_from vcr) (-1 'ok) (_ (erlang:error 'range_preset)))
    (require-ok (servirtium_lfe:set_playback_range vcr 1 -1))
    (case (tuple (servirtium_lfe:get_playback_range_from vcr)
                 (servirtium_lfe:get_playback_range_to vcr))
      ((tuple 1 2) 'ok)
      (other (erlang:error (tuple 'range_not_set other))))
    (let ((body (string:trim (os:cmd (++ "curl -s " (servirtium_lfe:base_url vcr) "/step/second"))
                             'trailing "\n")))
      (case body ("second-body" 'ok) (_ (erlang:error (tuple 'range_body body)))))
    (case (servirtium_lfe:last_index vcr) (1 'ok) (idx (erlang:error (tuple 'range_index idx))))
    (case (catch (servirtium_lfe:set_playback_range vcr 9 -1))
      ((tuple 'EXIT _) 'ok)
      (_ (erlang:error 'expected_range_refusal)))
    (servirtium_lfe:clear_playback_range vcr)
    (servirtium_lfe:close vcr))
  (let ((rec (servirtium_lfe:record (++ "/tmp/vcr-range-refused-lfe-" (os:getpid) ".md")
                                    "http://127.0.0.1:1")))
    (case (catch (servirtium_lfe:set_playback_range rec 0 -1))
      ((tuple 'EXIT _) 'ok)
      (_ (erlang:error 'expected_record_range_refusal)))
    (servirtium_lfe:close rec)))

;; Volatile values (docs/volatile-values.md), conformance checks 1-7.
(defun volatile-driver (mode vcr)
  (let ((out (os:cmd (++ "../target/test-tools/volatile_fixture " mode " '"
                         (servirtium_lfe:base_url vcr) "' 2>&1; echo RC:$?"))))
    (case (string:find out "RC:0")
      ('nomatch (erlang:error (tuple 'driver_failed mode out)))
      (_ 'ok))))

;; The core's message from a start that must fail.
(defun volatile-start-error (tape options)
  (case (catch (servirtium_lfe:playback_with tape options))
    ((tuple 'EXIT (tuple (tuple 'servirtium reason) _))
     (element (tuple_size reason) reason))
    (other (erlang:error (tuple 'expected_start_failure other)))))

(defun volatile-values ()
  (let ((tapes "../core_tests/volatile/"))
    ;; 1: rules in the tape only
    (let ((s1 (servirtium_lfe:playback_with (++ tapes "wcf.md") (list (tuple 'pretty_xml 2)))))
      (volatile-driver "wcf" s1)
      (require-found (servirtium_lfe:volatile_report s1) "binding: {{messageId-1}} = ")
      (require-ok (servirtium_lfe:close s1)))
    ;; 2: a profile file
    (let ((s2 (servirtium_lfe:playback_with (++ tapes "wcf_plain.md")
                (list (tuple 'pretty_xml 2)
                      (tuple 'volatile_profile (filename:absname (++ tapes "profile.md")))))))
      (volatile-driver "wcf" s2)
      (require-ok (servirtium_lfe:close s2)))
    ;; 3: rules in code
    (let ((s3 (servirtium_lfe:playback_with (++ tapes "wcf_plain.md")
                (list (tuple 'pretty_xml 2)
                      (tuple 'volatile_rule "request body" "<a:MessageID>urn:uuid:{{messageId}}</a:MessageID>")
                      (tuple 'volatile_rule "request body" "<a:To s:mustUnderstand=\"1\">{{endpoint}}/Services/")
                      (tuple 'volatile_rule "request body" "&lt;SubmissionDate&gt;{{submitted}}&lt;/SubmissionDate&gt;")
                      (tuple 'volatile_rule "response body" "<a:RelatesTo>urn:uuid:{{messageId}}</a:RelatesTo>")))))
      (volatile-driver "wcf" s3)
      (require-ok (servirtium_lfe:close s3)))
    ;; 4: markers
    (let ((s4 (servirtium_lfe:playback_with (++ tapes "wcf_dollar.md")
                (list (tuple 'pretty_xml 2) (tuple 'volatile_markers 'dollar_curly)))))
      (volatile-driver "wcf" s4)
      (require-ok (servirtium_lfe:close s4)))
    (require-found (volatile-start-error (++ tapes "wcf_dollar.md") (list (tuple 'pretty_xml 2)))
                   "DollarCurly")
    ;; 5: correlated rules in the tape, then a mismatch names the token
    (let ((s5 (servirtium_lfe:playback (++ tapes "cases.md"))))
      (volatile-driver "cases" s5)
      (servirtium_lfe:reset_cursor s5)
      (volatile-driver "cases-mismatch" s5)
      (require-found (servirtium_lfe:last_error s5 'false) "{{caseId-1}} = 42")
      (servirtium_lfe:last_error s5 'true)
      (require-ok (servirtium_lfe:close s5)))
    ;; 6: bind
    (require-found (volatile-start-error (++ tapes "cases_recorded.md") (list)) "caseId")
    (let ((s6 (servirtium_lfe:playback_with (++ tapes "cases_recorded.md")
                (list (tuple 'bind "caseId" "42")))))
      (volatile-driver "cases" s6)
      (require-ok (servirtium_lfe:close s6)))
    ;; 7: errors fail the start with the core's message
    (require-found (volatile-start-error (++ tapes "cases.md")
                     (list (tuple 'volatile_rule "request body" "no placeholder")))
                   "needs at least one placeholder")
    (let ((m (volatile-start-error (++ tapes "cases.md")
               (list (tuple 'volatile_rule "response body" "\"caseId\":\"{{id}}\"")))))
      (require-found m "conflicts with")
      (require-found m "(tape)"))
    (volatile-start-error (++ tapes "cases.md")
      (list (tuple 'volatile_rule "x" "a {{b}}" "regex")))
    'ok))
