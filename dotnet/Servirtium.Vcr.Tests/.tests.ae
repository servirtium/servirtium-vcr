// Servirtium.Vcr.Tests — run the xunit unit tests (dotnet test) against the
// generated project built by the sibling .build.ae. The engine .so is passed
// via SERVIRTIUM_VCR_LIB (NativeLoader also finds the native_runtime-staged
// copy next to the assembly). Sim-style: the test leaf lives in the test
// project dir, next to its generated csproj (dotnet.test scans source_dir).
import bldr
import dotnet
import bldr (env)
aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        dep("dotnet/Servirtium.Vcr.Tests/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        dotnet.test() { env("SERVIRTIUM_VCR_LIB", lib) }
    }
}
