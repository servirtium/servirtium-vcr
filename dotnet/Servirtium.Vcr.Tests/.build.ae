// Servirtium.Vcr.Tests — xunit unit tests for the .NET binding. Generated
// .csproj (git-ignored). ProjectReference to the library comes from the
// bldr.dep on Servirtium.Vcr/.build.ae; tapes/ fixtures are copied to the
// output dir via content_files (tests load them from AppContext.BaseDirectory).
import bldr
import dotnet
import dotnet (target_framework, nullable, test_project, nuget, content_files)
aeb(cap) {
    bldr.build() {
        dep("dotnet/Servirtium.Vcr/.build.ae")
        dotnet.build_project() {
            // net8.0 to MATCH the library leaf (Servirtium.Vcr targets net8.0
            // LTS). Tests were net10.0, which broke on SDK 10.0.302 with
            // NETSDK1226 (prune-package data missing for .NETCoreApp 10.0);
            // net8.0 has stable prune data on every SDK that can build this.
            target_framework("net8.0")
            nullable()
            test_project()
            nuget("Microsoft.NET.Test.Sdk:17.11.1")
            nuget("xunit:2.9.2")
            nuget("xunit.runner.visualstudio:2.8.2")
            content_files("tapes/**/*")
        }
    }
}
