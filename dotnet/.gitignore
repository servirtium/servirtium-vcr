*/bin/
*/obj/
.compatibility_suite*
.idea/
Servirtium.sln.DotSettings.user

# Generated by aeb (dotnet.build_project) from each project's .build.ae —
# never checked in. The .build.ae is the build authority; this is emitted.
**/.*.generated.csproj

# Native VCR libraries are build artifacts: produced by build-native.sh
# (locally) or the CI matrix (per RID), and bundled at pack time. Not
# committed — run ./build-native.sh after cloning to `dotnet test`.
Servirtium.Vcr/runtimes/**/native/*.so
Servirtium.Vcr/runtimes/**/native/*.dylib
Servirtium.Vcr/runtimes/**/native/*.dll
