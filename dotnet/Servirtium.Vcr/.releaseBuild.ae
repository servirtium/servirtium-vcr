// Release build of the Servirtium.Vcr managed assembly, wiring the FULL eight-RID
// native matrix into the generated project so `dotnet pack` (dotnet/Servirtium.Vcr/
// .dist.ae) bundles every verified release library under runtimes/<rid>/native/.
//
// Release-only twin of dotnet/Servirtium.Vcr/.build.ae: identical PropertyGroup
// (so the regenerated .Servirtium.Vcr.generated.csproj is the shape dotnet.pack()
// expects), but its single host native_runtime("linux-x64", …) is replaced by
// eight native_runtime(<rid>, <lib>) calls. FreeBSD is excluded (no standard
// NuGet RID).
//
// Each lib is STAGED DIRECTLY from this tag's release/dist (the checksummed
// release artifacts) into the project tree, mirroring selenium's
// dotnet/SeleniumCore/.releaseBuild.ae. This is deliberately NOT a
// dep_artifact(core/.releaseNugetMatrix.ae, …): release/build.sh reaches this
// node via `aeb dotnet/Servirtium.Vcr/.dist.ae --overrideDep
// dotnet/Servirtium.Vcr/.build.ae=dotnet/Servirtium.Vcr/.releaseBuild.ae`, and a
// node substituted in through --overrideDep does NOT get its own dep() edges
// resolved — so a matrix dep_artifact came back empty and the csproj got
// <None Include=""> (MSB4035). Reading release/dist directly sidesteps that.
import bldr
import dotnet
import dotnet (target_framework, root_namespace, assembly_name, nullable, package_id, package_version, package_description, native_runtime)
import std.fs
import std.string

// Copy one verified release engine from release/dist into the project tree under
// the canonical runtimes filename the .NET NativeLoader expects, and return the
// project-relative path for native_runtime().
_stage_release_native(root: string, source_name: string, rid: string, native_name: string) -> string {
    source = string.concat(root, string.concat("/release/dist/", source_name))
    destination_dir = string.concat(root, string.concat("/dotnet/Servirtium.Vcr/native/", rid))
    destination = string.concat(destination_dir, string.concat("/", native_name))
    if fs.exists(source) == 0 {
        bldr.fail(string.concat("release NuGet library missing: ", source))
        return ""
    } else {
        mkdir_err = fs.mkdir_p(destination_dir)
        if string.length(mkdir_err) > 0 {
            bldr.fail(string.concat("cannot stage NuGet library dir: ", destination_dir))
            return ""
        } else {
            copied, _copy_kind, copy_err = fs.copy(source, destination)
            if copied == 0 {
                bldr.fail(string.concat("cannot stage NuGet library: ", copy_err))
                return ""
            }
        }
    }
    return string.concat("native/", string.concat(rid, string.concat("/", native_name)))
}

aeb(cap) {
    bldr.build() {
        srcdir = bldr.source_dir(builder_context())
        root = string.concat(srcdir, "/../..")
        tag_text, read_err = fs.read(string.concat(root, "/SERVIRTIUM_VCR_VERSION"))
        if string.length(read_err) > 0 {
            bldr.fail("cannot read SERVIRTIUM_VCR_VERSION")
            return 1
        }
        tag = string.trim(tag_text)

        linux_x64 = _stage_release_native(root, string.concat("libservirtium_vcr-", string.concat(tag, "-linux-x86_64.so")), "linux-x64", "libservirtium_vcr.so")
        linux_arm64 = _stage_release_native(root, string.concat("libservirtium_vcr-", string.concat(tag, "-linux-arm64.so")), "linux-arm64", "libservirtium_vcr.so")
        linux_musl_x64 = _stage_release_native(root, string.concat("libservirtium_vcr-", string.concat(tag, "-linux-x86_64-musl.so")), "linux-musl-x64", "libservirtium_vcr.so")
        linux_musl_arm64 = _stage_release_native(root, string.concat("libservirtium_vcr-", string.concat(tag, "-linux-arm64-musl.so")), "linux-musl-arm64", "libservirtium_vcr.so")
        osx_x64 = _stage_release_native(root, string.concat("libservirtium_vcr-", string.concat(tag, "-macos-x86_64.dylib")), "osx-x64", "libservirtium_vcr.dylib")
        osx_arm64 = _stage_release_native(root, string.concat("libservirtium_vcr-", string.concat(tag, "-macos-arm64.dylib")), "osx-arm64", "libservirtium_vcr.dylib")
        win_x64 = _stage_release_native(root, string.concat("libservirtium_vcr-", string.concat(tag, "-windows-x86_64.dll")), "win-x64", "servirtium_vcr.dll")
        win_arm64 = _stage_release_native(root, string.concat("libservirtium_vcr-", string.concat(tag, "-windows-arm64.dll")), "win-arm64", "servirtium_vcr.dll")

        dotnet.build_project() {
            // Mirror dotnet/Servirtium.Vcr/.build.ae's PropertyGroup EXACTLY so
            // the regenerated csproj differs only in the native_runtime grid.
            target_framework("net8.0")
            root_namespace("Servirtium.Vcr")
            assembly_name("Servirtium.Vcr")
            nullable()
            package_id("Servirtium.Vcr")
            package_version("2.0.0-alpha.8")
            package_description("Idiomatic .NET record/replay (Servirtium) over the Aether VCR core, via P/Invoke to a precompiled native library.")
            native_runtime("linux-x64", linux_x64)
            native_runtime("linux-arm64", linux_arm64)
            native_runtime("linux-musl-x64", linux_musl_x64)
            native_runtime("linux-musl-arm64", linux_musl_arm64)
            native_runtime("osx-x64", osx_x64)
            native_runtime("osx-arm64", osx_arm64)
            native_runtime("win-x64", win_x64)
            native_runtime("win-arm64", win_arm64)
        }
    }
}
