// .NET binding tests. P/Invoke loads the shared engine via SERVIRTIUM_VCR_LIB.
import build
import std.os
aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    root = build._get(b, "root")
    lib = "${root}/core/native/libservirtium_vcr.so"
    rc = os.system("cd \"${root}/dotnet\" && SERVIRTIUM_VCR_LIB=\"${lib}\" dotnet test --nologo")
    if rc != 0 { println("dotnet: tests failed"); return 1 }
    println("dotnet: tests passed")
    return 0
}
