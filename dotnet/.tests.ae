// .NET binding tests. P/Invoke loads the shared engine via SERVIRTIUM_VCR_LIB.
import build
import dotnet
import build (env)
aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    lib = build.dep_artifact(b, "core/.build.ae", "shared_lib")
    dotnet.test_existing(b) { env("SERVIRTIUM_VCR_LIB", lib) }
}
