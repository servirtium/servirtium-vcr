// Lua binding tests. The binding is a hand-written Lua 5.4 C EXTENSION
// (csrc/servirtium.c — NOT LuaJIT FFI, since LuaJIT isn't installed) that
// links the shared engine (core/.build.ae output:
// core/native/libservirtium_vcr.so) via
// `cc ... -L<core/native> -lservirtium_vcr -Wl,-rpath,<core/native>`, so this
// deps the engine node, compiles servirtium_native.so, then runs the lua test.
// The rpath makes the engine resolvable at runtime; SERVIRTIUM_VCR_LIB is also
// passed for parity with the other bindings. tests/run_all.lua drives the full
// suite (playback + record + mutation, ~14 cases): playback shells out to curl
// against the VCR server; record/mutation spawn a throwaway python3 upstream
// (Lua 5.4 has no stdlib sockets) and record to temp tapes.
import bldr
import lua
import bldr (env, step)
import std.path
aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        core = path.dirname(lib)
        lua.test() {
            env("LUA_CPATH", "./?.so;;")
            env("SERVIRTIUM_VCR_LIB", lib)
            step("./build.sh \"${core}\"")
            step("lua5.4 tests/run_all.lua")
        }
    }
}
