// Release verification shared by the aeb node and its negative-path tests.
import std.cryptography
import std.dl
import std.fs
import std.list
import std.map
import std.os
import std.regex
import std.string
exports(check_version, check_artifacts, check_packages, check_link_identity, host_slot)

const PLATFORMS[] = ["linux-x86_64.so", "linux-arm64.so", "macos-x86_64.dylib", "macos-arm64.dylib",
    "windows-x86_64.dll", "windows-arm64.dll", "freebsd-x86_64.so", "linux-x86_64-musl.so", "linux-arm64-musl.so"]

// Match only the value: the surrounding pin syntax is part of the contract.
pin(file: string, pattern: string) -> string {
    text = fs.read(file)!
    re = regex.compile_flags(pattern, regex.FLAG_MULTILINE)!
    defer regex.free(re)
    hits = regex.find_all(re, text)!
    defer regex.find_all_free(hits)
    if hits == null || regex.find_all_count(hits) != 1 { return "" }
    return string.substring(text, regex.find_all_start(hits, 0), regex.find_all_end(hits, 0))
}
replace_pattern(pattern: string, text: string, replacement: string) -> (string, string) {
    re = regex.compile(pattern)!
    defer regex.free(re)
    return regex.replace_all(re, text, replacement)
}
// The slot whose library this host can dlopen: the ABI-export check loads it.
// Release runners are linux-x86_64, so that stays the fallback; a FreeBSD or
// macOS host checks its own slot (a Linux ELF cannot be dlopen'd there).
host_slot() -> string {
    key = "${os.platform()}-${os.arch()}."
    for i in 0..PLATFORMS.len {
        if string.starts_with(PLATFORMS[i], key) == 1 { return PLATFORMS[i] }
    }
    return "linux-x86_64.so"
}
// The names a consumer's loader looks for. A link-time binding records the
// library's own name (Mach-O install name, ELF SONAME) when it links, then
// finds that name through its rpath at run time, where every binding stages
// the library as libservirtium_vcr.dylib / .so (and `ae add` installs it so).
const DYLIB_ID = "@rpath/libservirtium_vcr.dylib"
const ELF_SONAME = "libservirtium_vcr.so"
// zlib's own inflate error text: present when zlib is compiled in. A library
// that depends on a shared zlib names it instead (an in-tree host build).
const ZLIB_MARKERS[] = ["incorrect header check", "libz.so.1", "libz.so.6", "libz.1.dylib", "zlib1.dll"]

macho_le32(b: byte[], at: int) -> int {
    return (b[at] as int) | ((b[at + 1] as int) << 8) | ((b[at + 2] as int) << 16) | ((b[at + 3] as int) << 24)
}
// The install name (LC_ID_DYLIB) of a thin 64-bit little-endian Mach-O, or
// "" when there is none; error when the bytes are not such a Mach-O.
macho_install_name(b: byte[], n: int) -> (string, string) {
    if n < 32 || b[0] != 0xcf || b[1] != 0xfa || b[2] != 0xed || b[3] != 0xfe { return "", "not a 64-bit Mach-O" }
    ncmds = macho_le32(b, 16)
    at = 32
    for _i in 0..ncmds {
        if at + 8 > n { return "", "truncated Mach-O load commands" }
        cmd = macho_le32(b, at); size = macho_le32(b, at + 4)
        if size < 8 || at + size > n { return "", "bad Mach-O load command size" }
        if cmd == 0xd {
            start = at + macho_le32(b, at + 8)
            stop = start
            while stop < at + size && b[stop] != 0 { stop += 1 }
            out = ""
            for k in start..stop { out = string.concat(out, string.from_char(b[k] as int)) }
            return out, ""
        }
        at += size
    }
    return "", ""
}
has_bytes(b: byte[], n: int, needle: string) -> bool {
    m = string.length(needle)
    if m == 0 || m > n { return false }
    nb = string.bytes(needle)
    first = nb[0]
    i = 0
    while i + m <= n {
        if b[i] == first {
            j = 1
            while j < m && b[i + j] == nb[j] { j += 1 }
            if j == m { return true }
        }
        i += 1
    }
    return false
}
// Per platform: the dylib's install name, the ELF SONAME (none, or the plain
// name; readelf output is passed in where the caller ran it), and zlib.
check_link_identity(file: string, platform: string, readelf: string) -> string {
    data, n, err = fs.read_binary(file)
    if err != "" || n <= 0 { return "cannot read ${file}" }
    b = string.bytes(data)
    if string.starts_with(platform, "macos-") == 1 {
        id, merr = macho_install_name(b, n)
        if merr != "" { return "${file}: ${merr}" }
        if id != DYLIB_ID { return "wrong install name in ${file}: '${id}' (must be ${DYLIB_ID})" }
    }
    if string.length(readelf) > 0 && string.contains(readelf, "(SONAME)") == 1 {
        soname = replace_pattern("(?s)^.*[(]SONAME[)][^\\[]*\\[([^]]+)\\].*$", readelf, "$1")!
        if soname != ELF_SONAME { return "wrong SONAME in ${file}: '${soname}' (must be ${ELF_SONAME} or none)" }
    }
    for i in 0..ZLIB_MARKERS.len {
        if has_bytes(b, n, ZLIB_MARKERS[i]) { return "" }
    }
    return "no zlib in ${file}: record mode could not decode a gzip upstream"
}
check_version(root: string, tag: string) -> string {
    if regex.matches_lit("^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$", tag)! == 0 { return "invalid release tag: ${tag}" }
    want = string.trim(fs.read("${root}/SERVIRTIUM_VCR_VERSION")!)
    if want != tag { return "SERVIRTIUM_VCR_VERSION is ${want}, expected ${tag}; commit the pin before tagging" }
    ae = pin("${root}/bootstrap.sh", "^AE_FETCH=\"\\K[^\"]+(?=\"$)")
    pinned_ae = pin("${root}/release/toolchain.env", "^AETHER_REF=\\K\\S+$")
    if ae == "" || ae != pinned_ae { return "release/toolchain.env AETHER_REF must match bootstrap.sh AE_FETCH" }
    aeb = pin("${root}/bootstrap.sh", "^AEB_REF=\"[$][{]AEB_REF:-\\K[^}]+(?=[}]\"$)")
    pinned_aeb = pin("${root}/release/toolchain.env", "^AEB_REF=\\K\\S+$")
    if aeb == "" || aeb != pinned_aeb { return "release/toolchain.env AEB_REF must match bootstrap.sh's default AEB_REF" }
    return ""
}
checksum(file: string) -> (string, string) {
    size, err = fs.size(file)
    if err != "" || size == 0 { return "", "missing or empty artifact: ${file}" }
    digest = cryptography.sha256_file(file)!
    sidecar = string.trim(fs.read("${file}.sha256")!)
    if regex.matches_lit("^${digest}\\s+\\Q${fs.path_basename(file)}\\E$", sidecar)! == 0 { return "", "checksum mismatch: ${file}" }
    return digest, ""
}
check_manifest(file: string, manifest: ptr) -> string {
    digest, err = checksum(file)
    if err != "" { return err }
    listed, _missing = map.get_string(manifest, fs.path_basename(file))
    if listed != digest { return "manifest mismatch: ${file}" }
    return ""
}
check_artifacts(root: string, tag: string, dist: string) -> string {
    manifest = map.map_new()
    defer map.map_free(manifest)
    lines = string.split(string.trim(fs.read("${dist}/SHA256SUMS.txt")!), "\n")
    defer string.array_free(lines)
    for i in 0..string.array_size(lines) {
        line = string.array_get(lines, i)
        fields = string.split(replace_pattern("\\s+", string.trim(line), " ")!, " ")
        if string.array_size(fields) != 2 { string.array_free(fields); return "invalid SHA256SUMS.txt entry" }
        name, _stripped = string.strip_prefix(string.array_get(fields, 1), "./")
        map.map_put(manifest, name, string.array_get(fields, 0))
        string.array_free(fields)
    }
    // The `ae add` package's stem is libservirtium_vcr, so its per-triple
    // assets are these raw libraries; only its aether.toml is separate.
    packages = dist
    if fs.dir_exists("${dist}/ae-add") == 1 { packages = "${dist}/ae-add" }
    for i in 0..PLATFORMS.len {
        platform = PLATFORMS[i]
        raw = "${dist}/libservirtium_vcr-${tag}-${platform}"
        err = check_manifest(raw, manifest)
        if err != "" { return err }
        dynamic = ""
        if string.starts_with(platform, "linux-") == 1 || string.starts_with(platform, "freebsd-") == 1 {
            args = list.new(); list.add(args, "-d"); list.add(args, raw)
            out, status, run_err = os.run_capture("readelf", args, null)
            list.free(args)
            if run_err != "" || status != 0 { return "readelf failed for ${raw}: ${run_err}" }
            dynamic = out
        }
        if string.starts_with(platform, "linux-") == 1 {
            needed = replace_pattern("(?m)^.*[(]NEEDED[)].*\\[([^]]+)\\].*$", dynamic, "NEEDED:$1")!
            libc = "libc.so.6"; other = "libc.so"
            if string.contains(platform, "-musl") == 1 { libc = "libc.so"; other = "libc.so.6" }
            if string.contains(needed, "NEEDED:${libc}\n") == 0 || string.contains(needed, "NEEDED:${other}\n") == 1 { return "wrong Linux libc for ${raw}" }
        }
        err = check_link_identity(raw, platform, dynamic)
        if err != "" { return err }
        if string.starts_with(platform, "windows-") == 1 {
            err = check_manifest("${raw}.lib", manifest)
            if err != "" { return err }
        }
    }
    toml = fs.read("${packages}/aether.toml")!
    if regex.matches_lit("(?m)^binary = \"libservirtium_vcr\"$", toml)! == 0 || regex.matches_lit("(?m)^modules = \"[.]\"$", toml)! == 0 { return "ae-add manifest must export binary libservirtium_vcr at modules = '.'" }
    slot = host_slot()
    library = dl.open("${dist}/libservirtium_vcr-${tag}-${slot}")!
    defer dl.close(library)
    source = fs.read("${root}/core/embed.ae")!
    re = regex.compile_flags("^vcr_embed_\\w+(?=[(])", regex.FLAG_MULTILINE)!
    defer regex.free(re)
    symbols = regex.find_all(re, source)!
    defer regex.find_all_free(symbols)
    count = regex.find_all_count(symbols)
    if count == 0 { return "no C ABI declarations found" }
    for i in 0..count {
        name = string.substring(source, regex.find_all_start(symbols, i), regex.find_all_end(symbols, i))
        symbol, err = dl.symbol(library, "aether_${name}")
        if symbol == null || err != "" { return "missing ABI export in ${slot}: aether_${name}" }
    }
    println("Verified ${PLATFORMS.len} libraries (install names, SONAMEs, zlib), Windows import libraries, the ae-add manifest, checksums, and ${count} ABI exports (${slot}).")
    return ""
}
check_packages(dist: string) -> string {
    jars = 0; nupkgs = 0; tgzs = 0; bundles = 0
    entries = fs.list_dir(dist)!
    defer fs.dir_list_free(entries)
    for i in 0..fs.dir_list_count(entries) {
        name = fs.dir_list_get(entries, i)
        jar = string.starts_with(name, "servirtium-vcr-") == 1 && string.ends_with(name, ".jar") == 1 && string.ends_with(name, "-sources.jar") == 0 && string.ends_with(name, "-javadoc.jar") == 0
        nupkg = string.starts_with(name, "Servirtium.Vcr.") == 1 && string.ends_with(name, ".nupkg") == 1
        tgz = string.starts_with(name, "servirtium-vcr-") == 1 && string.ends_with(name, ".tgz") == 1
        bundle = string.starts_with(name, "servirtium-vcr-swift-") == 1 && string.ends_with(name, ".artifactbundle.zip") == 1
        if jar || nupkg || tgz || bundle {
            _digest, err = checksum("${dist}/${name}")
            if err != "" { return err }
            if jar { jars += 1 } else if nupkg { nupkgs += 1 } else if tgz { tgzs += 1 } else { bundles += 1 }
        }
    }
    if jars == 0 { return "no fat Java jar (servirtium-vcr-*.jar) in dist" }
    if nupkgs == 0 { return "no multi-RID .NET nupkg (Servirtium.Vcr.*.nupkg) in dist" }
    if tgzs == 0 { return "no multi-platform npm tarball (servirtium-vcr-*.tgz) in dist" }
    if bundles == 0 { return "no Swift artifact bundle (servirtium-vcr-swift-*.artifactbundle.zip) in dist" }
    println("Verified ${jars} fat Java jar(s), ${nupkgs} multi-RID .NET nupkg(s), ${tgzs} npm tarball(s) and ${bundles} Swift artifact bundle(s) with checksums.")
    return ""
}
