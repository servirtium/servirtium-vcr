// Groovy binding tests — compile src/test/groovy, run via JUnit 5 (the
// runner is language-agnostic). Engine .so via SERVIRTIUM_VCR_LIB.
import build
import groovy
import java
import groovy (source_layout, target_bytecode)
import build (env)
aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    build.dep(b, "groovy/.build.ae")
    build.dep(b, "libs/java/junit-jupiter/.junit-jupiter.jar.ae")
    lib = build.dep_artifact(b, "core/.build.ae", "shared_lib")
    groovy.groovyc_test(b) { source_layout("maven idiomatic") target_bytecode("22") }
    java.junit5(b) { env("SERVIRTIUM_VCR_LIB", lib) }
}
