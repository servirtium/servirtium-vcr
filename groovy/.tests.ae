// Groovy binding tests — compile src/test/groovy, run via JUnit 5 (the
// runner is language-agnostic). Engine .so via SERVIRTIUM_VCR_LIB.
//
// The Groovy RUNTIME jar is a dep for the run, not the compile: groovyc comes
// from the system Groovy install, but every class it emits implements
// groovy.lang.GroovyObject, so without the runtime on the JUnit classpath the
// test class cannot load. JUnit's scanner silently skips classes it can't
// load, so the symptom was "0 tests found" — a red suite that never mentioned
// Groovy. Kotlin and Scala don't need this because kotlinc/scalac classes
// carry their stdlib in via the binding's own jar deps.
import bldr
import groovy
import java
import groovy (source_layout, target_bytecode)
import bldr (env)
aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        dep("groovy/.build.ae")
        dep("libs/java/junit-jupiter/.junit-jupiter.jar.ae")
        dep("libs/java/groovy/.groovy.jar.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        groovy.groovyc_test() { source_layout("maven idiomatic") target_bytecode("22") }
        java.junit5() { env("SERVIRTIUM_VCR_LIB", lib) }
    }
}
