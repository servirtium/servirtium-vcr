// Groovy binding — aeb-native. Compiles src/main/groovy against the Java
// binding's classes (build.dep java/.build.ae); the groovy SDK supplies the
// Groovy runtime jars.
import build
import groovy
import groovy (source_layout, target_bytecode)
aeb(cap) {
    b = build.start()
    build.dep(b, "java/.build.ae")
    groovy.groovyc(b) { source_layout("maven idiomatic") target_bytecode("22") }
}
