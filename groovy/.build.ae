// Groovy binding — aeb-native. Compiles src/main/groovy against the Java
// binding's classes (bldr.dep java/.build.ae); the groovy SDK supplies the
// Groovy runtime jars.
import bldr
import groovy
import groovy (source_layout, target_bytecode)
aeb(cap) {
    bldr.build() {
        dep("java/.build.ae")
        groovy.groovyc() { source_layout("maven idiomatic") target_bytecode("22") }
    }
}
