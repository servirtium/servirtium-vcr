// Third-party-consumer EXAMPLE test for the Groovy binding. Standalone Maven
// project depending only on the installed servirtium-vcr-groovy jar (~/.m2);
// replays the canonical tape via the Groovy DSL, engine .so transitive from the
// servirtium-vcr jar resource, no SERVIRTIUM_VCR_LIB.
import bldr
import std.os

aeb(cap) {
    bldr.build() {
        dep("groovy/.package.ae")
        _gav = dep_artifact("groovy/.package.ae", "maven_gav")
        root = _get("root")
        exdir = "${root}/groovy/example"
    
        rc = os.system("cd \"${exdir}\" && env -u SERVIRTIUM_VCR_LIB mvn -q -B test")
        if rc != 0 {
            println("groovy example: consumer `mvn test` against the installed groovy jar failed")
            return 1
        }
        println("groovy example: PASS — installed Groovy jar replayed the canonical tape (discovery)")
        return 0
    }
}
