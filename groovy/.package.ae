// Third-party-consumer PACKAGE stage for the Groovy binding.
// mvn-installs the Groovy DSL layer (servirtium-vcr-groovy) to ~/.m2; deps
// java/.package.ae so the Java jar (with the bundled engine .so) is present and
// rides along transitively for a Groovy consumer.
import bldr
import maven

aeb(cap) {
    bldr.build() {
        dep("java/.package.ae")

        // maven.install runs `mvn -q -DskipTests install` in this leaf's
        // module_dir (groovy/) — no ${root}/groovy hardcode.
        maven.install()

        publish_artifact("maven_gav", "com.paulhammant.servirtium:servirtium-vcr-groovy:2.0.0-SNAPSHOT")
        println("groovy package: installed servirtium-vcr-groovy jar to ~/.m2")
        return 0
    }
}
