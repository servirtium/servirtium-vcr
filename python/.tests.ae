// Python binding tests (ctypes). The loader honors SERVIRTIUM_VCR_LIB, which
// we point at the shared engine artifact this node deps. python.test runs the
// project's pytest as-is (system python3, serial).
import bldr
import python
import bldr (env)
aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        python.test() { env("SERVIRTIUM_VCR_LIB", lib) }
    }
}
