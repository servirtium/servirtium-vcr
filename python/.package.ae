// Third-party-consumer PACKAGE stage for the Python binding.
//
// Builds the `servirtium` wheel exactly as a downstream user would receive it
// from PyPI: the freshly-built engine .so bundled INSIDE the wheel (via the
// existing setup.py `package_data={'servirtium': ['native/*.so', ...]}`), using
// the idiomatic `python -m build`. We deliberately do NOT use aeb's
// python.package builder here — it generates/overwrites pyproject.toml from DSL
// metadata and would drop the native-lib bundling that setup.py encodes.
//
// Deps core/.build.ae for the engine .so; publishes the built wheel on the
// "wheel" artifact edge, which python/.example.ae consumes.
import bldr
import std.os
import copy
import copy (from, to)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")
        pydir = "${root}/python"

        // 1. Bundle the engine .so into the package tree (what the wheel ships).
        //    copy.file auto-creates the dest parent; `to` resolves against the
        //    leaf's source_dir (python/).
        copy.file() {
            from(lib)
            to("servirtium/native/libservirtium_vcr.so")
        }

        // 2. Build the wheel from the existing setup.py (isolated build backend).
        rc2 = os.system("cd \"${pydir}\" && rm -rf dist build servirtium.egg-info && python3 -m build --wheel")
        if rc2 != 0 {
            println("python package: `python3 -m build --wheel` failed (is python-build installed?)")
            return 1
        }
    
        // 3. Publish the dist/ dir (holds exactly one wheel — dist was wiped above).
        //    We can't rename the wheel to a fixed name: pip validates wheel
        //    filenames strictly (name-version-python-abi-platform). The consumer
        //    leaf globs dist/*.whl.
        rc3 = os.system("ls \"${pydir}/dist\"/*.whl >/dev/null 2>&1")
        if rc3 != 0 {
            println("python package: no wheel produced under python/dist/")
            return 1
        }
        publish_artifact("wheel_dir", "${pydir}/dist")
        println("python package: built wheel with engine .so bundled → python/dist/")
        return 0
    }
}
