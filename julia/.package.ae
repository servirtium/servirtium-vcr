// Third-party-consumer PACKAGE stage for the Julia binding.
//
// Julia consumes `Servirtium` as a Pkg package (source-consumed from a path or
// git URL): Project.toml + src/. `ccall` needs an actual library path, and the
// module resolves one in three steps — SERVIRTIUM_VCR_LIB, then a bundled
// native/libservirtium_vcr.so beside the package, then the bare soname. This
// stage puts the freshly-built engine .so at that bundled path, so a
// Pkg.add-ed copy works with SERVIRTIUM_VCR_LIB unset.
//
// No tests run here; packaging is a build step (julia/.tests.ae is the test
// node). Deps core/.build.ae; publishes the package dir on "package_dir".
import bldr
import copy
import copy (from, to)
aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")

        copy.file() {
            from(lib)
            to("native/libservirtium_vcr.so")
        }

        publish_artifact("package_dir", "${_get("root")}/julia")
        println("julia package: staged engine .so into julia/native/ (Pkg package ready)")
        return 0
    }
}
