// Third-party-consumer EXAMPLE test for the Erlang binding.
//
// Relocates the self-contained servirtium_nif app (erlang/_build_pkg) to
// target/erlang-pkg — proving the $ORIGIN rpath, since the NIF now finds the
// engine .so beside it in priv/ at a NEW location with no core/ near. A
// consumer escript then uses `servirtium` via ERL_LIBS (standard OTP
// resolution) and replays the canonical tape, with no SERVIRTIUM_VCR_LIB.
import bldr
import std.os

aeb(cap) {
    bldr.build() {
        dep("erlang/.package.ae")
        libs = dep_artifact("erlang/.package.ae", "erl_libs")
        root = _get("root")
        exdir = "${root}/erlang/example"
        pkg = "${root}/target/erlang-pkg"
        consumer = "${root}/target/erlang-consumer"
    
        rc = os.system("rm -rf \"${pkg}\" \"${consumer}\" && cp -r \"${libs}\" \"${pkg}\" && mkdir -p \"${consumer}/tapes\" && cp \"${exdir}/consumer.escript\" \"${consumer}/\" && cp \"${exdir}/tapes/single_get.md\" \"${consumer}/tapes/\"")
        if rc != 0 {
            println("erlang example: relocating the app + staging consumer failed")
            return 1
        }
    
        rc2 = os.system("cd \"${consumer}\" && env -u SERVIRTIUM_VCR_LIB ERL_LIBS=\"${pkg}\" escript consumer.escript")
        if rc2 != 0 {
            println("erlang example: consumer escript against the relocated app failed")
            return 1
        }
        println("erlang example: PASS — consumer replayed the canonical tape (discovery; $ORIGIN-relocated NIF)")
        return 0
    }
}
