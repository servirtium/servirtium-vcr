// Erlang binding tests. Erlang owns the canonical Servirtium NIF for the BEAM
// family — erlang/.build.ae compiles it ONCE into the OTP app
// _build/servirtium_nif/{ebin,priv}. This node deps that build and runs the
// escript with ERL_LIBS pointed at _build, so the `servirtium`/`servirtium_nif`
// modules and the NIF .so resolve the standard OTP way (code:priv_dir). The
// Elixir and Gleam leaves consume the very same _build app.
import build
import erlang
import build (env, step)
aeb(cap) {
    b = build.start()
    build.dep(b, "erlang/.build.ae")
    libs = build.dep_artifact(b, "erlang/.build.ae", "erl_libs")
    erlang.eunit(b) {
        env("ERL_LIBS", libs)
        step("escript test/playback.escript")
    }
}
