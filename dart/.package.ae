// Third-party-consumer PACKAGE stage for the Dart binding.
//
// Dart/pub packages are source-consumed; "packaging" here stages the freshly-
// built engine .so into dart/lib/native/ — the fixed, package-relative
// location the loader self-locates via the consumer's package_config.json
// (`package:servirtium` -> its lib/, so lib/native/ survives pub publish and a
// path: dep alike). Deps core/.build.ae; publishes the dart package dir on the
// "package_dir" edge for dart/.example.ae.
import bldr
import copy
import copy (from, to)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")

        // copy.file auto-creates the dest parent; `to` resolves against this
        // leaf's source_dir (dart/), so no ${root}/dart hardcode.
        copy.file() {
            from(lib)
            to("lib/native/libservirtium_vcr.so")
        }

        publish_artifact("package_dir", "${_get("root")}/dart")
        println("dart package: staged engine .so into dart/lib/native/ (pub package ready)")
        return 0
    }
}
