// Dart binding tests (dart:ffi). The loader honors SERVIRTIUM_VCR_LIB, pointed
// at the shared engine artifact this node deps. `dart pub get` then `dart test`
// serially (-j 1; native VCR state is process-global, shared across isolates).
import build
import dart
import build (env, step)
aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    lib = build.dep_artifact(b, "core/.build.ae", "shared_lib")
    dart.test_existing(b) {
        env("SERVIRTIUM_VCR_LIB", lib)
        step("dart pub get >/dev/null 2>&1")
        step("dart test -j 1")
    }
}
