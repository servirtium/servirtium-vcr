// Elixir binding tests. Elixir does NOT build its own NIF — it consumes the
// shared `servirtium_nif` OTP app that the Erlang binding builds once
// (erlang/.build.ae -> erlang/_build/servirtium_nif). This node deps that
// build and runs `mix test`, passing SERVIRTIUM_NIF_EBIN so test_helper.exs
// Code.append_path's the shared app onto the code path (mix doesn't fold
// ERL_LIBS in); code:priv_dir then resolves priv/servirtium_nif.so and the NIF
// loads. The engine .so is pulled in transitively via erlang/.build.ae's dep
// on core. ExUnit runs serially (max_cases: 1).
import build
import elixir
import build (env)
import elixir (deps_get_first)
aeb(cap) {
    b = build.start()
    build.dep(b, "erlang/.build.ae")
    ebin = build.dep_artifact(b, "erlang/.build.ae", "nif_ebin")
    elixir.test(b) {
        env("SERVIRTIUM_NIF_EBIN", ebin)
        deps_get_first("1")
    }
}
