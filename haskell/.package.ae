// Third-party-consumer PACKAGE stage for the Haskell binding.
// The servirtium-haskell package links the engine .so via `extra-libraries:
// servirtium_vcr` + an extra-lib-dirs/rpath a consumer supplies. This stages
// the freshly-built engine .so into haskell/native/, where a consumer points
// extra-lib-dirs. Deps core/.build.ae; publishes the haskell package dir.
import bldr
import std.os

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")
        hsdir = "${root}/haskell"
    
        rc = os.system("mkdir -p \"${hsdir}/native\" && cp \"${lib}\" \"${hsdir}/native/libservirtium_vcr.so\"")
        if rc != 0 {
            println("haskell package: failed to stage engine .so into haskell/native/")
            return 1
        }
        publish_artifact("package_dir", "${hsdir}")
        println("haskell package: staged engine .so into haskell/native/ (cabal package ready)")
        return 0
    }
}
