cabal-version: 1.12

name:           servirtium-haskell
version:        2.0.0
synopsis:       Thin Haskell FFI wrapper over the Aether VCR record/replay core
description:    Please see the README on GitHub at <https://github.com/servirtium/servirtium-haskell#readme>
category:       Testing, Web
homepage:       https://github.com/servirtium/servirtium-haskell#readme
bug-reports:    https://github.com/servirtium/servirtium-haskell/issues
author:         Servirtium contributors
maintainer:     paul@hammant.org
copyright:      MIT
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/servirtium/servirtium-haskell

library
  exposed-modules:
      Servirtium.Vcr
      Servirtium.Vcr.Native
  hs-source-dirs:
      src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  -- Link against the native Aether VCR engine (libservirtium_vcr.so, built
  -- by ./build-native.sh into native/). The lib *directory* is supplied as an
  -- absolute path + rpath via cabal.project.local, which build-native.sh
  -- generates: ghc-pkg rejects a *relative* extra-lib-dirs when it registers
  -- this library, so we don't list `native` here. See docs/building.md.
  extra-libraries:
      servirtium_vcr
  build-depends:
      base >=4.11 && <10
  default-language: Haskell2010

-- TodoBackend browser integration: drives the vendored Mocha CRUD suite in
-- real headless Chrome (via the `webdriver` package + the cached chromedriver)
-- against a Servirtium VCR. Two phases share Browser; `playback` is the offline
-- CI artifact (integration/todobackend/.haskell_playback.ae), `record` is
-- on-demand. Built only when its leaf is named — the cabal `test` stanza is
-- unaffected. Sources live under integration/todobackend/haskell.
executable servirtium-todobackend
  main-is: Main.hs
  other-modules:
      Browser
  hs-source-dirs:
      ../integration/todobackend/haskell
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  -- See the library stanza: extra-lib-dirs/rpath come from cabal.project.local
  -- so this binary links + loads the engine (transitively, via the library).
  build-depends:
      base >=4.11 && <10
    , servirtium-haskell
    , text
    , directory
    , webdriver
    , monad-logger
    , unliftio
  default-language: Haskell2010

test-suite servirtium-haskell-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      PlaybackSpec
      RecordSpec
      RedactionSpec
      MismatchSpec
      TestSupport
  hs-source-dirs:
      test
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  -- See the library stanza: extra-lib-dirs/rpath come from cabal.project.local
  -- (generated by build-native.sh) so test binaries link + load the engine.
  extra-libraries:
      servirtium_vcr
  build-depends:
      base >=4.11 && <10
    , bytestring
    , directory
    , filepath
    , hspec
    , http-client
    , http-types
    , network
    , servirtium-haskell
  default-language: Haskell2010
